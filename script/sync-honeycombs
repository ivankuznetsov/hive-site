#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../lib/honeycomb_catalog_sync"

options = {}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: script/sync-honeycombs --catalog PATH --source-sha SHA"
  opts.on("--catalog PATH", "Local Honeycomb repository-root catalog.json") { |value| options[:catalog_path] = value }
  opts.on("--source-sha SHA", "Pinned merged Honeycomb commit") { |value| options[:source_sha] = value }
  opts.on("-h", "--help", "Show this help") do
    puts opts
    exit 0
  end
end

begin
  parser.parse!
  raise OptionParser::MissingArgument, "--catalog" unless options[:catalog_path]
  raise OptionParser::MissingArgument, "--source-sha" unless options[:source_sha]
  raise OptionParser::InvalidOption, ARGV.join(" ") unless ARGV.empty?

  HoneycombCatalogSync.sync!(**options)
  puts "Synced _data/honeycombs.json from Honeycomb #{options.fetch(:source_sha)}"
rescue OptionParser::ParseError => e
  warn "sync-honeycombs: #{e.message}"
  warn parser
  exit 2
rescue HoneycombCatalogSync::Invalid => e
  e.errors.each { |error| warn "sync-honeycombs: #{error}" }
  exit 1
end
