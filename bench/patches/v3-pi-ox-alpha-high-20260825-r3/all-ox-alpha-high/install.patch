+    DESC
+    option :purge, type: :boolean, default: false,
+                   desc: "non-interactive removal of binary/registration layers (never deletes project state)"
+    option :cleanup_projects, type: :array, desc: "explicit opt-in list of project names whose hive state should be removed"
+    def uninstall
+      require "hive/commands/uninstall"
+      exit Hive::Commands::Uninstall.new(
