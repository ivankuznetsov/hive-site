+
+      File.write(
+        File.join(task_folder, "reviews", "escalations-01.md"),
+        "# Escalations\n\n- [ ] still open for human\n"
+      )
+      unanswered = evaluate(task, ctx, binding, worktree)
+      refute unanswered.accepted
