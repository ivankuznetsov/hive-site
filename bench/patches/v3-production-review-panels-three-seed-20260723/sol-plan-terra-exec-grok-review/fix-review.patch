+  def test_rejects_unanswered_escalation_errors_file_and_unreadable_worktree
+    with_tmp_git_repo do |worktree|
+      task_folder, ctx, task = review_context(worktree)
+      baseline = git_head(worktree)
+      binding = Hive::Stages::Review::CompletionEvidence.prepare!(
+        task: task, ctx: ctx, accepted_findings: 1, baseline_head: baseline
