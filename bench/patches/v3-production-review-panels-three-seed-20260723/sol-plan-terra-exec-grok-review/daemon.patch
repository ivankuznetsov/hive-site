+          normalized = value.transform_keys(&:to_s)
+          required = %w[task_id stage marker_id reason attempt]
+          return nil unless normalized.keys.sort == required.sort
+          return nil if normalized["task_id"].to_s.empty? || normalized["marker_id"].to_s.empty? ||
+                        normalized["reason"].to_s.empty?
+          return nil unless normalized["stage"].is_a?(String) &&
+                            /\A\d+-[a-z][a-z0-9-]*\z/.match?(normalized["stage"])
+          return nil unless normalized["attempt"].is_a?(Integer) && normalized["attempt"].between?(1, 2)
+
+          normalized.slice(*required)
+        end
+
         def parse_time(value)
           return nil if value.nil? || value.to_s.empty?
 
