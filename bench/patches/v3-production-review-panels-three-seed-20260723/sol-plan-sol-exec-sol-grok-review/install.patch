+  def test_release_workflow_is_two_phase_and_distribution_suite_is_blocking
+    workflow = File.read(File.join(ROOT, ".github/workflows/release.yml"))
+    build_workflow = File.read(File.join(ROOT, ".github/workflows/build-release.yml"))
+    install_smoke = File.read(File.join(ROOT, ".github/workflows/install-smoke.yml"))
+    assert_match(/needs:.*build/m, workflow)
