+    assert_match(/needs:.*release/m, workflow)
+    assert_includes workflow, "rake distribution"
+    assert_includes workflow, "tier1-shell"
+    assert_includes workflow, "tier1-homebrew"
+    assert_includes workflow, "tier1-aur"
+    assert_includes workflow, "publish-skills"
+    assert_includes workflow, "claude plugin marketplace add"
+    assert_includes workflow, "claude plugin install"
+    assert_includes workflow, "codex plugin add"
+    assert_includes workflow, "pi install"
