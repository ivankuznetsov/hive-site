+require "test_helper"
+require "hive/command_name"
+
+class HiveCommandNameTest < Minitest::Test
+  include HiveTestHelper
+
+  def test_selects_hive_when_unclaimed
+    with_tmp_dir do |dir|
+      assert_equal "hive", Hive::CommandName.select(path: dir)
+    end
