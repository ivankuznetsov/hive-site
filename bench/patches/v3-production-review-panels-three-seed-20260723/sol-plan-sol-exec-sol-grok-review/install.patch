+    publisher = File.read(File.join(ROOT, "scripts/publish-packages"))
+    assert_includes publisher, "scripts/verify-release"
+    assert_includes publisher, "--remote"
+    assert_includes workflow, "SHA256:RFzBCUItH9LZS0cKB5UE6ceAYhBD5C8GeOBip8Z11+4"
