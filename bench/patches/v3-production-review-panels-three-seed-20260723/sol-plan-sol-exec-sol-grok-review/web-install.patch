@@ -0,0 +1,41 @@
+require "test_helper"
+require "timeout"
+require "hive/bounded_process"
+
+class BoundedProcessTest < Minitest::Test
+  def test_capture3_kills_a_hung_process_group
+    started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+
+    assert_raises(Timeout::Error) do
+      Hive::BoundedProcess.capture3(
+        RbConfig.ruby,
+        "-e",
+        "trap('TERM') {}; sleep 60",
+        timeout: 0.1
+      )
+    end
+
+    elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
+    assert_operator elapsed, :<, 2
+  end
+
+  def test_run_kills_a_hung_process_group
+    started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+
+    assert_raises(Timeout::Error) do
+      Hive::BoundedProcess.run(
+        {},
+        RbConfig.ruby,
+        "-e",
+        "trap('TERM') {}; sleep 60",
+        chdir: Dir.pwd,
+        timeout: 0.1,
+        out: File::NULL,
+        err: File::NULL
+      )
+    end
+
+    elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
+    assert_operator elapsed, :<, 2
+  end
+end
