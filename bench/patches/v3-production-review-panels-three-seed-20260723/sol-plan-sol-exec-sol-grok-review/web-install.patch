+require "test_helper"
+require "hive/web/host_authorization"
+
+class WebHostAuthorizationTest < Minitest::Test
+  def test_allows_complete_loopback_range_and_configured_hosts
+    hosts = Hive::Web::HostAuthorization.allowed_hosts(
+      bind: "0.0.0.0",
+      origin: "https://hive.internal.example:4567"
+    )
+
+    assert_includes hosts, "localhost"
+    assert hosts.any? { |host| host.is_a?(IPAddr) && host.include?("127.0.0.2") }
+    assert hosts.any? { |host| host.is_a?(IPAddr) && host.include?("::1") }
+    assert hosts.any? { |host| host.is_a?(IPAddr) && host.include?("192.0.2.10") }
+    assert_includes hosts, "hive.internal.example"
+    refute_includes hosts, "attacker.example"
+  end
