+  def write_status_hive(root, fixture, include_identity: false)
+    status_path = File.join(root, "status.json")
+    calls_path = File.join(root, "status-calls.log")
+    File.write(status_path, JSON.generate(status_payload(fixture)))
+    identity = include_identity ? JSON.generate(Hive::InvokedBinary.loaded_identity) : "{}"
+    hive = write_executable(File.join(root, "bin", "hive"), <<~SH)
+      #!/bin/sh
+      if [ "$1" = "status" ]; then
+        printf 'status\\n' >> #{Shellwords.escape(calls_path)}
+        exec cat #{Shellwords.escape(status_path)}
+      fi
+      if [ "$1" = "--install-fingerprint" ]; then
+        printf '%s\\n' '#{identity}'
+        exit 0
+      fi
+      exit 2
+    SH
+    [ hive, calls_path ]
+  end
