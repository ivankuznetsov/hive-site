+  def test_unresolved_binary_and_cheap_fingerprint_error_have_stable_fallbacks
+    with_tmp_dir do |project|
+      probe = build_probe(project, runner: ->(**args) {
+        probe_result(args[:name], healthy: true)
+      })
+      assert_equal "definitely-missing",
+                   probe.send(:resolve_binary, "definitely-missing")
+      probe.define_singleton_method(:cheap_fingerprint) do |reason:|
+        raise TypeError, reason
+      end
+      fallback = probe.send(:safe_cheap_fingerprint, reason: "implementer_failed")
+      assert_match(/\A[0-9a-f]{64}\z/, fallback)
+    end
