+
+class DaemonAutoRetryIntegrationTest < Minitest::Test
+  include HiveTestHelper
+
+  HealthyDoctor = Struct.new(:unused) do
+    def required_checks
+      { healthy: true, rows: [] }
+    end
+  end
+
+  class RecordingSupervisor
+    attr_reader :spawned
+
+    def initialize
+      @spawned = []
+      @next_pid = 100
+    end
+
+    def spawn(**attrs)
+      pid = @next_pid
+      @next_pid += 1
+      @spawned << attrs.merge(pid: pid)
+      pid
+    end
+
+    def reap_all(now: Time.now)
+      []
