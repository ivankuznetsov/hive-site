+  # ── happy paths ────────────────────────────────────────────────────────
+
+  def test_codex_auth_failure_clears_and_emits_auto_retry
+    with_marker_file(reason: "implementer_failed", message: "401 Missing bearer/basic auth") do |state_file, dir|
+      row = make_row(state_file, reason: "implementer_failed", message: "401 Missing bearer/basic auth")
