+
+  def test_codex_auth_unhealthy_when_login_reports_not_logged_in
+    runner = FakeRunner.new
+    runner.on([ "codex", "login", "status" ], ok_result(stdout: "not logged in"))
+    with_replaced_singleton_method(Hive::AgentProfiles, :logged_in?, ->(_name, home: Dir.home) { true }) do
+      result = make_probe(runner: runner).probe_codex_auth(env: {})
+      refute result.healthy?
+      assert_match(/not logged in/, result.detail)
