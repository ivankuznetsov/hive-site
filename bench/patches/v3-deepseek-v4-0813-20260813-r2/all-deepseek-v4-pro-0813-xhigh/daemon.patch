+
+  def test_stage_skill_failure_rescues_lookup_error
+    with_replaced_singleton_method(Hive::AgentProfiles, :lookup, ->(*_args, **_kwargs) { raise Hive::ConfigError, "nope" }) do
+      failure = make_probe.send(:stage_skill_failure, "3-plan")
