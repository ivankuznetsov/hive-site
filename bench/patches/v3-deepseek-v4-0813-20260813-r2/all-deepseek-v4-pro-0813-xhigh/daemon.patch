+  def test_codex_auth_unhealthy_without_credential
+    with_replaced_singleton_method(Hive::AgentProfiles, :logged_in?, ->(_name, home: Dir.home) { false }) do
+      result = make_probe.probe_codex_auth(env: {})
+      refute result.healthy?
+      assert_match(/auth.json/, result.detail)
+    end
