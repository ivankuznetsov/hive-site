+# frozen_string_literal: true
+
+require_relative "../test_helper"
+require "hive/install"
+
+# Install-channel bookkeeping + command-name resolution (plan: U3).
+class InstallTest < Minitest::Test
+  ENV_VARS = %w[HIVE_HOME XDG_CONFIG_HOME HOME HIVE_BIN_DIR HIVE_COMMAND_NAME].freeze
+
+  def with_clean_env
+    saved = {}
+    ENV_VARS.each { |v| saved[v] = ENV[v] }
+    ENV_VARS.each { |v| ENV.delete(v) }
+    yield
+  ensure
+    saved.each { |v, val| val.nil? ? ENV.delete(v) : ENV[v] = val }
+  end
+
+  def test_install_channel_round_trips
+    Dir.mktmpdir("hive-install") do |dir|
+      with_clean_env do
+        ENV["HIVE_HOME"] = dir
+        assert_nil Hive::Install.install_channel
+        Hive::Install.record_install_channel!("brew")
+        assert_equal "brew", Hive::Install.install_channel
+        Hive::Install.clear_install_channel!
+        assert_nil Hive::Install.install_channel
+      end
+    end
+  end
+
+  def test_bin_dir_defaults_to_local_bin
+    Dir.mktmpdir("hive-home") do |home|
+      with_clean_env do
+        ENV["HOME"] = home
+        assert_equal File.join(home, ".local/bin"), Hive::Install.bin_dir
+      end
+    end
+  end
+
+  def test_bin_dir_honours_override
+    with_clean_env do
+      ENV["HIVE_BIN_DIR"] = "/opt/custom/bin"
+      assert_equal "/opt/custom/bin", Hive::Install.bin_dir
+    end
+  end
+
+  def test_command_name_defaults_to_hive
+    with_clean_env do
+      assert_equal "hive", Hive::Install.command_name
+      refute Hive::Install.hv_fallback?
+    end
+  end
+
+  def test_command_name_honours_hv_fallback
+    with_clean_env do
+      ENV["HIVE_COMMAND_NAME"] = "hv"
+      assert_equal "hv", Hive::Install.command_name
+      assert Hive::Install.hv_fallback?
+    end
+  end
+
+  def test_command_name_reads_recorded_value
+    Dir.mktmpdir("hive-install") do |dir|
+      with_clean_env do
+        ENV["HIVE_HOME"] = dir
+        Hive::Install.record_command_name!("hv")
+        assert_equal "hv", Hive::Install.command_name
+        assert Hive::Install.hv_fallback?
+        assert_equal File.join(dir, "command-name"), Hive::Install.command_name_path
+
+        Hive::Install.clear_command_name!
+        assert_equal "hive", Hive::Install.command_name
+      end
+    end
+  end
+end
