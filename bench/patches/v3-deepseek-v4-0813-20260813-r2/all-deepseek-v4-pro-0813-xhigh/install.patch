new file mode 100644
index 000000000..42fae6986
--- /dev/null
+++ b/packaging/tebako.yml
@@ -0,0 +1,32 @@
+# Tebako packaging config (plan: install/packaging U1).
+#
+# Tebako packs CRuby + the hive gem tree + all dependencies into a single
+# self-contained executable so tier-1 installs need no system Ruby. The TUI
+# backend (bubbletea 0.1.4 + lipgloss) is FFI to the Charm Go library — the
+# one piece Tebako does not trivially bundle. `packaging/build.sh` verifies
+# whether those shared libraries were captured and escalates to Risks R1 with
+# the documented fallback if not.
+#
+# Reference: https://github.com/tamatebako/tebako
+package:
+  name: hive
+  version_file: lib/hive.rb        # Hive::VERSION is the single source of truth
+
+ruby:
+  version: "3.4.0"
+
+# Gemfile deps are packaged from the lockfile; nothing native beyond the
+# Charm FFI bindings is expected.
+dependencies:
+  bundler: true
+  use_lockfile: true
+
+entrypoint:
+  - bin/hive
+
+# The TUI's Charm shared libraries. Listed explicitly so build.sh can assert
+# they landed in the image; if Tebako cannot capture them, the runtime-free
+# contract breaks for the TUI path and build.sh surfaces the R1 fallback.
+native_libraries:
+  - bubbletea
+  - lipgloss
