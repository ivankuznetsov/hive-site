diff --git a/install.sh b/install.sh
new file mode 100644
index 000000000..53d807874
--- /dev/null
+++ b/install.sh
@@ -0,0 +1,217 @@
+#!/bin/sh
+# hive install.sh — bash one-liner installer (plan: install/packaging U8).
+#
+#   curl -fsSL https://github.com/ivankuznetsov/hive/releases/latest/download/install.sh | bash
+#
+# Detects OS/arch, selects the right self-contained U1 binary, verifies its
+# SHA256 checksum against the published SHA256SUMS (fail-closed), and drops it
+# under XDG paths. No sudo, no curl-to-root. Records the `bash` install channel
+# and prints the runtime-dependency report (U5) + a `hive init` hint.
+#
+# Environment overrides:
+#   HIVE_BIN_DIR        where to install the binary (default ~/.local/bin)
+#   HIVE_VERSION        pin a specific release (default: latest)
+#   HIVE_INSTALL_BASE   base URL for artifacts (default: GitHub Releases)
+
+set -eu
+
+# --- defaults & overrides ---------------------------------------------------
+DEFAULT_BASE="https://github.com/ivankuznetsov/hive/releases"
+BASE_URL="${HIVE_INSTALL_BASE:-${DEFAULT_BASE}}"
+VERSION="${HIVE_VERSION:-latest}"
+BIN_DIR="${HIVE_BIN_DIR:-}"
+
+# --- OS / arch detection → tier-1 artifact ----------------------------------
+os="$(uname -s)"
+arch="$(uname -m)"
+
+case "${os}" in
+  Darwin) os_id="macos" ;;
+  Linux)  os_id="linux" ;;
+  *)
+    echo "hive: unsupported OS '${os}' (tier-1: macOS arm64 / Linux x86_64 glibc)" >&2
+    exit 1
+    ;;
+esac
+
+# --- distro detection (for per-OS dependency hints) -------------------------
+# `os_id` stays macos/linux for artifact selection; `distro_id` refines the
+# Linux side to ubuntu/arch so the dependency report's install hints match
+# Hive::Dependencies' per-OS contract instead of hardcoding brew for everyone.
+distro_id="${os_id}"
+if [ "${os_id}" = "linux" ]; then
+  if [ -f /etc/os-release ]; then
+    id_value="$(sed -n 's/^ID=//p' /etc/os-release | head -n 1 | tr -d '"')"
+    case "${id_value}" in
+      arch|manjaro|endeavouros) distro_id="arch" ;;
+      ubuntu|debian|linuxmint|pop) distro_id="ubuntu" ;;
+    esac
+  fi
+fi
+
+case "${os_id}/${arch}" in
+  macos/arm64)         target="hive-macos-arm64" ;;
+  linux/x86_64)        target="hive-linux-x86_64-glibc" ;;
+  *)
+    echo "hive: unsupported arch '${os_id}/${arch}' (tier-1: macOS arm64 / Linux x86_64)" >&2
+    exit 1
+    ;;
+esac
+
+# --- install location -------------------------------------------------------
+if [ -z "${BIN_DIR}" ]; then
+  if [ -d "${HOME}/.local/bin" ]; then
+    BIN_DIR="${HOME}/.local/bin"
+  else
+    BIN_DIR="${HOME}/.local/bin"
+    mkdir -p "${BIN_DIR}"
+  fi
+fi
+mkdir -p "${BIN_DIR}"
+
+# --- conflict detection: hive vs hv -----------------------------------------
+# If a foreign `hive` already owns the name on PATH (and it is not the binary
+# we are about to install), install ours as `hv` and record the fallback.
+cmd_name="hive"
+if command -v hive >/dev/null 2>&1; then
+  existing="$(command -v hive)"
+  if [ "${existing}" != "${BIN_DIR}/hive" ]; then
+    echo "hive: a different 'hive' is already on PATH (${existing}); installing as 'hv'" >&2
+    cmd_name="hv"
+  fi
+fi
+dest="${BIN_DIR}/${cmd_name}"
+
+# --- runtime-dependency report (U5) -----------------------------------------
+report_dependencies() {
+  echo ""
+  echo "hive: checking required runtime tools (report only — nothing is auto-installed):"
+  for tool in git bash claude gh jq; do
+    if command -v "${tool}" >/dev/null 2>&1; then
+      echo "  ✓ ${tool} found"
+    else
+      hint=""
+      case "${tool}" in
+        git)
+          case "${distro_id}" in
+            macos)  hint="brew install git" ;;
+            ubuntu) hint="sudo apt install git" ;;
+            arch)   hint="sudo pacman -S git" ;;
+            *)      hint="install git (see https://git-scm.com/downloads)" ;;
+          esac ;;
+        bash)
+          case "${distro_id}" in
+            macos)  hint="brew install bash" ;;
+            ubuntu) hint="sudo apt install bash" ;;
+            arch)   hint="sudo pacman -S bash" ;;
+            *)      hint="install bash" ;;
+          esac ;;
+        claude)
+          case "${distro_id}" in
+            macos) hint="brew install claude-code  (or: npm install -g @anthropic-ai/claude-code)" ;;
+            *)     hint="npm install -g @anthropic-ai/claude-code" ;;
+          esac ;;
+        gh)
+          case "${distro_id}" in
+            macos)  hint="brew install gh" ;;
+            ubuntu) hint="sudo apt install gh  (see https://cli.github.com for the apt repo)" ;;
+            arch)   hint="sudo pacman -S github-cli" ;;
+            *)      hint="install gh (see https://cli.github.com)" ;;
+          esac ;;
+        jq)
+          case "${distro_id}" in
+            macos)  hint="brew install jq" ;;
+            ubuntu) hint="sudo apt install jq" ;;
+            arch)   hint="sudo pacman -S jq" ;;
+            *)      hint="install jq (see https://jqlang.github.io/jq)" ;;
+          esac ;;
+      esac
+      echo "  ✗ ${tool} missing — ${hint}"
+    fi
+  done
+}
+
+# Dry-run: resolve the plan + report dependencies without downloading. Useful
+# for CI and for `hive update`'s re-run path to surface dependency status.
+if [ "${HIVE_INSTALL_DRY_RUN:-}" = "1" ]; then
+  echo "hive: dry-run — os=${os_id} arch=${arch} target=${target}"
+  echo "hive: would install ${cmd_name} to ${dest}"
+  report_dependencies
+  exit 0
+fi
+
+# --- download + checksum verify (fail-closed) ------------------------------
+tmpdir="$(mktemp -d)"
+trap 'rm -rf "${tmpdir}"' EXIT
+
+checksum_tool="sha256sum"
+if command -v sha256sum >/dev/null 2>&1; then
+  checksum_tool="sha256sum"
+elif command -v shasum >/dev/null 2>&1; then
+  checksum_tool="shasum -a 256"
+else
+  echo "hive: neither sha256sum nor shasum found; cannot verify integrity. Aborting." >&2
+  exit 1
+fi
+
+fetch() {
+  url="$1"; out="$2"
+  if command -v curl >/dev/null 2>&1; then
+    curl -fsSL "${url}" -o "${out}"
+  elif command -v wget >/dev/null 2>&1; then
+    wget -q -O "${out}" "${url}"
+  else
+    echo "hive: neither curl nor wget found; cannot download. Aborting." >&2
+    exit 1
+  fi
+}
+
+echo "hive: downloading ${target} (version ${VERSION})..."
+fetch "${BASE_URL}/${VERSION}/download/${target}.tar.gz" "${tmpdir}/${target}.tar.gz"
+fetch "${BASE_URL}/${VERSION}/download/SHA256SUMS" "${tmpdir}/SHA256SUMS"
+
+# Verify the tarball's checksum against the published list. Fail closed: a
+# mismatch (corrupted download or tampered artifact) aborts with non-zero.
+expected="$(awk -v f="${target}.tar.gz" '$2 == f { print $1 }' "${tmpdir}/SHA256SUMS")"
+if [ -z "${expected}" ]; then
+  echo "hive: ${target}.tar.gz not listed in SHA256SUMS; refusing to install" >&2
+  exit 1
+fi
+
+actual="$(cd "${tmpdir}" && ${checksum_tool} "${target}.tar.gz" | awk '{ print $1 }')"
+if [ "${actual}" != "${expected}" ]; then
+  echo "hive: checksum mismatch for ${target}.tar.gz" >&2
+  echo "  expected ${expected}" >&2
+  echo "  actual   ${actual}" >&2
+  echo "  refusing to install (see SECURITY.md for the release-signing key)" >&2
+  exit 1
+fi
+echo "hive: checksum verified (${actual})"
+
+# --- extract + install ------------------------------------------------------
+tar -xzf "${tmpdir}/${target}.tar.gz" -C "${tmpdir}"
+install -m 0755 "${tmpdir}/hive" "${dest}"
+echo "hive: installed ${dest}"
+
+# --- record the install channel + command name ------------------------------
+config_dir="${HIVE_HOME:-${XDG_CONFIG_HOME:-${HOME}/.config}/hive}"
+mkdir -p "${config_dir}"
+printf 'bash\n' > "${config_dir}/install-channel"
+# The conflict-fallback name (`hv` when a foreign `hive` owns the PATH slot) is
+# recorded so `hive uninstall` / `hive update` resolve the binary that was
+# actually installed rather than assuming `hive`.
+printf '%s\n' "${cmd_name}" > "${config_dir}/command-name"
+
+# --- PATH guidance ----------------------------------------------------------
+case ":${PATH}:" in
+  *":${BIN_DIR}:"*) ;;
+  *) echo "hive: note: ${BIN_DIR} is not on PATH; add it (e.g. export PATH=\"${BIN_DIR}:\$PATH\")" >&2 ;;
+esac
+
+
+report_dependencies
+
+echo ""
+echo "hive: installed. Verify with:"
+echo "  ${cmd_name} --version"
+echo "  ${cmd_name} init .   # inside a project to attach hive"
