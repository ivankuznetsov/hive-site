diff --git a/lib/hive/commands/uninstall.rb b/lib/hive/commands/uninstall.rb
new file mode 100644
index 000000000..985b84e38
--- /dev/null
+++ b/lib/hive/commands/uninstall.rb
@@ -0,0 +1,190 @@
+# frozen_string_literal: true
+
+require "fileutils"
+require "hive/config"
+require "hive/install"
+require "hive/service"
+
+module Hive
+  module Commands
+    # `hive uninstall` — remove hive cleanly (plan: install/packaging U3).
+    #
+    # Removes, in order: the daemon service registration, the installed
+    # binary (per install channel), the global config + install-channel
+    # record, and each registered project's `.hive-state/` directory.
+    #
+    # Safety contracts (R-UNINST):
+    #   * Completed work is preserved — `.hive-state/stages/8-done/` is left
+    #     in place when a project's state is removed.
+    #   * Interactive mode prompts before deleting anything and per-project
+    #     before touching each `.hive-state/`.
+    #   * `--purge` is the non-interactive CI path: no prompts, but it still
+    #     preserves completed pipeline outputs.
+    #
+    # The shell-out command runner is injectable for tests.
+    class Uninstall
+      def initialize(json: false, purge: false, runner: nil,
+                     channel: Hive::Install.install_channel,
+                     input: $stdin, output: $stdout)
+        @json = json
+        @purge = purge
+        @runner = runner
+        @channel = channel
+        @input = input
+        @output = output
+      end
+
+      def call
+        unless @purge
+          confirm_global
+        end
+
+        # Snapshot registered projects BEFORE removing the global config, or
+        # the registry read below would return [] and skip project cleanup.
+        projects = Hive::Config.registered_projects
+
+        removed_service = Hive::Service.remove!
+        remove_binary!
+        remove_global_config!
+
+        removed_projects = projects.each_with_object([]) do |project, acc|
+          acc << project["name"] if remove_project_state!(project)
+        end
+
+        report(removed_service: removed_service, removed_projects: removed_projects)
+      end
+
+      # Remove the installed binary per channel. For bash installs this deletes
+      # the binary we own under bin_dir (and its `hv`/`hive` sibling when the
+      # command was installed under the conflict-fallback name). For brew/aur
+      # the package manager owns the binary, so we shell out to its uninstaller.
+      def remove_binary!
+        case @channel
+        when "bash"
+          File.delete(Hive::Install.binary_path) if File.exist?(Hive::Install.binary_path)
+        when "brew"
+          run(%w[brew uninstall hive])
+        when "aur"
+          run(%w[yay -R hive-bin])
+        else
+          # Unknown/unrecorded channel — the binary isn't ours to manage.
+          @output.puts "hive: no install channel recorded; skipping binary removal" if @output
+        end
+      rescue Errno::ENOENT, Errno::EACCES
+        # binary already gone or not removable — nothing to do
+      end
+
+      def remove_global_config!
+        File.delete(Hive::Config.global_config_path) if File.exist?(Hive::Config.global_config_path)
+        Hive::Install.clear_install_channel!
+        Hive::Install.clear_command_name!
+
+        # Removing config.yml / install-channel / command-name can leave the
+        # XDG dirs empty; clean them up so uninstall doesn't strand empty
+        # shells. Only EMPTY dirs are removed — a live daemon's pid/log files
+        # (under state/) keep that tree populated and are left alone.
+        [ Hive::Paths.config_dir, Hive::Paths.state_dir, Hive::Paths.cache_dir ].each do |dir|
+          remove_dir_if_empty(dir)
+        end
+      end
+
+      def remove_dir_if_empty(dir)
+        return unless dir && File.directory?(dir)
+
+        Dir.rmdir(dir) if Dir.empty?(dir)
+      rescue SystemCallError
+        nil
+      end
+
+      # Remove one project's `.hive-state/` preserving completed work under
+      # `stages/8-done/`. Returns true when state was removed. Interactive mode
+      # prompts per project; `--purge` removes without prompting.
+      def remove_project_state!(project)
+        hive_state = project["hive_state_path"]
+        return false unless hive_state && File.directory?(hive_state)
+
+        unless @purge
+          return false unless confirm_project(project)
+        end
+
+        preserve_completed_work(hive_state)
+        true
+      end
+
+      # Delete everything under a project's .hive-state EXCEPT stages/8-done
+      # (completed, merged work is never destroyed by uninstall).
+      def preserve_completed_work(hive_state)
+        stages = File.join(hive_state, "stages")
+        done = File.join(stages, "8-done")
+
+        # Remove every top-level child of .hive-state except the `stages/`
+        # tree (which we handle selectively below).
+        Dir.children(hive_state).each do |child|
+          next if child == "stages"
+
+          FileUtils.rm_rf(File.join(hive_state, child))
+        end
+
+        return unless File.directory?(stages)
+
+        Dir.children(stages).each do |child|
+          next if child == "8-done"
+
+          FileUtils.rm_rf(File.join(stages, child))
+        end
+
+        # Leave 8-done in place even when empty — it is the completed-work marker.
+        _ = done
+      end
+
+      def confirm_global
+        return unless interactive?
+
+        @output.print "Uninstall hive (binary, daemon service, global config, and per-project .hive-state)? [y/N]: "
+        @output.flush
+        answer = @input.gets
+        return if answer && answer.strip =~ /\Ay(?:es)?\z/i
+
+        raise Hive::Error, "uninstall aborted"
+      end
+
+      def confirm_project(project)
+        return true unless interactive?
+
+        @output.print "Remove #{project['name']} .hive-state (preserves completed work)? [y/N]: "
+        @output.flush
+        answer = @input.gets
+        answer && answer.strip =~ /\Ay(?:es)?\z/i
+      end
+
+      def interactive?
+        @input.respond_to?(:tty?) && @input.tty?
+      end
+
+      def run(cmd)
+        if @runner
+          @runner.call(cmd)
+        else
+          system(*cmd)
+        end
+      end
+
+      def report(removed_service:, removed_projects:)
+        if @json
+          require "json"
+          puts JSON.generate(
+            "schema" => "hive-uninstall",
+            "schema_version" => 1,
+            "ok" => true,
+            "removed_service" => removed_service,
+            "removed_projects" => removed_projects,
+            "channel" => @channel
+          )
+        else
+          puts "hive: uninstalled#{removed_service ? ' (daemon service removed)' : ''}" \
+               "#{removed_projects.empty? ? '' : " (removed #{removed_projects.size} project state dir(s))"}"
+        end
+      end
+    end
+  end
+end
