diff --git a/test/integration/install_acceptance_test.rb b/test/integration/install_acceptance_test.rb
new file mode 100644
index 000000000..c63e805f3
--- /dev/null
+++ b/test/integration/install_acceptance_test.rb
@@ -0,0 +1,76 @@
+# frozen_string_literal: true
+
+require_relative "../test_helper"
+require "open3"
+
+# End-to-end acceptance for the install/uninstall lifecycle (plan: U11).
+# Exercises the real bin/hive entry point in subprocesses over an isolated
+# HOME/HIVE_HOME, so it validates the CLI surface (--version, hv alias, init,
+# uninstall --purge) without touching the developer's real home.
+#
+# Scenario D (clean uninstall preserves work) is fully container-runnable;
+# scenarios A (macOS brew) / B (Arch AUR) / C (prompt) are documented manual
+# checklists in docs/acceptance.md because they need macOS/Arch hardware.
+class InstallAcceptanceTest < Minitest::Test
+  include HiveTestHelper
+
+  ROOT = File.expand_path("../..", __dir__)
+
+  def run_hive(*args, env: {})
+    Open3.capture3(env, RbConfig.ruby, File.join(ROOT, "bin", "hive"), *args)
+  end
+
+  def isolated_env(root)
+    {
+      "HOME" => File.join(root, "home"),
+      "HIVE_HOME" => File.join(root, "config-home"),
+      "PATH" => ENV.fetch("PATH", "")
+    }
+  end
+
+  def test_hive_and_hv_report_version
+    with_tmp_dir do |root|
+      env = isolated_env(root)
+      FileUtils.mkdir_p(env["HOME"])
+
+      out, err, status = run_hive("--version", env: env)
+      assert status.success?, "hive --version failed: #{err}"
+      assert_match(/^\d+\.\d+\.\d+$/, out.strip)
+
+      out_hv, err_hv, status_hv = Open3.capture3(env, RbConfig.ruby, File.join(ROOT, "bin", "hv"), "--version")
+      assert status_hv.success?, "hv --version failed: #{err_hv}"
+      assert_equal out, out_hv, "hv must dispatch the same version as hive"
+    end
+  end
+
+  def test_scenario_d_uninstall_preserves_completed_work
+    with_tmp_dir do |root|
+      env = isolated_env(root)
+      FileUtils.mkdir_p(env["HOME"])
+
+      with_tmp_git_repo do |dir|
+        _out, err, status = run_hive("init", dir, env: env)
+        assert status.success?, "hive init failed: #{err}"
+
+        state = File.join(dir, ".hive-state")
+        assert File.directory?(state), "init must create .hive-state"
+        assert File.exist?(File.join(state, "config.yml")), "init must scaffold config.yml"
+
+        # Simulate completed + in-flight work.
+        done = File.join(state, "stages", "8-done", "merged-task")
+        inflight = File.join(state, "stages", "4-execute", "active-task")
+        FileUtils.mkdir_p(done)
+        FileUtils.mkdir_p(inflight)
+        File.write(File.join(done, "summary.md"), "merged")
+
+        _out, err, status = run_hive("uninstall", "--purge", env: env)
+        assert status.success?, "hive uninstall --purge failed: #{err}"
+
+        assert File.directory?(done), "completed work (8-done) must survive uninstall"
+        assert File.exist?(File.join(done, "summary.md")), "completed artifact must survive"
+        refute File.directory?(inflight), "in-flight work must be removed"
+        refute File.exist?(env["HIVE_HOME"] + "/config.yml"), "global config must be removed"
+      end
+    end
+  end
+end
