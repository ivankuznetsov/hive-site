+++ b/test/unit/commands/uninstall_test.rb
@@ -0,0 +1,134 @@
+# frozen_string_literal: true
+
+require_relative "../../test_helper"
+require "hive/commands/uninstall"
+
+# `hive uninstall` safety contracts (plan: U3): binary removal per channel,
+# completed-work preservation (8-done survives), non-interactive --purge,
+# and interactive confirmation.
+class UninstallCommandTest < Minitest::Test
+  ENV_VARS = %w[HIVE_HOME XDG_CONFIG_HOME XDG_STATE_HOME XDG_CACHE_HOME HOME HIVE_BIN_DIR].freeze
+
+  def with_clean_env
+    saved = {}
+    ENV_VARS.each { |v| saved[v] = ENV[v] }
+    ENV_VARS.each { |v| ENV.delete(v) }
+    yield
+  ensure
+    saved.each { |v, val| val.nil? ? ENV.delete(v) : ENV[v] = val }
+  end
+
+  def test_preserve_completed_work_keeps_8_done
+    Dir.mktmpdir("hive-uninstall") do |dir|
+      state = File.join(dir, ".hive-state")
+      inbox = File.join(state, "stages", "1-inbox", "task-a")
+      done = File.join(state, "stages", "8-done", "task-b")
+      config = File.join(state, "config.yml")
+      FileUtils.mkdir_p(inbox)
+      FileUtils.mkdir_p(done)
+      File.write(config, "x")
+      File.write(File.join(done, "summary.md"), "merged")
+
+      Hive::Commands::Uninstall.new(purge: true).preserve_completed_work(state)
+
+      refute File.directory?(File.join(state, "stages", "1-inbox")), "non-done stages removed"
+      refute File.exist?(config), "config.yml removed"
+      assert File.directory?(done), "8-done preserved"
+      assert File.exist?(File.join(done, "summary.md")), "completed artifact preserved"
+    end
+  end
+
+  def test_remove_binary_bash_channel_deletes_binary
+    Dir.mktmpdir("hive-uninstall") do |dir|
+      with_clean_env do
+        ENV["HIVE_BIN_DIR"] = dir
+        bin = File.join(dir, "hive")
+        File.write(bin, "#!/bin/sh\n")
+        assert File.exist?(bin)
+
+        Hive::Commands::Uninstall.new(purge: true, channel: "bash").remove_binary!
+        refute File.exist?(bin), "bash-installed binary removed"
+      end
+    end
+  end
+
+  def test_call_purge_removes_config_and_project_state_preserving_done
+    Dir.mktmpdir("hive-uninstall") do |root|
+      with_clean_env do
+        ENV["HIVE_HOME"] = File.join(root, "config-home")
+        ENV["HOME"] = File.join(root, "home")
+
+        # A registered project with in-flight and completed work.
+        project = File.join(root, "project")
+        state = File.join(project, ".hive-state")
+        FileUtils.mkdir_p(File.join(state, "stages", "4-execute", "task"))
+        FileUtils.mkdir_p(File.join(state, "stages", "8-done", "merged"))
+        Hive::Config.register_project(name: "proj", path: project)
+
+        Hive::Install.record_install_channel!("bash")
+
+        Hive::Commands::Uninstall.new(purge: true, channel: "bash").call
+
+        refute File.exist?(Hive::Config.global_config_path), "global config removed"
+        assert File.directory?(File.join(state, "stages", "8-done", "merged")), "completed work preserved"
+        refute File.directory?(File.join(state, "stages", "4-execute")), "in-flight work removed"
+      end
+    end
+  end
+
+  def test_interactive_abort_raises_and_leaves_state
+    Dir.mktmpdir("hive-uninstall") do |dir|
+      with_clean_env do
+        ENV["HIVE_HOME"] = File.join(dir, "config-home")
+        ENV["HOME"] = File.join(dir, "home")
+        FileUtils.mkdir_p(ENV["HIVE_HOME"])
+        File.write(Hive::Config.global_config_path, "registered_projects: []\n")
+
+        input = StringIO.new("n\n")
+        input.define_singleton_method(:tty?) { true }
+        output = StringIO.new
+
+        assert_raises(Hive::Error) do
+          Hive::Commands::Uninstall.new(channel: "brew", input: input, output: output).call
+        end
+        assert File.exist?(Hive::Config.global_config_path), "abort must not delete config"
+      end
+    end
+  end
+
+  def test_remove_global_config_removes_empty_xdg_dirs
+    Dir.mktmpdir("hive-uninstall") do |root|
+      with_clean_env do
+        ENV["XDG_CONFIG_HOME"] = File.join(root, "config")
+        ENV["XDG_STATE_HOME"]  = File.join(root, "state")
+        ENV["XDG_CACHE_HOME"]  = File.join(root, "cache")
+        ENV["HOME"] = File.join(root, "home")
+
+        FileUtils.mkdir_p(Hive::Paths.config_dir)
+        File.write(Hive::Config.global_config_path, "registered_projects: []\n")
+        FileUtils.mkdir_p(Hive::Paths.state_dir)
+        FileUtils.mkdir_p(Hive::Paths.cache_dir)
+
+        Hive::Commands::Uninstall.new(purge: true, channel: "brew").remove_global_config!
+
+        refute File.exist?(Hive::Paths.config_dir), "empty config dir must be removed"
+        refute File.exist?(Hive::Paths.state_dir), "empty state dir must be removed"
+        refute File.exist?(Hive::Paths.cache_dir), "empty cache dir must be removed"
+      end
+    end
+  end
+
+  def test_brew_channel_shells_out_to_brew_uninstall
+    captured = nil
+    runner = ->(cmd) { captured = cmd }
+    Hive::Commands::Uninstall.new(purge: true, channel: "brew", runner: runner).remove_binary!
+    assert_equal %w[brew uninstall hive], captured
+  end
+
+  def test_aur_channel_shells_out_to_yay_remove
+    captured = nil
+    runner = ->(cmd) { captured = cmd }
+    Hive::Commands::Uninstall.new(purge: true, channel: "aur", runner: runner).remove_binary!
+    assert_equal %w[yay -R hive-bin], captured
+  end
+end
