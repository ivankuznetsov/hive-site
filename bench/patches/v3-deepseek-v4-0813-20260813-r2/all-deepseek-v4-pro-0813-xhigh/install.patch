diff --git a/lib/hive/dependencies.rb b/lib/hive/dependencies.rb
new file mode 100644
index 000000000..ee6a8c850
--- /dev/null
+++ b/lib/hive/dependencies.rb
@@ -0,0 +1,171 @@
+# frozen_string_literal: true
+
+require "open3"
+require "timeout"
+
+require "hive"
+
+module Hive
+  # Runtime dependency detection (plan: install/packaging U5).
+  #
+  # Enumerates the external tools the hive CLI relies on (`git`, `bash`,
+  # `claude`, `gh`, `jq`) with minimum versions and per-OS install hints, so
+  # `hive doctor` can report a missing tool with an actionable command instead
+  # of failing a stage mid-run. No silent auto-install: this module only
+  # reports; the operator (or installer) decides whether to install.
+  #
+  # `claude`'s minimum version is Hive::MIN_CLAUDE_VERSION (2.1.118), the same
+  # gate AgentProfile#check_version! enforces at spawn time. The rest are
+  # presence + a conservative floor chosen so version-flag parsing is uniform.
+  module Dependencies
+    VERSION_CHECK_TIMEOUT_SEC = 5
+
+    TOOLS = [
+      {
+        "name" => "git",
+        "min_version" => "2.40.0",
+        "flag" => "--version",
+        "hints" => {
+          "macos" => "brew install git",
+          "ubuntu" => "sudo apt install git",
+          "arch" => "sudo pacman -S git",
+          "default" => "install git (see https://git-scm.com/downloads)"
+        }
+      },
+      {
+        "name" => "bash",
+        "min_version" => "3.2.0",
+        "flag" => "--version",
+        "hints" => {
+          "macos" => "brew install bash",
+          "ubuntu" => "sudo apt install bash",
+          "arch" => "sudo pacman -S bash",
+          "default" => "install bash"
+        }
+      },
+      {
+        "name" => "claude",
+        "min_version" => Hive::MIN_CLAUDE_VERSION,
+        "flag" => "--version",
+        "hints" => {
+          "macos" => "brew install claude-code  (or: npm install -g @anthropic-ai/claude-code)",
+          "ubuntu" => "npm install -g @anthropic-ai/claude-code",
+          "arch" => "npm install -g @anthropic-ai/claude-code",
+          "default" => "npm install -g @anthropic-ai/claude-code"
+        }
+      },
+      {
+        "name" => "gh",
+        "min_version" => "2.0.0",
+        "flag" => "--version",
+        "hints" => {
+          "macos" => "brew install gh",
+          "ubuntu" => "sudo apt install gh  (see https://cli.github.com for the apt repo)",
+          "arch" => "sudo pacman -S github-cli",
+          "default" => "install gh (see https://cli.github.com)"
+        }
+      },
+      {
+        "name" => "jq",
+        "min_version" => "1.6",
+        "flag" => "--version",
+        "hints" => {
+          "macos" => "brew install jq",
+          "ubuntu" => "sudo apt install jq",
+          "arch" => "sudo pacman -S jq",
+          "default" => "install jq (see https://jqlang.github.io/jq)"
+        }
+      }
+    ].freeze
+
+    module_function
+
+    # Rows for every required tool, shaped to drop into `hive doctor`'s table
+    # (`kind`, `label`, `agent`, `skill`, `status`, `message`, plus a `hint`
+    # carry field for the actionable install command).
+    def check
+      TOOLS.map { |tool| check_one(tool) }
+    end
+
+    def check_one(tool)
+      version = detect_version(tool["name"], tool["flag"])
+      label = "dependency/#{tool['name']}"
+      required = ">= #{tool['min_version']}"
+
+      if version.nil?
+        row(tool, label, "missing", nil, "not found on PATH", hint(tool))
+      elsif below_min?(version, tool["min_version"])
+        row(tool, label, "version_too_old", version, "found #{version}, needs #{required}", hint(tool))
+      else
+        row(tool, label, "present", version, "#{version} (#{required})", nil)
+      end
+    end
+
+    def row(tool, label, status, version, message, hint)
+      {
+        kind: "dependency",
+        label: label,
+        agent: tool["name"],
+        configured_skill: ">= #{tool['min_version']}",
+        skill: tool["name"],
+        status: status,
+        version: version,
+        message: message,
+        hint: hint
+      }
+    end
+
+    def hint(tool)
+      os = current_os
+      tool["hints"][os] || tool["hints"]["default"]
+    end
+
+    def current_os
+      host = RbConfig::CONFIG["host_os"]
+      return "macos" if host =~ /darwin/i
+      return "arch" if arch_linux?
+
+      "ubuntu"
+    end
+
+    # `host_os` is `linux`/`linux-gnu` on Arch (never `arch`), so the old
+    # `/arch/i` probe could never match. Detect Arch the way the distro
+    # actually identifies itself: `/etc/os-release` ID=arch (or a `pacman`
+    # binary on PATH for minimal/container images that strip os-release).
+    def arch_linux?
+      return true if File.exist?("/etc/os-release") &&
+                     File.read("/etc/os-release") =~ /^ID=["']?arch["']?\s*$/i
+
+      ENV["PATH"].to_s.split(File::PATH_SEPARATOR).any? do |dir|
+        File.executable?(File.join(dir, "pacman"))
+      end
+    end
+
+    # Run `<tool> --version` and parse the first x[.y[.z]] token. Returns nil
+    # when the binary is missing or its version cannot be parsed. Bounded by
+    # VERSION_CHECK_TIMEOUT_SEC so a wrapper binary that prompts/hangs cannot
+    # wedge `hive doctor`.
+    #
+    # Accepts 1–3 numeric components (not exactly three): `jq --version` on
+    # Ubuntu 22.04 prints `jq-1.6` — requiring `\d+\.\d+\.\d+` reported that
+    # tier-1 default as missing.
+    def detect_version(name, flag)
+      out, _err, status = Timeout.timeout(VERSION_CHECK_TIMEOUT_SEC) do
+        Open3.capture3(name, flag)
+      end
+      return nil unless status.success?
+
+      out[/\d+(?:\.\d+){0,2}/]
+    rescue Errno::ENOENT, Errno::EACCES, Timeout::Error
+      nil
+    end
+
+    def version_tuple(str)
+      str.split(".").map(&:to_i)
+    end
+
+    def below_min?(version, min_version)
+      (version_tuple(version) <=> version_tuple(min_version)).negative?
+    end
+  end
+end
diff --git a/lib/hive/install.rb b/lib/hive/install.rb
new file mode 100644
index 000000000..4413600ee
--- /dev/null
+++ b/lib/hive/install.rb
@@ -0,0 +1,108 @@
+# frozen_string_literal: true
+
+require "fileutils"
+require "hive/paths"
+
+module Hive
+  # Install-channel bookkeeping and command-name resolution (plan:
+  # install/packaging U3). At install time the installer records which
+  # distribution channel delivered the binary — `brew`, `aur`, or `bash`
+  # (the one-liner) — so `hive update` can shell out to the native updater
+  # and `hive uninstall` can clean up the right way.
+  module Install
+    CHANNELS = %w[brew aur bash].freeze
+
+    # Canonical install.sh location on GitHub Releases; the bash channel's
+    # updater re-runs it rather than swapping the binary in place.
+    INSTALL_SH_URL = "https://github.com/ivankuznetsov/hive/releases/latest/download/install.sh".freeze
+
+    module_function
+
+    def install_channel_path
+      File.join(Hive::Paths.config_dir, "install-channel")
+    end
+
+    # Where the installer records the command name (`hive` or the `hv`
+    # conflict-fallback) so `binary_path` resolves the binary that was
+    # actually installed, not the default.
+    def command_name_path
+      File.join(Hive::Paths.config_dir, "command-name")
+    end
+
+    # The recorded channel, or nil when unknown/unset (e.g. a dev clone).
+    def install_channel
+      path = install_channel_path
+      return nil unless File.exist?(path)
+
+      value = File.read(path).strip
+      value.empty? ? nil : value
+    rescue StandardError
+      nil
+    end
+
+    def record_install_channel!(channel)
+      FileUtils.mkdir_p(Hive::Paths.config_dir)
+      File.write(install_channel_path, "#{channel}\n")
+      channel
+    end
+
+    def clear_install_channel!
+      File.delete(install_channel_path) if File.exist?(install_channel_path)
+    rescue StandardError
+      nil
+    end
+
+    # The bin directory the installer drops the binary into. HIVE_BIN_DIR
+    # override wins (install.sh respects it too), else ~/.local/bin.
+    def bin_dir
+      override = ENV["HIVE_BIN_DIR"]
+      return override unless override.nil? || override.empty?
+
+      File.expand_path("~/.local/bin")
+    end
+
+    # The command name this install answers to: `hv` when a foreign `hive`
+    # owns the name (recorded by the installer), else `hive`. The explicit
+    # HIVE_COMMAND_NAME env override wins; otherwise the recorded value from
+    # the installer is authoritative, falling back to `hive`.
+    def command_name
+      name = ENV["HIVE_COMMAND_NAME"]
+      return name unless name.nil? || name.empty?
+
+      recorded = read_command_name
+      return recorded unless recorded.nil? || recorded.empty?
+
+      "hive"
+    end
+
+    def record_command_name!(name)
+      FileUtils.mkdir_p(Hive::Paths.config_dir)
+      File.write(command_name_path, "#{name}\n")
+      name
+    end
+
+    def read_command_name
+      path = command_name_path
+      return nil unless File.exist?(path)
+
+      value = File.read(path).strip
+      value.empty? ? nil : value
+    rescue StandardError
+      nil
+    end
+
+    def clear_command_name!
+      File.delete(command_name_path) if File.exist?(command_name_path)
+    rescue StandardError
+      nil
+    end
+
+    def hv_fallback?
+      command_name == "hv"
+    end
+
+    def binary_path
+      File.join(bin_dir, command_name)
+    end
+  end
+end
diff --git a/lib/hive/paths.rb b/lib/hive/paths.rb
new file mode 100644
index 000000000..8278e4dfb
--- /dev/null
+++ b/lib/hive/paths.rb
@@ -0,0 +1,71 @@
+# frozen_string_literal: true
+
+module Hive
+  # XDG on-disk layout resolver (plan: install/packaging U2).
+  #
+  # Hive's global home used to be `~/Dev/hive/`. v1 moves it onto XDG
+  # paths so a packaged binary can write without owning a source checkout:
+  #
+  #   config  ~/.config/hive        — global config.yml, install-channel
+  #   data    ~/.local/share/hive   — shared assets
+  #   state   ~/.local/state/hive   — pid files, logs (runtime state)
+  #   cache   ~/.cache/hive         — derived caches
+  #
+  # Every path is overridable two ways, in precedence order:
+  #
+  #   1. `HIVE_HOME` — the legacy base override. When set (non-empty), ALL
+  #      four dirs collapse to `HIVE_HOME`, preserving the pre-XDG
+  #      behaviour that pid files and config lived side-by-side. This keeps
+  #      existing scripts, tests, and CI that point HIVE_HOME at a temp
+  #      dir working unchanged.
+  #   2. `XDG_CONFIG_HOME` / `XDG_DATA_HOME` / `XDG_STATE_HOME` /
+  #      `XDG_CACHE_HOME` — per-dir XDG base overrides (only consulted when
+  #      HIVE_HOME is unset). Each defaults to the XDG Base Directory spec
+  #      fallback (`~/.config`, `~/.local/share`, `~/.local/state`,
+  #      `~/.cache`) with the `hive` subdir appended.
+  module Paths
+    module_function
+
+    # The legacy global-home override. Empty string / nil mean "unset" so
+    # an accidental `HIVE_HOME=` doesn't pin everything to the cwd.
+    def home_override
+      v = ENV["HIVE_HOME"]
+      v.nil? || v.empty? ? nil : v
+    end
+
+    def config_dir
+      home_override || xdg_dir("XDG_CONFIG_HOME", "~/.config")
+    end
+
+    def data_dir
+      home_override || xdg_dir("XDG_DATA_HOME", "~/.local/share")
+    end
+
+    def state_dir
+      home_override || xdg_dir("XDG_STATE_HOME", "~/.local/state")
+    end
+
+    def cache_dir
+      home_override || xdg_dir("XDG_CACHE_HOME", "~/.cache")
+    end
+
+    # Resolve one XDG base: honour the env var when non-empty, else the
+    # literal default, then append the `hive` component. The default is
+    # expanded (`~` -> $HOME) so the result is always an absolute path.
+    def xdg_dir(env_var, default)
+      base = ENV[env_var]
+      base = File.expand_path(default) if base.nil? || base.empty?
+      File.join(base, "hive")
+    end
+
+    # The legacy global home (`~/Dev/hive`) that pre-XDG installs wrote.
+    # Used only by the one-way migration shim in Hive::Config.
+    def legacy_home
+      File.expand_path("~/Dev/hive")
+    end
+
+    def legacy_config_path
+      File.join(legacy_home, "config.yml")
+    end
+  end
+end
diff --git a/lib/hive/service.rb b/lib/hive/service.rb
new file mode 100644
index 000000000..ad5de65b9
--- /dev/null
+++ b/lib/hive/service.rb
@@ -0,0 +1,312 @@
+# frozen_string_literal: true
+
+require "fileutils"
+require "rbconfig"
+require "hive/paths"
+
+module Hive
+  # OS-registered service for the hive daemon (plan: install/packaging U4).
+  #
+  # Registers the daemon as a first-class supervisor job — a launchd LaunchAgent
+  # on macOS, a `systemd --user` unit on Linux — instead of an on-demand
+  # subprocess with a pid file. The supervisor owns start/stop/restart; the
+  # foreground `hive daemon start` dispatcher loop remains as the job body the
+  # supervisor execs, and as the fallback when no service is registered.
+  #
+  # Lifecycle verbs and their side effects:
+  #
+  #   register!  write the unit file (idempotent; no enable/start)
+  #   enable!    launchctl load / systemctl --user enable (+ daemon-reload)
+  #   start!     launchctl start / systemctl --user start
+  #   stop!      launchctl stop / systemctl --user stop
+  #   remove!    stop + disable/unload + delete the unit file
+  #
+  # `Hive::Commands::Init` calls register! then prompts the operator whether to
+  # enable+start now (never silent autostart). `hive uninstall` calls remove!.
+  #
+  # The supervisor marks the job body with `HIVE_DAEMON_SERVICE=1` so a
+  # `hive daemon start` exec'd by launchd/systemd runs the dispatcher in the
+  # foreground instead of delegating back to the supervisor (which would loop).
+  module Service
+    module_function
+
+    # launchd label (reverse-DNS-ish, `local.*` namespace for per-user jobs).
+    LAUNCHD_LABEL = "local.hive-daemon"
+    # systemd user unit name (no `.service` suffix in `systemctl` calls).
+    SYSTEMD_UNIT = "hive-daemon"
+
+    # The `ProgramArguments`/`ExecStart` body always runs the dispatcher in the
+    # foreground with this marker so `Daemon#start_daemon` can tell it is being
+    # run by the supervisor.
+    SUPERVISED_ENV = "HIVE_DAEMON_SERVICE"
+
+    # True when this process is the daemon job body spawned by launchd/systemd.
+    def supervised?
+      ENV[SUPERVISED_ENV] == "1"
+    end
+
+    def macos?
+      RbConfig::CONFIG["host_os"] =~ /darwin/i
+    end
+
+    def linux?
+      RbConfig::CONFIG["host_os"] =~ /linux/i
+    end
+
+    def supported?
+      macos? || linux?
+    end
+
+    def launchd_plist_path
+      File.expand_path("~/Library/LaunchAgents/#{LAUNCHD_LABEL}.plist")
+    end
+
+    def systemd_unit_path
+      File.expand_path("~/.config/systemd/user/#{SYSTEMD_UNIT}.service")
+    end
+
+    # The absolute path to the hive binary the unit should invoke. Resolve order:
+    # explicit HIVE_SERVICE_BINARY override, else the running program's path
+    # (a vendored binary's $0), else a ~/.local/bin fallback. Callers (init,
+    # tests) normally inject the resolved path via register!.
+    def binary_path
+      override = ENV["HIVE_SERVICE_BINARY"]
+      return File.expand_path(override) if override && !override.empty?
+
+      prog = $PROGRAM_NAME.to_s
+      return File.expand_path(prog) unless prog.empty?
+
+      File.expand_path("~/.local/bin/hive")
+    end
+
+    # Where the daemon logs land (state dir, per the XDG layout in U2). Used to
+    # generate the unit's stdout/stderr capture paths.
+    def state_dir
+      Hive::Paths.state_dir
+    end
+
+    def registered?
+      return false unless supported?
+
+      File.exist?(unit_file_path)
+    end
+
+    def unit_file_path
+      macos? ? launchd_plist_path : systemd_unit_path
+    end
+
+    def service_name
+      macos? ? LAUNCHD_LABEL : SYSTEMD_UNIT
+    end
+
+    # Write the unit file. Idempotent; does NOT enable or start (the caller
+    # decides whether to enable+start, and must prompt before autostart).
+    # Returns the absolute path written. Raises Hive::Error on unsupported OS.
+    def register!(binary: nil)
+      ensure_supported!
+      path = unit_file_path
+      FileUtils.mkdir_p(File.dirname(path))
+      File.write(path, macos? ? render_plist(binary || binary_path) : render_unit(binary || binary_path))
+      path
+    end
+
+    def enable!
+      ensure_supported!
+      if macos?
+        run("launchctl", "load", launchd_plist_path)
+      else
+        run("systemctl", "--user", "daemon-reload")
+        run("systemctl", "--user", "enable", SYSTEMD_UNIT)
+      end
+    end
+
+    def start!
+      ensure_supported!
+      macos? ? run("launchctl", "start", LAUNCHD_LABEL) : run("systemctl", "--user", "start", SYSTEMD_UNIT)
+    end
+
+    def stop!
+      ensure_supported!
+      macos? ? run("launchctl", "stop", LAUNCHD_LABEL) : run("systemctl", "--user", "stop", SYSTEMD_UNIT)
+    end
+
+    # Stop + disable/unload + delete the generated unit. Idempotent: removing a
+    # service that was never registered is a no-op. Returns true when a unit
+    # file was present and removed, false when there was nothing to remove.
+    def remove!
+      return false unless supported?
+
+      path = unit_file_path
+      return false unless File.exist?(path)
+
+      if macos?
+        run("launchctl", "unload", path)
+      else
+        run("systemctl", "--user", "disable", SYSTEMD_UNIT)
+        run("systemctl", "--user", "daemon-reload")
+      end
+      File.delete(path)
+      true
+    end
+
+    # Whether the supervisor currently reports the service as active/running.
+    # Best-effort: a supervisor that isn't running (no user session bus) is
+    # reported as not-running rather than raising.
+    def running?
+      return false unless supported? && registered?
+
+      macos? ? launchd_running? : systemd_running?
+    end
+
+    # `launchctl list <label>` exits 0 whenever the job is merely LOADED — even
+    # when it is dead or never started — so its exit status cannot be the
+    # running signal. Parse the PID field instead: only a positive integer PID
+    # means the job is actually running.
+    def launchd_running?
+      out, _ok = run_capture("launchctl", "list", LAUNCHD_LABEL)
+      pid = launchd_pid(out)
+      pid && pid.positive?
+    end
+
+    def systemd_running?
+      run_capture("systemctl", "--user", "is-active", "--quiet", SYSTEMD_UNIT).last
+    end
+
+    # Extract the PID from `launchctl list <label>` output. Handles both the
+    # plist-style form (`"PID" = 123;`, where a loaded-but-not-running job
+    # reports `-1`) and the classic tab-separated table (`PID\tStatus\tLabel`,
+    # where the not-running PID column is `-`). Returns nil when no PID is
+    # present or the job is not loaded.
+    def launchd_pid(output)
+      output.to_s.each_line do |line|
+        if (m = line.match(/^\s*["']?PID["']?\s*=\s*(-?\d+)\s*;\s*$/i))
+          return m[1].to_i
+        end
+
+        cols = line.split
+        next if cols.empty?
+        next if cols.first.casecmp?("PID") # classic table header row
+        next unless cols.first.match?(/\A-?\d+\z/)
+
+        return cols.first.to_i
+      end
+      nil
+    end
+
+    # Structured status for the daemon command's service path.
+    # `active_state` is one of "active"/"inactive"/"unknown".
+    def status
+      return { registered: false, active_state: "inactive" } unless supported? && registered?
+
+      active = running? ? "active" : "inactive"
+      { registered: true, active_state: active }
+    end
+
+    # The command runner, injectable for tests. Default shells out for real.
+    class << self
+      attr_writer :runner
+
+      def runner
+        @runner ||= ->(*cmd) { system(*cmd) }
+      end
+    end
+
+    def run(*cmd)
+      runner.call(*cmd)
+    end
+
+    def run_capture(*cmd)
+      out = IO.popen(cmd.flatten, err: %i[child out], &:read)
+      [ out, $CHILD_STATUS&.success? == true ]
+    rescue Errno::ENOENT
+      [ "", false ]
+    end
+
+    def ensure_supported!
+      return if supported?
+
+      raise Hive::Error,
+            "hive daemon service is not supported on #{RbConfig::CONFIG['host_os']}; " \
+            "use `hive daemon start` for the foreground fallback"
+    end
+
+    def ensure_registered!
+      return if registered?
+
+      raise Hive::Error,
+            "hive daemon is not registered as a service; run `hive init` or " \
+            "`hive daemon enable` first"
+    end
+
+    def render_plist(binary)
+      out_log = File.join(File.expand_path("~/Library/Logs"), "#{LAUNCHD_LABEL}.out.log")
+      err_log = File.join(File.expand_path("~/Library/Logs"), "#{LAUNCHD_LABEL}.err.log")
+      <<~PLIST
+        <?xml version="1.0" encoding="UTF-8"?>
+        <!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
+          "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+        <plist version="1.0">
+        <dict>
+          <key>Label</key>
+          <string>#{LAUNCHD_LABEL}</string>
+
+          <key>ProgramArguments</key>
+          <array>
+            <string>/bin/sh</string>
+            <string>-c</string>
+            <string>[ -x "$0" ] || exit 0; exec "$0" "$@"</string>
+            <string>#{binary}</string>
+            <string>daemon</string>
+            <string>start</string>
+          </array>
+
+          <key>RunAtLoad</key>
+          <false/>
+
+          <key>KeepAlive</key>
+          <dict>
+            <key>SuccessfulExit</key>
+            <false/>
+          </dict>
+
+          <key>ThrottleInterval</key>
+          <integer>30</integer>
+
+          <key>StandardOutPath</key>
+          <string>#{out_log}</string>
+          <key>StandardErrorPath</key>
+          <string>#{err_log}</string>
+
+          <key>EnvironmentVariables</key>
+          <dict>
+            <key>#{SUPERVISED_ENV}</key>
+            <string>1</string>
+          </dict>
+        </dict>
+        </plist>
+      PLIST
+    end
+
+    def render_unit(binary)
+      <<~UNIT
+        [Unit]
+        Description=Hive auto-advancing dispatcher (ADR-024)
+        After=default.target
+        StartLimitBurst=3
+        StartLimitIntervalSec=300
+
+        [Service]
+        Type=simple
+        Environment=#{SUPERVISED_ENV}=1
+        ExecStart=#{binary} daemon start
+        Restart=on-failure
+        RestartSec=30s
+        KillMode=mixed
+        TimeoutStopSec=900
+
+        [Install]
+        WantedBy=default.target
+      UNIT
+    end
+  end
+end
diff --git a/packaging/assemble.sh b/packaging/assemble.sh
new file mode 100755
index 000000000..d8fbe3bae
--- /dev/null
+++ b/packaging/assemble.sh
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+# Assemble tarballs + a SHA256SUMS file from the per-target build artifacts
+# downloaded by the release workflow (plan: install/packaging U1). Expects
+# each target's `hive` binary under dist/<target>/hive.
+set -euo pipefail
+
+DIST_ROOT="${1:-dist}"
+
+cd "${DIST_ROOT}"
+
+# Every tier-1 target → a tarball with the binary at the archive root.
+for target_dir in hive-*; do
+  [ -d "${target_dir}" ] || continue
+  bin_path="${target_dir}/hive"
+  [ -f "${bin_path}" ] || { echo "missing binary: ${bin_path}" >&2; exit 1; }
+
+  tar_name="${target_dir}.tar.gz"
+  # Archive the binary alone so the formula/PKGBUILD can extract predictably.
+  tar -czf "${tar_name}" -C "${target_dir}" hive
+  echo "packed ${tar_name}"
+done
+
+# SHA256SUMS over the tarballs (the canonical integrity anchor every channel
+# verifies against — install.sh fail-closes on mismatch).
+: > SHA256SUMS
+for tar in *.tar.gz; do
+  ( cd "$(dirname "${tar}")" && sha256sum "$(basename "${tar}")" ) >> SHA256SUMS
+done
+sort -o SHA256SUMS SHA256SUMS
+
+echo "--- SHA256SUMS ---"
+cat SHA256SUMS
