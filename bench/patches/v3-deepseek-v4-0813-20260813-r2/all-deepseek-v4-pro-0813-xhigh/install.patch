diff --git a/test/unit/commands/doctor_dependencies_test.rb b/test/unit/commands/doctor_dependencies_test.rb
new file mode 100644
index 000000000..aa52fcbdc
--- /dev/null
+++ b/test/unit/commands/doctor_dependencies_test.rb
@@ -0,0 +1,48 @@
+# frozen_string_literal: true
+
+require_relative "../../test_helper"
+require "hive/commands/doctor"
+
+# Wiring between `hive doctor` and Hive::Dependencies (plan: U5). The actual
+# probe logic is covered in test/unit/dependencies_test.rb; here we pin that
+# `hive doctor` includes dependency rows by default and omits them when
+# `dependencies: false` (the path `hive init`'s non-fatal preflight uses).
+class DoctorDependenciesTest < Minitest::Test
+  def stub_dependencies(rows)
+    singleton = Hive::Dependencies.singleton_class
+    singleton.send(:alias_method, :__deps_orig_check, :check)
+    singleton.send(:define_method, :check) { rows }
+    yield
+  ensure
+    singleton.send(:alias_method, :check, :__deps_orig_check)
+    singleton.send(:remove_method, :__deps_orig_check)
+  end
+
+  def base_config
+    { "brainstorm" => { "agent" => "claude" }, "plan" => { "agent" => "claude" } }
+  end
+
+  def test_doctor_includes_dependency_rows_by_default
+    row = { kind: "dependency", label: "dependency/jq", agent: "jq",
+            configured_skill: ">= 1.6", skill: "jq", status: "missing",
+            version: nil, message: "not found on PATH", hint: "brew install jq" }
+    stub_dependencies([ row ]) do
+      doctor = Hive::Commands::Doctor.new(config: base_config, project_root: nil, output: StringIO.new)
+      doctor.call
+      deps = doctor.rows.select { |r| r[:kind] == "dependency" }
+      assert_equal 1, deps.length
+      assert_equal "dependency/jq", deps.first[:label]
+    end
+  end
+
+  def test_doctor_omits_dependency_rows_when_disabled
+    row = { kind: "dependency", label: "dependency/jq", agent: "jq",
+            configured_skill: ">= 1.6", skill: "jq", status: "missing",
+            version: nil, message: "not found", hint: "brew install jq" }
+    stub_dependencies([ row ]) do
+      doctor = Hive::Commands::Doctor.new(config: base_config, project_root: nil, output: StringIO.new, dependencies: false)
+      doctor.call
+      assert_empty doctor.rows.select { |r| r[:kind] == "dependency" }
+    end
+  end
+end
