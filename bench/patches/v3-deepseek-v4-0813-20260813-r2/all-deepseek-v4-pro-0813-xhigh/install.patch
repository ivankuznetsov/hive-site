+# frozen_string_literal: true
+
+require_relative "../test_helper"
+require "open3"
+
+# install.sh (plan: U8) shell-logic smoke tests. No network: exercises the
+# dry-run path and syntax validity, plus the checksum fail-closed branch via a
+# minimal local mock of the download step.
+class InstallScriptTest < Minitest::Test
+  ROOT = File.expand_path("../..", __dir__)
+  INSTALL_SH = File.join(ROOT, "install.sh")
+
+  def test_script_is_posix_syntax_valid
+    out, err, status = Open3.capture3("sh", "-n", INSTALL_SH)
+    assert status.success?, "install.sh must pass sh -n: #{err}"
+    assert_equal "", out
+  end
+
+  def test_dry_run_resolves_target_and_reports_dependencies
+    Dir.mktmpdir("hive-install") do |home|
+      env = { "HOME" => home, "HIVE_INSTALL_DRY_RUN" => "1", "HIVE_BIN_DIR" => File.join(home, "bin") }
+      out, _err, status = Open3.capture3(env, "sh", INSTALL_SH)
+      assert status.success?
+      assert_includes out, "dry-run"
+      assert_includes out, "would install"
+      assert_includes out, "checking required runtime tools"
+    end
+  end
+
+  def test_dry_run_does_not_download_or_write_channel
+    Dir.mktmpdir("hive-install") do |home|
+      env = { "HOME" => home, "HIVE_INSTALL_DRY_RUN" => "1", "HIVE_BIN_DIR" => File.join(home, "bin") }
+      Open3.capture3(env, "sh", INSTALL_SH)
+      refute File.exist?(File.join(home, ".config", "hive", "install-channel")),
+             "dry-run must not record the install channel"
+      refute File.exist?(File.join(home, "bin", "hive")), "dry-run must not install a binary"
+    end
+  end
+end
