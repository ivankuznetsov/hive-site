+# frozen_string_literal: true
+
+require_relative "../../test_helper"
+require "hive/commands/update"
+
+# `hive update` channel → updater command assembly (plan: U3). No network —
+# the runner is injected and command arrays are asserted directly.
+class UpdateCommandTest < Minitest::Test
+  def test_update_command_for_brew
+    cmd = Hive::Commands::Update.new.update_command("brew")
+    assert_equal %w[brew upgrade hive], cmd
+  end
+
+  def test_update_command_for_aur
+    cmd = Hive::Commands::Update.new.update_command("aur")
+    assert_equal %w[yay -Syu hive-bin], cmd
+  end
+
+  def test_update_command_for_bash_reruns_installer
+    cmd = Hive::Commands::Update.new.update_command("bash")
+    assert_match(/curl -fsSL .*install\.sh \| bash/, cmd)
+  end
+
+  def test_call_unknown_channel_raises
+    err = assert_raises(Hive::Error) do
+      Hive::Commands::Update.new(channel: "nix").call
+    end
+    assert_match(/unknown install channel/, err.message)
+  end
+
+  def test_call_nil_channel_raises
+    err = assert_raises(Hive::Error) do
+      Hive::Commands::Update.new(channel: nil).call
+    end
+    assert_match(/install channel unknown/, err.message)
+  end
+
+  def test_call_invokes_runner_with_assembled_command
+    captured = nil
+    runner = ->(cmd) { captured = cmd }
+    Hive::Commands::Update.new(channel: "brew", runner: runner).call
+    assert_equal %w[brew upgrade hive], captured
+  end
+
+  def test_call_json_reports_channel
+    runner = ->(_cmd) { true }
+    out, = capture_io do
+      Hive::Commands::Update.new(channel: "aur", runner: runner, json: true).call
+    end
+    payload = JSON.parse(out)
+    assert_equal true, payload["ok"]
+    assert_equal "aur", payload["channel"]
+  end
+end
