--- /dev/null
+++ b/lib/hive/cli_entry.rb
@@ -0,0 +1,46 @@
+# frozen_string_literal: true
+
+require "hive"
+require "hive/cli"
+
+module Hive
+  # Shared entry point for the `hive` and `hv` executables (plan:
+  # install/packaging U3). `hv` is the conflict-safe command name used when a
+  # foreign `hive` binary (e.g. Apache Hive) already owns the name on PATH;
+  # both dispatchers funnel into the exact same Thor CLI here.
+  module CliEntry
+    module_function
+
+    def run!(argv)
+      if argv == [ "--version" ] || argv == [ "-v" ]
+        puts Hive::VERSION
+        exit 0
+      end
+
+      rewrite_help_flag!(argv)
+
+      Hive::CLI.start(argv)
+    rescue Hive::Error => e
+      warn "hive: #{e.message}"
+      exit(e.respond_to?(:exit_code) ? e.exit_code : 1)
+    end
+
+    # Thor only honours `--help` *before* the subcommand name (`hive help
+    # approve`); `hive approve --help` would be consumed as the TARGET
+    # positional. Intercept the help flag before Thor dispatch so the
+    # convention agents try first works.
+    def rewrite_help_flag!(argv)
+      return if argv.empty?
+
+      cmd_idx = argv.index { |a| !a.start_with?("-") }
+      return unless cmd_idx
+
+      help_idx = argv[(cmd_idx + 1)..]&.index { |a| a == "--help" || a == "-h" }
+      return unless help_idx
+
+      cmd = argv.delete_at(cmd_idx)
+      argv.delete_at(cmd_idx + help_idx)
+      argv.unshift("help", cmd)
+    end
+  end
+end
