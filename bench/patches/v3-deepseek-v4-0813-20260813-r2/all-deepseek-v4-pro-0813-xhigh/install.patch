@@ -0,0 +1,24 @@
+# Maintainer: hive maintainers <https://github.com/ivankuznetsov/hive>
+
+# hive-bin — prebuilt hive binary for Arch (plan: install/packaging U7).
+# Consumes the U1 vendored-Ruby binary from GitHub Releases; no build step,
+# no system Ruby. The package is ALWAYS named `hive-bin` regardless of any
+# binary conflict resolution. `hive-git` is deferred (see plan Scope).
+
+pkgname=hive-bin
+pkgver=0.1.0
+pkgrel=1
+pkgdesc="Folder-as-agent pipeline: eight-stage multi-agent control plane + TUI"
+arch=('x86_64')
+url="https://github.com/ivankuznetsov/hive"
+license=('MIT')
+depends=('glibc')
+source=("${pkgname}-${pkgver}.tar.gz::https://github.com/ivankuznetsov/hive/releases/download/v${pkgver}/hive-linux-x86_64-glibc.tar.gz")
+sha256sums=('REPLACE_WITH_SHA256_OF_hive-linux-x86_64-glibc.tar.gz')
+
+package() {
+  install -Dm755 "hive" "${pkgdir}/usr/bin/hive"
+  # Conflict-safe alias: a foreign `hive` (Apache Hive) owns the name on some
+  # systems; `hv` always dispatches the same hive CLI.
+  ln -s hive "${pkgdir}/usr/bin/hv"
+}
