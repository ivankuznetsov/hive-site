@@ -0,0 +1,49 @@
+# Hive (plan: install/packaging U6).
+#
+# Homebrew formula for a project-owned tap (`homebrew-hive`). Consumes the U1
+# vendored binary from GitHub Releases — no Ruby, no build step, no `depends_on`
+# Ruby-related anything. Tier-1 targets: macOS arm64 and Linux x86_64 glibc.
+#
+#   brew tap <org>/homebrew-hive
+#   brew install hive
+#   brew upgrade hive
+#   brew uninstall hive
+#
+# The sha256 pins are the U1 release checksums. Update `version`, each `url`,
+# and each `sha256` together when cutting a new release (see the U1 workflow's
+# SHA256SUMS).
+class Hive < Formula
+  desc "Folder-as-agent pipeline: eight-stage multi-agent control plane + TUI"
+  homepage "https://github.com/ivankuznetsov/hive"
+  license "MIT"
+  version "0.1.0"
+
+  on_macos do
+    on_arm do
+      url "https://github.com/ivankuznetsov/hive/releases/download/v0.1.0/hive-macos-arm64.tar.gz"
+      sha256 "REPLACE_WITH_SHA256_OF_hive-macos-arm64.tar.gz"
+    end
+  end
+
+  on_linux do
+    on_intel do
+      url "https://github.com/ivankuznetsov/hive/releases/download/v0.1.0/hive-linux-x86_64-glibc.tar.gz"
+      sha256 "REPLACE_WITH_SHA256_OF_hive-linux-x86_64-glibc.tar.gz"
+    end
+  end
+
+  # A foreign `hive` (e.g. Apache Hive) owns the name on many systems; hive's
+  # own conflict-safe alias lets both coexist. Installing this formula also
+  # provides `hv` so a pre-existing `hive` doesn't force a rename war.
+  conflicts_with "hive", because: "hive is also the Apache Hive CLI name; use `hv` from this tap"
+
+  def install
+    bin.install "hive"
+    bin.install_symlink "hive" => "hv"
+  end
+
+  test do
+    assert_match version.to_s, shell_output("#{bin}/hive --version").strip
+    assert_match version.to_s, shell_output("#{bin}/hv --version").strip
+  end
+end
diff --git a/packaging/pin-checksums.sh b/packaging/pin-checksums.sh
new file mode 100755
index 000000000..ca3c55052
--- /dev/null
+++ b/packaging/pin-checksums.sh
@@ -0,0 +1,60 @@
+#!/usr/bin/env bash
+# Pin the U1 release checksums into the packaging manifests (plan:
+# install/packaging U6/U7). Reads SHA256SUMS (produced by assemble.sh) and
+# replaces every `REPLACE_WITH_SHA256_OF_<file>` placeholder in
+# packaging/homebrew/hive.rb, packaging/aur/PKGBUILD, and
+# packaging/aur/.SRCINFO with the real digest. Fails closed when a placeholder
+# has no matching SHA256SUMS entry, so a release can never publish a manifest
+# that still carries a placeholder (which would break `brew install` /
+# `makepkg` / `brew audit`).
+#
+# Usage:
+#   ./packaging/pin-checksums.sh [path/to/SHA256SUMS]
+#
+# The release workflow runs this after assemble.sh; tap/AUR maintainers run it
+# locally to pin the manifests before pushing a new formula/PKGBUILD.
+set -euo pipefail
+
+SUMS_FILE="${1:-dist/SHA256SUMS}"
+REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+
+MANIFESTS=(
+  packaging/homebrew/hive.rb
+  packaging/aur/PKGBUILD
+  packaging/aur/.SRCINFO
+)
+
+if [ ! -f "${SUMS_FILE}" ]; then
+  echo "pin-checksums: ${SUMS_FILE} not found; run packaging/assemble.sh first" >&2
+  exit 1
+fi
+
+missing=0
+for manifest in "${MANIFESTS[@]}"; do
+  path="${REPO_ROOT}/${manifest}"
+  [ -f "${path}" ] || { echo "pin-checksums: missing manifest ${path}" >&2; exit 1; }
+
+  placeholders="$(grep -oE 'REPLACE_WITH_SHA256_OF_[A-Za-z0-9._-]+' "${path}" || true)"
+  [ -n "${placeholders}" ] || continue
+
+  while IFS= read -r placeholder; do
+    file="${placeholder#REPLACE_WITH_SHA256_OF_}"
+    sha="$(awk -v f="${file}" '$2 == f { print $1 }' "${SUMS_FILE}")"
+    if [ -z "${sha}" ]; then
+      echo "pin-checksums: no SHA256SUMS entry for ${file} " \
+           "(placeholder ${placeholder} in ${manifest})" >&2
+      missing=1
+      continue
+    fi
+    sed -i.bak "s|${placeholder}|${sha}|g" "${path}"
+    rm -f "${path}.bak"
+    echo "pin-checksums: pinned ${manifest}: ${file} = ${sha}"
+  done <<< "${placeholders}"
+done
+
+if [ "${missing}" -ne 0 ]; then
+  echo "pin-checksums: refusing to proceed with unresolved placeholders" >&2
+  exit 1
+fi
+
+echo "pin-checksums: all manifests pinned from ${SUMS_FILE}"
