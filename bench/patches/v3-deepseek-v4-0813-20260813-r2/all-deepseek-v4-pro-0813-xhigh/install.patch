new file mode 100644
index 000000000..a86ced8b5
--- /dev/null
+++ b/test/unit/dependencies_test.rb
@@ -0,0 +1,97 @@
+# frozen_string_literal: true
+
+require_relative "../test_helper"
+require "hive/dependencies"
+
+# Runtime dependency detection (plan: U5). Uses fake binaries on PATH so the
+# version probes are hermetic — no dependency on the host's real tools.
+class DependenciesTest < Minitest::Test
+  include HiveTestHelper
+
+  def with_fake_bin_dir
+    with_tmp_dir do |dir|
+      old_path = ENV["PATH"]
+      ENV["PATH"] = "#{dir}:#{old_path}"
+      yield dir
+    ensure
+      ENV["PATH"] = old_path
+    end
+  end
+
+  def write_bin(dir, name, output, exit_status: 0)
+    path = File.join(dir, name)
+    File.write(path, <<~SH)
+      #!/usr/bin/env bash
+      echo "#{output}"
+      exit #{exit_status}
+    SH
+    File.chmod(0o755, path)
+    path
+  end
+
+  def test_check_returns_all_five_required_tools
+    rows = Hive::Dependencies.check
+    names = rows.map { |r| r[:agent] }.sort
+    assert_equal %w[bash claude gh git jq], names
+  end
+
+  def test_present_tool_reports_present_with_version
+    with_fake_bin_dir do |dir|
+      write_bin(dir, "jq", "jq-1.7.1")
+      row = Hive::Dependencies.check_one(Hive::Dependencies::TOOLS.find { |t| t["name"] == "jq" })
+      assert_equal "present", row[:status]
+      assert_equal "1.7.1", row[:version]
+    end
+  end
+
+  def test_two_component_version_reports_present_not_missing
+    # jq 1.6 (Ubuntu 22.04 default) prints `jq-1.6` — a two-component
+    # version. detect_version must accept it as present rather than failing
+    # the three-component regex and reporting the tier-1 default as missing.
+    with_fake_bin_dir do |dir|
+      write_bin(dir, "jq", "jq-1.6")
+      row = Hive::Dependencies.check_one(Hive::Dependencies::TOOLS.find { |t| t["name"] == "jq" })
+      assert_equal "present", row[:status]
+      assert_equal "1.6", row[:version]
+    end
+  end
+
+  def test_missing_tool_reports_missing_with_hint
+    # A tool that is definitely not on PATH: use a unique name by temporarily
+    # pointing detect_version at a nonexistent binary via a one-off tool hash.
+    tool = { "name" => "definitely-not-a-real-tool-#{Process.pid}", "min_version" => "1.0.0",
+             "flag" => "--version", "hints" => { "default" => "install it" } }
+    row = Hive::Dependencies.check_one(tool)
+    assert_equal "missing", row[:status]
+    assert_equal "install it", row[:hint]
+  end
+
+  def test_version_too_old_reports_hint
+    with_fake_bin_dir do |dir|
+      write_bin(dir, "jq", "jq-1.5.0")
+      row = Hive::Dependencies.check_one(Hive::Dependencies::TOOLS.find { |t| t["name"] == "jq" })
+      assert_equal "version_too_old", row[:status]
+      assert_equal "1.5.0", row[:version]
+      assert row[:hint], "old version must carry an install hint"
+    end
+  end
+
+  def test_detect_version_returns_nil_on_failure
+    with_fake_bin_dir do |dir|
+      write_bin(dir, "broken", "oops", exit_status: 1)
+      assert_nil Hive::Dependencies.detect_version("broken", "--version")
+    end
+  end
+
+  def test_below_min_compares_version_tuples
+    assert Hive::Dependencies.below_min?("2.39.0", "2.40.0")
+    refute Hive::Dependencies.below_min?("2.40.0", "2.40.0")
+    refute Hive::Dependencies.below_min?("3.0.0", "2.40.0")
+  end
+
+  def test_hint_falls_back_to_default
+    tool = { "hints" => { "macos" => "brew install x", "default" => "install x" } }
+    hint = Hive::Dependencies.hint(tool)
+    assert [ "brew install x", "install x" ].include?(hint)
+  end
+end
