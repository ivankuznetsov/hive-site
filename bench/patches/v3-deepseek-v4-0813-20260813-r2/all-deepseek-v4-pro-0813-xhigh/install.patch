new file mode 100644
index 000000000..85563d3b2
--- /dev/null
+++ b/lib/hive/commands/update.rb
@@ -0,0 +1,80 @@
+# frozen_string_literal: true
+
+require "open3"
+require "hive/install"
+
+module Hive
+  module Commands
+    # `hive update` — update the hive binary via its native package manager
+    # (plan: install/packaging U3). Never rewrites the binary in place
+    # (R-UPD): it detects the recorded install channel and shells out to the
+    # updater that owns it.
+    #
+    #   brew  → `brew upgrade hive`
+    #   aur   → `yay -Syu hive-bin`
+    #   bash  → re-runs the install.sh one-liner
+    #
+    # The command runner is injectable for tests (assert command assembly
+    # without network); production shells out for real.
+    class Update
+      def initialize(json: false, runner: nil, channel: Hive::Install.install_channel)
+        @json = json
+        @runner = runner
+        @channel = channel
+      end
+
+      def call
+        unless Hive::Install::CHANNELS.include?(@channel)
+          raise Hive::Error, channel_error_message
+        end
+
+        cmd = update_command(@channel)
+        raise Hive::Error, "update failed (channel #{@channel})" unless run_update_command(cmd)
+
+        report_success
+      end
+
+      def run_update_command(cmd)
+        return @runner.call(cmd) if @runner
+        return system(*cmd) if cmd.is_a?(Array)
+
+        system(cmd)
+      end
+
+      # The shell command each channel maps to. Public for unit tests so they
+      # can assert the exact argv without invoking it.
+      def update_command(channel)
+        case channel
+        when "brew" then %w[brew upgrade hive]
+        when "aur"  then %w[yay -Syu hive-bin]
+        when "bash" then "curl -fsSL #{Hive::Install::INSTALL_SH_URL} | bash"
+        end
+      end
+
+      def report_success
+        if @json
+          require "json"
+          puts JSON.generate(
+            "schema" => "hive-update",
+            "schema_version" => 1,
+            "ok" => true,
+            "channel" => @channel,
+            "command" => update_command(@channel)
+          )
+        else
+          puts "hive: update requested via #{@channel}"
+        end
+      end
+
+      def channel_error_message
+        known = Hive::Install::CHANNELS.join(", ")
+        if @channel.nil? || @channel.to_s.strip.empty?
+          "hive: install channel unknown (no install-channel record); " \
+          "reinstall via a supported package manager or install.sh"
+        else
+          "hive: unknown install channel #{@channel.inspect} (known: #{known})"
+        end
+      end
+    end
+  end
+end
