diff --git a/packaging/check_packaged_scripts.rb b/packaging/check_packaged_scripts.rb
new file mode 100644
index 000000000..5e9ec39a1
--- /dev/null
+++ b/packaging/check_packaged_scripts.rb
@@ -0,0 +1,63 @@
+#!/usr/bin/env ruby
+# frozen_string_literal: true
+
+# Packaging guard for runtime-invoked shell scripts. Verifies that every
+# Hive::PackagedScripts::SCRIPTS entry is present inside an already-built
+# hive-cli .gem, and that scripts invoked directly (not via `bash …`) still
+# ship with the executable bit preserved. Used by
+# test/integration/packaged_gem_test.rb (which builds the gem) and by
+# release.yml (against the artifact it just built), so a script referenced at
+# runtime but omitted from spec.files fails the gate instead of breaking a
+# clean `gem install` at launch time.
+#
+#   ruby packaging/check_packaged_scripts.rb <path-to-.gem>
+
+require_relative "../lib/hive/packaged_scripts"
+require "rubygems/package"
+require "zlib"
+require "stringio"
+
+gem_file = ARGV.fetch(0) { abort "usage: ruby packaging/check_packaged_scripts.rb <gem-file>\n" }
+abort "gem file not found: #{gem_file}\n" unless File.file?(gem_file)
+
+# Scripts invoked directly by the generated hook/settings command (not via
+# `bash <script>`), so the built gem must preserve their +x bit. This
+# enumeration lives in Hive::PackagedScripts::EXEC_REQUIRED — the single
+# source of truth shared with the integration test.
+EXEC_REQUIRED = Hive::PackagedScripts::EXEC_REQUIRED
+
+# Map of full tar paths ("lib/hive/scripts/…") -> header (for mode bits).
+entries = {}
+File.open(gem_file) do |io|
+  Gem::Package::TarReader.new(io) do |outer|
+    outer.each do |entry|
+      next unless entry.full_name == "data.tar.gz"
+
+      gz = Zlib::GzipReader.new(StringIO.new(entry.read))
+      Gem::Package::TarReader.new(gz) do |data|
+        data.each { |inner| entries[inner.full_name] = inner.header }
+      end
+    end
+  end
+end
+
+missing = Hive::PackagedScripts::SCRIPTS.reject do |relative|
+  entries.key?("lib/hive/#{relative}")
+end
+
+unless missing.empty?
+  abort "BUNDLED gem #{gem_file} is missing runtime script(s): #{missing.join(', ')}\n" \
+        "Add them to spec.files (lib/hive/scripts/**/* glob) — see hive.gemspec.\n"
+end
+
+EXEC_REQUIRED.each do |relative|
+  mode = entries.fetch("lib/hive/#{relative}").mode
+  next if (mode & 0o111) != 0
+
+  abort "BUNDLED gem #{gem_file} ships #{relative} without the executable bit " \
+        "(mode 0#{mode.to_s(8)}); it is invoked directly by the Stop-hook command " \
+        "and must remain +x — see Hive::StopHookInstaller / hive.gemspec.\n"
+end
+
+puts "ok: built gem #{gem_file} packages every runtime script " \
+     "(#{Hive::PackagedScripts::SCRIPTS.join(', ')})"
