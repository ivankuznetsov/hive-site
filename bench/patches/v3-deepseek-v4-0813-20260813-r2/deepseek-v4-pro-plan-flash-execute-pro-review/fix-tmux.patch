diff --git a/test/integration/packaged_gem_test.rb b/test/integration/packaged_gem_test.rb
new file mode 100644
index 000000000..5b11a7661
--- /dev/null
+++ b/test/integration/packaged_gem_test.rb
@@ -0,0 +1,217 @@
+require "test_helper"
+require "open3"
+require "rubygems/package"
+require "zlib"
+require "stringio"
+require "hive/packaged_scripts"
+
+# Packaging guard: builds the ACTUAL .gem (the same `gem build` release.yml
+# runs) and asserts every runtime-invoked script is packaged inside it, with
+# the direct-invocation scripts still executable. The unit-level counterpart
+# in gemspec_test.rb locks spec.files; this integration test is the ground
+# truth that the shipped artifact really carries the scripts, so a future
+# script added to Hive::PackagedScripts but omitted from the gemspec fails CI
+# on every PR instead of silently breaking a clean `gem install`.
+class PackagedGemTest < Minitest::Test
+  include HiveTestHelper
+
+  REPO_ROOT = File.expand_path("../..", __dir__)
+  CHECKER = File.join(REPO_ROOT, "packaging", "check_packaged_scripts.rb")
+
+  # Scripts invoked directly (not via `bash …`) by the generated hook /
+  # settings command — the built gem must preserve their +x bit. The
+  # enumeration is shared with the release guard via
+  # Hive::PackagedScripts::EXEC_REQUIRED (single source of truth).
+  EXEC_REQUIRED = Hive::PackagedScripts::EXEC_REQUIRED
+
+  def test_built_gem_packages_every_runtime_script_and_preserves_exec_bit
+    with_built_gem do |gem_path|
+      contents = gem_contents(gem_path)
+      Hive::PackagedScripts::SCRIPTS.each do |relative|
+        assert_includes contents, "lib/hive/#{relative}",
+                        "#{relative} is referenced at runtime (PackagedScripts) " \
+                        "but missing from the built gem"
+      end
+
+      entries = data_tar_entries(gem_path)
+      EXEC_REQUIRED.each do |relative|
+        mode = entries.fetch("lib/hive/#{relative}").mode
+        assert (mode & 0o111) != 0,
+               "built gem ships #{relative} without +x (mode 0#{mode.to_s(8)}); " \
+               "it is invoked directly by the Stop-hook command"
+      end
+    end
+  end
+
+  # The guard must fail loudly when a script reference is added without a
+  # corresponding packaged file — that is exactly the regression this suite
+  # exists to prevent. Build the real gem, tamper it to drop one runtime
+  # script, and run the ACTUAL guard (check_packaged_scripts.rb) against it so
+  # the abort path is exercised, not just re-asserted as a tautology.
+  def test_guard_fails_when_a_script_reference_is_missing_from_the_built_gem
+    missing_script = "scripts/stop_hook.sh"
+    with_built_gem do |gem_path|
+      with_tmp_dir do |dir|
+        tampered = File.join(dir, "tampered.gem")
+        write_tampered_gem_without(gem_path, missing_script, tampered)
+        out, status = Open3.capture2e(RbConfig.ruby, CHECKER, tampered)
+        refute status.success?,
+               "checker must fail on a gem missing #{missing_script}:\n#{out}"
+        assert_match(/missing runtime script/, out)
+        assert_includes out, missing_script
+      end
+    end
+  end
+
+  # release.yml runs the checker against its own freshly built artifact; lock
+  # that the script is runnable here too so a refactor of the guard never
+  # silently desyncs the workflow step.
+  def test_checker_script_is_runnable_and_passes_on_the_built_gem
+    with_built_gem do |gem_path|
+      out, status = Open3.capture2e(RbConfig.ruby, CHECKER, gem_path)
+      assert status.success?, "checker script failed:\n#{out}"
+      assert_match(/ok: built gem .* packages every runtime script/, out)
+    end
+  end
+
+  # The +x abort branch is the other half of the guard: a script shipped in
+  # the gem but without the executable bit breaks a clean `gem install` at
+  # launch time, when the Stop-hook command invokes it directly. Build the
+  # real gem, strip +x from stop_hook.sh, and run the ACTUAL guard so the
+  # exec-bit abort path is exercised rather than only re-asserted via the
+  # direct mode math in test_built_gem_packages_every_runtime_script_and_preserves_exec_bit.
+  def test_guard_fails_when_an_exec_script_loses_its_exec_bit
+    relative = "scripts/stop_hook.sh"
+    with_built_gem do |gem_path|
+      with_tmp_dir do |dir|
+        tampered = File.join(dir, "no-exec.gem")
+        write_tampered_gem_with_mode(gem_path, relative, 0o644, tampered)
+        out, status = Open3.capture2e(RbConfig.ruby, CHECKER, tampered)
+        refute status.success?,
+               "checker must fail on a gem shipping #{relative} without +x:\n#{out}"
+        assert_match(/without the executable bit/, out)
+        assert_includes out, relative
+      end
+    end
+  end
+
+  private
+
+  # Build the real gem from the repo root (Gemfile globs resolve against cwd,
+  # exactly like release.yml's `gem build hive.gemspec`), yield the resulting
+  # path, then remove the artifact we created.
+  def with_built_gem
+    Dir.chdir(REPO_ROOT) do
+      before = Dir.glob("hive-cli-*.gem")
+      out, status = Open3.capture2e("gem", "build", "hive.gemspec")
+      assert status.success?, "gem build failed:\n#{out}"
+      created = Dir.glob("hive-cli-*.gem") - before
+      refute_empty created, "gem build produced no hive-cli-*.gem"
+      yield File.expand_path(created.first)
+    ensure
+      Array(created).each { |f| File.delete(f) if File.exist?(f) }
+    end
+  end
+
+  def gem_contents(gem_path)
+    Gem::Package.new(gem_path).contents
+  end
+
+  # Full tar path -> header, read directly from data.tar.gz (Gem::Package's
+  # extract_files normalizes every mode to 0644, so we must read the tar).
+  def data_tar_entries(gem_path)
+    entries = {}
+    File.open(gem_path) do |io|
+      Gem::Package::TarReader.new(io) do |outer|
+        outer.each do |entry|
+          next unless entry.full_name == "data.tar.gz"
+
+          gz = Zlib::GzipReader.new(StringIO.new(entry.read))
+          Gem::Package::TarReader.new(gz) do |data|
+            data.each { |inner| entries[inner.full_name] = inner.header }
+          end
+        end
+      end
+    end
+    entries
+  end
+
+  # Yield each `full_name` -> raw bytes entry inside data.tar.gz. Unlike
+  # data_tar_entries (headers only), this carries the file contents so we can
+  # re-pack a deliberately tampered gem that omits one runtime script.
+  def each_data_tar_entry(gem_path)
+    File.open(gem_path) do |io|
+      Gem::Package::TarReader.new(io) do |outer|
+        outer.each do |entry|
+          next unless entry.full_name == "data.tar.gz"
+
+          gz = Zlib::GzipReader.new(StringIO.new(entry.read))
+          Gem::Package::TarReader.new(gz) do |data|
+            data.each { |inner| yield inner.full_name, inner.read }
+          end
+        end
+      end
+    end
+  end
+
+  # Rebuild a .gem whose data.tar.gz carries every original entry EXCEPT
+  # `lib/hive/<relative>`, leaving that runtime-referenced script genuinely
+  # absent. The checker only inspects data.tar.gz, so a minimal outer tar with
+  # just that entry is sufficient to exercise its abort path. The inner tar is
+  # written to a StringIO first: TarWriter needs `pos=` to backfill headers,
+  # which Zlib::GzipWriter does not support.
+  def write_tampered_gem_without(gem_path, relative, out_path)
+    retained = {}
+    each_data_tar_entry(gem_path) do |name, bytes|
+      retained[name] = bytes unless name == "lib/hive/#{relative}"
+    end
+
+    inner_tar = StringIO.new
+    Gem::Package::TarWriter.new(inner_tar) do |inner|
+      retained.each { |name, bytes| inner.add_file(name, 0o644) { |f| f.write(bytes) } }
+    end
+    inner_tar.rewind
+
+    File.open(out_path, "wb") do |io|
+      Gem::Package::TarWriter.new(io) do |writer|
+        writer.add_file("data.tar.gz", 0o644) do |tar|
+          gz = Zlib::GzipWriter.new(tar)
+          gz.write(inner_tar.read)
+          gz.close
+        end
+      end
+    end
+  end
+
+  # Rebuild a .gem whose data.tar.gz carries every original entry, but write
+  # `lib/hive/<relative>` with the given (non-executable) mode while leaving
+  # every other entry at 0644. This simulates a script that shipped in the gem
+  # but lost its +x bit, exercising the checker's exec-bit abort path. Same
+  # StringIO-first strategy as write_tampered_gem_without (TarWriter needs
+  # `pos=` to backfill headers, which Zlib::GzipWriter does not support).
+  def write_tampered_gem_with_mode(gem_path, relative, mode, out_path)
+    bytes_by_name = {}
+    each_data_tar_entry(gem_path) do |name, bytes|
+      bytes_by_name[name] = bytes
+    end
+
+    inner_tar = StringIO.new
+    Gem::Package::TarWriter.new(inner_tar) do |inner|
+      bytes_by_name.each do |name, bytes|
+        entry_mode = name == "lib/hive/#{relative}" ? mode : 0o644
+        inner.add_file(name, entry_mode) { |f| f.write(bytes) }
+      end
+    end
+    inner_tar.rewind
+
+    File.open(out_path, "wb") do |io|
+      Gem::Package::TarWriter.new(io) do |writer|
+        writer.add_file("data.tar.gz", 0o644) do |tar|
+          gz = Zlib::GzipWriter.new(tar)
+          gz.write(inner_tar.read)
+          gz.close
+        end
+      end
+    end
+  end
+end
