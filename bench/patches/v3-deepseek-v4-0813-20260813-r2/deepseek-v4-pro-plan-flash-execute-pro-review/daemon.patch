+      File.write(state_file, "irrelevant\n")
+      row = make_row(stage: "2-brainstorm", folder: dir, state_file: state_file,
+                     attrs: { "reason" => "claude_launch_failed" })
+      original = Hive::BrainstormParser.method(:parse)
+      Hive::BrainstormParser.define_singleton_method(:parse) do |_path|
+        raise RuntimeError, "boom"
