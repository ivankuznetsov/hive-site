+require "test_helper"
+require "tmpdir"
+require "time"
+require "json"
+require "hive/markers"
+require "hive/events"
+require "hive/daemon/status_consumer"
+require "hive/daemon/auto_retry"
+
+class HiveDaemonAutoRetryEngineTest < Minitest::Test
+  include HiveTestHelper
+
+  Row = Hive::Daemon::StatusConsumer::Row
+  ProbeResult = Hive::Daemon::AutoRetry::ProbeResult
+
+  NOW = Time.utc(2026, 6, 20, 12, 0, 0)
+
+  class FakeController
+    attr_reader :observed_mtimes
+    attr_accessor :running
+
+    def initialize(running: false)
+      @running = running
+      @observed_mtimes = []
+    end
+
+    def running_task?(project:, slug:)
+      @running
+    end
+
