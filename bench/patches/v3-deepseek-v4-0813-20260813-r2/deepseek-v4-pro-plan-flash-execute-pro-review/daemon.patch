+                     attrs: { "reason" => "claude_launch_failed" })
+      refute @classifier.work_area_safe?(row, :claude_launch_failed, CODX_CFG)
+    end
+  end
+
+  def test_claude_launch_failed_open_pr_and_artifacts_are_idempotently_safe
+    %w[5-open-pr 7-artifacts].each do |stage|
+      row = make_row(stage: stage, attrs: { "reason" => "claude_launch_failed" })
