+      assert @classifier.work_area_safe?(row, :claude_launch_failed, CODX_CFG)
+    end
+  end
+
+  def test_nonblank_plan_is_unsafe
+    Dir.mktmpdir do |dir|
+      File.write(File.join(dir, "plan.md"), "# plan of record\n")
+      row = make_row(stage: "3-plan", folder: dir,
+                     attrs: { "reason" => "claude_launch_failed" })
+      refute @classifier.work_area_safe?(row, :claude_launch_failed, CODX_CFG)
+    end
+  end
+
+  def test_brainstorm_missing_state_file_is_unsafe
+    Dir.mktmpdir do |dir|
