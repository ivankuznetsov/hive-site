+
+  def test_brainstorm_with_answered_question_is_unsafe
+    Dir.mktmpdir do |dir|
+      state_file = File.join(dir, "brainstorm.md")
+      File.write(state_file, [
+        "## Round 1",
+        "### Q1. Should I build it?",
+        "",
+        "### A1.",
+        "yes"
