+      #
+      # Reuses `parse_escalation_questions` — the same parser as
+      # `count_escalations` / `collect_answered_escalation_findings_with_count` —
+      # so a blank `### An.` body is classified unanswered exactly like the
+      # rest of the triage pipeline, and a mismatched `### An.` number never
+      # closes a different question.
+      def unanswered_escalations?(path)
