+      File.write(File.join(stage_dir, Hive::TmuxRunner::EXIT_STATUS_FILENAME), "bogus")
+      assert_nil r.clean_exit_status
+
+      File.write(File.join(stage_dir, Hive::TmuxRunner::EXIT_STATUS_FILENAME), "")
