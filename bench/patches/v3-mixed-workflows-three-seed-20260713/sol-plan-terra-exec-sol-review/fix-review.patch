+  def fallback_runner(tails:, pane_pid:, exit_status:, unreadable_after_kill: false)
+    runner = Object.new
+    runner.instance_variable_set(:@tails, tails.dup)
+    runner.instance_variable_set(:@pane_pid_value, pane_pid)
+    runner.instance_variable_set(:@exit_status, exit_status)
