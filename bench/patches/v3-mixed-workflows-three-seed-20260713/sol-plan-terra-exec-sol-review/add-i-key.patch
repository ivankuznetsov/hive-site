+      # Close by stable folder identity rather than stale row indices.
+      # Polling can reorder projects/rows while the panel is open.
+      def close_info_panel(model, flash: nil)
+        state = model.info_panel_state
+        closed = model.with(
+          mode: :grid,
+          info_panel_state: nil,
+          flash: flash,
+          flash_set_at: flash ? Time.now : nil
+        )
+        visible = visible_snapshot(closed)
+        return closed if visible.nil?
+
+        cursor = state ? cursor_for_folder(visible, state.row.folder) : nil
+        if cursor
+          closed.with(cursor: cursor)
+        else
+          fallback = reclamp_cursor(visible, closed.cursor)
+          message = flash || "#{state&.row&.slug || 'task'} no longer in this project"
