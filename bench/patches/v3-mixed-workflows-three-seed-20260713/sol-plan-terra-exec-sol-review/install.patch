+#!/usr/bin/env ruby
+# frozen_string_literal: true
+
+require "json"
+
+tag = ARGV.fetch(0) { abort "usage: script/update-skills-metadata vMAJOR.MINOR.PATCH [SKILLS_ROOT]" }
+abort "version must be vMAJOR.MINOR.PATCH" unless tag.match?(/\Av\d+\.\d+\.\d+\z/)
+
+version = tag.delete_prefix("v")
+root = File.expand_path(ARGV.fetch(1, "../packaging/hive-skills"), __dir__)
+json_files = [
+  File.join(root, ".codex-plugin", "plugin.json"),
+  File.join(root, "plugins", "hive", ".claude-plugin", "plugin.json"),
+  File.join(root, "package.json")
+]
+json_files.each do |path|
+  document = JSON.parse(File.read(path))
+  document["version"] = version
+  File.write(path, JSON.pretty_generate(document) + "\n")
+end
+
+Dir.glob(File.join(root, "**", "*.md"), File::FNM_DOTMATCH).each do |path|
+  text = File.read(path).gsub(/v\d+\.\d+\.\d+/, tag)
+  File.write(path, text)
+end
