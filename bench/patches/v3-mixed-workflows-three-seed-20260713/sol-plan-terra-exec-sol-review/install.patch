+
+require "json"
+
+manifest_path = ARGV.fetch(0) { abort "usage: script/update-homebrew-formula RELEASE_MANIFEST.json" }
+manifest = JSON.parse(File.read(manifest_path))
+target = manifest.fetch("targets").find { |entry| entry["os"] == "darwin" && entry["arch"] == "arm64" }
+abort "manifest has no darwin/arm64 target" unless target
+
+formula = File.expand_path(ARGV.fetch(1, "../packaging/homebrew/Formula/hive.rb"), __dir__)
