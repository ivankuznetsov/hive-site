+      paths = Hive::Paths.new(env: {}, home: home)
+      path = Hive::Service::Launchd.write!(paths: paths, executable_path: "/opt/homebrew/bin/hive")
+
+      assert_equal File.join(home, "Library", "LaunchAgents", "dev.hive.daemon.plist"), path
+      content = File.read(path)
+      assert_includes content, "<string>/opt/homebrew/bin/hive</string>"
+      assert_includes content, "<key>HIVE_SERVICE_CHILD</key>"
