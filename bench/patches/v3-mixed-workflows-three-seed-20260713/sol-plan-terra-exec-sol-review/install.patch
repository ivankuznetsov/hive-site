+    end
+  end
+
+  def test_requested_host_has_an_executable_install_and_remove_route
+    host = ENV["HIVE_PROMPT_HOST"]
+    skip "HIVE_PROMPT_HOST is only set by the tier-1 host matrix" unless host
+
+    prompt = File.read("docs/install-prompt.md")
+    routes = {
+      "claude" => [ "claude plugin install hive@hive-skills", "claude plugin uninstall hive@hive-skills" ],
+      "codex" => [ "codex plugin add hive@hive-skills", "codex plugin remove hive@hive-skills" ],
+      "pi" => [
+        "pi install git:github.com/ivankuznetsov/hive-skills@v0.1.0",
+        "pi remove git:github.com/ivankuznetsov/hive-skills@v0.1.0"
