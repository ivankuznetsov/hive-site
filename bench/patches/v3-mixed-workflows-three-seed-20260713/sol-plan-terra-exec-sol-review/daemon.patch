+  def test_real_cooldown_exhaustion_and_manual_clear_reset_survive_restarts
+    with_real_execute_task(slug: "retry-budget") do |project, state_home, _folder, state_file, _worktree|
+      probe_state = File.join(state_home, "probe-state")
