+        assert_equal :error, Hive::Markers.current(state_file).name
+        assert_empty Hive::Daemon::DispatchRequestQueue.pending(state_home: state_home)
+
+        # A daemon restart and recovered smoke command do not alter any cheap
+        # fingerprint input. The 30-minute fallback is therefore the only path
+        # that can re-run the external probe.
+        File.write(probe_state, "ok\n")
+        real_coordinator(state_home: state_home, logger: logger, fake_codex: fake_codex)
+          .process([ real_status_row(state_home, "retry-acceptance") ], now: started_at + 1799)
+        assert_equal :error, Hive::Markers.current(state_file).name
