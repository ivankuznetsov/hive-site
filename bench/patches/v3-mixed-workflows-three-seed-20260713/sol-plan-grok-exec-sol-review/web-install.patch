+        "ok": { "type": "boolean" },
+        "platform": { "type": "string" },
+        "results": {
+          "type": "array",
+          "items": { "$ref": "#/$defs/DiagnosticResult" }
+        }
+      }
+    },
+    "DiagnosticResult": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["name", "status", "detail", "fix", "bootstrappable", "path", "version"],
+      "properties": {
+        "name": { "type": "string", "minLength": 1 },
+        "status": {
+          "type": "string",
+          "enum": ["ok", "missing", "outdated", "unauthenticated", "bootstrappable", "error", "unsupported"]
+        },
+        "detail": { "type": ["string", "null"] },
+        "fix": { "type": ["string", "null"] },
+        "bootstrappable": { "type": "boolean" },
+        "path": { "type": ["string", "null"] },
+        "version": { "type": ["string", "null"] }
+      }
+    }
