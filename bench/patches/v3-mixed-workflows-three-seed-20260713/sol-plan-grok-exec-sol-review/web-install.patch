diff --git a/examples/launchd/hive-web.plist b/examples/launchd/hive-web.plist
new file mode 100644
index 00000000..0a613dce
--- /dev/null
+++ b/examples/launchd/hive-web.plist
@@ -0,0 +1,87 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!--
+  Sample launchd plist for `hive web` (macOS).
+
+  This file is installer-managed: `hive web install` rewrites the binary
+  path, the bin directory in PATH, and the log directory to match the
+  resolved binary + your home, then loads it. You normally do not edit
+  this by hand — re-run `hive web install` instead.
+
+  Install:
+    hive web install
+    # or by hand:
+    mkdir -p ~/Library/LaunchAgents
+    cp examples/launchd/hive-web.plist ~/Library/LaunchAgents/local.hive-web.plist
+    $EDITOR ~/Library/LaunchAgents/local.hive-web.plist
+    launchctl load ~/Library/LaunchAgents/local.hive-web.plist
+
+  Verify:
+    launchctl list | grep hive-web
+    cat ~/Library/Logs/hive-web.err.log
+    curl -sS http://127.0.0.1:4567/health/deep
+
+  View logs:
+    tail -f ~/Library/Logs/hive-web.{out,err}.log
+
+  Stop / restart:
+    launchctl unload ~/Library/LaunchAgents/local.hive-web.plist
+    launchctl load   ~/Library/LaunchAgents/local.hive-web.plist
+
+  Note the absolute-path requirement: launchd doesn't read shell rc files.
+
+  RESPAWN-LOOP CIRCUIT-BREAKER: launchd has no native StartLimitBurst.
+  With KeepAlive { SuccessfulExit: false } and a wrong ProgramArguments
+  path, launchd would respawn every 30 s forever. The /bin/sh wrapper
+  converts "binary not executable" into a clean exit 0 — which KeepAlive
+  { SuccessfulExit: false } then respects (no respawn). A real Rails
+  crash still exits non-zero through `exec` and respawns normally per
+  ThrottleInterval.
+
+  hive-web is independent of hive-daemon — separate launchd jobs sharing
+  the same XDG state and project registry.
+-->
+<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
+  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">
+<dict>
+  <key>Label</key>
+  <string>local.hive-web</string>
+
+  <!-- ProgramArguments wraps the real invocation in a tiny /bin/sh
+       precheck. If the binary path passed as $0 is missing or not
+       executable, the wrapper exits 0 (clean) so KeepAlive's
+       SuccessfulExit:false STOPS respawning. If it IS executable, exec
+       hands the process tree to hive web. -->
+  <key>ProgramArguments</key>
+  <array>
+    <string>/bin/sh</string>
+    <string>-c</string>
+    <string>[ -x "$0" ] || exit 0; exec "$0" "$@"</string>
+    <string>/Users/YOU/.local/bin/hive</string>
+    <string>web</string>
+  </array>
+
+  <key>RunAtLoad</key>
+  <true/>
+
+  <key>KeepAlive</key>
+  <dict>
+    <key>SuccessfulExit</key>
+    <false/>
+  </dict>
+
+  <key>ThrottleInterval</key>
+  <integer>30</integer>
+
+  <key>StandardOutPath</key>
+  <string>/Users/YOU/Library/Logs/hive-web.out.log</string>
+  <key>StandardErrorPath</key>
+  <string>/Users/YOU/Library/Logs/hive-web.err.log</string>
+
+  <key>EnvironmentVariables</key>
+  <dict>
+    <key>PATH</key>
+    <string>/Users/YOU/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
+  </dict>
+</dict>
+</plist>
