+      installer.define_singleton_method(:status_snapshot) { { "service_active" => true } }
+      installer.define_singleton_method(:restart!) { restarts << true; :ok }
+      ctx[:cmd].instance_variable_set(:@web_installer, installer)
+      ctx[:cmd].instance_variable_set(
+        :@web_health_probe,
+        ->(url, timeout:) { probes << [ url, timeout ]; true }
+      )
+
+      ctx[:cmd].call
+      payload = JSON.parse(ctx[:out].string)
+      web_phase = payload["phases"].find { |phase| phase["name"] == "web_install" }
+
+      assert web_phase["ok"], web_phase.inspect
+      assert_equal [ true ], restarts
+      assert_equal 1, probes.length
+      assert_equal "http://127.0.0.1:4567/health", probes.first.first
+      assert_operator probes.first.last, :>, 0
+      assert_match(/restarted=true/, web_phase["detail"])
