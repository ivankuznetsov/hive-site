+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://github.com/ivankuznetsov/hive/blob/main/schemas/hive-setup.v1.json",
+  "title": "hive setup output (v1)",
+  "description": "Stable complete phase report emitted by `hive setup --json`, including failed diagnostic and provisioning outcomes before the command exits non-zero.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema", "schema_version", "ok", "service", "no_bootstrap",
+    "no_init", "binary_path", "project_path", "web_url", "diagnostics", "phases"
+  ],
+  "properties": {
+    "schema": { "const": "hive-setup" },
+    "schema_version": { "const": 1 },
+    "ok": { "type": "boolean" },
+    "service": { "type": "boolean" },
+    "no_bootstrap": { "type": "boolean" },
+    "no_init": { "type": "boolean" },
+    "binary_path": { "type": ["string", "null"] },
+    "project_path": { "type": "string" },
+    "web_url": { "type": "string", "const": "http://127.0.0.1:4567" },
+    "diagnostics": { "$ref": "#/$defs/Diagnostics" },
+    "phases": {
+      "type": "array",
+      "minItems": 1,
+      "items": { "$ref": "#/$defs/Phase" }
+    }
+  },
+  "$defs": {
+    "Phase": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["name", "ok", "detail", "error"],
+      "properties": {
+        "name": { "type": "string", "minLength": 1 },
+        "ok": { "type": "boolean" },
+        "detail": { "type": ["string", "null"] },
+        "error": { "type": ["string", "null"] }
+      }
+    },
+    "Diagnostics": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["schema", "schema_version", "ok", "platform", "results"],
+      "properties": {
+        "schema": { "const": "hive-setup-diagnostics" },
