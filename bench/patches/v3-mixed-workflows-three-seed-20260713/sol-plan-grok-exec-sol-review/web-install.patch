+        init_runner: ->(*) { "ok" },
+        qmd_installer: -> { "ok" },
+        app_bundle: Object.new.tap { |o| o.define_singleton_method(:ensure_installed!) { "app" } },
+        output: StringIO.new,
+        err: StringIO.new
+      )
+      capture_io { cmd.call }
+      assert_equal %i[d w], seen
+      assert_equal "/exact/hive", cmd.instance_variable_get(:@binary_path)
+    end
+  end
