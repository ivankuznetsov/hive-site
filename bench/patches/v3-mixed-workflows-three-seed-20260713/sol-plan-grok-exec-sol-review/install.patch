+      command = install_fake_bash_channel(prefix: dir, command_names: [ "hv" ])
+      adapter = Object.new
+      adapter.define_singleton_method(:stop!) { false }
+      adapter.define_singleton_method(:unregister!) { raise "must not run" }
+
+      error = assert_raises(Hive::Error) do
+        Hive::Commands::Uninstall.new(
+          project_path: dir,
+          yes: true,
+          command_path: command,
+          service_adapter: adapter,
