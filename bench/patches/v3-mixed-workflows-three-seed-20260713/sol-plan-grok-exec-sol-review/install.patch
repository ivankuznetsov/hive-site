+# frozen_string_literal: true
+
+require "test_helper"
+require "hive/project/manifest"
+require "digest"
+
+class ProjectManifestTest < Minitest::Test
+  include HiveTestHelper
+
+  def test_record_and_unmodified
+    with_tmp_dir do |dir|
+      manifest = Hive::Project::Manifest.new(dir)
+      content = "hello\n"
+      rel = ".hive/README.md"
+      FileUtils.mkdir_p(File.join(dir, ".hive"))
+      File.write(File.join(dir, rel), content)
+      digest = manifest.record!(rel, content)
+      assert_equal Digest::SHA256.hexdigest(content), digest
+      manifest.save!
+      assert File.exist?(Hive::Project::Manifest.path_for(dir))
+      assert manifest.unmodified?(rel)
+
+      File.write(File.join(dir, rel), "changed\n")
+      refute manifest.unmodified?(rel)
+      assert_includes manifest.preserved_paths, rel
+    end
+  end
+
+  def test_load_roundtrip
+    with_tmp_dir do |dir|
+      m = Hive::Project::Manifest.new(dir)
+      m.record!(".hive/README.md", "x")
+      m.save!
+      loaded = Hive::Project::Manifest.load(dir)
+      assert_equal Hive::VERSION, loaded.template_version
+      assert loaded.generated[".hive/README.md"]
+    end
+  end
+end
