+      - run: npm pack --dry-run
+        working-directory: plugins/hive
+      - run: npm publish --access public --provenance
+        working-directory: plugins/hive
+        env:
+          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
