+    root = Hive::Paths.repo_root
+    assert File.directory?(File.join(root, "templates"))
+    assert File.directory?(File.join(root, "lib", "hive"))
+    assert Hive::Paths.source_checkout?
+    assert File.exist?(Hive::Paths.template_path("project_config.yml.erb"))
+  end
