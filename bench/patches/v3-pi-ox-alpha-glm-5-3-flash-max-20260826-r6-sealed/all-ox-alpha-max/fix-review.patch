+      return nil unless result_status.nil? || result_status == :ok
+
+      evidence = evaluate_completion_evidence(completion_evidence, pane_tail)
+      return nil unless evidence
+
+      detail = evidence.is_a?(Hash) ? evidence : { summary: evidence.to_s }
+      emit_completion_fallback_event(task, runner, detail)
+
+      {
+        status: :ok,
+        log_label: log_label,
+        fallback: {
