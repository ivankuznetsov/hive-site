diff --git a/test/unit/service_test.rb b/test/unit/service_test.rb
new file mode 100644
index 0000000..54ba52b
--- /dev/null
+++ b/test/unit/service_test.rb
@@ -0,0 +1,187 @@
+require "test_helper"
+require "hive/service"
+require "hive/commands/init"
+require "stringio"
+
+# U5 (plan figure-out-way-to-install-260513-4a0a): per-user daemon
+# service registration — manifest rendering, prompt defaults, and the
+# start/register/skip contract. Platform manager invocations are stubbed;
+# nothing here touches a real launchd/systemd.
+class HiveServiceTest < Minitest::Test
+  include HiveTestHelper
+
+  ORIGINAL_PLATFORM = Hive::Service.method(:platform)
+  ORIGINAL_SUPPORTED = Hive::Service.method(:supported?)
+
+  def setup
+    # Force the linux branch + supportedness deterministically.
+    Hive::Service.define_singleton_method(:platform) { :linux }
+    Hive::Service.define_singleton_method(:supported?) { true }
+  end
+
+  def teardown
+    Hive::Service.define_singleton_method(:platform, ORIGINAL_PLATFORM)
+    Hive::Service.define_singleton_method(:supported?, ORIGINAL_SUPPORTED)
+    Hive::Service.instance_variable_set(:@bin_path, nil)
+  end
+
+  def with_service_sandbox(home)
+    # Point Paths (manifests) and the manager binary at a hermetic sandbox.
+    saved_home = ENV["HIVE_HOME"]
+    old_bin = ENV["HIVE_SERVICE_BIN"]
+    dir = Dir.mktmpdir("hive-service-home")
+    ENV["HIVE_HOME"] = dir
+    ENV["HIVE_SERVICE_BIN"] = File.join(home, "bin", "hive")
+    yield dir
+  ensure
+    FileUtils.rm_rf(dir) if dir
+    if saved_home.nil?
+      ENV.delete("HIVE_HOME")
+    else
+      ENV["HIVE_HOME"] = saved_home
+    end
+    if old_bin.nil?
+      ENV.delete("HIVE_SERVICE_BIN")
+    else
+      ENV["HIVE_SERVICE_BIN"] = old_bin
+    end
+  end
+
+  def test_renders_linux_unit_with_restart_on_failure_and_state_paths
+    text = Hive::Service.render("hive.service.erb", Hive::Service.template_bindings)
+    assert_includes text, "Restart=on-failure"
+    bin_path = Hive::Service.template_bindings[:bin_path]
+    assert_match(/ExecStart=#{Regexp.escape(bin_path)} daemon start/, text)
+    assert_includes text, "WantedBy=default.target"
+  end
+
+  def test_renders_macos_plist_with_label_keepalive_and_daemon_args
+    text = Hive::Service.render("io.github.ivankuznetsov.hive.plist.erb",
+                                Hive::Service.template_bindings)
+    assert_includes text, "<string>#{Hive::Service::LABEL}</string>"
+    assert_includes text, "<key>KeepAlive</key>"
+    assert_includes text, "<key>RunAtLoad</key>"
+    # ProgramArguments carries `<bin> daemon start`
+    bin_path = Hive::Service.template_bindings[:bin_path]
+    assert_match(/<string>#{Regexp.escape(bin_path)}<\/string>\s*<string>daemon<\/string>\s*<string>start<\/string>/m,
+                 text)
+    assert_equal 1, text.scan("<plist").size
+  end
+
+  def test_register_writes_manifest_and_start_now_enables
+    with_tmp_dir do |home|
+      with_service_sandbox(home) do
+        captured = []
+        stub_managers(captured) do
+          result = Hive::Service.register!(Hive::Service::START_NOW)
+          assert result[:started_now]
+          expected_manifest = File.join(Hive::Paths.state_dir, "systemd", "user", "hive.service")
+          assert_equal expected_manifest, result[:manifest]
+          assert File.exist?(expected_manifest)
+          assert_includes File.read(expected_manifest), "Restart=on-failure"
+        end
+        enabled_call = captured.find { |args| args.join(" ").include?("enable --now") }
+        refute_nil enabled_call, "start_now must enable --now the user unit"
+        reload_call = captured.find { |args| args.join(" ").include?("daemon-reload") }
+        refute_nil reload_call
+      end
+    end
+  end
+
+  def test_register_only_never_starts_the_unit
+    with_tmp_dir do |home|
+      with_service_sandbox(home) do
+        captured = []
+        stub_managers(captured) do
+          result = Hive::Service.register!(Hive::Service::REGISTER_ONLY)
+          refute result[:started_now]
+          assert File.exist?(result[:manifest])
+        end
+        started = captured.any? { |args| args.include?("--now") }
+        refute started, "register-only must not enable/start anything"
+      end
+    end
+  end
+
+  def test_prompt_non_tty_defaults_to_register_only
+    out = StringIO.new
+    prompt = Hive::ServiceRegisterPrompt.new(input: StringIO.new, output: out)
+    assert_equal Hive::Service::REGISTER_ONLY, prompt.ask
+    assert_match(/registering only/, out.string)
+  end
+
+  def test_prompt_tty_answers_map_to_choices
+    [ [ "start\n", Hive::Service::START_NOW ],
+      [ "\n", Hive::Service::START_NOW ],
+      [ "register\n", Hive::Service::REGISTER_ONLY ],
+      [ "skip\n", Hive::Service::SKIP ],
+      [ "bogus\nstart\n", Hive::Service::START_NOW ] ].each do |input_text, expected|
+      out = StringIO.new
+      answer = Hive::ServiceRegisterPrompt.new(input: tty_io(input_text), output: out).ask
+      assert_equal expected, answer, "input #{input_text.inspect}"
+    end
+  end
+
+  def test_prompt_eof_mid_question_returns_skip_never_autostart
+    out = StringIO.new
+    # An empty, EOF-at-start stream: gets returns nil immediately.
+    input = StringIO.new("")
+    input.define_singleton_method(:tty?) { true }
+    answer = Hive::ServiceRegisterPrompt.new(input: input, output: out).ask
+    assert_equal Hive::Service::SKIP, answer, "EOF must degrade to skip"
+  end
+
+  def test_init_register_service_guard_honors_hive_no_service
+    prev = ENV["HIVE_NO_SERVICE"]
+    ENV["HIVE_NO_SERVICE"] = "1"
+    init = Hive::Commands::Init.allocate
+    called = false
+    begin
+      result = nil
+      _out, _err = capture_io do
+        result = init.send(:register_service!)
+      end
+      assert_nil result
+      refute called
+    ensure
+      if prev.nil?
+        ENV["HIVE_NO_SERVICE"] = nil
+      else
+        ENV["HIVE_NO_SERVICE"] = prev
+      end
+    end
+  end
+
+  private
+
+  def tty_io(text)
+    io = StringIO.new(text)
+    io.define_singleton_method(:tty?) { true }
+    io
+  end
+
+  # Stubs both the run! helper and Open3.capture3 so register!/start!/
+  # unload! never spawn a real manager binary. Collector receives each
+  # command argv array.
+  def stub_managers(collector)
+    original_run = Hive::Service.method(:run!)
+    Hive::Service.define_singleton_method(:run!) do |*cmd|
+      collector << cmd.map(&:to_s)
+      ""
+    end
+
+    original_capture3 = Open3.method(:capture3)
+    ok_status = begin
+      system("true")
+      $CHILD_STATUS.clone
+    end
+    Open3.define_singleton_method(:capture3) do |*cmd, **opts|
+      collector << cmd.map(&:to_s)
+      [ "", "", ok_status ]
+    end
+    yield
+  ensure
+    Hive::Service.define_singleton_method(:run!, original_run)
+    Open3.define_singleton_method(:capture3, original_capture3)
+  end
+end
