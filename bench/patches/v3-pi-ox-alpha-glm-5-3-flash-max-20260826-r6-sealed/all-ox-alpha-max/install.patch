+desc "Build a self-contained release tarball (packaging/build.sh, plan U3)."
+# Usage: rake 'release:tarball[v0.1.0]'
+# Produces tmp/release/hive-<version>-<os>-<arch>.tar.gz of the fixed
+# channel-consumed shape (bin/hive + share/hive payload + SHA256SUMS).
+# Default PACKAGING_BACKEND=auto tries Tebako then falls back; dev builds
+# without an embedded runtime are fine for local smoke verification.
+namespace :release do
+  task :tarball, [:version] do |_t, args|
+    version = args[:version] || ENV["HIVE_VERSION"] || Hive::VERSION.tap { |v| abort "usage: rake 'release:tarball[vX.Y.Z]'" }
+    sh "bash packaging/build.sh #{version}"
+  end
+end
