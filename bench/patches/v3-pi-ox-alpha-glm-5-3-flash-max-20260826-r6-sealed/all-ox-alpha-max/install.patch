+
+  def test_aur_channel_delegates_via_sudo_pacman
+    recorder = []
+    with_uninstall_sandbox({ "channel" => "aur", "version" => "v0.1.0" }) do
+      # Craft an AUR channel explicitly and verify delegation shape.
+      run_uninstall(
+        runner: lambda do |*argv|
+          recorder << argv.map(&:to_s)
+          [ "", "", ok_status ]
+        end,
+        mutate: ->(cmd) { cmd.define_singleton_method(:binary_delegation_command) do
