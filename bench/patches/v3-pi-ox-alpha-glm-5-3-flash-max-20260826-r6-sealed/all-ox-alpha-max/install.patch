+
+  def test_interactive_project_removal_opt_in_deletes_scaffold_not_state
+    with_uninstall_sandbox do |dir|
+      project_path = register_project_fixture(dir)
+
+      run_uninstall(input_text: "remove\nN\n") # project remove, global keep
+
+      refute File.exist?(File.join(project_path, ".hive")), "opted-in scaffold deleted"
+      registry = Hive::Config.registered_projects
+      refute(registry.any? { |p| p["name"] == "proj" }, "registry row dropped")
+      assert File.directory?(Hive::Paths.config_dir), "global config untouched"
