+    path = File.join(Hive::Paths.config_home, "config.yml")
+    data = YAML.safe_load(File.read(path)) || {}
+    data["web"] ||= {}
+    data["web"]["github"] ||= {}
+    data["web"]["github"]["owner"] = login
+    File.write(path, YAML.dump(data))
+  end
