+
+    assert Hive::ClaudeLauncher.claude_ready_prompt?(pane),
+           "the prior ready shape (line-end caret after cwd/git context) must still read as ready"
+  end
+
+  def test_claude_ready_prompt_rejects_permission_prompt_fixture
+    pane = pane_fixture("permission_prompt_live.txt")
+
+    assert_match(Hive::ClaudeLauncher::CLAUDE_PERMISSION_PROMPT_MARKER, pane)
