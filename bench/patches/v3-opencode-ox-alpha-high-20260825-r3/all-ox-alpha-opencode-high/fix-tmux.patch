diff --git a/test/integration/built_gem_contents_test.rb b/test/integration/built_gem_contents_test.rb
new file mode 100644
index 000000000..ac01b2da3
--- /dev/null
+++ b/test/integration/built_gem_contents_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+require "rubygems/package"
+require "securerandom"
+require "zlib"
+require "stringio"
+
+# Built-gem packaging guard (release gate, R2/AE2). Builds the REAL `.gem`
+# artifact from the checked-out gemspec and asserts every runtime shell
+# script referenced under lib/hive actually ships inside its data payload.
+#
+# This catches the defect class where the source tree looks healthy and
+# every unit test passes, yet a clean `gem install` omits a script: the
+# tmux Claude launcher execs `bash <gem>/lib/hive/scripts/
+# interactive_claude_wrapper.sh`, so a missing script exits instantly and
+# kills every tmux-mode launch (the 0.3.1/0.3.2 packaging defect). The
+# lighter unit-level spec.files assertions live in test/unit/gemspec_test.rb;
+# this guard inspects the actually built archive.
+class BuiltGemContentsTest < Minitest::Test
+  ROOT = File.expand_path("../..", __dir__)
+  GEMSPEC_PATH = File.join(ROOT, "hive.gemspec")
+  # Script refs are written as File.expand_path("scripts/<name>.sh", __dir__)
+  # inside lib/hive/*.rb; enumerate them from source so future additions are
+  # covered automatically instead of hardcoding today's wrapper.
+  SCRIPT_REF_RE = /["']scripts\/([A-Za-z0-9_.-]+\.sh)["']/
+
+  def test_built_gem_contains_every_referenced_hive_script
+    entries = built_gem_data_entries
+
+    referenced_scripts.each do |script|
+      path = "data/lib/hive/scripts/#{script}"
+      assert_includes entries, path,
+                      "the built gem must contain #{path}; add #{SCRIPTS_GLOB} coverage for " \
+                      "lib/hive/scripts/#{script} to hive.gemspec"
+    end
+  end
+
+  # Negative control: rebuild with the scripts glob removed (simulating the
+  # pre-fix gemspec) and prove the packaged scripts disappear — i.e. the
+  # acceptance assertion above can actually fail rather than pass vacuously.
+  def test_guard_detects_missing_scripts_when_glob_is_dropped
+    entries = built_gem_data_entries(exclude_globs: [ "lib/hive/scripts/**/*.sh" ])
+
+    assert_empty entries.grep(%r{\Adata/lib/hive/scripts/}),
+                 "negative control failed: dropping the scripts glob must empty the packaged scripts"
+    refute_includes entries, "data/lib/hive/scripts/interactive_claude_wrapper.sh"
+  end
+
+  private
+
+  SCRIPTS_GLOB = "lib/hive/scripts/**/*.sh"
+
+  def referenced_scripts
+    refs = Dir[File.join(ROOT, "lib/hive/**/*.rb")].flat_map do |file|
+      File.read(file).scan(SCRIPT_REF_RE).map { |(name)| name }
+    end.uniq.sort
+
+    refute_empty refs,
+                 "expected at least one scripts/*.sh reference under lib/hive; " \
+                 "if the launcher stopped using scripts, retire this guard deliberately"
+    refs
+  end
+
+  def built_gem_data_entries(exclude_globs: [])
+    spec = Gem::Specification.load(GEMSPEC_PATH)
+    exclude_globs.each do |glob|
+      excluded = Dir[File.join(ROOT, glob)].map { |path| path.delete_prefix("#{ROOT}/") }
+      spec.files -= excluded
+    end
+
+    # Build from the repo root so the gemspec's Dir[...] globs resolve;
+    # target the tmpdir explicitly (falling back to the cwd default for
+    # older RubyGems without the gem_path argument). `*.gem` is gitignored
+    # and removed below either way, so the worktree stays clean.
+    artifact =
+      begin
+        Gem::Package.build(spec, false, true,
+                           File.join(Dir.tmpdir, "hive-gem-guard-#{Process.pid}-#{SecureRandom.hex(4)}.gem"))
+      rescue ArgumentError
+        Gem::Package.build(spec)
+      end
+
+    begin
+      gem_data_entries(artifact)
+    ensure
+      FileUtils.rm_f(artifact)
+    end
+  rescue Errno::ENOENT, Gem::Exception => e
+    skip "cannot build the gem artifact in this environment: #{e.class}: #{e.message}"
+  end
+
+  def gem_data_entries(gem_path)
+    File.open(gem_path, "rb") do |outer|
+      Gem::Package::TarReader.new(outer) do |tar|
+        data_entry = nil
+        tar.each { |entry| data_entry = entry if entry.name == "data.tar.gz" }
+        flunk "built gem is missing data.tar.gz" unless data_entry
+
+        Zlib::GzipReader.wrap(StringIO.new(data_entry.read)) do |gz|
+          names = []
+          Gem::Package::TarReader.new(gz) { |inner| inner.each { |entry| names << entry.name } }
+          names
+        end
+      end
+    end
+  end
+end
