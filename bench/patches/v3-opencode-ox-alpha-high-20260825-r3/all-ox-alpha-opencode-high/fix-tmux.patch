+
+  def test_claude_ready_prompt_rejects_trust_prompt_fixture
+    pane = pane_fixture("trust_prompt_live.txt")
+
+    assert Hive::ClaudeLauncher.claude_trust_prompt?(pane),
+           "the trust fixture must be classified as a trust prompt"
+    refute Hive::ClaudeLauncher.claude_ready_prompt?(pane)
+  end
+
+  def test_claude_ready_prompt_rejects_menu_selection_fixture
+    refute Hive::ClaudeLauncher.claude_ready_prompt?(pane_fixture("menu_selection_live.txt"))
+  end
+
+  # Whitespace variants of the bare caret: ASCII space (older builds), NBSP
+  # (2.1.179), and narrow no-break space (U+202F, some TUI font stacks).
+  # Ruby's `\s` only matches the first — the detector must accept all three.
+  def test_claude_ready_prompt_accepts_caret_with_ascii_space
+    pane = "Claude Code v2.1.170\n❯ "
+
+    assert Hive::ClaudeLauncher.claude_ready_prompt?(pane)
+  end
+
+  def test_claude_ready_prompt_accepts_caret_with_non_breaking_space
+    pane = "Claude Code v2.1.179\n❯\u00A0"
+
+    assert Hive::ClaudeLauncher.claude_ready_prompt?(pane)
+  end
+
+  def test_claude_ready_prompt_accepts_caret_with_narrow_no_break_space
+    pane = "Claude Code v2.1.179\n❯\u202F"
+
+    assert Hive::ClaudeLauncher.claude_ready_prompt?(pane)
+  end
+
+  # Footer-distance independence: the caret may sit several non-blank lines
+  # above the true pane bottom when newer builds render multi-line border /
+  # status stacks beneath it. A window deep enough to cover that must accept
+  # the caret without pinning any particular footer offset.
+  def test_claude_ready_prompt_accepts_caret_deeper_than_two_line_tail_window
+    pane = [
+      "▐▛███▜▌   Claude Code v2.1.179",
+      "",
+      "~/dev/hive  main*  ❯\u00A0",
+      "─" * 46,
+      "? for shortcuts",
+      "⏵⏵ bypass permissions on (shift+tab to cycle)",
+      "· ← for agents"
+    ].join("\n")
+
+    assert Hive::ClaudeLauncher.claude_ready_prompt?(pane),
+           "the caret inside the widened tail window reads as ready regardless of footer distance"
+  end
+
+  # A stale numbered-menu remnant higher in the window does not block a
+  # valid live caret below it: menu carets are excluded structurally, so
+  # the live caret still reads as ready.
+  def test_claude_ready_prompt_accepts_valid_caret_with_stale_menu_scrollback
+    pane = "Claude Code v2.1.179\nSelect a theme?\n❯ 1. Dark mode\n\n" \
+           "Claude Code v2.1.179\n~/dev/hive  main*  ❯\u00A0"
+
+    assert Hive::ClaudeLauncher.claude_ready_prompt?(pane),
+           "a stale menu remnant plus a live bare caret is ready, not a blocking selection"
+  end
+
