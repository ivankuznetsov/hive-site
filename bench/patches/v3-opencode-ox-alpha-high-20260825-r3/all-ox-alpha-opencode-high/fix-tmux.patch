+    refute_empty scripts,
+                 "#{SCRIPTS_GLOB} must match real files; an empty glob silently packages nothing"
+
+    scripts.each do |absolute|
+      relative = absolute.delete_prefix("#{ROOT}/")
+      assert File.file?(absolute), "#{relative} should exist on disk"
+    end
+  end
+
