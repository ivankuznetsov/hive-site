+require "test_helper"
+require "json"
+
+module Packaging
+  # U7 + U8 — prompt installer and separate skills-package artifacts.
+  class PromptAndSkillsTest < Minitest::Test
+    ROOT = File.expand_path("../../..", __dir__).freeze
+    INSTALL_MD = File.join(ROOT, "install.md").freeze
+    MARKETPLACE = File.join(ROOT, "packaging/skills/.claude-plugin/marketplace.json").freeze
+
+    def test_install_md_covers_all_five_phases_and_channels
+      raw = File.read(INSTALL_MD)
+      %w[
+        Phase\ 1\ —\ Detect\ environment
+        Phase\ 2\ —\ Choose\ the\ channel
+        Phase\ 3\ —\ Verify
+        Phase\ 4\ —\ Initialize
+        Phase\ 5\ —\ Skills
+      ].each { |phase| assert_includes raw, phase }
+
+      # Channel priority and verification contract (R6/R13).
+      assert_includes raw, "brew install ivankuznetsov/hive/hive"
+      assert_includes raw, "-S hive-bin"
+      assert_match(%r{releases/latest/download/install\.sh \| bash}, raw)
+      assert_includes raw, "--version"
+    end
+
+    def test_install_md_is_defensive_about_conflicts_and_dependencies
+      raw = File.read(INSTALL_MD)
+      assert_match(/Apache Hive|fallback name `hv`/, raw)
+      assert_includes raw, "Do NOT install them yourself"
+      assert_includes raw, "STOP"
+    end
+
+    def test_skills_marketplace_manifest_is_valid_json
+      manifest = JSON.parse(File.read(MARKETPLACE))
+      assert_equal "hive-skills", manifest.fetch("name")
+      plugin = manifest.fetch("plugins").first
+      assert_equal "hive", plugin.fetch("name")
+    end
+
+    def test_skills_distribution_is_documented_as_marketplace_only
+      readme = File.read(File.join(ROOT, "packaging/skills/README.md"))
+      assert_match(/marketplace/i, readme)
+      assert_match(/zero skill-writing logic/, readme)
+      assert_match(/leaves them untouched/, readme)
+    end
+
+    def test_readme_links_the_prompt_installer_and_channels
+      readme = File.read(File.join(ROOT, "README.md"))
+      assert_includes readme, "install.md"
+      assert_includes readme, "brew install ivankuznetsov/hive/hive"
+      assert_includes readme, "yay -S hive-bin"
+      assert_includes readme, "hive update"
+      assert_includes readme, "hive uninstall"
+    end
+
+    def test_core_binary_contains_no_skill_writing_logic
+      # R7: installers/init must not write agent skill files. Scan the CLI
+      # command surface for writes into agent config dirs.
+      forbidden = %r{\.claude/(commands|skills)|\.codex/skills|\.pi/agent/skills}
+      Dir[File.join(ROOT, "lib/hive/commands/*.rb"), File.join(ROOT, "lib/hive/service/**/*.rb")].each do |file|
+        refute_match(forbidden, File.read(file)),
+          "#{file} must never write into an agent's skill directories"
+      end
+    end
+  end
+end
diff --git a/test/unit/packaging/release_pipeline_test.rb b/test/unit/packaging/release_pipeline_test.rb
new file mode 100644
index 000000000..e15486b45
--- /dev/null
+++ b/test/unit/packaging/release_pipeline_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+require "open3"
+require "yaml"
+require "digest"
+
+module Packaging
+  # U1 — release pipeline sanity checks. These are hermetic: they exercise
+  # the shell scripts' syntax and the pure-logic parts (checksum generation)
+  # without invoking Tebako or any network.
+  class ReleasePipelineTest < Minitest::Test
+    ROOT = File.expand_path("../../..", __dir__).freeze
+
+    def test_build_script_passes_bash_syntax_check
+      assert_sh_parses(File.join(ROOT, "packaging", "build.sh"))
+    end
+
+    def test_checksums_script_passes_bash_syntax_check
+      assert_sh_parses(File.join(ROOT, "packaging", "checksums.sh"))
+    end
+
+    def test_tebako_config_is_valid_yaml_with_entrypoint
+      path = File.join(ROOT, "packaging", "tebako.yml")
+      cfg = YAML.safe_load(File.read(path), permitted_classes: [], aliases: false)
+      assert_instance_of Hash, cfg
+      entry = cfg.dig("entries", "package", "entry")
+      assert_equal "bin/hive", entry
+    end
+
+    def test_checksums_script_generates_manifest_over_fixture_artifacts
+      Dir.mktmpdir do |dir|
+        art = File.join(dir, "dist")
+        Dir.mkdir(art)
+        content = "#!/bin/sh\necho fake-hive-binary\n"
+        File.write(File.join(art, "hive-linux-x86_64"), content)
+        expected_digest = Digest::SHA256.hexdigest(content)
+
+        out, err, status = Open3.capture3("bash", File.join(ROOT, "packaging", "checksums.sh"), art)
+
+        assert status.success?, "checksums.sh failed: #{err}"
+        sums_path = File.join(art, "SHA256SUMS")
+        assert File.file?(sums_path), "SHA256SUMS not written"
+        line = File.read(sums_path).chomp
+        assert_includes line, "hive-linux-x86_64"
+        assert_includes line, expected_digest
+        assert_includes out, expected_digest
+      end
+    end
+
+    def test_checksums_script_fails_on_empty_dir
+      Dir.mktmpdir do |dir|
+        art = File.join(dir, "empty-dist")
+        Dir.mkdir(art)
+        _, err, status = Open3.capture3("bash", File.join(ROOT, "packaging", "checksums.sh"), art)
+        refute status.success?, "expected nonzero exit for a directory without artifacts"
+        assert_match(/no hive-\* artifacts/, err)
+      end
+    end
+
+    def test_release_workflow_references_pipeline_scripts_and_matrix
+      workflow = YAML.safe_load(
+        File.read(File.join(ROOT, ".github", "workflows", "release.yml")),
+        permitted_classes: [],
+        aliases: true
+      )
+      raw = File.read(File.join(ROOT, ".github", "workflows", "release.yml"))
+
+      # NOTE: YAML 1.1 parses the bare `on:` key as boolean true.
+      assert_equal ["v*"], (workflow["on"] || workflow[true])["push"]["tags"]
+      assert_includes raw, "packaging/build.sh"
+      assert_includes raw, "packaging/checksums.sh"
+      assert_includes raw, "macos-14"
+      assert_includes raw, "ubuntu-22.04"
+      # Smoke gate: the built artifact must report --version before upload.
+      assert_includes raw, "--version"
+    end
+
+    private
+
+    def assert_sh_parses(path)
+      _out, err, status = Open3.capture3("bash", "-n", path)
+      assert status.success?, "#{path} failed bash -n: #{err}"
+    end
+  end
+end
diff --git a/test/unit/service/service_test.rb b/test/unit/service/service_test.rb
new file mode 100644
index 000000000..db5d1ba1e
--- /dev/null
+++ b/test/unit/service/service_test.rb
@@ -0,0 +1,216 @@
+require "test_helper"
+require "hive/service"
+require "hive/service/launchd"
+require "hive/service/systemd_user"
+
+class ServiceTest < Minitest::Test
+  PLIST_TEMPLATE = File.expand_path("../../packaging/service/com.hive.daemon.plist.erb", __dir__).freeze
+  UNIT_TEMPLATE = File.expand_path("../../packaging/service/hive.service.erb", __dir__).freeze
+
+  def recorder_runner(log)
+    lambda do |*argv|
+      log << argv
+      true
+    end
+  end
+
+  def test_factory_picks_launchd_on_darwin_and_systemd_elsewhere
+    Dir.mktmpdir do |tmp|
+      env = { "XDG_STATE_HOME" => tmp, "XDG_CONFIG_HOME" => tmp }
+      launchd = Hive::Service.for_platform(host_os: "darwin24", env: env)
+      assert_instance_of Hive::Service::Launchd, launchd
+
+      systemd = Hive::Service.for_platform(host_os: "linux", env: env)
+      assert_instance_of Hive::Service::SystemdUser, systemd
+    end
+  end
+
+  # --- Launchd ---------------------------------------------------------------
+
+  def test_launchd_render_contains_label_binary_and_log_paths
+    Dir.mktmpdir do |tmp|
+      svc = Hive::Service::Launchd.new(
+        home: tmp, binary_path: "/opt/hive/hive", uid: 501,
+        template_path: PLIST_TEMPLATE,
+        env: { "XDG_STATE_HOME" => File.join(tmp, "state") }
+      )
+      plist = svc.render
+
+      assert_includes plist, "<string>com.hive.daemon</string>"
+      assert_includes plist, "<string>/opt/hive/hive</string>"
+      assert_includes plist, "<string>daemon</string>"
+      assert_includes plist, "<string>start</string>"
+      assert_match(%r{<string>#{Regexp.escape(tmp)}/state/hive/logs/daemon\.err\.log</string>}, plist)
+    end
+  end
+
+  def test_launchd_register_bootstraps_and_opt_in_starts
+    Dir.mktmpdir do |tmp|
+      log = []
+      svc = Hive::Service::Launchd.new(
+        home: tmp, binary_path: "/opt/hive/hive", uid: 501,
+        template_path: PLIST_TEMPLATE, runner: recorder_runner(log),
+        env: { "XDG_STATE_HOME" => File.join(tmp, "state") }
+      )
+
+      refute svc.installed?
+      svc.register!(start_now: false)
+
+      assert svc.installed?
+      assert File.directory?(svc.log_dir), "log dir must be created for StandardOutPath"
+      assert_equal ["launchctl", "bootstrap", "gui/501", svc.registration_path], log.first
+
+      log.clear
+      svc.unregister!
+      assert_equal ["launchctl", "bootout", "gui/501/com.hive.daemon"], log.first
+      refute svc.installed?
+    end
+  end
+
+  def test_launchd_register_with_start_now_kickstarts
+    Dir.mktmpdir do |tmp|
+      log = []
+      svc = Hive::Service::Launchd.new(
+        home: tmp, binary_path: "/opt/hive/hive", uid: 501,
+        template_path: PLIST_TEMPLATE, runner: recorder_runner(log),
+        env: { "XDG_STATE_HOME" => File.join(tmp, "state") }
+      )
+
+      svc.register!(start_now: true)
+      assert_equal ["launchctl", "kickstart", "-k", "gui/501/com.hive.daemon"], log.last
+    end
+  end
+
+  def test_launchd_failed_command_raises_service_error
+    Dir.mktmpdir do |tmp|
+      svc = Hive::Service::Launchd.new(
+        home: tmp, binary_path: "/x", uid: 0,
+        template_path: PLIST_TEMPLATE, runner: ->(*) { false },
+        env: { "XDG_STATE_HOME" => File.join(tmp, "state") }
+      )
+      assert_raises(Hive::Service::Error) { svc.register!(start_now: false) }
+    end
+  end
+
+  def test_launchd_running_reflects_command_result
+    Dir.mktmpdir do |tmp|
+      svc = Hive::Service::Launchd.new(
+        home: tmp, binary_path: "/x", uid: 501,
+        template_path: PLIST_TEMPLATE, runner: ->(*) { true },
+        env: { "XDG_STATE_HOME" => File.join(tmp, "state") }
+      )
+      assert svc.running?
+    end
+  end
+
+  # --- SystemdUser -----------------------------------------------------------
+
+  def sandbox_env(tmp)
+    {
+      "XDG_CONFIG_HOME" => File.join(tmp, "config"),
+      "XDG_STATE_HOME" => File.join(tmp, "state"),
+      "HIVE_BIN_DIR" => File.join(tmp, "bin")
+    }
+  end
+
+  def test_systemd_render_and_unit_path_honor_xdg
+    Dir.mktmpdir do |tmp|
+      env = sandbox_env(tmp)
+      svc = Hive::Service::SystemdUser.new(
+        home: tmp, binary_path: "/usr/bin/hive",
+        template_path: UNIT_TEMPLATE, env: env
+      )
+
+      expected_unit = File.join(tmp, "config/systemd/user/hive.service")
+      assert_equal expected_unit, svc.registration_path
+      unit = svc.render
+      assert_includes unit, "ExecStart=/usr/bin/hive daemon start"
+      assert_includes unit, "WantedBy=default.target"
+    end
+  end
+
+  def test_systemd_register_writes_unit_and_enables_only_on_opt_in
+    Dir.mktmpdir do |tmp|
+      log = []
+      env = sandbox_env(tmp).merge("PATH" => "")
+      svc = Hive::Service::SystemdUser.new(
+        home: tmp, binary_path: "/usr/bin/hive",
+        template_path: UNIT_TEMPLATE, runner: recorder_runner(log),
+        env: env, proc_version_path: File.join(tmp, "no-proc-version")
+      )
+
+      # Declined autostart → unit written + reload, but no enable.
+      svc.register!(start_now: false)
+      assert svc.installed?
+      assert_equal ["systemctl", "--user", "daemon-reload"], log.first
+      refute_includes log.flatten.join(" "), "enable"
+
+      # Opt-in → enable --now.
+      log.clear
+      svc.register!(start_now: true)
+      assert_includes log, ["systemctl", "--user", "enable", "--now", "hive.service"]
+    end
+  end
+
+  def test_systemd_unregister_disables_removes_unit_and_reloads
+    Dir.mktmpdir do |tmp|
+      log = []
+      env = sandbox_env(tmp)
+      svc = Hive::Service::SystemdUser.new(
+        home: tmp, template_path: UNIT_TEMPLATE,
+        runner: recorder_runner(log), env: env,
+        proc_version_path: File.join(tmp, "no-proc-version")
+      )
+      FileUtils.mkdir_p(File.dirname(svc.registration_path))
+      File.write(svc.registration_path, "[Unit]\n")
+
+      svc.unregister!
+
+      refute svc.installed?
+      assert_includes log.flatten.join(" "), "disable"
+      assert_includes log, ["systemctl", "--user", "daemon-reload"]
+    end
+  end
+
+  def test_wsl2_without_systemd_degrades_to_actionable_error
+    Dir.mktmpdir do |tmp|
+      proc_version = File.join(tmp, "proc-version")
+      File.write(proc_version, "Linux version 5.15.167.4-microsoft-standard-WSL2")
+
+      svc = Hive::Service::SystemdUser.new(
+        home: tmp, template_path: UNIT_TEMPLATE,
+        runner: ->(*) { false }, env: sandbox_env(tmp),
+        proc_version_path: proc_version,
+        systemd_available: false
+      )
+
+      assert svc.wsl2?
+      error = assert_raises(Hive::Service::Error) { svc.register!(start_now: true) }
+      assert_match(/hive daemon start --detach/, error.message)
+      assert_match(/wsl\.conf/, error.message)
+      refute svc.installed?, "nothing may be written when registration is unsupported"
+    end
+  end
+
+  def test_non_wsl_linux_registers_normally
+    Dir.mktmpdir do |tmp|
+      proc_version = File.join(tmp, "proc-version")
+      File.write(proc_version, "Linux version 6.8.0-arch1 (gcc)")
+
+      log = []
+      svc = Hive::Service::SystemdUser.new(
+        home: tmp, template_path: UNIT_TEMPLATE,
+        runner: recorder_runner(log), env: sandbox_env(tmp),
+        proc_version_path: proc_version
+      )
+
+      svc.register!(start_now: true)
+      assert svc.installed?
+    end
+  end
+
+  def test_service_templates_exist_next_to_runtime_code
+    assert File.file?(PLIST_TEMPLATE)
+    assert File.file?(UNIT_TEMPLATE)
+  end
+end
