--- /dev/null
+++ b/packaging/skills/README.md
@@ -0,0 +1,37 @@
+# hive-skills — agent skills package (distribution contract)
+
+Hive's agent-facing skills ship **separately** from the core `hive` binary and
+are installed ONLY through each coding agent's native marketplace/plugin flow
+(plan U8 / R7). The core binary and `hive init` contain zero skill-writing
+logic; nothing here is ever copied into `~/.claude/commands/` or equivalent
+paths by an installer.
+
+## Layout
+
+This directory is the extraction source for the separate
+`<org>/hive-skills` repository:
+
+```
+hive-skills/
+├── .claude-plugin/
+│   └── marketplace.json     # mirrored from packaging/skills/.claude-plugin/
+├── skills/
+│   └── hive/
+│       ├── SKILL.md         # extracted at v0.1.0 parity with the core binary
+│       └── commands/
+└── README.md                # per-agent install instructions
+```
+
+## Per-agent install paths
+
+| Agent | Mechanism | Status |
+|---|---|---|
+| Claude Code | `/plugin marketplace add <org>/hive-skills`, then install the `hive` plugin | Day-one supported |
+| Pi / Codex | Native marketplace formats still stabilizing — README in the skills repo documents the manual path until a real mechanism exists (per A23) | Manual for now |
+
+## Versioning
+
+The skills package versions independently of the core binary; the skills repo
+README documents the compatibility range per release. Uninstalling skills
+happens through each agent's own plugin management — `hive uninstall`
+deliberately leaves them untouched.
diff --git a/packaging/tap-bump.sh b/packaging/tap-bump.sh
new file mode 100644
index 000000000..b86ccd46b
--- /dev/null
+++ b/packaging/tap-bump.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+#
+# Substitute a released version and its artifact checksums into a copy of the
+# homebrew formula template. Run by .github/workflows/tap-bump.yml on every
+# published release; also runnable locally:
+#
+#   packaging/tap-bump.sh <formula-in> <formula-out> <version> \
+#     <macos-arm64.sha256> <linux-x86_64.sha256>
+set -euo pipefail
+
+[ $# -eq 5 ] || { echo "usage: $0 <in> <out> <version> <macos-sha> <linux-sha>" >&2; exit 64; }
+
+in="$1"; out="$2"; ver="$3"; mac_sha="$4"; lin_sha="$5"
+
+for sha in "$mac_sha" "$lin_sha"; do
+  [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || { echo "not a sha256: $sha" >&2; exit 64; }
+done
+[[ "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "not a semver: $ver" >&2; exit 64; }
+
+sed -E \
+  -e "s/^  version \"[^\"]+\"/  version \"${ver}\"/" \
+  -e "s/^  MACOS_ARM64_SHA256 = \"[0-9a-f]{64}\"/  MACOS_ARM64_SHA256 = \"${mac_sha}\"/" \
+  -e "s/^  LINUX_X86_64_SHA256 = \"[0-9a-f]{64}\"/  LINUX_X86_64_SHA256 = \"${lin_sha}\"/" \
+  "$in" > "$out"
+
+echo "tap-bump: wrote $out (v$ver)"
diff --git a/packaging/tebako.yml b/packaging/tebako.yml
new file mode 100644
index 000000000..f85b5f3a6
--- /dev/null
+++ b/packaging/tebako.yml
@@ -0,0 +1,26 @@
+# Tebako packaging configuration for the vendored-Ruby `hive` binary.
+#
+# Tebako packs the app tree plus an embedded Ruby runtime into a single-file
+# binary backed by DwarFS. `bin/hive` stays the entrypoint so the packaged
+# artifact behaves exactly like the repo checkout (`hive --version`, subcommand
+# dispatch through Hive::CLI).
+#
+# Build invocation lives in packaging/build.sh; release automation runs it on
+# macos-14 (arm64) and ubuntu-22.04 runners via .github/workflows/release.yml.
+---
+entries:
+  package:
+    root: .
+    entry: bin/hive
+    ruby_version: "3.4"
+
+# The whole source tree is mounted into the DwarFS filesystem, including
+# lib/, templates/, schemas/ and packaging/service/*.erb — runtime code reads
+# templates via paths relative to __dir__, which resolve inside the package.
+filesystem:
+  include:
+    - bin/
+    - lib/
+    - templates/
+    - schemas/
+    - packaging/service/
diff --git a/test/unit/commands/init_service_test.rb b/test/unit/commands/init_service_test.rb
new file mode 100644
index 000000000..d9727ceeb
--- /dev/null
+++ b/test/unit/commands/init_service_test.rb
@@ -0,0 +1,163 @@
+require "test_helper"
+require "hive/commands/init"
+
+# U6/R12 integration: `hive init` offers OS daemon-service registration
+# (launchd agent / systemd --user unit) with an explicit opt-in. These tests
+# exercise Init's registration step directly (with a fake service factory)
+# so the full git pipeline is not needed per case.
+class InitServiceRegistrationTest < Minitest::Test
+  class FakeService
+    attr_reader :register_calls
+
+    def initialize(installed: false)
+      @installed = installed
+      @register_calls = []
+    end
+
+    def installed? = @installed
+    def registration_path = "/fake/com.hive.daemon.plist"
+
+    def register!(start_now:)
+      @register_calls << start_now
+      true
+    end
+  end
+
+  def build_init(start_daemon:, factory_result:, prompts: nil, env: {})
+    Hive::Commands::Init.new(
+      "/tmp/not-a-real-project",
+      force: true,
+      prompts: prompts,
+      start_daemon: start_daemon,
+      env: env,
+      service_factory: -> { factory_result }
+    )
+  end
+
+  def test_explicit_opt_in_registers_and_starts
+    Dir.mktmpdir do |tmp|
+      $stdin = StringIO.new
+      service = FakeService.new
+      init = build_init(start_daemon: true, factory_result: service, env: { "HOME" => tmp })
+
+      capture_io do
+        init.send(:register_daemon_service!)
+      end
+
+      assert_equal [true], service.register_calls
+    end
+  ensure
+    restore_stdin
+  end
+
+  def test_explicit_decline_never_touches_the_service_factory
+    Dir.mktmpdir do |tmp|
+      $stdin = StringIO.new
+      factory_called = false
+      service = FakeService.new
+      init = Hive::Commands::Init.new(
+        "/tmp/not-a-real-project",
+        force: true,
+        start_daemon: false,
+        env: { "HOME" => tmp },
+        service_factory: lambda {
+          factory_called = true
+          service
+        }
+      )
+
+      capture_io { init.send(:register_daemon_service!) }
+
+      refute factory_called
+      assert_empty service.register_calls
+    end
+  ensure
+    restore_stdin
+  end
+
+  def test_non_tty_without_flag_defaults_to_skip
+    Dir.mktmpdir do |tmp|
+      # test_helper already replaces $stdin with a non-tty StringIO.
+      service = FakeService.new
+      init = build_init(start_daemon: nil, factory_result: service, env: { "HOME" => tmp })
+
+      _out, err = capture_io do
+        init.send(:register_daemon_service!)
+      end
+
+      assert_empty service.register_calls
+      assert_match(/registration skipped|skipped/, err) if err && !err.empty?
+    end
+  end
+
+  def test_env_override_hive_init_daemon_yes_forces_registration
+    init = Hive::Commands::Init.new("/tmp/x", start_daemon: nil, env: { "HIVE_INIT_DAEMON" => "yes" })
+    assert_equal :start, init.send(:service_choice)
+
+    no_init = Hive::Commands::Init.new("/tmp/x", start_daemon: nil, env: { "HIVE_INIT_DAEMON" => "no" })
+    assert_equal :skip, no_init.send(:service_choice)
+  end
+
+  def test_tty_prompt_defaults_to_no_on_blank_answer
+    Dir.mktmpdir do |tmp|
+      tty_input = StringIO.new("\n")
+      def tty_input.tty? = true
+      $stdin = tty_input
+
+      service = FakeService.new
+      prompts = Hive::Commands::Init::Prompts.new(
+        input: tty_input, output: StringIO.new, summary_io: StringIO.new
+      )
+      init = build_init(start_daemon: nil, factory_result: service, prompts: prompts,
+                        env: { "HIVE_INIT_DAEMON" => "" })
+
+      _out, _err = capture_io { init.send(:register_daemon_service!) }
+      assert_empty service.register_calls, "blank answer at the prompt must not enable autostart"
+    end
+  ensure
+    restore_stdin
+  end
+
+  def test_already_registered_service_is_left_in_place
+    Dir.mktmpdir do |tmp|
+      $stdin = StringIO.new
+      service = FakeService.new(installed: true)
+      init = build_init(start_daemon: true, factory_result: service, env: { "HOME" => tmp })
+
+      _out, err = capture_io { init.send(:register_daemon_service!) }
+
+      assert_empty service.register_calls
+      assert_match(/already registered/, err)
+    end
+  ensure
+    restore_stdin
+  end
+
+  def test_registration_failure_degrades_to_warning_not_crash
+    Dir.mktmpdir do |tmp|
+      $stdin = StringIO.new
+      failing = Object.new
+      failing.define_singleton_method(:installed?) { false }
+      failing.define_singleton_method(:registration_path) { "/x" }
+      failing.define_singleton_method(:register!) { |**| raise "launchctl missing" }
+
+      init = build_init(start_daemon: true, factory_result: failing, env: { "HOME" => tmp })
+
+      _out, err = capture_io { init.send(:register_daemon_service!) }
+
+      assert_match(/registration skipped/, err)
+      assert_match(/hive daemon start --detach/, err)
+    end
+  ensure
+    restore_stdin
+  end
+
+  private
+
+  def restore_stdin
+    # test_helper's isolation hook restores the real stdin in after_teardown;
+    # here we just make sure we leave a non-tty StringIO in place for other
+    # assertions inside this test class.
+    $stdin = StringIO.new unless $stdin.respond_to?(:tty?) && !$stdin.tty?
+  end
+end
diff --git a/test/unit/commands/uninstall_test.rb b/test/unit/commands/uninstall_test.rb
new file mode 100644
index 000000000..e01b6babe
--- /dev/null
+++ b/test/unit/commands/uninstall_test.rb
@@ -0,0 +1,224 @@
+require "test_helper"
+require "hive/commands/uninstall"
+
+class UninstallCommandTest < Minitest::Test
+  class FakeService
+    attr_reader :unregister_calls
+
+    def initialize
+      @unregister_calls = 0
+    end
+
+    def installed? = true
+    def registration_path = "/fake/hive.service"
+    def unregister!
+      @unregister_calls += 1
+      true
+    end
+  end
+
+  def sandbox_env(tmp)
+    {
+      "XDG_CONFIG_HOME" => File.join(tmp, "config"),
+      "XDG_STATE_HOME" => File.join(tmp, "state"),
+      "XDG_CACHE_HOME" => File.join(tmp, "cache"),
+      "HIVE_BIN_DIR" => File.join(tmp, "bin"),
+      # Hermetic name-conflict resolution: an empty PATH means no foreign
+      # `hive` binary can leak in from the host running the tests.
+      "PATH" => ""
+    }
+  end
+
+  def make_command(purge: false, yes: false, project_root:, env:, service:,
+                   projects: [], prompter: ->(_q) { false })
+    Hive::Commands::Uninstall.new(
+      purge: purge,
+      yes: yes,
+      project_root: project_root,
+      env: env,
+      projects_provider: -> { projects },
+      prompter: prompter,
+      service_factory: -> { service },
+      out: StringIO.new,
+      err: StringIO.new
+    )
+  end
+
+  def test_deregisters_service_and_clears_channel_marker
+    Dir.mktmpdir do |tmp|
+      env = sandbox_env(tmp)
+      Hive::InstallLayout.write_channel("script", env)
+      service = FakeService.new
+
+      make_command(project_root: tmp, env: env, service: service).call
+
+      assert_equal 1, service.unregister_calls
+      assert_nil Hive::InstallLayout.read_channel(env)
+    end
+  end
+
+  def test_non_interactive_run_keeps_project_scaffolds
+    Dir.mktmpdir do |tmp|
+      env = sandbox_env(tmp)
+      scaffold = File.join(tmp, ".hive-state")
+      FileUtils.mkdir_p(scaffold)
+      File.write(File.join(scaffold, "task.md"), "work")
+
+      summary = make_command(
+        project_root: tmp, env: env, service: FakeService.new,
+        projects: [{ "name" => "demo", "path" => tmp, "hive_state_path" => scaffold }]
+      ).call
+
+      assert File.directory?(scaffold), "scaffold must be preserved without consent"
+      assert_includes summary[:kept_projects], scaffold
+      assert_empty summary[:removed_projects]
+    end
+  end
+
+  def test_prompted_yes_removes_scaffold_but_never_state_dir
+    Dir.mktmpdir do |tmp|
+      env = sandbox_env(tmp)
+      scaffold = File.join(tmp, ".hive-state")
+      FileUtils.mkdir_p(File.join(scaffold, "4-execute"))
+      FileUtils.mkdir_p(Hive::InstallLayout.state_dir(env))
+
+      questions = []
+      summary = make_command(
+        project_root: tmp, env: env, service: FakeService.new,
+        prompter: ->(q) { questions << q; true }
+      ).call
+
+      refute File.exist?(scaffold)
+      assert_empty summary[:kept_projects]
+      assert_equal 1, questions.size
+      assert_match(/Remove project scaffold/, questions.first)
+
+      # R14: ~/.local/state/hive is NEVER deleted.
+      assert File.directory?(Hive::InstallLayout.state_dir(env))
+    end
+  end
+
+  def test_registered_projects_under_cwd_are_listed_individually
+    Dir.mktmpdir do |outer|
+      env = sandbox_env(outer)
+      sub_a = File.join(outer, "a")
+      sub_b = File.join(outer, "b")
+      outside = File.join(outer, "elsewhere")
+      [sub_a, sub_b, outside].each { |d| FileUtils.mkdir_p(File.join(d, ".hive-state")) }
+
+      projects = [
+        { "name" => "a", "path" => sub_a, "hive_state_path" => File.join(sub_a, ".hive-state") },
+        { "name" => "b", "path" => sub_b, "hive_state_path" => File.join(sub_b, ".hive-state") },
+        # Outside cwd → never offered for deletion from this run.
+        { "name" => "far", "path" => outside, "hive_state_path" => File.join(outside, ".hive-state") }
+      ]
+
+      answered = []
+      summary = make_command(
+        project_root: outer, env: env, service: FakeService.new,
+        projects: projects,
+        prompter: lambda { |q|
+          answered << q
+          q.include?("a/.hive-state")
+        }
+      ).call
+
+      assert_equal 2, answered.size, "only scaffolds under the cwd are offered"
+      refute File.exist?(File.join(sub_a, ".hive-state"))
+      assert File.exist?(File.join(sub_b, ".hive-state"))
+      assert File.exist?(File.join(outside, ".hive-state"))
+      assert_includes summary[:removed_projects], File.join(sub_a, ".hive-state")
+    end
+  end
+
+  def test_purge_removes_config_and_cache_but_not_state_or_data
+    Dir.mktmpdir do |tmp|
+      env = sandbox_env(tmp)
+      Hive::InstallLayout.write_channel("script", env)
+      FileUtils.mkdir_p(Hive::InstallLayout.data_dir(env))
+      File.write(File.join(Hive::InstallLayout.data_dir(env), "outputs.txt"), "done work")
+
+      make_command(purge: true, yes: false, project_root: tmp, env: env,
+                   service: FakeService.new).call
+
+      refute File.directory?(Hive::InstallLayout.config_dir(env))
+      refute File.directory?(Hive::InstallLayout.cache_dir(env))
+      # State and data (accumulated work) survive even --purge.
+      assert File.directory?(Hive::InstallLayout.state_dir(env))
+      assert_equal "done work",
+        File.read(File.join(Hive::InstallLayout.data_dir(env), "outputs.txt"))
+    end
+  end
+
+  def test_script_channel_removes_binary_and_hv_fallback
+    Dir.mktmpdir do |tmp|
+      env = sandbox_env(tmp)
+      Hive::InstallLayout.write_channel("script", env)
+      bin_dir = Hive::InstallLayout.bin_dir(env)
+      FileUtils.mkdir_p(bin_dir)
+      %w[hive hv].each { |n| FileUtils.touch(File.join(bin_dir, n)) }
+
+      summary = make_command(project_root: tmp, env: env, service: FakeService.new).call
+
+      refute File.exist?(File.join(bin_dir, "hive"))
+      refute File.exist?(File.join(bin_dir, "hv"))
+      assert_match(/removed/, summary[:binary_action])
+    end
+  end
+
+  def test_package_manager_channels_print_hint_instead_of_deleting
+    %w[brew aur].each do |channel|
+      Dir.mktmpdir do |tmp|
+        env = sandbox_env(tmp)
+        Hive::InstallLayout.write_channel(channel, env)
+        bin_dir = Hive::InstallLayout.bin_dir(env)
+        FileUtils.mkdir_p(bin_dir)
+        FileUtils.touch(File.join(bin_dir, "hive"))
+
+        out = StringIO.new
+        cmd = Hive::Commands::Uninstall.new(
+          project_root: tmp, env: env, service_factory: -> { FakeService.new },
+          out: out, err: StringIO.new
+        )
+        summary = cmd.call
+
+        assert File.exist?(File.join(bin_dir, "hive")), "#{channel}-owned binary must not be unlinked"
+        assert_match(/package-manager owned/, summary[:binary_action])
+      end
+    end
+  end
+
+  def test_skills_are_left_alone_with_reminder
+    Dir.mktmpdir do |tmp|
+      env = sandbox_env(tmp)
+      out = StringIO.new
+      Hive::Commands::Uninstall.new(
+        project_root: tmp, env: env, service_factory: -> { FakeService.new },
+        out: out, err: StringIO.new
+      ).call
+
+      assert_match(/marketplace/, out.string)
+      assert_match(/leaves them untouched/, out.string)
+    end
+  end
+
+  def test_service_failure_degrades_to_warning_not_crash
+    Dir.mktmpdir do |tmp|
+      env = sandbox_env(tmp)
+      failing = Object.new
+      failing.define_singleton_method(:unregister!) { raise "launchctl exploded" }
+      failing.define_singleton_method(:installed?) { true }
+      failing.define_singleton_method(:registration_path) { "/x" }
+
+      _out, err = nil
+      err = StringIO.new
+      summary = Hive::Commands::Uninstall.new(
+        project_root: tmp, env: env, service_factory: -> { failing },
+        out: StringIO.new, err: err
+      ).call
+
+      refute summary[:service_deregistered]
+      assert_match(/service deregistration skipped/, err.string)
+    end
+  end
+end
diff --git a/test/unit/commands/update_test.rb b/test/unit/commands/update_test.rb
new file mode 100644
index 000000000..62ae75575
--- /dev/null
+++ b/test/unit/commands/update_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+require "hive/commands/update"
+
+class UpdateCommandTest < Minitest::Test
+  def env_with_config(tmp)
+    {"XDG_CONFIG_HOME" => File.join(tmp, "config")}
+  end
+
+  def make_command(channel: nil, env: {}, which: nil, runner: nil)
+    Hive::Commands::Update.new(
+      channel: channel,
+      env: env,
+      which: which || ->(_bin) { nil },
+      runner: runner,
+      out: StringIO.new,
+      err: StringIO.new
+    )
+  end
+
+  def test_brew_channel_runs_brew_upgrade_from_marker
+    Dir.mktmpdir do |tmp|
+      env = env_with_config(tmp)
+      Hive::InstallLayout.write_channel("brew", env)
+
+      calls = []
+      cmd = make_command(env: env, runner: ->(*argv) { calls << argv; true })
+      cmd.call
+
+      assert_equal [["brew", "upgrade", "ivankuznetsov/hive/hive"]], calls
+      assert_equal "brew", cmd.channel
+    end
+  end
+
+  def test_explicit_channel_overrides_marker
+    Dir.mktmpdir do |tmp|
+      env = env_with_config(tmp)
+      Hive::InstallLayout.write_channel("script", env)
+
+      calls = []
+      cmd = make_command(channel: "aur", env: env, runner: ->(*argv) { calls << argv; true },
+                         which: ->(bin) { bin == "yay" ? "/usr/bin/yay" : nil })
+      cmd.call
+
+      assert_equal [["yay", "-Syu", "hive-bin"]], calls
+    end
+  end
+
+  def test_aur_channel_prefers_detected_helper_then_pacman_fallback
+    Dir.mktmpdir do |tmp|
+      env = env_with_config(tmp)
+      Hive::InstallLayout.write_channel("aur", env)
+
+      calls = []
+      make_command(
+        env: env,
+        runner: ->(*argv) { calls << argv; true },
+        which: ->(bin) { bin == "paru" ? "/usr/bin/paru" : nil }
+      ).call
+      assert_equal [["paru", "-Syu", "hive-bin"]], calls
+
+      # No helper, pacman present → sudo pacman fallback.
+      make_command(
+        env: env,
+        runner: ->(*argv) { calls << argv; true },
+        which: ->(bin) { bin == "pacman" ? "/usr/bin/pacman" : nil }
+      ).call
+      assert_equal ["sudo", "pacman", "-Syu", "hive-bin"], calls.last
+    end
+  end
+
+  def test_aur_channel_without_any_package_manager_raises
+    Dir.mktmpdir do |tmp|
+      env = env_with_config(tmp)
+      Hive::InstallLayout.write_channel("aur", env)
+
+      cmd = make_command(env: env, runner: ->(*) { true }, which: ->(_bin) { nil })
+      assert_raises(Hive::Error) { cmd.call }
+    end
+  end
+
+  def test_script_channel_reruns_the_one_liner_without_touching_binaries
+    Dir.mktmpdir do |tmp|
+      env = env_with_config(tmp)
+      Hive::InstallLayout.write_channel("script", env)
+
+      calls = []
+      make_command(env: env, runner: ->(*argv) { calls << argv; true }).call
+
+      argv = calls.first
+      assert_equal 3, argv.size
+      assert_equal "bash", argv[0]
+      assert_equal "-c", argv[1]
+      assert_match(%r{releases/latest/download/install\.sh \| bash -s --}, argv[2])
+    end
+  end
+
+  def test_missing_or_unknown_marker_refuses_to_guess
+    Dir.mktmpdir do |tmp|
+      env = env_with_config(tmp)
+      cmd = make_command(env: env, runner: ->(*) { flunk("must not run") })
+
+      error = assert_raises(Hive::Commands::Update::ChannelUnknown) { cmd.call }
+      assert_equal Hive::ExitCodes::USAGE, error.exit_code
+      assert_match(/Refusing to guess/, error.message)
+    end
+
+    Dir.mktmpdir do |tmp|
+      env = env_with_config(tmp)
+      FileUtils.mkdir_p(Hive::InstallLayout.config_dir(env))
+      File.write(Hive::InstallLayout.channel_marker_path(env), "snap\n")
+
+      cmd = make_command(env: env, runner: ->(*) { flunk("must not run") })
+      assert_raises(Hive::Commands::Update::ChannelUnknown) { cmd.call }
+    end
+  end
+
+  def test_failed_channel_command_surfaces_error
+    Dir.mktmpdir do |tmp|
+      env = env_with_config(tmp)
+      Hive::InstallLayout.write_channel("brew", env)
+
+      cmd = make_command(env: env, runner: ->(*) { false })
+      assert_raises(Hive::Error) { cmd.call }
+    end
+  end
+end
diff --git a/test/unit/install_layout_test.rb b/test/unit/install_layout_test.rb
new file mode 100644
index 000000000..c96c3ac01
--- /dev/null
+++ b/test/unit/install_layout_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+require "hive/install_layout"
+
+class InstallLayoutTest < Minitest::Test
+  def sandbox_env(tmp)
+    {
+      "XDG_CONFIG_HOME" => File.join(tmp, "config"),
+      "XDG_STATE_HOME" => File.join(tmp, "state"),
+      "XDG_CACHE_HOME" => File.join(tmp, "cache"),
+      "XDG_DATA_HOME" => File.join(tmp, "data")
+    }
+  end
+
+  def test_xdg_dirs_honor_environment_overrides
+    Dir.mktmpdir do |tmp|
+      env = sandbox_env(tmp)
+      assert_equal "#{tmp}/config/hive", Hive::InstallLayout.config_dir(env)
+      assert_equal "#{tmp}/state/hive", Hive::InstallLayout.state_dir(env)
+      assert_equal "#{tmp}/cache/hive", Hive::InstallLayout.cache_dir(env)
+      assert_equal "#{tmp}/data/hive", Hive::InstallLayout.data_dir(env)
+    end
+  end
+
+  def test_bin_dir_defaults_to_local_bin_and_honors_override
+    assert_equal File.expand_path("~/.local/bin"), Hive::InstallLayout.bin_dir({})
+
+    Dir.mktmpdir do |tmp|
+      assert_equal tmp, Hive::InstallLayout.bin_dir("HIVE_BIN_DIR" => tmp)
+      # Empty-string override falls back to the default rather than "".
+      assert_equal File.expand_path("~/.local/bin"), Hive::InstallLayout.bin_dir("HIVE_BIN_DIR" => "")
+    end
+  end
+
+  def test_channel_marker_roundtrip
+    Dir.mktmpdir do |tmp|
+      env = sandbox_env(tmp)
+      assert_nil Hive::InstallLayout.read_channel(env)
+
+      assert_equal "brew", Hive::InstallLayout.write_channel("brew", env)
+      assert_equal "brew", Hive::InstallLayout.read_channel(env)
+      assert_equal File.join(tmp, "config/hive/install-channel"),
+        Hive::InstallLayout.channel_marker_path(env)
+
+      Hive::InstallLayout.clear_channel(env)
+      assert_nil Hive::InstallLayout.read_channel(env)
+    end
+  end
+
+  def test_read_channel_returns_nil_for_unknown_value
+    Dir.mktmpdir do |tmp|
+      env = sandbox_env(tmp)
+      FileUtils.mkdir_p(Hive::InstallLayout.config_dir(env))
+      File.write(Hive::InstallLayout.channel_marker_path(env), "mystery\n")
+      assert_nil Hive::InstallLayout.read_channel(env)
+    end
+  end
+
+  def test_write_channel_rejects_unknown_channel
+    e = assert_raises(Hive::Error) do
+      Hive::InstallLayout.write_channel("npm", {})
+    end
+    assert_match(/unknown install channel/, e.message)
+  end
+
+  def test_migrate_legacy_state_absent_is_noop
+    Dir.mktmpdir do |tmp|
+      env = sandbox_env(tmp).merge("HIVE_LEGACY_STATE_DIR" => File.join(tmp, "nope"))
+      assert_equal :absent, Hive::InstallLayout.migrate_legacy_state!(env)
+    end
+  end
+
+  def test_migrate_legacy_state_copies_then_renames_with_backup
+    Dir.mktmpdir do |tmp|
+      legacy = File.join(tmp, ".hive-state")
+      env = sandbox_env(tmp).merge("HIVE_LEGACY_STATE_DIR" => legacy)
+      FileUtils.mkdir_p(File.join(legacy, "logs"))
+      File.write(File.join(legacy, "marker.txt"), "precious")
+
+      result = Hive::InstallLayout.migrate_legacy_state!(env)
+      assert_equal :migrated, result
+
+      # Copy landed at the XDG state dir.
+      assert_equal "precious",
+        File.read(File.join(Hive::InstallLayout.state_dir(env), "marker.txt"))
+      # Original preserved as backup (never deleted).
+      refute File.exist?(legacy)
+      assert_equal "precious", File.read("#{legacy}.migrated-backup/marker.txt")
+    end
+  end
+
+  def test_migrate_legacy_state_refuses_when_already_migrated
+    Dir.mktmpdir do |tmp|
+      legacy = File.join(tmp, ".hive-state")
+      env = sandbox_env(tmp).merge("HIVE_LEGACY_STATE_DIR" => legacy)
+      FileUtils.mkdir_p(legacy)
+      FileUtils.mkdir_p(Hive::InstallLayout.state_dir(env))
+
+      assert_equal :already_migrated, Hive::InstallLayout.migrate_legacy_state!(env)
+      assert File.directory?(legacy), "legacy directory must be left untouched"
+    end
+  end
+
+  def test_migrate_legacy_state_refuses_over_existing_backup
+    Dir.mktmpdir do |tmp|
+      legacy = File.join(tmp, ".hive-state")
+      env = sandbox_env(tmp).merge("HIVE_LEGACY_STATE_DIR" => legacy)
+      FileUtils.mkdir_p(legacy)
+      FileUtils.mkdir_p("#{legacy}.migrated-backup")
+
+      assert_equal :backup_exists, Hive::InstallLayout.migrate_legacy_state!(env)
+      assert File.directory?(legacy)
+    end
+  end
+end
