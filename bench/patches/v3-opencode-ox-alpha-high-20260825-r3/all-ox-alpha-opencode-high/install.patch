new file mode 100644
index 000000000..f765e1019
--- /dev/null
+++ b/test/unit/name_conflict_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+require "hive/name_conflict"
+
+class NameConflictTest < Minitest::Test
+  def test_no_conflict_when_name_is_free
+    Dir.mktmpdir do |tmp|
+      refute Hive::NameConflict.conflicted?("hive", path: tmp)
+      assert_equal "hive", Hive::NameConflict.resolve_install_name("hive", "hv", path: tmp)
+    end
+  end
+
+  def test_foreign_hive_on_path_triggers_fallback_name
+    Dir.mktmpdir do |tmp|
+      foreign = File.join(tmp, "hive")
+      File.write(foreign, "#!/bin/sh\necho apache-hive\n")
+      FileUtils.chmod("+x", foreign)
+
+      assert_equal foreign, Hive::NameConflict.foreign_path("hive", path: tmp, self_program: "/elsewhere/hive")
+      assert Hive::NameConflict.conflicted?("hive", path: tmp, self_program: "/elsewhere/hive")
+      assert_equal "hv", Hive::NameConflict.resolve_install_name("hive", "hv", path: tmp, self_program: "/elsewhere/hive")
+    end
+  end
+
+  def test_own_binary_on_path_does_not_count_as_conflict
+    Dir.mktmpdir do |tmp|
+      ours = File.join(tmp, "hive")
+      File.write(ours, "#!/bin/sh\nexit 0\n")
+      FileUtils.chmod("+x", ours)
+      real_self = File.realpath(ours)
+
+      assert_nil Hive::NameConflict.foreign_path("hive", path: tmp, self_program: real_self)
+      assert_equal "hive", Hive::NameConflict.resolve_install_name("hive", "hv", path: tmp, self_program: real_self)
+    end
+  end
+
+  def test_symlink_to_self_resolves_before_comparison
+    Dir.mktmpdir do |tmp|
+      real_bin = File.join(tmp, "real-hive-dir")
+      Dir.mkdir(real_bin)
+      actual = File.join(real_bin, "hive")
+      File.write(actual, "#!/bin/sh\nexit 0\n")
+      FileUtils.chmod("+x", actual)
+
+      link_dir = File.join(tmp, "links")
+      Dir.mkdir(link_dir)
+      link = File.join(link_dir, "hive")
+      File.symlink(actual, link)
+
+      assert_nil(
+        Hive::NameConflict.foreign_path(
+          "hive", path: link_dir,
+                  self_program: File.realpath(actual)
+        ),
+        "a symlink pointing back at ourselves must not be treated as foreign"
+      )
+    end
+  end
+
+  def test_non_executable_entries_are_ignored
+    Dir.mktmpdir do |tmp|
+      inert = File.join(tmp, "hive")
+      File.write(inert, "not executable")
+      FileUtils.chmod("-x", inert)
+
+      refute Hive::NameConflict.conflicted?("hive", path: tmp, self_program: "/elsewhere/hive")
+    end
+  end
+
+  def test_fallback_constants
+    assert_equal "hive", Hive::NameConflict::DEFAULT_NAME
+    assert_equal "hv", Hive::NameConflict::FALLBACK_NAME
+  end
+end
diff --git a/test/unit/packaging/install_sh_test.rb b/test/unit/packaging/install_sh_test.rb
new file mode 100644
index 000000000..551a060de
--- /dev/null
+++ b/test/unit/packaging/install_sh_test.rb
@@ -0,0 +1,144 @@
+require "test_helper"
+require "open3"
+require "digest"
+
+module Packaging
+  # U2 — install.sh one-liner tests. The script is source-safe (main only
+  # runs when executed directly), so these drive its functions through a
+  # bash subshell and exercise the full install flow offline via the
+  # HIVE_FETCH_OVERRIDE hook.
+  class InstallShTest < Minitest::Test
+    SCRIPT = File.expand_path("../../../packaging/install.sh", __dir__).freeze
+
+    def test_script_passes_bash_syntax_check
+      _out, err, status = Open3.capture3("bash", "-n", SCRIPT)
+      assert status.success?, "install.sh failed bash -n: #{err}"
+    end
+
+    def test_detect_os_and_arch_map_tier1_platforms
+      run_fn("hive::artifact_name macos arm64").tap do |out, err, st|
+        assert st.success?, err
+        assert_equal "hive-macos-arm64", out.strip
+      end
+      run_fn("hive::artifact_name linux x86_64").tap do |out, err, st|
+        assert st.success?, err
+        assert_equal "hive-linux-x86_64", out.strip
+      end
+    end
+
+    def test_unsupported_combos_are_refused_with_clear_message
+      _out, err, st = run_fn("hive::artifact_name linux armv7l")
+      refute st.success?
+      assert_match(/outside the supported tier-1 matrix/, err)
+
+      _out, err, st = run_fn("hive::artifact_name macos x86_64")
+      refute st.success?
+      assert_match(/tier-2 best-effort/, err)
+    end
+
+    def test_probe_dependencies_reports_missing_tools_and_hard_fails_without_bash
+      env = {
+        "PATH" => "/nonexistent-hive-test/bin",
+        "HIVE_SKIP_DEPS" => "1"
+      }
+      _out, err, st = run_fn("hive::probe_dependencies", env: env)
+      # With an empty PATH every advisory dep is reported; bash itself
+      # missing is the one hard failure (R9).
+      refute st.success?, "missing bash must hard-fail the probe"
+      %w[git claude gh jq].each { |dep| assert_includes err, dep }
+      assert_match(/continuing anyway/, err)
+      assert_match(/bash is required/, err)
+    end
+
+    def test_full_install_flow_offline_via_fetch_override
+      Dir.mktmpdir do |tmp|
+        artifact_dir = File.join(tmp, "release")
+        Dir.mkdir(artifact_dir)
+        fake_binary = "#!/bin/sh\necho 9.9.9\n"
+        File.write(File.join(artifact_dir, "hive-linux-x86_64"), fake_binary)
+        digest = Digest::SHA256.hexdigest(fake_binary)
+        File.write(File.join(artifact_dir, "SHA256SUMS"), "#{digest}  hive-linux-x86_64\n")
+
+        home = File.join(tmp, "home")
+        Dir.mkdir(home)
+        bin_dir = File.join(home, ".local", "bin")
+
+        script = <<~BASH
+          set -euo pipefail
+          export HIVE_FETCH_OVERRIDE="#{artifact_dir}"
+          export HIVE_BIN_DIR="#{bin_dir}"
+          export HOME="#{home}"
+          unset HIVE_VERSION
+          source #{SCRIPT.inspect}
+          hive::main
+        BASH
+        _out, err, st = Open3.capture3("bash", "-c", script)
+        assert st.success?, "offline install failed: #{err}"
+
+        installed = File.join(bin_dir, "hive")
+        assert File.executable?(installed), "binary not installed at #{installed}"
+        assert_equal digest, Digest::SHA256.hexdigest(File.read(installed))
+
+        # XDG dirs created (R8).
+        %w[
+          .config/hive
+          .local/state/hive/logs
+          .cache/hive
+          .local/share/hive
+        ].each { |d| assert File.directory?(File.join(home, d)), "missing XDG dir #{d}" }
+
+        # Channel marker written for `hive update` (R13).
+        assert_equal "script",
+          File.read(File.join(home, ".config/hive/install-channel")).strip
+      end
+    end
+
+    def test_corrupted_download_aborts_without_installing
+      Dir.mktmpdir do |tmp|
+        artifact_dir = File.join(tmp, "release")
+        Dir.mkdir(artifact_dir)
+        File.write(File.join(artifact_dir, "hive-linux-x86_64"), "tampered payload")
+        good = Digest::SHA256.hexdigest("original payload")
+        File.write(File.join(artifact_dir, "SHA256SUMS"), "#{good}  hive-linux-x86_64\n")
+
+        home = File.join(tmp, "home")
+        Dir.mkdir(home)
+        bin_dir = File.join(home, ".local", "bin")
+
+        script = <<~BASH
+          set -uo pipefail
+          export HIVE_FETCH_OVERRIDE="#{artifact_dir}"
+          export HIVE_BIN_DIR="#{bin_dir}"
+          export HOME="#{home}"
+          source #{SCRIPT.inspect}
+          hive::detect_os >/dev/null || exit 0
+          os="$(hive::detect_os)"; arch="$(hive::detect_arch)"
+          artifact="$(hive::artifact_name "$os" "$arch")"
+          tmp="$(mktemp -d)"
+          cp "$HIVE_FETCH_OVERRIDE/$artifact" "$tmp/$artifact"
+          cp "$HIVE_FETCH_OVERRIDE/SHA256SUMS" "$tmp/SHA256SUMS"
+          if hive::verify_checksum "$tmp/$artifact" "$tmp/SHA256SUMS"; then
+            echo "UNEXPECTED CHECKSUM PASS"; exit 1
+          fi
+          echo "CHECKSUM REFUSED"
+        BASH
+        _out, err, st = Open3.capture3("bash", "-c", script)
+        assert st.success?, err
+        assert_match(/CHECKSUM MISMATCH|CHECKSUM REFUSED/, _out + err)
+        refute File.exist?(File.join(bin_dir, "hive")), "nothing must be installed on checksum failure"
+      end
+    end
+
+    private
+
+    # Source the installer and invoke a single function in a bash subshell.
+    def run_fn(expr, env: {})
+      default_env = { "PATH" => ENV["PATH"] }
+      Open3.capture3(default_env.merge(env).compact, "bash", "-c", <<~BASH)
+        set -uo pipefail
+        source #{SCRIPT.inspect}
+        #{expr}
+      BASH
+    end
+  end
+end
diff --git a/test/unit/packaging/package_manifests_test.rb b/test/unit/packaging/package_manifests_test.rb
new file mode 100644
index 000000000..1e8633bca
--- /dev/null
+++ b/test/unit/packaging/package_manifests_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+require "open3"
+require "yaml"
+
+module Packaging
+  # U3 + U4 — native package manifest checks (homebrew formula, AUR
+  # PKGBUILD/.SRCINFO, tap automation scripts). Hermetic: syntax checks and
+  # field assertions only; no brew/pacman invocation.
+  class PackageManifestsTest < Minitest::Test
+    ROOT = File.expand_path("../../..", __dir__).freeze
+    FORMULA = File.join(ROOT, "packaging/homebrew/Formula/hive.rb").freeze
+    PKGBUILD = File.join(ROOT, "packaging/aur/PKGBUILD").freeze
+    SRCINFO = File.join(ROOT, "packaging/aur/.SRCINFO").freeze
+
+    def test_formula_passes_ruby_syntax_check
+      _out, err, status = Open3.capture3(RbConfig.ruby, "-c", FORMULA)
+      assert status.success?, "formula failed ruby -c: #{err}"
+    end
+
+    def test_formula_pins_release_artifacts_without_system_dependencies
+      raw = File.read(FORMULA)
+      assert_includes raw, "hive-macos-arm64"
+      assert_includes raw, "hive-linux-x86_64"
+      assert_match(%r{releases/download/v#\{version\}/hive-macos-arm64}, raw)
+      # R1: vendored Ruby means no depends_on entries at all.
+      refute_match(/depends_on/, raw)
+      assert_includes raw, "MACOS_ARM64_SHA256"
+      assert_includes raw, "LINUX_X86_64_SHA256"
+    end
+
+    def test_formula_test_block_asserts_version_output
+      raw = File.read(FORMULA)
+      assert_match(/test do\b.*?--version.*?end/m, raw)
+    end
+
+    def test_pkgbuild_is_valid_bash_and_targets_usr_bin_hive
+      _out, err, status = Open3.capture3("bash", "-n", PKGBUILD)
+      assert status.success?, "PKGBUILD failed bash -n: #{err}"
+
+      raw = File.read(PKGBUILD)
+      assert_includes raw, 'pkgname=hive-bin'
+      assert_match(/install -Dm755 .* "\$\{pkgdir\}\/usr\/bin\/hive"/, raw)
+      assert_includes raw, "license=(\"MIT\")"
+      # R4/R10: never collides with Apache Hive packaging.
+      refute_match(/^provides=\(.+\)/, raw)
+      refute_match(/^conflicts=\(.+\)/, raw)
+      assert_match(/optdepends=/, raw)
+      assert_match(/releases\/download\/v\$\{pkgver\}\/hive-linux-x86_64/, raw)
+    end
+
+    def test_srcinfo_matches_pkgbuild_version_and_package_name
+      pkgver = File.read(PKGBUILD)[/^pkgver=(.+)$/, 1]
+      info = File.read(SRCINFO)
+      assert_includes info, "pkgname = hive-bin"
+      assert_includes info, "pkgver = #{pkgver}"
+      assert_includes info, "arch = x86_64"
+      # Source URL version must track pkgver in lockstep.
+      assert_includes info, "releases/download/v#{pkgver}/hive-linux-x86_64"
+    end
+
+    def test_tap_bump_script_substitutes_version_and_checksums
+      Dir.mktmpdir do |dir|
+        out = File.join(dir, "hive.rb")
+        sha_a = "a" * 64
+        sha_b = "b" * 64
+        _o, err, st = Open3.capture3(
+          "bash", File.join(ROOT, "packaging", "tap-bump.sh"),
+          FORMULA, out, "1.2.3", sha_a, sha_b
+        )
+        assert st.success?, err
+        bumped = File.read(out)
+        assert_includes bumped, 'version "1.2.3"'
+        assert_includes bumped, "MACOS_ARM64_SHA256 = \"#{sha_a}\""
+        assert_includes bumped, "LINUX_X86_64_SHA256 = \"#{sha_b}\""
+        _out2, err2, st2 = Open3.capture3(RbConfig.ruby, "-c", out)
+        assert st2.success?, "rendered formula invalid: #{err2}"
+      end
+    end
+
+    def test_tap_bump_script_rejects_malformed_input
+      Dir.mktmpdir do |dir|
+        out = File.join(dir, "hive.rb")
+        _o, _e, st = Open3.capture3(
+          "bash", File.join(ROOT, "packaging", "tap-bump.sh"),
+          FORMULA, out, "not-semver", ("a" * 64), ("b" * 64)
+        )
+        refute st.success?
+        _o, _e, st = Open3.capture3(
+          "bash", File.join(ROOT, "packaging", "tap-bump.sh"),
+          FORMULA, out, "1.2.3", "zz", ("b" * 64)
+        )
+        refute st.success?
+      end
+    end
+
+    def test_aur_bump_script_updates_pkgver_and_srcinfo
+      Dir.mktmpdir do |dir|
+        aur = File.join(dir, "aur")
+        FileUtils.cp_r(File.join(ROOT, "packaging", "aur"), aur)
+        sha = "c" * 64
+        _o, err, st = Open3.capture3(
+          "bash", File.join(aur, "bump.sh"), "2.0.7", sha
+        )
+        assert st.success?, err
+        assert_equal "2.0.7", File.read(File.join(aur, "PKGBUILD"))[/^pkgver=(.+)$/, 1]
+        srcinfo = File.read(File.join(aur, ".SRCINFO"))
+        assert_includes srcinfo, "pkgver = 2.0.7"
+        assert_includes srcinfo, "releases/download/v2.0.7/hive-linux-x86_64"
+        assert_includes srcinfo, sha
+      end
+    end
+
+    def test_tap_bump_workflow_wires_release_to_pr
+      raw = File.read(File.join(ROOT, ".github/workflows/tap-bump.yml"))
+      workflow = YAML.safe_load(raw, permitted_classes: [], aliases: true)
+      triggers = workflow["on"] || workflow[true]
+      assert_includes triggers["release"]["types"], "published"
+      assert_includes raw, "tap-bump.sh"
+      assert_includes raw, "Formula/hive.rb"
+    end
+  end
+end
