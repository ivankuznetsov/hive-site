+# Maintainer: Hive release automation <bot@users.noreply.github.com>
+# AUR package: hive-bin — installs the pinned, vendored-Ruby Release binary
+# under pacman management (plan U4). pkgver and sha256sums are bumped by
+# packaging/aur/bump.sh on every published release.
+pkgname=hive-bin
+pkgver=0.1.0
+pkgrel=1
+pkgdesc="Multi-agent idea-to-merged-PR pipeline driven by coding agents (prebuilt binary)"
+arch=("x86_64")
+url="https://github.com/ivankuznetsov/hive"
+license=("MIT")
+optdepends=(
+  "claude: planning/review agent CLI (Claude Code)"
+  "codex: default execute agent CLI"
+  "gh: GitHub PR operations from the pipeline"
+  "jq: JSON processing used by agent tooling"
+)
+# Plain provides/conflicts on purpose: Apache Hive's AUR packages own the
+# `hive` name; hive-bin never claims it at package-manager level (R4/R10).
+provides=()
+conflicts=()
+source=("hive-linux-x86_64::${url}/releases/download/v${pkgver}/hive-linux-x86_64")
+sha256sums=("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
+
+package() {
+  install -Dm755 "${srcdir}/hive-linux-x86_64" "${pkgdir}/usr/bin/hive"
+
+  cat <<EOF > "${pkgdir}/usr/share/doc/hive-bin/post-install.txt"
+hive-bin installed /usr/bin/hive.
+
+If a different 'hive' command (e.g. Apache Hive) already exists earlier in
+PATH, invoke this package as 'hv' via a shell alias, or see the README's
+command-conflict section.
+
+Optional runtime dependencies are listed in optdepends; none are installed
+automatically.
+EOF
+}
diff --git a/packaging/aur/bump.sh b/packaging/aur/bump.sh
new file mode 100644
index 000000000..1d1e6413b
--- /dev/null
+++ b/packaging/aur/bump.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+#
+# Bump the AUR hive-bin package to a released version. Run by maintainers
+# (or release CI with AUR SSH credentials) after each GitHub Release:
+#
+#   packaging/aur/bump.sh <version> <linux-x86_64.sha256>
+#
+# Updates PKGBUILD (pkgver + real sha256) and regenerates .SRCINFO when
+# makepkg is available (falls back to sed for CI images without pacman).
+set -euo pipefail
+
+[ $# -eq 2 ] || { echo "usage: $0 <version> <sha256>" >&2; exit 64; }
+ver="$1" sha="$2"
+[[ "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "not a semver: $ver" >&2; exit 64; }
+[[ "$sha" =~ ^[0-9a-f]{64}$ ]] || { echo "not a sha256: $sha" >&2; exit 64; }
+
+cd "$(dirname "$0")"
+
+sed -i -E "s/^pkgver=.*/pkgver=${ver}/" PKGBUILD
+sed -i -E "s/^sha256sums=\(\"[0-9a-f]{64}\"\)/sha256sums=(\"${sha}\")/" PKGBUILD
+
+if command -v makepkg >/dev/null 2>&1; then
+  makepkg --printsrcinfo > .SRCINFO
+else
+  # Minimal regeneration without pacman: keep field order stable.
+  sed -i -E \
+    -e "s|^(\tpkgver = ).*|\1${ver}|" \
+    -e "s|^(\tsha256sums = ).*|\1${sha}|" \
+    -e "s|(releases/download/v)[^/]+|\1${ver}|" \
+    .SRCINFO
+fi
+
+echo "aur/bump.sh: PKGBUILD + .SRCINFO updated to ${ver}"
+echo "next: push both files to the AUR (ssh aur@aur.archlinux.org:hive-bin.git)."
diff --git a/packaging/build.sh b/packaging/build.sh
new file mode 100644
index 000000000..594596e91
--- /dev/null
+++ b/packaging/build.sh
@@ -0,0 +1,108 @@
+#!/usr/bin/env bash
+#
+# Build self-contained, vendored-Ruby hive binaries for the current host.
+#
+# Strategy ladder (see plan "Hive Packaging & Installation v1" risk table):
+#   1. Tebako (preferred) — packages bin/hive with an embedded Ruby runtime
+#      into a single-file binary via DwarFS. Produces dist/hive-<os>-<arch>.
+#   2. Portable-Ruby tarball fallback — ships the app tree plus an embedded
+#      portable Ruby prefix and a launcher shim. Produces
+#      dist/hive-<os>-<arch>.tar.gz (tier-2 best-effort; installers prefer
+#      the raw Tebako binary when present).
+#
+# Environment:
+#   HIVE_VERSION         override the baked version (defaults to Hive::VERSION)
+#   TEBAKO_CMD           tebako executable (default: tebako)
+#   PORTABLE_RUBY_URL    portable Ruby tarball for the fallback path
+#
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+DIST="${HIVE_DIST_DIR:-$ROOT/dist}"
+TEBAKO_CMD="${TEBAKO_CMD:-tebako}"
+
+die() { echo "build.sh: $*" >&2; exit 2; }
+
+detect_os() {
+  case "$(uname -s)" in
+    Darwin) echo "macos" ;;
+    Linux) echo "linux" ;;
+    *) die "unsupported OS: $(uname -s) (tier-1 targets are macOS and Linux)" ;;
+  esac
+}
+
+detect_arch() {
+  case "$(uname -m)" in
+    arm64 | aarch64) echo "arm64" ;;
+    x86_64) echo "x86_64" ;;
+    *) die "unsupported architecture: $(uname -m)" ;;
+  esac
+}
+
+baked_version() {
+  if [ -n "${HIVE_VERSION:-}" ]; then
+    echo "$HIVE_VERSION"
+  else
+    ruby -I"$ROOT/lib" -r hive -e 'print Hive::VERSION'
+  fi
+}
+
+build_tebako() {
+  local out="$DIST/hive-$os-$arch"
+  echo "==> building vendored-Ruby binary with tebako -> $out"
+  (cd "$ROOT" && "$TEBAKO_CMD" press \
+    --root "$ROOT" \
+    --entry bin/hive \
+    --output "$out")
+  chmod +x "$out"
+}
+
+build_portable_tarball() {
+  local tarball="$DIST/hive-$os-$arch.tar.gz"
+  local staging prefix_url
+  prefix_url="${PORTABLE_RUBY_URL:-}"
+
+  [ -n "$prefix_url" ] || die "fallback build requires PORTABLE_RUBY_URL (portable Ruby tarball for this platform)"
+
+  echo "==> building portable-Ruby tarball fallback -> $tarball"
+  staging="$(mktemp -d)"
+  trap 'rm -rf "$staging"' RETURN
+
+  mkdir -p "$staging/hive"
+  cp -R "$ROOT/bin" "$ROOT/lib" "$ROOT/templates" "$ROOT/schemas" "$ROOT/Gemfile" "$ROOT/Gemfile.lock" "$staging/hive/"
+  (cd "$ROOT" && bundle config set --local path "$staging/hive/vendor/bundle" >/dev/null \
+    && bundle install --quiet)
+  cp -R "$ROOT/vendor/bundle" "$staging/hive/vendor/bundle"
+
+  curl -fsSL "$prefix_url" | tar -xz -C "$staging/hive" --strip-components=1 -s '/^ruby-/portable-ruby/'
+  local staged_ruby="$staging/hive/portable-ruby/bin/ruby"
+  [ -x "$staged_ruby" ] || die "portable Ruby did not land at portable-ruby/bin/ruby"
+
+  cat > "$staging/hive/hive-launcher" <<LAUNCHER
+#!/bin/bash
+DIR="\$(cd "\$(dirname "\${BASH_SOURCE[0]}")" && pwd)"
+exec "\$DIR/portable-ruby/bin/ruby" -I"\$DIR/lib" "\$DIR/bin/hive" "\$@"
+LAUNCHER
+  chmod +x "$staging/hive/hive-launcher"
+
+  tar -czf "$tarball" -C "$staging" hive
+}
+
+os="$(detect_os)"
+arch="$(detect_arch)"
+version="$(baked_version)"
+echo "==> hive build: version=$version os=$os arch=$arch"
+
+mkdir -p "$DIST"
+
+if command -v "$TEBAKO_CMD" >/dev/null 2>&1; then
+  build_tebako
+else
+  echo "==> tebako not found on PATH; skipping raw-binary build" >&2
+fi
+
+if [ "${BUILD_TARBALL_FALLBACK:-0}" = "1" ]; then
+  build_portable_tarball
+fi
+
+ls -la "$DIST"
diff --git a/packaging/checksums.sh b/packaging/checksums.sh
new file mode 100644
index 000000000..01c8b3888
--- /dev/null
+++ b/packaging/checksums.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+#
+# Generate a SHA256SUMS manifest for every release artifact in a directory.
+# Usage: checksums.sh [dir]   (default: dist)
+#
+# Works on Linux (sha256sum) and macOS (shasum -a 256) so release CI can run
+# it on either runner. Output is written as <dir>/SHA256SUMS with paths
+# relative to <dir>, matching the layout GitHub Release assets are uploaded
+# with.
+set -euo pipefail
+
+DIR="${1:-dist}"
+[ -d "$DIR" ] || { echo "checksums.sh: no such directory: $DIR" >&2; exit 2; }
+
+sum_cmd() {
+  if command -v sha256sum >/dev/null 2>&1; then
+    echo "sha256sum"
+  elif command -v shasum >/dev/null 2>&1; then
+    echo "shasum -a 256"
+  else
+    echo "checksums.sh: need sha256sum or shasum on PATH" >&2
+    exit 2
+  fi
+}
+
+cd "$DIR"
+OUT="SHA256SUMS"
+: > "$OUT"
+shopt -s nullglob
+for f in hive-*; do
+  [ -f "$f" ] || continue
+  $(sum_cmd) "$f" >> "$OUT"
+done
+shopt -u nullglob
+
+if [ ! -s "$OUT" ]; then
+  echo "checksums.sh: no hive-* artifacts found in $DIR" >&2
+  exit 2
+fi
+
+cat "$OUT"
diff --git a/packaging/homebrew/Formula/hive.rb b/packaging/homebrew/Formula/hive.rb
new file mode 100644
index 000000000..28f7f4fbb
--- /dev/null
+++ b/packaging/homebrew/Formula/hive.rb
@@ -0,0 +1,55 @@
+# Homebrew formula template for the hive tap (<org>/homebrew-hive).
+#
+# This file lives in the main repo as the single source of truth and is
+# mirrored into packaging/homebrew/Formula/hive.rb by release CI
+# (.github/workflows/tap-bump.yml), which substitutes the real version and
+# SHA256 checksums from the freshly published GitHub Release before opening
+# a PR against the tap repository.
+#
+# Vendored Ruby (R1): the formula depends on nothing — each Release asset
+# embeds its own Ruby runtime.
+class Hive < Formula
+  desc "Multi-agent idea-to-merged-PR pipeline driven by coding agents"
+  homepage "https://github.com/ivankuznetsov/hive"
+  # Managed by packaging/tap-bump.sh — do not bump by hand without updating
+  # both checksums below.
+  version "0.1.0"
+
+  MACOS_ARM64_SHA256 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855".freeze
+  LINUX_X86_64_SHA256 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855".freeze
+
+  on_macos do
+    on_arm do
+      url "https://github.com/ivankuznetsov/hive/releases/download/v#{version}/hive-macos-arm64"
+      sha256 MACOS_ARM64_SHA256
+    end
+  end
+
+  on_linux do
+    if Hardware::CPU.intel?
+      url "https://github.com/ivankuznetsov/hive/releases/download/v#{version}/hive-linux-x86_64"
+      sha256 LINUX_X86_64_SHA256
+    end
+  end
+
+  def install
+    binary = "hive-macos-arm64"
+    binary = "hive-linux-x86_64" if OS.linux? && Hardware::CPU.intel?
+    bin.install binary => "hive"
+  end
+
+  def caveats
+    <<~EOS
+      The command name is `hive`. If Apache Hive is already on your PATH,
+      installers fall back to `hv` — run `hv --version` in that case.
+
+      Runtime dependencies are probed at first use, never auto-installed:
+        git, claude (Claude Code CLI), gh (GitHub CLI), jq.
+      Install any that are missing with their official channels.
+    EOS
+  end
+
+  test do
+    assert_match version.to_s, shell_output("#{bin}/hive --version")
+  end
+end
diff --git a/packaging/install.sh b/packaging/install.sh
new file mode 100644
index 000000000..140974383
--- /dev/null
+++ b/packaging/install.sh
@@ -0,0 +1,225 @@
+#!/usr/bin/env bash
+#
+# hive one-line installer.
+#
+#   curl -fsSL https://github.com/ivankuznetsov/hive/releases/latest/download/install.sh | bash
+#
+# Detects OS/arch, maps to the tier-1 release artifact, verifies the SHA256
+# checksum, installs to ~/.local/bin/hive (override with HIVE_BIN_DIR), and
+# creates the XDG directories from plan requirement R8. Dependency probing is
+# advisory (R9): missing tools are reported with install hints and never
+# auto-installed. A missing `bash` hard-fails because this script IS bash.
+#
+# Environment overrides:
+#   HIVE_BIN_DIR       install directory      (default ~/.local/bin)
+#   HIVE_BIN_NAME      binary name            (default hive; set "hv" to pre-seed
+#                      the Apache-Hive conflict fallback, see R10)
+#   HIVE_REPO          GitHub slug            (default ivankuznetsov/hive)
+#   HIVE_SKIP_DEPS     set non-empty to skip the dependency probe
+#
+# The file is source-safe: sourcing it only defines functions so tests can
+# exercise detect_os / artifact_name / probe_dependencies in isolation.
+set -euo pipefail
+
+HIVE_INSTALL_DEFAULT_REPO="${HIVE_INSTALL_DEFAULT_REPO:-ivankuznetsov/hive}"
+
+hive::detect_os() {
+  local s
+  s="$(uname -s)"
+  case "$s" in
+    Darwin) echo "macos" ;;
+    Linux) echo "linux" ;;
+    *)
+      echo "hive installer: unsupported OS '$s'." >&2
+      echo "  Tier-1 platforms are macOS (arm64) and Linux (x86_64)." >&2
+      return 1
+      ;;
+  esac
+}
+
+hive::detect_arch() {
+  local m
+  m="$(uname -m)"
+  case "$m" in
+    arm64 | aarch64) echo "arm64" ;;
+    x86_64) echo "x86_64" ;;
+    *)
+      echo "hive installer: unsupported architecture '$m'." >&2
+      echo "  Supported: arm64/aarch64 and x86_64." >&2
+      return 1
+      ;;
+  esac
+}
+
+# Map OS+arch to a tier-1 release artifact name (R15). Returns nonzero for
+# unsupported combos so callers can refuse cleanly.
+hive::artifact_name() {
+  local os="$1" arch="$2"
+  case "$os-$arch" in
+    macos-arm64 | linux-x86_64) echo "hive-$os-$arch" ;;
+    macos-x86_64)
+      echo "hive installer: macOS x86_64 is tier-2 best-effort; no packaged binary yet." >&2
+      return 2
+      ;;
+    *)
+      echo "hive installer: $os-$arch is outside the supported tier-1 matrix." >&2
+      return 2
+      ;;
+  esac
+}
+
+# Advisory dependency probe (R9). Prints one line per missing tool with an
+# actionable hint. Never installs anything. Returns 0 always except when bash
+# itself is absent (defensive; we could not be running otherwise).
+hive::probe_dependencies() {
+  local missing=0 dep hint
+  for dep in git claude gh jq; do
+    if command -v "$dep" >/dev/null 2>&1; then
+      continue
+    fi
+    case "$dep" in
+      git) hint="https://git-scm.com/downloads" ;;
+      claude)
+        hint="npm install -g @anthropic-ai/claude-code  (or your package manager of choice)"
+        ;;
+      gh) hint="https://cli.github.com/" ;;
+      jq) hint="https://jqlang.github.io/jq/download/ or your system package manager" ;;
+    esac
+    if [ "$missing" = "0" ]; then
+      echo "hive installer: optional dependencies not found:" >&2
+    fi
+    echo "  - $dep   (install: $hint)" >&2
+    missing=1
+  done
+  if [ "$missing" = "1" ]; then
+    echo "hive installer: continuing anyway — these are runtime conveniences, not install prerequisites." >&2
+  fi
+  command -v bash >/dev/null 2>&1 || {
+    echo "hive installer: bash is required but was not found on PATH." >&2
+    return 1
+  }
+  return 0
+}
+
+hive::sha256_of() {
+  if command -v sha256sum >/dev/null 2>&1; then
+    sha256sum "$1" | cut -d" " -f1
+  elif command -v shasum >/dev/null 2>&1; then
+    shasum -a 256 "$1" | cut -d" " -f1
+  else
+    echo "hive installer: need sha256sum or shasum to verify downloads" >&2
+    return 1
+  fi
+}
+
+# Fetch a URL into a destination file. Honors HIVE_FETCH_OVERRIDE for tests:
+# when set it must name a directory containing the artifacts by basename,
+# which lets container-less test runs exercise the full flow offline.
+hive::fetch() {
+  local url="$1" dest="$2"
+  if [ -n "${HIVE_FETCH_OVERRIDE:-}" ]; then
+    cp "$HIVE_FETCH_OVERRIDE/$(basename "$url")" "$dest"
+  else
+    curl -fL --retry 3 -o "$dest" "$url"
+  fi
+}
+
+hive::verify_checksum() {
+  local binary="$1" sums="$2" want got
+  want="$(awk -v name="$(basename "$binary")" '$2 == name { print $1 }' "$sums")"
+  if [ -z "$want" ]; then
+    echo "hive installer: SHA256SUMS has no entry for $(basename "$binary"); refusing to install." >&2
+    return 1
+  fi
+  got="$(hive::sha256_of "$binary")"
+  if [ "$got" != "$want" ]; then
+    echo "hive installer: CHECKSUM MISMATCH for $(basename "$binary")" >&2
+    echo "  expected $want" >&2
+    echo "  got      $got" >&2
+    echo "Refusing to install a tampered or corrupted download." >&2
+    return 1
+  fi
+}
+
+hive::main() {
+  local version="${HIVE_VERSION:-latest}"
+  local repo="${HIVE_REPO:-$HIVE_INSTALL_DEFAULT_REPO}"
+  local bin_dir="${HIVE_BIN_DIR:-$HOME/.local/bin}"
+  local bin_name="${HIVE_BIN_NAME:-hive}"
+
+  # Parse flags: --version vX.Y.Z pins the tag (R13 — pinned semver only).
+  while [ $# -gt 0 ]; do
+    case "$1" in
+      --version)
+        shift
+        version="${1#v}"
+        [ -n "$version" ] || { echo "hive installer: --version needs a value" >&2; return 64; }
+        ;;
+      --help | -h)
+        sed -n '2,20p' "${BASH_SOURCE[0]}"
+        return 0
+        ;;
+      *)
+        echo "hive installer: unknown argument '$1'" >&2
+        return 64
+        ;;
+    esac
+    shift
+  done
+
+  local os arch artifact base_url tmp
+  os="$(hive::detect_os)" || return 2
+  arch="$(hive::detect_arch)" || return 2
+  artifact="$(hive::artifact_name "$os" "$arch")" || return $?
+
+  if [ "$version" = "latest" ]; then
+    base_url="https://github.com/$repo/releases/latest/download"
+  else
+    base_url="https://github.com/$repo/releases/download/v$version"
+  fi
+
+  echo "==> installing hive ($artifact, ${version}) from github.com/$repo"
+
+  tmp="$(mktemp -d)"
+  trap 'rm -rf "$tmp"' RETURN
+
+  hive::fetch "$base_url/$artifact" "$tmp/$artifact"
+  hive::fetch "$base_url/SHA256SUMS" "$tmp/SHA256SUMS"
+  hive::verify_checksum "$tmp/$artifact" "$tmp/SHA256SUMS"
+
+  mkdir -p "$bin_dir"
+  # Idempotent upgrade path: overwrite whatever is at the target atomically.
+  mv -f "$tmp/$artifact" "$bin_dir/$bin_name.tmp.$$"
+  chmod +x "$bin_dir/$bin_name.tmp.$$"
+  mv -f "$bin_dir/$bin_name.tmp.$$" "$bin_dir/$bin_name"
+
+  # XDG layout (R8): config, state, cache, data dirs.
+  mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/hive" \
+    "${XDG_STATE_HOME:-$HOME/.local/state}/hive/logs" \
+    "${XDG_CACHE_HOME:-$HOME/.cache}/hive" \
+    "${XDG_DATA_HOME:-$HOME/.local/share}/hive"
+
+  # Channel marker consumed by `hive update` (R13).
+  printf 'script\n' > "${XDG_CONFIG_HOME:-$HOME/.config}/hive/install-channel"
+
+  case ":$PATH:" in
+    *":$bin_dir:"*) ;;
+    *)
+      echo "" >&2
+      echo "NOTE: $bin_dir is not on your PATH." >&2
+      echo "Add it, e.g.:  echo 'export PATH=\"$bin_dir:\$PATH\"' >> ~/.bashrc" >&2
+      echo "(hive never edits your shell rc files without asking.)" >&2
+      ;;
+  esac
+
+  if [ -z "${HIVE_SKIP_DEPS:-}" ]; then
+    hive::probe_dependencies || return 1
+  fi
+
+  echo "==> installed: $bin_dir/$bin_name ($(command -v "$bin_name" 2>/dev/null || echo 'not on PATH yet'))"
+  echo "==> next step: run 'hive init' inside a project directory."
+}
+
+if [ "${BASH_SOURCE[0]}" = "$0" ]; then
+  hive::main "$@"
+fi
