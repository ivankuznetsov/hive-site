@@ -0,0 +1,96 @@
+name: Release
+
+# Publishes checksummed, vendored-Ruby hive binaries on every semver tag
+# (v0.1.0+). GitHub Releases is the canonical artifact source for the brew
+# tap, the AUR `hive-bin` package, and the install.sh one-liner.
+on:
+  push:
+    tags: ["v*"]
+
+permissions:
+  contents: write
+
+concurrency:
+  group: release-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  verify-tag:
+    name: Verify tag matches Hive::VERSION
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v6
+      - uses: ruby/setup-ruby@v1
+        with:
+          ruby-version: "3.4"
+          bundler-cache: true
+      - name: Tag must equal lib/hive.rb version
+        run: |
+          TAG="${GITHUB_REF_NAME#v}"
+          LIB="$(ruby -Ilib -rhive -e 'print Hive::VERSION')"
+          if [ "$TAG" != "$LIB" ]; then
+            echo "::error::tag ${GITHUB_REF_NAME} does not match lib/hive.rb VERSION (${LIB})"
+            exit 1
+          fi
+
+  build:
+    name: Build (${{ matrix.os }})
+    needs: verify-tag
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - os: macos-14      # arm64 (tier-1 macOS)
+          - os: ubuntu-22.04  # x86_64 (tier-1 Linux)
+    runs-on: ${{ matrix.os }}
+    env:
+      HIVE_VERSION: "${{ github.ref_name }}"
+    steps:
+      - uses: actions/checkout@v6
+      - uses: ruby/setup-ruby@v1
+        with:
+          ruby-version: "3.4"
+          bundler-cache: true
+      - name: Install tebako
+        run: gem install tebako --no-document
+      - name: Build vendored-Ruby binary
+        run: packaging/build.sh
+      - name: Smoke test artifact (--version)
+        shell: bash
+        run: |
+          BIN="$(ls dist/hive-* | grep -v '\.tar\.gz$' | head -n1)"
+          [ -x "$BIN" ] || { echo "::error::no binary artifact produced"; exit 1; }
+          OUT="$("$BIN" --version)"
+          echo "artifact reported: $OUT"
+          [ "$OUT" = "${GITHUB_REF_NAME#v}" ] || {
+            echo "::error::artifact --version ($OUT) != tag (${GITHUB_REF_NAME#v})"
+            exit 1
+          }
+      - uses: actions/upload-artifact@v4
+        with:
+          name: hive-${{ matrix.os }}
+          path: dist/
+          if-no-files-found: error
+
+  publish:
+    name: Publish GitHub Release
+    needs: build
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          path: dist/
+          merge-multiple: true
+      - name: Generate SHA256SUMS
+        run: |
+          ls -la dist/
+          packaging/checksums.sh dist
+      - name: Create release with artifacts + SHA256SUMS
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          gh release create "$GITHUB_REF_NAME" dist/* \
+            --repo "$GITHUB_REPOSITORY" \
+            --title "hive ${GITHUB_REF_NAME}" \
+            --generate-notes \
+            --verify-tag
diff --git a/.github/workflows/tap-bump.yml b/.github/workflows/tap-bump.yml
new file mode 100644
index 000000000..95dde9d4f
--- /dev/null
+++ b/.github/workflows/tap-bump.yml
@@ -0,0 +1,61 @@
+name: Tap bump
+
+# On every published release: substitute the version + artifact checksums
+# into the homebrew formula template and open a PR against the tap repo
+# (<org>/homebrew-hive). Merging the PR is what makes `brew upgrade` pick
+# up the new release (R3/R13).
+on:
+  release:
+    types: [published]
+
+permissions:
+  contents: read
+
+jobs:
+  formula-pr:
+    runs-on: ubuntu-latest
+    env:
+      TAP_REPO: "${{ vars.HIVE_TAP_REPO || 'ivankuznetsov/homebrew-hive' }}"
+      TAG: ${{ github.event.release.tag_name }}
+    steps:
+      - uses: actions/checkout@v6
+
+      - name: Download release assets and compute checksums
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          mkdir -p dist
+          gh release download "$TAG" --repo "$GITHUB_REPOSITORY" --dir dist
+          packaging/checksums.sh dist
+          grep "hive-macos-arm64" dist/SHA256SUMS | awk '{print "MAC_SHA256="$1}' >> "$GITHUB_ENV"
+          grep "hive-linux-x86_64" dist/SHA256SUMS | awk '{print "LIN_SHA256="$1}' >> "$GITHUB_ENV"
+
+      - name: Render updated formula
+        run: |
+          packaging/tap-bump.sh \
+            packaging/homebrew/Formula/hive.rb \
+            /tmp/hive.rb \
+            "${TAG#v}" \
+            "$MAC_SHA256" \
+            "$LIN_SHA256"
+
+      - name: Open PR against the tap repository
+        env:
+          GH_TOKEN: ${{ secrets.TAP_PAT }}
+          TAG: ${{ github.event.release.tag_name }}
+        run: |
+          work="$(mktemp -d)"
+          git clone "https://x-access-token:${GH_TOKEN}@github.com/${TAP_REPO}.git" "$work/tap"
+          cd "$work/tap"
+          branch="bump-hive-${TAG}"
+          git checkout -b "$branch"
+          cp /tmp/hive.rb Formula/hive.rb
+          git config user.name "hive-release-bot"
+          git config user.email "bot@users.noreply.github.com"
+          git commit -am "hive ${TAG}" --quiet
+          git push origin "$branch" --force
+          gh pr create \
+            --repo "$TAP_REPO" \
+            --head "$branch" \
+            --title "hive ${TAG}" \
+            --body "Automated formula bump from ${GITHUB_REPOSITORY}@${TAG}." || true
