diff --git a/lib/hive/commands/uninstall.rb b/lib/hive/commands/uninstall.rb
new file mode 100644
index 000000000..7cd4c3b04
--- /dev/null
+++ b/lib/hive/commands/uninstall.rb
@@ -0,0 +1,194 @@
+require "fileutils"
+require "hive/install_layout"
+require "hive/name_conflict"
+
+module Hive
+  module Commands
+    # `hive uninstall` — prompted, project-scoped removal (plan R14).
+    #
+    # Removes the OS service registration and the install-channel marker.
+    # Project scaffolds (`.hive-state/`) are listed individually and only
+    # removed after an explicit yes — accumulated pipeline state is user
+    # work and is never deleted by default. `~/.local/state/hive/`,
+    # `~/.local/share/hive/`, and completed outputs are NEVER deleted,
+    # even under --purge (--purge additionally clears config + cache only).
+    #
+    # The binary itself is package-manager-owned on brew/AUR channels, so
+    # uninstall prints the channel-native removal command instead of
+    # unlinking files it does not own. Skills/plugins are distributed via
+    # each agent's own marketplace and are left untouched; a reminder says
+    # so on every run.
+    class Uninstall
+      PROJECT_DIR_NAME = ".hive-state".freeze
+      BREW_UNINSTALL_CMD = "brew uninstall ivankuznetsov/hive/hive".freeze
+      AUR_UNINSTALL_CMD = "sudo pacman -Rns hive-bin".freeze
+
+      def initialize(purge: false, yes: false, project_root: Dir.pwd, env: ENV,
+                     projects_provider: nil, prompter: nil, service_factory: nil,
+                     out: $stdout, err: $stderr)
+        @purge = purge
+        @yes = yes
+        @project_root = File.expand_path(project_root)
+        @env = env
+        @projects_provider = projects_provider || -> { Hive::Config.registered_projects }
+        @prompter = prompter || default_prompter(err)
+        @service_factory = service_factory || default_service_factory
+        @out = out
+        @err = err
+      end
+
+      def call
+        summary = {
+          service_deregistered: false,
+          channel_cleared: false,
+          removed_projects: [],
+          kept_projects: [],
+          purged_dirs: [],
+          binary_action: nil
+        }
+
+        # Capture the channel BEFORE clearing its marker so the binary step
+        # still knows who owns the install.
+        @channel = Hive::InstallLayout.read_channel(@env)
+        summary[:service_deregistered] = deregister_service!
+        summary[:channel_cleared] = clear_channel_marker!
+        handle_project_scaffolds!(summary)
+        purge_extras!(summary) if @purge
+        remove_binary!(summary)
+        print_skills_reminder
+        print_preserved_note(summary)
+
+        summary
+      end
+
+      private
+
+      def deregister_service!
+        service = @service_factory.call
+        return false if service.nil?
+
+        service.unregister!
+        true
+      rescue StandardError => e
+        @err.puts "hive uninstall: service deregistration skipped (#{e.message})"
+        false
+      end
+
+      def clear_channel_marker!
+        return false if Hive::InstallLayout.read_channel(@env).nil?
+
+        Hive::InstallLayout.clear_channel(@env)
+        true
+      end
+
+      # Candidate scaffolds = the cwd's own `.hive-state/` plus every
+      # registered project whose path lives at-or-under the cwd. Each is
+      # prompted separately (R14); non-interactive runs keep everything.
+      def handle_project_scaffolds!(summary)
+        candidates(project_root_scaffold + registered_scaffolds).each do |dir|
+          if confirm_removal(dir)
+            FileUtils.rm_rf(dir)
+            summary[:removed_projects] << dir
+          else
+            summary[:kept_projects] << dir
+          end
+        end
+      end
+
+      def candidates(*groups)
+        groups.flatten.uniq.select { |d| File.directory?(d) }
+      end
+
+      def project_root_scaffold
+        [File.join(@project_root, PROJECT_DIR_NAME)]
+      end
+
+      def registered_scaffolds
+        projects = Array(@projects_provider.call)
+        projects.filter_map do |entry|
+          path = entry["path"].to_s
+          state = entry["hive_state_path"].to_s
+          next if path.empty? || state.empty?
+          next unless path == @project_root || path.start_with?("#{@project_root}#{File::SEPARATOR}")
+
+          File.expand_path(state)
+        end
+      end
+
+      def confirm_removal(dir)
+        return true if @yes
+
+        @prompter.call(
+          "Remove project scaffold #{dir}? " \
+          "(deletes this project's task folders and stage history) [y/N]: "
+        )
+      end
+
+      def purge_extras!(summary)
+        [Hive::InstallLayout.config_dir(@env), Hive::InstallLayout.cache_dir(@env)].each do |dir|
+          next unless File.directory?(dir)
+
+          FileUtils.rm_rf(dir)
+          summary[:purged_dirs] << dir
+        end
+      end
+
+      def remove_binary!(summary)
+        case @channel
+        when "brew"
+          summary[:binary_action] =
+            "package-manager owned — run: #{BREW_UNINSTALL_CMD}"
+        when "aur"
+          summary[:binary_action] =
+            "package-manager owned — run: #{AUR_UNINSTALL_CMD}"
+        when "script"
+          name = Hive::NameConflict.resolve_install_name("hive", "hv", path: @env["PATH"])
+          [name, Hive::NameConflict::FALLBACK_NAME].uniq.each do |bin_name|
+            FileUtils.rm_f(File.join(Hive::InstallLayout.bin_dir(@env), bin_name))
+          end
+          summary[:binary_action] = "removed #{File.join(Hive::InstallLayout.bin_dir(@env), 'hive')}"
+        else
+          summary[:binary_action] =
+            "install channel unknown — locate the hive binary with `command -v hive` " \
+            "and remove it manually (or via its package manager)"
+        end
+        @out.puts "hive uninstall: binary — #{summary[:binary_action]}"
+      end
+
+      def print_skills_reminder
+        @out.puts ""
+        @out.puts "Note: hive skills/plugins are installed through each coding agent's own" \
+                   " marketplace (e.g. Claude Code `/plugin marketplace add`). This uninstall" \
+                   " leaves them untouched — remove them from each agent's plugin management."
+      end
+
+      def print_preserved_note(_summary)
+        @out.puts(
+          "Preserved: #{Hive::InstallLayout.state_dir(@env)} and all project work artifacts " \
+          "outside the scaffolds you chose to remove."
+        )
+      end
+
+      def default_prompter(err)
+        lambda { |question|
+          if $stdin.respond_to?(:tty?) && $stdin.tty?
+            err.print question
+            err.flush
+            answer = $stdin.gets
+            answer.nil? ? false : answer.strip.downcase.start_with?("y")
+          else
+            err.puts "hive uninstall: skipping (non-interactive): #{question.sub(/ \[y\/N\]: \z/, "")}"
+            false
+          end
+        }
+      end
+
+      def default_service_factory
+        lambda {
+          require "hive/service"
+          Hive::Service.for_platform
+        }
+      end
+    end
+  end
+end
diff --git a/lib/hive/commands/update.rb b/lib/hive/commands/update.rb
new file mode 100644
index 000000000..95295a313
--- /dev/null
+++ b/lib/hive/commands/update.rb
@@ -0,0 +1,94 @@
+require "shellwords"
+require "hive/install_layout"
+
+module Hive
+  module Commands
+    # `hive update` — channel-native upgrade (plan R13).
+    #
+    # Reads the install-channel marker written by each installer (U2–U4) and
+    # shells out to the owning package manager. It NEVER swaps the binary in
+    # place: brew-managed installs go through `brew upgrade`, AUR installs
+    # through the user's AUR helper / pacman, and one-liner installs re-run
+    # install.sh pinned to the latest tag.
+    #
+    # When the marker is absent or ambiguous the command refuses with a
+    # usage error instead of guessing — guessing is how brew/pacman-owned
+    # installs get corrupted.
+    class Update
+      REPO = "ivankuznetsov/hive".freeze
+      TAP_TOKEN = "ivankuznetsov/hive/hive".freeze
+
+      # Marker missing/unreadable → refuse (USAGE, exit 64 via InvalidTaskPath).
+      class ChannelUnknown < Hive::InvalidTaskPath; end
+
+      AUR_HELPERS = %w[yay paru].freeze
+
+      attr_reader :channel
+
+      def initialize(channel: nil, env: ENV, runner: nil, which: nil, out: $stdout, err: $stderr)
+        @requested_channel = channel
+        @env = env
+        @runner = runner || ->(*argv) { run_command!(*argv) }
+        @which = which || ->(bin) { which_bin(bin) }
+        @out = out
+        @err = err
+      end
+
+      def call
+        @channel = (@requested_channel || Hive::InstallLayout.read_channel(@env)).to_s.strip.downcase
+        unless Hive::InstallLayout::CHANNELS.include?(@channel)
+          raise ChannelUnknown,
+            "hive update: install channel unknown or ambiguous " \
+            "(marker at #{Hive::InstallLayout.channel_marker_path(@env)}). " \
+            "Refusing to guess — re-run your original install command instead " \
+            "(brew upgrade #{TAP_TOKEN} / yay -Syu hive-bin / the install.sh one-liner), " \
+            "or pass --channel {brew|aur|script}."
+        end
+
+        send("update_#{@channel}")
+        @out.puts "hive update: #{@channel} channel upgrade complete."
+      end
+
+      private
+
+      def update_brew
+        @runner.call("brew", "upgrade", TAP_TOKEN)
+      end
+
+      def update_aur
+        helper = AUR_HELPERS.find { |h| @which.call(h) }
+        if helper
+          @runner.call(helper.to_s, "-Syu", "hive-bin")
+        elsif @which.call("pacman")
+          @err.puts "hive update: no AUR helper found; falling back to pacman (may need sudo)"
+          @runner.call("sudo", "pacman", "-Syu", "hive-bin")
+        else
+          raise Hive::Error,
+                "hive update: neither an AUR helper (yay, paru) nor pacman was found on PATH"
+        end
+      end
+
+      def update_script
+        url = "https://github.com/#{REPO}/releases/latest/download/install.sh"
+        # Re-run the official one-liner (pinned-latest); it verifies checksums
+        # and upgrades in place idempotently. Never touch the binary here.
+        @runner.call("bash", "-c", "curl -fsSL #{url.shellescape} | bash -s --")
+      end
+
+      def run_command!(*argv)
+        system(*argv) || raise(
+          Hive::Error,
+          "hive update: step failed (exit #{$?.exitstatus}): #{argv.shelljoin}"
+        )
+      end
+
+      def which_bin(bin)
+        @env.fetch("PATH", "").split(File::PATH_SEPARATOR).each do |dir|
+          candidate = File.join(dir, bin)
+          return candidate if File.file?(candidate) && File.executable?(candidate)
+        end
+        nil
+      end
+    end
+  end
+end
diff --git a/lib/hive/install_layout.rb b/lib/hive/install_layout.rb
new file mode 100644
index 000000000..4608d55d4
--- /dev/null
+++ b/lib/hive/install_layout.rb
@@ -0,0 +1,122 @@
+require "fileutils"
+
+module Hive
+  # XDG on-disk layout for packaged hive installs (plan "Hive Packaging &
+  # Installation v1", R8):
+  #
+  #   bin    ~/.local/bin/hive            (or /opt/homebrew/bin/hive via brew)
+  #   config ~/.config/hive/              (install-channel marker lives here)
+  #   assets ~/.local/share/hive/
+  #   state  ~/.local/state/hive/         (migrates the legacy ~/.hive-state/)
+  #   cache  ~/.cache/hive/
+  #
+  # All accessors honor the standard XDG_* environment variables so tests and
+  # sandboxed runs can redirect every path.
+  module InstallLayout
+    # Install channels recorded by each installer (U2–U4). `hive update`
+    # refuses to guess when this marker is missing or unreadable (R13).
+    CHANNELS = %w[brew aur script].freeze
+    CHANNEL_MARKER_NAME = "install-channel".freeze
+
+    LEGACY_STATE_DIR = File.expand_path("~/.hive-state").freeze
+
+    module_function
+
+    def config_dir(env = ENV)
+      File.join(xdg(env, "XDG_CONFIG_HOME", ".config"), "hive")
+    end
+
+    def state_dir(env = ENV)
+      File.join(xdg(env, "XDG_STATE_HOME", ".local/state"), "hive")
+    end
+
+    def cache_dir(env = ENV)
+      File.join(xdg(env, "XDG_CACHE_HOME", ".cache"), "hive")
+    end
+
+    def data_dir(env = ENV)
+      File.join(xdg(env, "XDG_DATA_HOME", ".local/share"), "hive")
+    end
+
+    def bin_dir(env = ENV)
+      env["HIVE_BIN_DIR"].to_s.empty? ? File.expand_path("~/.local/bin") : env["HIVE_BIN_DIR"]
+    end
+
+    def xdg(env, var, default_suffix)
+      value = env[var]
+      return value if value.is_a?(String) && !value.empty?
+
+      File.expand_path(default_suffix, "~")
+    end
+
+    def channel_marker_path(env = ENV)
+      File.join(config_dir(env), CHANNEL_MARKER_NAME)
+    end
+
+    # Returns the normalized channel ("brew" / "aur" / "script") or nil when
+    # the marker is absent, empty, or holds an unknown value. nil means "do
+    # not know" — callers must refuse rather than guess (R13).
+    def read_channel(env = ENV)
+      path = channel_marker_path(env)
+      return nil unless File.file?(path)
+
+      channel = File.read(path).to_s.strip.downcase
+      CHANNELS.include?(channel) ? channel : nil
+    end
+
+    def write_channel(channel, env = ENV)
+      unless CHANNELS.include?(channel)
+        raise Hive::Error,
+              "unknown install channel #{channel.inspect} (expected one of #{CHANNELS.join(", ")})"
+      end
+
+      dir = config_dir(env)
+      FileUtils.mkdir_p(dir)
+      File.write(File.join(dir, CHANNEL_MARKER_NAME), "#{channel}\n")
+      channel
+    end
+
+    def clear_channel(env = ENV)
+      FileUtils.rm_f(channel_marker_path(env))
+    end
+
+    # One-time migration of the legacy ~/.hive-state directory into
+    # ~/.local/state/hive (R8/R14). Copy-then-rename with a backup of the
+    # original: on any failure the original directory is left untouched.
+    #
+    # Returns one of:
+    #   :migrated          — copied to state_dir; original renamed to a backup
+    #   :absent            — no legacy directory present (common case)
+    #   :already_migrated  — state_dir already exists; legacy left as-is
+    #   :backup_exists     — both target and backup present; refusing to touch
+    #                        either so an operator can reconcile by hand
+    #   :failed            — copy failed; partial target removed, original kept
+    def migrate_legacy_state!(env = ENV)
+      legacy = legacy_state_dir(env)
+      target = state_dir(env)
+
+      return :absent unless File.directory?(legacy)
+      return :already_migrated if File.directory?(target)
+
+      backup = "#{legacy}.migrated-backup"
+      return :backup_exists if File.exist?(backup)
+
+      begin
+        FileUtils.mkdir_p(File.dirname(target))
+        FileUtils.cp_r(legacy, target)
+        File.rename(legacy, backup)
+        :migrated
+      rescue StandardError
+        # Never delete user data on failure — only unwind our own partial
+        # copy; the original legacy directory remains in place.
+        FileUtils.rm_rf(target)
+        :failed
+      end
+    end
+
+    def legacy_state_dir(env = ENV)
+      override = env["HIVE_LEGACY_STATE_DIR"]
+      override.to_s.empty? ? LEGACY_STATE_DIR : File.expand_path(override)
+    end
+  end
+end
diff --git a/lib/hive/name_conflict.rb b/lib/hive/name_conflict.rb
new file mode 100644
index 000000000..30dcf761e
--- /dev/null
+++ b/lib/hive/name_conflict.rb
@@ -0,0 +1,49 @@
+module Hive
+  # `hive` command-name conflict resolution (plan R10).
+  #
+  # Apache Hive (and other tools) may already own `hive` on PATH. Packaged
+  # installs fall back to the name `hv` in that case: installers call
+  # `resolve_install_name` at install time, and runtime code can use
+  # `conflicted?` to explain which binary it detected.
+  module NameConflict
+    DEFAULT_NAME = "hive".freeze
+    FALLBACK_NAME = "hv".freeze
+
+    module_function
+
+    # Absolute PATH entry of a foreign executable named bin_name — i.e. one
+    # that does not resolve to the running hive program itself — or nil when
+    # the name is free (or only occupied by us).
+    def foreign_path(bin_name = DEFAULT_NAME, path: ENV["PATH"], self_program: $PROGRAM_NAME)
+      self_real = safe_realpath(self_program)
+      (path || "").split(File::PATH_SEPARATOR).each do |dir|
+        next if dir.nil? || dir.empty?
+
+        candidate = File.join(dir, bin_name)
+        next unless File.file?(candidate) && File.executable?(candidate)
+
+        real = safe_realpath(candidate)
+        next if self_real && real && real == self_real
+
+        return candidate
+      end
+      nil
+    end
+
+    def conflicted?(bin_name = DEFAULT_NAME, path: ENV["PATH"])
+      !foreign_path(bin_name, path: path).nil?
+    end
+
+    # The name a fresh install should use: falls back to `hv` exactly when a
+    # foreign `hive` occupies PATH.
+    def resolve_install_name(bin_name = DEFAULT_NAME, fallback = FALLBACK_NAME, path: ENV["PATH"])
+      conflicted?(bin_name, path: path) ? fallback : bin_name
+    end
+
+    def safe_realpath(path)
+      File.realpath(path.to_s)
+    rescue StandardError
+      nil
+    end
+  end
+end
diff --git a/lib/hive/service.rb b/lib/hive/service.rb
new file mode 100644
index 000000000..05d1937ef
--- /dev/null
+++ b/lib/hive/service.rb
@@ -0,0 +1,30 @@
+module Hive
+  # OS service registration for the hive daemon (plan U6): launchd agent on
+  # macOS, systemd --user unit on Linux. Registration is always opt-in —
+  # `hive init` prompts before enabling + starting anything.
+  module Service
+    LABEL = "com.hive.daemon".freeze
+    UNIT_NAME = "hive.service".freeze
+
+    ERB_DIR = File.expand_path("../../packaging/service", __dir__).freeze
+
+    class Error < Hive::Error; end
+
+    module_function
+
+    # Factory: picks the right backend for the current host. Raises a
+    # descriptive Service::Error on platforms with no supported backend
+    # (e.g. WSL2 without systemd) so callers degrade gracefully instead of
+    # half-registering.
+    def for_platform(host_os: RbConfig::CONFIG["host_os"], env: ENV)
+      case host_os
+      when /darwin/i
+        require "hive/service/launchd"
+        Launchd.new(env: env)
+      else
+        require "hive/service/systemd_user"
+        SystemdUser.new(env: env)
+      end
+    end
+  end
+end
diff --git a/lib/hive/service/launchd.rb b/lib/hive/service/launchd.rb
new file mode 100644
index 000000000..e0c596530
--- /dev/null
+++ b/lib/hive/service/launchd.rb
@@ -0,0 +1,115 @@
+require "erb"
+require "fileutils"
+require "shellwords"
+require "hive/install_layout"
+require "hive/service"
+
+module Hive
+  module Service
+    # launchd agent registration (macOS tier-1). Writes
+    # ~/Library/LaunchAgents/com.hive.daemon.plist and bootstraps it into the
+    # user's gui domain only when the operator opts in.
+    class Launchd
+      attr_reader :plist_path, :log_dir
+
+      def initialize(home: Dir.home, binary_path: nil, uid: Process.uid,
+                     template_path: File.join(Service::ERB_DIR, "com.hive.daemon.plist.erb"),
+                     runner: nil, env: ENV)
+        @home = home
+        @uid = uid
+        @binary_path = binary_path || default_binary_path
+        @template_path = template_path
+        @runner = runner || ->(*argv) { system(*argv) }
+        @plist_path = File.join(@home, "Library", "LaunchAgents", "#{Service::LABEL}.plist")
+        @log_dir = File.join(InstallLayout.state_dir(env), "logs")
+      end
+
+      # Render the plist from packaging/service/com.hive.daemon.plist.erb.
+      def render
+        @label = Service::LABEL
+        @log_out = File.join(@log_dir, "daemon.out.log")
+        @log_err = File.join(@log_dir, "daemon.err.log")
+        ERB.new(File.read(@template_path)).result(binding)
+      end
+
+      def installed?
+        File.file?(@plist_path)
+      end
+
+      # Path reported in user-facing messages (shared contract with
+      # SystemdUser#registration_path).
+      def registration_path
+        @plist_path
+      end
+
+      # Write (or refresh) the plist. Idempotent — re-running `hive init`
+      # overwrites in place instead of duplicating units.
+      def write!
+        FileUtils.mkdir_p(File.dirname(@plist_path))
+        FileUtils.mkdir_p(@log_dir)
+        File.write(@plist_path, render)
+        @plist_path
+      end
+
+      # Register into the user's gui launchd domain. start_now kicks the
+      # daemon immediately (the init prompt's "enable and start now").
+      def register!(start_now: false)
+        write! unless installed?
+        run!("launchctl", "bootstrap", "gui/#{@uid}", @plist_path)
+        start! if start_now
+        true
+      end
+
+      def start!
+        run!("launchctl", "kickstart", "-k", "gui/#{@uid}/#{Service::LABEL}")
+        true
+      end
+
+      # Stop without deleting the plist (inverse of start!/kickstart).
+      def stop!
+        run!("launchctl", "bootout", "gui/#{@uid}/#{Service::LABEL}")
+        true
+      end
+
+      # Fully remove: unload + delete the plist.
+      def unregister!
+        begin
+          stop!
+        rescue Service::Error
+          # Not currently loaded — nothing to unload; still remove the file.
+        end
+        FileUtils.rm_f(@plist_path)
+        true
+      end
+
+      def running?
+        run("launchctl", "print", "gui/#{@uid}/#{Service::LABEL}")
+      end
+
+      private
+
+      def default_binary_path
+        prefix = brew_prefix
+        candidates = []
+        candidates << File.join(prefix, "bin", "hive") if prefix && !prefix.empty?
+        candidates << File.join(InstallLayout.bin_dir, "hive")
+        candidates.find { |c| File.file?(c) } || candidates.first
+      end
+
+      def brew_prefix
+        return nil unless system("brew", "--prefix", out: File::NULL, err: File::NULL)
+
+        IO.popen(["brew", "--prefix"], &:read).strip
+      end
+
+      def run!(*argv)
+        ok = @runner.call(*argv)
+        raise Service::Error, "command failed: #{argv.shelljoin}" unless ok
+      end
+
+      def run(*argv)
+        @runner.call(*argv) ? true : false
+      end
+    end
+  end
+end
diff --git a/lib/hive/service/systemd_user.rb b/lib/hive/service/systemd_user.rb
new file mode 100644
index 000000000..d9005d0e1
--- /dev/null
+++ b/lib/hive/service/systemd_user.rb
@@ -0,0 +1,153 @@
+require "erb"
+require "fileutils"
+require "shellwords"
+require "hive/install_layout"
+require "hive/service"
+
+module Hive
+  module Service
+    # systemd --user unit registration (Linux tier-1). Writes
+    # ~/.config/systemd/user/hive.service and only enables + starts on the
+    # operator's explicit opt-in. WSL2 (tier-2) without systemd degrades to
+    # a descriptive Service::Error carrying manual-start instructions.
+    class SystemdUser
+      attr_reader :unit_path, :binary_path
+
+      def initialize(home: Dir.home, binary_path: nil,
+                     template_path: File.join(Service::ERB_DIR, "hive.service.erb"),
+                     runner: nil, env: ENV, proc_version_path: "/proc/version",
+                     systemd_available: nil)
+        @home = home
+        @binary_path = binary_path || File.join(InstallLayout.bin_dir(env), "hive")
+        @template_path = template_path
+        @runner = runner || ->(*argv) { system(*argv) }
+        @env = env
+        @proc_version_path = proc_version_path
+        # Test/CI injection hook: when non-nil it short-circuits the probe.
+        @systemd_available_override = systemd_available
+        # systemd --user units live under $XDG_CONFIG_HOME/systemd/user.
+        config_base = InstallLayout.xdg(@env, "XDG_CONFIG_HOME", ".config")
+        @unit_path = File.join(config_base, "systemd", "user", Service::UNIT_NAME)
+      end
+
+      # Render the unit from packaging/service/hive.service.erb.
+      def render
+        template = ERB.new(File.read(@template_path))
+        ctx = TemplateContext.new(binary_path: @binary_path, home: @home)
+        template.result(ctx.get_binding)
+      end
+
+      def installed?
+        File.file?(@unit_path)
+      end
+
+      # Path reported in user-facing messages (shared contract with
+      # Launchd#registration_path).
+      def registration_path
+        @unit_path
+      end
+
+      def wsl2?
+        return false unless File.readable?(@proc_version_path)
+
+        File.read(@proc_version_path).match?(/microsoft/i)
+      rescue StandardError
+        false
+      end
+
+      def write!
+        dir = File.dirname(@unit_path)
+        FileUtils.mkdir_p(dir)
+        File.write(@unit_path, render)
+        @unit_path
+      end
+
+      def register!(start_now: false)
+        raise unsupported_error if wsl2? && !systemd_available?
+
+        write!
+        run!("systemctl", "--user", "daemon-reload")
+        if start_now
+          run!("systemctl", "--user", "enable", "--now", Service::UNIT_NAME)
+        else
+          # Declined autostart: unit exists but stays disabled.
+          nil
+        end
+        true
+      end
+
+      def start!
+        run!("systemctl", "--user", "start", Service::UNIT_NAME)
+        true
+      end
+
+      def stop!
+        run!("systemctl", "--user", "stop", Service::UNIT_NAME)
+        true
+      end
+
+      def unregister!
+        begin
+          stop!
+        rescue Service::Error
+          nil
+        end
+        run("systemctl", "--user", "disable", Service::UNIT_NAME)
+        FileUtils.rm_f(@unit_path)
+        begin
+          run!("systemctl", "--user", "daemon-reload")
+        rescue Service::Error
+          nil
+        end
+        true
+      end
+
+      def running?
+        run("systemctl", "--user", "is-active", "--quiet", Service::UNIT_NAME)
+      end
+
+      # Best-effort probe for a usable systemd user session.
+      def systemd_available?
+        return @systemd_available_override unless @systemd_available_override.nil?
+
+        dir = "/run/user/#{Process.uid}/systemd"
+        return true if File.directory?(dir)
+
+        run("systemctl", "--user", "is-system-running") || false
+      end
+
+      private
+
+      def unsupported_error
+        Service::Error.new(
+          "systemd --user is not available in this environment (WSL2 or minimal container). " \
+          "Start the daemon manually with `hive daemon start --detach`, or enable systemd " \
+          "in /etc/wsl.conf ([boot] systemd=true) and re-run `hive init`."
+        )
+      end
+
+      def run!(*argv)
+        ok = @runner.call(*argv)
+        raise Service::Error, "command failed: #{argv.shelljoin}" unless ok
+      end
+
+      def run(*argv)
+        @runner.call(*argv) ? true : false
+      end
+
+      # Minimal binding context matching the ERB's local-variable style.
+      class TemplateContext
+        attr_reader :binary_path, :home
+
+        def initialize(binary_path:, home:)
+          @binary_path = binary_path
+          @home = home
+        end
+
+        def get_binding
+          binding
+        end
+      end
+    end
+  end
+end
