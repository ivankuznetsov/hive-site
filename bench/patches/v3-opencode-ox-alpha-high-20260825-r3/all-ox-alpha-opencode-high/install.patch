+      def resolve_start_daemon(flag, env)
+        return flag unless flag.nil?
+
+        env_value = env["HIVE_INIT_DAEMON"].to_s.strip.downcase
+        return false if %w[no 0 false skip].include?(env_value)
+        return true if %w[yes 1 true start].include?(env_value)
+
+        nil
+      end
+
+      # U6/R12: register the daemon as a login service (launchd agent /
+      # systemd --user unit), gated by an explicit opt-in. Never fails init:
+      # any registration problem degrades to a stderr warning.
+      def register_daemon_service!
+        choice = service_choice
+        if choice == :prompt
+          choice = prompt_service_opt_in
+        end
+        return if choice == :skip
+
+        require "hive/service"
+        service = @service_factory.call
+        if service.installed?
+          warn "hive: daemon service already registered at #{service.registration_path}; leaving it in place"
+          return
+        end
+
+        service.register!(start_now: true)
+        warn "hive: daemon service registered and started (#{service.registration_path})"
+      rescue StandardError => e
+        warn "hive: daemon service registration skipped (#{e.message}); " \
+             "run `hive init --start-daemon` again or start manually with `hive daemon start --detach`"
+      end
+
+      def service_choice
+        return :skip if @start_daemon == false
+        return :start if @start_daemon == true
+
+        tty = @prompts.respond_to?(:interactive?) ? @prompts.interactive? :
+                ($stdin.respond_to?(:tty?) && $stdin.tty?)
+        tty ? :prompt : :skip
+      end
+
+      def prompt_service_opt_in
+        $stderr.print "Register the hive daemon as a login service and start it now? [y/N]: "
+        $stderr.flush
+        answer = $stdin.gets
+        answer.to_s.strip.downcase.start_with?("y") ? :start : :skip
+      rescue StandardError
+        :skip
+      end
+
+      def default_service
+        require "hive/service"
+        Hive::Service.for_platform(env: @env)
+      end
