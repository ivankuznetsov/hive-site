+      get "/health/daemon"
+      assert_response :success
+      assert_match(/ok/, response.body)
+      refute_match(/Repair daemon/, response.body,
+                   "a consistent daemon offers no repair action")
+    end
+  end
+
+  test "simulated drift renders degraded status with the concrete finding" do
+    sign_in!
+    drifted = FakeProbe.new(
+      report: Report.new(status: "path_mismatch", expected_binary: "/bin/hive",
+                         unit_binary: "/usr/bin/hive", expected_version: Hive::VERSION,
+                         unit_version: nil, unit_path: "/u/hive-daemon.service",
+                         detail: "drift: unit pins /usr/bin/hive")
+    )
+    with_probe(drifted) do
+      get "/health/daemon"
+      assert_response :success
+      assert_match(/\/usr\/bin\/hive/, response.body,
+                   "the degraded page names the drifted path, not a generic error")
+      assert_match(/Repair daemon/, response.body)
+    end
+  end
+
+  test "repair action converges the daemon through the shared repair routine" do
+    sign_in!
+    drifted = FakeProbe.new(
+      report: Report.new(status: "version_mismatch", detail: "stale"),
+      repair_to: Report.new(status: "ok", detail: "converged")
+    )
+    with_probe(drifted) do
+      post "/health/daemon/repair"
+      follow_redirect!
+
+      assert_equal 1, drifted.repair_calls
+      assert_match(/Daemon repaired/i, response.body)
+    end
+  end
+
+  test "drift JSON is 503 with the structured report; healthy JSON is 200" do
+    sign_in!
+    drifted = FakeProbe.new(
+      report: Report.new(status: "not_running", expected_binary: "/bin/hive",
+                         unit_binary: "/bin/hive", expected_version: Hive::VERSION,
+                         unit_version: nil, unit_path: "/u/unit.service", detail: "stopped")
+    )
+    with_probe(drifted) do
+      get "/health/daemon", headers: { "ACCEPT" => "application/json" }
+      assert_response :service_unavailable
+      assert_equal "not_running", response.parsed_body["status"]
+    end
+
+    healthy = FakeProbe.new(
+      report: Report.new(status: "ok", detail: "fine")
+    )
+    with_probe(healthy) do
+      get "/health/daemon", headers: { "ACCEPT" => "application/json" }
+      assert_response :success
+      assert_equal true, response.parsed_body["ok"]
+    end
+  end
 end
