+  def test_plist_units_are_parsed_through_the_unit_binary_dispatch
+    Dir.mktmpdir("hive-drift-plist") do |dir|
+      plist = File.join(dir, "Library/LaunchAgents/local.hive-daemon.plist")
+      FileUtils.mkdir_p(File.dirname(plist))
+      File.write(plist, <<~PLIST)
+        <key>ProgramArguments</key>
+        <array>
+          <string>/bin/sh</string>
+          <string>-c</string>
+          <string>[ -x "$0" ] || exit 0; exec "$0" "$@"</string>
+          <string>#{dir}/bin/hive</string>
+          <string>daemon</string>
+          <string>start</string>
+        </array>
+      PLIST
+
+      installer_double = Struct.new(:target_path).new(plist)
+      check = Hive::Local::DaemonDriftCheck.new(
+        binary_path: File.join(dir, "bin", "hive"),
+        installer: installer_double
