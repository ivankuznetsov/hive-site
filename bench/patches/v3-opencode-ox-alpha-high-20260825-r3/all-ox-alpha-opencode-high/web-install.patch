@@ -0,0 +1,357 @@
+require "test_helper"
+require "hive/local/dependency_audit"
+
+class DependencyAuditTest < Minitest::Test
+  include HiveTestHelper
+
+  def test_classify_ok_when_present_version_ok_and_authenticated
+    assert_equal "ok", Hive::Local::DependencyAudit.classify(present: true)
+  end
+
+  def test_classify_wrong_version_outranks_unauthenticated
+    # A stale binary must be upgraded before re-authenticating, so the
+    # version finding wins over the auth finding.
+    assert_equal "wrong_version",
+                 Hive::Local::DependencyAudit.classify(present: true, version_ok: false, authenticated: false)
+  end
+
+  def test_classify_reports_missing_before_auth_when_absent
+    assert_equal "missing",
+                 Hive::Local::DependencyAudit.classify(present: false, authenticated: false)
+  end
+
+  def test_classify_reports_unauthenticated_for_present_binary
+    assert_equal "unauthenticated",
+                 Hive::Local::DependencyAudit.classify(present: true, authenticated: false)
+  end
+
+  def test_audit_all_present_yields_ok_rows
+    Dir.mktmpdir("hive-audit-bin") do |bin_dir|
+      %w[git tmux gh node npm].each { |name| stub_bin(bin_dir, name) }
+      runner = ok_runner
+      with_agent_credential(:claude) do |home|
+        with_env("HOME" => home) do
+          rows = audit_with(bin_path: bin_dir, gh_runner: runner)
+          by_name = rows.to_h { |r| [ r.name, r ] }
+
+          assert_equal "ok", by_name.fetch("ruby").status
+          assert_equal "ok", by_name.fetch("gh").status
+          assert by_name.fetch("gh").critical, "gh is dispatch-critical"
+          %w[git tmux node npm].each do |name|
+            assert_equal "ok", by_name.fetch(name).status, "#{name} present ⇒ ok"
+            refute by_name.fetch(name).critical
+          end
+        end
+      end
+    end
+  end
+
+  def test_missing_claude_is_reported_missing_with_install_command_and_never_installed
+    Dir.mktmpdir("hive-audit-bin") do |bin_dir|
+      # Deliberately claude-free PATH (no fallback to the system PATH, so the
+      # test stays deterministic on machines that DO have claude installed).
+      with_agent_home_missing_credentials do
+        with_env("PATH" => "#{bin_dir}#{File::PATH_SEPARATOR}/usr/bin:/bin") do
+          row = Hive::Local::DependencyAudit.check_agent("claude", env: ENV)
+
+          assert_equal "missing", row.status
+          assert row.critical, "claude is dispatch-critical"
+          assert row.fix_commands.any?, "a missing external must carry an exact fix command"
+          refute_includes row.fix_commands.join(" "), "&&",
+                          "no chained auto-install command may be offered for an external dep"
+        end
+      end
+    end
+  end
+
+  def test_installed_but_unauthenticated_claude_reports_unauthenticated_without_login_attempt
+    Dir.mktmpdir("hive-audit-bin") do |bin_dir|
+      stub_bin(bin_dir, "claude")
+      commands_run = []
+      login_runner = lambda do |*argv|
+        commands_run << argv
+        [ "", "", false ]
+      end
+      with_agent_home_missing_credentials do
+        rows = nil
+        with_env("PATH" => "#{bin_dir}#{File::PATH_SEPARATOR}/usr/bin:/bin") do
+          rows = Hive::Local::DependencyAudit.audit(runner: login_runner)
+        end
+        row = rows.find { |r| r.name == "claude" }
+
+        assert_equal "unauthenticated", row.status
+        assert_empty commands_run.select { |argv| argv.join(" ").include?("login") },
+                     "the audit must never attempt a login flow itself"
+        assert row.fix_commands.any? { |cmd| cmd.include?("login") || cmd.include?("Agents") }
+      end
+    end
+  end
+
+  def test_ruby_below_minimum_reports_wrong_version_with_guidance
+    row = Hive::Local::DependencyAudit.check_ruby(current: "3.3.9")
+
+    assert_equal "wrong_version", row.status
+    assert_includes row.fix_commands.first, "3.4"
+  end
+
+  def test_qmd_absent_is_hive_owned_and_bootstrapable
+    Dir.mktmpdir("hive-audit-xdg") do |xdg|
+      with_env("XDG_DATA_HOME" => xdg, "HIVE_QMD_BIN" => "") do
+        row = Hive::Local::DependencyAudit.check_qmd(env: ENV)
+
+        assert_equal "missing", row.status
+        assert row.hive_owned?
+        assert_includes row.fix_commands.first, "@tobilu/qmd"
+      end
+    end
+  end
+
+  def test_qmd_bootstrap_runs_npm_install_into_hive_prefix_and_reports_success
+    Dir.mktmpdir("hive-audit-xdg") do |xdg|
+      commands = []
+      runner = lambda do |*argv|
+        commands << argv
+        [ "", "", argv[0] == "npm" ]
+      end
+      check = Hive::Local::DependencyAudit.build_check(
+        name: "qmd", kind: "hive_owned", status: "missing", detail: ""
+      )
+      with_env("XDG_DATA_HOME" => xdg) do
+        assert Hive::Local::DependencyAudit.bootstrap!(check, runner: runner)
+      end
+
+      cmd = commands.first
+      assert_equal "npm", cmd[0]
+      assert_equal "@tobilu/qmd", cmd.last
+      assert_includes cmd.join(" "), File.join(xdg, "hive", "qmd")
+    end
+  end
+
+  def test_bootstrap_refuses_external_deps
+    check = Hive::Local::DependencyAudit.build_check(
+      name: "claude", kind: "external", status: "missing", detail: ""
+    )
+    commands = []
+    runner = ->(*argv) { commands << argv; [ "", "", true ] }
+
+    refute Hive::Local::DependencyAudit.bootstrap!(check, runner: runner),
+           "external deps must never be auto-installed"
+    assert_empty commands
+  end
+
+  def test_web_bundle_check_failure_surfaces_bundler_error_verbatim
+    app = fake_rails_app(with_lockfile: true)
+    runner = ->(*) { [ "", "Could not find rake-13.x in any cache\n", false ] }
+    with_env("HIVEBOX_WEB_APP_DIR" => app) do
+      row = Hive::Local::DependencyAudit.check_web_bundle(runner: runner)
+
+      assert_equal "missing", row.status
+      assert_includes row.detail, "Could not find rake-13.x",
+                      "bundler's own error must surface verbatim, not be paraphrased away"
+      assert row.hive_owned?
+      assert_includes row.fix_commands.first, "bundle install"
+    end
+  ensure
+    FileUtils.rm_rf(app) if app
+  end
+
+  def test_web_bundle_satisfied_when_bundle_check_passes
+    app = fake_rails_app(with_lockfile: true)
+    runner = ->(*) { [ "", "", true ] }
+    with_env("HIVEBOX_WEB_APP_DIR" => app) do
+      row = Hive::Local::DependencyAudit.check_web_bundle(runner: runner)
+
+      assert_equal "ok", row.status
+    end
+  ensure
+    FileUtils.rm_rf(app) if app
+  end
+
+  def test_web_bundle_bootstrap_uses_the_app_gemfile
+    app = fake_rails_app(with_lockfile: true)
+    with_env("HIVEBOX_WEB_APP_DIR" => app) do
+      cmd = Hive::Local::DependencyAudit.bootstrap_command("web-bundle")
+
+      assert_equal File.join(app, "Gemfile"), cmd.last
+    end
+  ensure
+    FileUtils.rm_rf(app) if app
+  end
+
+  def test_gh_unauthenticated_reports_exact_login_command_without_running_it
+    Dir.mktmpdir("hive-audit-bin") do |bin_dir|
+      stub_bin(bin_dir, "gh")
+      commands = []
+      runner = lambda do |*argv|
+        commands << argv
+        [ "", "", false ]
+      end
+      with_env("PATH" => "#{bin_dir}#{File::PATH_SEPARATOR}#{ENV['PATH']}") do
+        row = Hive::Local::DependencyAudit.check_gh(runner: runner)
+        probe = commands.first
+
+        assert_equal %w[gh auth status], probe, "only the read-only status probe may run"
+        assert_equal "unauthenticated", row.status
+        assert_equal ["gh auth login"], row.fix_commands
+      end
+    end
+  end
+
+  # ── helpers ────────────────────────────────────────────────────────────
+
+  def stub_bin(dir, name)
+    path = File.join(dir, name)
+    FileUtils.mkdir_p(dir)
+    File.write(path, "#!/bin/sh\nexit 0\n")
+    FileUtils.chmod(0o755, path)
+    path
+  end
+
+  # A qmd stub that answers `--version` with a fixed line (or fails).
+  def stub_versioned_qmd(dir, exit_code:, stderr: "")
+    path = File.join(dir, "qmd-#{exit_code}-#{rand(10_000)}")
+    File.write(path, <<~SH)
+      #!/bin/sh
+      if [ -n "#{stderr}" ]; then
+        echo "#{stderr}" >&2
+      fi
+      cat <<'EOF'
+      qmd-1.0.0
+      EOF
+      exit #{exit_code}
+    SH
+    FileUtils.chmod(0o755, path)
+    path
+  end
+
+  # ── probe-level edge cases (line-coverage critical) ────────────────────
+
+  def test_default_runner_reports_failure_for_missing_binary
+    out, err, ok = Hive::Local::DependencyAudit::DEFAULT_RUNNER.call("/nonexistent/hive-probe-bin")
+
+    assert_equal "", out
+    assert_equal "", err
+    refute ok
+  end
+
+  def test_check_binary_missing_branch_carries_install_guidance
+    missing = Hive::Local::DependencyAudit.check_binary("definitely-not-a-real-bin-xyz")
+
+    assert_equal "missing", missing.status
+    assert_includes missing.detail, "not found on PATH"
+    assert_includes missing.fix_commands.first, "definitely-not-a-real-bin-xyz"
+  end
+
+  def test_unknown_agent_profile_falls_back_to_a_missing_row
+    row = Hive::Local::DependencyAudit.check_agent("not-an-agent-profile")
+
+    assert_equal "missing", row.status
+    assert_equal "external", row.kind
+  end
+
+  def test_bootstrap_command_web_bundle_is_nil_without_an_app_gemfile
+    Dir.mktmpdir("hive-audit-emptyapp") do |dir|
+      FileUtils.mkdir_p(File.join(dir, "config"))
+      File.write(File.join(dir, "config", "application.rb"), "# marker")
+      with_env("HIVEBOX_WEB_APP_DIR" => dir) do
+        assert_nil Hive::Local::DependencyAudit.bootstrap_command("web-bundle")
+      end
+    end
+
+    with_env("HIVEBOX_WEB_APP_DIR" => "/nonexistent-hive-app") do
+      assert_nil Hive::Local::DependencyAudit.bootstrap_command("web-bundle"),
+                 "no app dir ⇒ no bootstrap command"
+    end
+  end
+
+  def test_qmd_ok_and_unavailable_paths_via_real_stubs
+    Dir.mktmpdir("hive-audit-qmd") do |dir|
+      good = stub_versioned_qmd(dir, exit_code: 0)
+      with_env("HIVE_QMD_BIN" => good) do
+        row = Hive::Local::DependencyAudit.check_qmd(env: ENV)
+
+        assert_equal "ok", row.status
+        assert_includes row.detail, "qmd-1.0"
+        assert_empty row.fix_commands
+      end
+
+      bad = stub_versioned_qmd(dir, exit_code: 1, stderr: "better-sqlite3 ABI mismatch")
+      with_env("HIVE_QMD_BIN" => bad) do
+        row = Hive::Local::DependencyAudit.check_qmd(env: ENV)
+
+        assert_equal "unavailable", row.status
+        assert_includes row.detail, "ABI mismatch"
+        assert row.fix_commands.first.include?("@tobilu/qmd")
+      end
+    end
+  end
+
+  def test_find_qmd_uses_path_and_install_prefix_candidates
+    Dir.mktmpdir("hive-audit-qmdpath") do |dir|
+      qmd = stub_bin(dir, "qmd")
+      with_env("HIVE_QMD_BIN" => "", "PATH" => "#{dir}#{File::PATH_SEPARATOR}#{ENV.fetch('PATH', '')}",
+               "XDG_DATA_HOME" => File.join(dir, "data")) do
+        assert_equal qmd, Hive::Local::DependencyAudit.find_qmd(env: ENV),
+                     "PATH candidate wins when no env override"
+      end
+    end
+
+    Dir.mktmpdir("hive-audit-qmdprefix") do |dir|
+      data_home = File.join(dir, "data")
+      prefix_root = File.join(dir, "custom-prefix")
+      stub_qmd = stub_bin(File.join(prefix_root, "hive", "qmd", "bin"), "qmd")
+      FileUtils.mkdir_p(File.join(data_home, "hive"))
+      File.write(File.join(data_home, "hive", "install-prefix"), "#{prefix_root}\n")
+      with_env("HIVE_QMD_BIN" => "", "XDG_DATA_HOME" => data_home,
+               "PATH" => "/usr/bin:/bin") do
+        assert_equal stub_qmd, Hive::Local::DependencyAudit.find_qmd(env: ENV),
+                     "install-prefix marker extends the candidate list"
+      end
+    end
+  end
+
+  def ok_runner
+    ->(*_argv) { [ "", "", true ] }
+  end
+
+  # Audit with a PATH that resolves every probed binary inside `bin_path`
+  # (falling back to the system PATH for anything not stubbed).
+  def audit_with(bin_path:, gh_runner: ok_runner)
+    rows = nil
+    with_env("PATH" => "#{bin_path}#{File::PATH_SEPARATOR}#{ENV.fetch('PATH', '')}") do
+      rows = Hive::Local::DependencyAudit.audit(runner: gh_runner)
+    end
+    rows
+  end
+
+  # Point HOME at a tmpdir so AgentProfiles.logged_in? probes a sandboxed
+  # credential location instead of the developer's real one.
+  def with_agent_credential(agent)
+    Dir.mktmpdir("hive-audit-home") do |home|
+      cred = case agent
+             when :claude then File.join(home, ".claude", ".credentials.json")
+             when :codex then File.join(home, ".codex", "auth.json")
+             end
+      FileUtils.mkdir_p(File.dirname(cred))
+      File.write(cred, '{"token":"x"}')
+      yield home
+    end
+  end
+
+  def with_agent_home_missing_credentials
+    Dir.mktmpdir("hive-audit-home") do |home|
+      with_env("HOME" => home) do
+        yield
+      end
+    end
+  end
+
+  def fake_rails_app(with_lockfile:)
+    dir = Dir.mktmpdir("hive-audit-app")
+    FileUtils.mkdir_p(File.join(dir, "config"))
+    File.write(File.join(dir, "config", "application.rb"), "# marker")
+    File.write(File.join(dir, "Gemfile"), "source 'https://rubygems.org'\n")
+    File.write(File.join(dir, "Gemfile.lock"), "GEM\n") if with_lockfile
+    dir
+  end
+end
