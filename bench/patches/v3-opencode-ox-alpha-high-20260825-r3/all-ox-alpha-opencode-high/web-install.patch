@@ -0,0 +1,46 @@
+require "test_helper"
+require "hive/web/bind_policy"
+
+class BindPolicyTest < Minitest::Test
+  def decide(bind:, unsafe_bind: false, https_origin: false)
+    Hive::Web::BindPolicy.decide(
+      bind: bind, unsafe_bind: unsafe_bind, https_origin: https_origin
+    )
+  end
+
+  def test_loopback_binds_are_allowed_without_auth
+    %w[127.0.0.1 ::1 localhost].each do |host|
+      decision = decide(bind: host)
+
+      assert decision.allowed?, "#{host} is loopback and must be allowed by default"
+      assert_nil decision.warning
+    end
+  end
+
+  def test_non_loopback_bind_is_refused_by_default_with_guidance
+    decision = decide(bind: "0.0.0.0")
+
+    refute decision.allowed?
+    assert_match(/--unsafe-bind/, decision.warning)
+    assert_match(/https/, decision.warning)
+  end
+
+  def test_https_origin_implies_fronting_proxy_and_allows_non_loopback
+    decision = decide(bind: "0.0.0.0", https_origin: true)
+
+    assert decision.allowed?
+    assert_nil decision.warning
+  end
+
+  def test_unsafe_bind_allows_but_prints_a_prominent_warning
+    decision = decide(bind: "0.0.0.0", unsafe_bind: true)
+
+    assert decision.allowed?
+    assert_match(/WARNING.*--unsafe-bind/m, decision.warning)
+  end
+
+  def test_ipv6_any_and_specific_addresses_are_non_loopback
+    refute decide(bind: "::").allowed?
+    refute decide(bind: "192.168.1.10").allowed?
+  end
+end
diff --git a/test/unit/web/service_lifecycle_test.rb b/test/unit/web/service_lifecycle_test.rb
