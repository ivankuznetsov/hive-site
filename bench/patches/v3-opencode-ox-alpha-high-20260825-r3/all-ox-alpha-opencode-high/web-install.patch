+<?xml version="1.0" encoding="UTF-8"?>
+<!--
+  Sample launchd plist for `hive web` (macOS) — the LOCAL web tier.
+
+  This file is installer-managed: `hive web install` rewrites the binary
+  argv (absolute path + bind/port) and the environment dictionary to match
+  the resolved binary and installing shell, then you load it with
+  `hive web start`. You normally do not edit this by hand.
+
+  This agent is SEPARATE from local.hive-daemon by design: daemon and web
+  have different lifecycles and must be restartable independently.
+  Foreground remains the zero-config default (`hive web`).
+
+  Logs land under ~/Library/Logs/hive-web.{out,err}.log (launchd capture).
+
+  The /bin/sh precheck wrapper converts "binary not executable" into a clean
+  exit 0 so KeepAlive { SuccessfulExit: false } STOPS respawning (same
+  respawn circuit-breaker as the daemon plist).
+-->
+<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
+  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">
+<dict>
+  <key>Label</key>
+  <string>local.hive-web</string>
+
+  <key>ProgramArguments</key>
+  <array>
+    <string>/bin/sh</string>
+    <string>-c</string>
+    <string>[ -x "$0" ] || exit 0; exec "$0" "$@"</string>
+    <string>/Users/YOU/.local/bin/hive</string>
+    <string>web</string>
+    <string>--host</string>
+    <string>127.0.0.1</string>
+    <string>--port</string>
+    <string>4567</string>
+  </array>
+
+  <key>RunAtLoad</key>
+  <true/>
+
+  <key>KeepAlive</key>
+  <dict>
+    <key>SuccessfulExit</key>
+    <false/>
+  </dict>
+
+  <key>ThrottleInterval</key>
+  <integer>30</integer>
+
+  <key>StandardOutPath</key>
+  <string>/Users/YOU/Library/Logs/hive-web.out.log</string>
+  <key>StandardErrorPath</key>
+  <string>/Users/YOU/Library/Logs/hive-web.err.log</string>
+
+  <key>EnvironmentVariables</key>
+  <dict>
+    <key>PATH</key>
+    <string>/Users/YOU/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
+    <key>XDG_CONFIG_HOME</key>
+    <string>/Users/YOU/.config/hive</string>
+    <key>XDG_DATA_HOME</key>
+    <string>/Users/YOU/.local/share/hive</string>
+    <key>XDG_STATE_HOME</key>
+    <string>/Users/YOU/.local/state/hive</string>
+  </dict>
+</dict>
+</plist>
diff --git a/examples/systemd/hive-web.service b/examples/systemd/hive-web.service
new file mode 100644
index 000000000..1288e579f
--- /dev/null
+++ b/examples/systemd/hive-web.service
@@ -0,0 +1,55 @@
+# Sample systemd-user unit for `hive web` (Linux) — the LOCAL web tier.
+#
+# This file is installer-managed: `hive web install` rewrites ExecStart=,
+# Environment=PATH=, and the HOME/XDG environment lines to match the
+# resolved binary, bind/port, and installing shell, then you enable it with
+# `hive web start`. You normally do not edit this by hand.
+#
+# This unit is SEPARATE from hive-daemon.service by design: daemon and web
+# have different lifecycles (the daemon dispatches agents; the web tier
+# serves HTTP) and must be restartable independently.
+#
+# Foreground remains the zero-config default (`hive web`); this managed
+# service is strictly optional.
+#
+# Stop / restart:
+#   systemctl --user stop hive-web
+#   systemctl --user restart hive-web
+#
+# View logs:
+#   journalctl --user -u hive-web -f
+#
+# To survive logout (run when no user session is active):
+#   sudo loginctl enable-linger $USER
+
+[Unit]
+Description=Hive local web UI
+After=default.target network-online.target
+Wants=network-online.target
+# Hard cap on the auto-restart loop: a misconfigured ExecStart= or a port
+# collision marks the unit `failed` after 3 attempts in 5 minutes instead of
+# respawning forever.
+StartLimitBurst=3
+StartLimitIntervalSec=300
+
+[Service]
+Type=simple
+# systemd user services do NOT inherit your interactive shell's environment,
+# so every path below is baked at install time:
+#   PATH          — gem wrapper shebang resolution (mise/rbenv/asdf shim
+#                   detection mirrors the daemon installer)
+#   HIVE_HOME     — preserved ONLY when your shell exports it; otherwise the
+#                   standard XDG layout applies
+#   XDG_*_HOME    — absolute values from the installing shell so the served
+#                   app reads/writes exactly the same config/state as the TUI
+Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
+Environment=HIVE_HOME=
+Environment=XDG_CONFIG_HOME=
+Environment=XDG_DATA_HOME=
+Environment=XDG_STATE_HOME=
+ExecStart=%h/.local/bin/hive web --host 127.0.0.1 --port 4567
+Restart=on-failure
+RestartSec=10
+
+[Install]
+WantedBy=default.target
