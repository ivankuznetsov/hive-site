+  # ── helpers ────────────────────────────────────────────────────────────
+
+  def drift_struct(status, expected_binary:, unit_binary:, expected_version:,
+                   unit_version:, unit_path:, running_pid:, detail: status)
+    Hive::Local::DaemonDriftCheck::Result.new(
+      status: status, expected_binary: expected_binary, unit_binary: unit_binary,
+      expected_version: expected_version, unit_version: unit_version,
+      unit_path: unit_path, running_pid: running_pid, detail: detail
+    )
+  end
+
+  # A bare instance whose collaborators are never touched by the parse
+  # helpers under test.
+  def minimal_check
+    Hive::Local::DaemonDriftCheck.new(binary_path: nil, home: "/nonexistent")
+  end
+
+  def with_sandbox
+    Dir.mktmpdir("hive-drift-home") do |dir|
+      hive_bin = File.join(dir, "bin", "hive")
+      FileUtils.mkdir_p(File.dirname(hive_bin))
+      File.write(hive_bin, "#!/bin/sh\n[ \"$1\" = version ] && echo #{Hive::VERSION}\nexit 0\n")
+      FileUtils.chmod(0o755, hive_bin)
+      statedir = File.join(dir, "state")
+      FileUtils.mkdir_p(statedir)
+      yield dir, hive_bin, statedir
+    end
