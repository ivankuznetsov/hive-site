diff --git a/lib/hive/commands/web/service_installer.rb b/lib/hive/commands/web/service_installer.rb
new file mode 100644
index 000000000..580314ced
--- /dev/null
+++ b/lib/hive/commands/web/service_installer.rb
@@ -0,0 +1,209 @@
+require "cgi"
+require "shellwords"
+require "hive/commands/service_installer/base"
+require "hive/config"
+
+module Hive
+  module Commands
+    class Web
+      # Per-user managed-service installer for the hivebox web tier (plan U3).
+      # Reuses the shared ServiceInstaller::Base mechanics (drift/backup,
+      # atomic write, shim-PATH detection, enable/load orchestration) with a
+      # SEPARATE identity from the daemon — `hive-web.service` /
+      # `local.hive-web` — because merging daemon and web into one unit is
+      # explicitly forbidden by the local-mode plan.
+      #
+      # The generated unit pins the ABSOLUTE resolved path of the currently
+      # running hive binary and bakes the resolved bind/port plus the full
+      # XDG environment (HOME / XDG_*_HOME / PATH) so the served app sees
+      # exactly the same state as an interactive TUI run — the classic
+      # "works in terminal, broken as a service" failure mode.
+      class ServiceInstaller < Hive::Commands::ServiceInstaller::Base
+        attr_reader :bind, :port
+
+        def initialize(host_os: RbConfig::CONFIG["host_os"], home: nil, binary_path: nil,
+                       runner: nil, systemctl_available: nil, launchctl_available: nil,
+                       bind: nil, port: nil)
+          super(
+            host_os: host_os, home: home, binary_path: binary_path, runner: runner,
+            systemctl_available: systemctl_available, launchctl_available: launchctl_available
+          )
+          cfg = Hive::Config.load_global_web
+          @bind = bind || cfg.fetch("bind", "127.0.0.1")
+          @port = (port || cfg.fetch("port", 4567)).to_i
+        rescue Hive::Error, Hive::ConfigError
+          # An unreadable global config must not block writing a unit; fall
+          # back to the documented loopback defaults.
+          @bind ||= "127.0.0.1"
+          @port ||= 4567
+        end
+
+        def service_name
+          "hive-web"
+        end
+
+        def cli_label
+          "web"
+        end
+
+        def service_noun
+          "web service"
+        end
+
+        def unit_noun
+          "web unit"
+        end
+
+        def target_path
+          case platform
+          when :macos then File.join(@home, "Library/LaunchAgents/local.hive-web.plist")
+          when :linux then File.join(@home, ".config/systemd/user/hive-web.service")
+          end
+        end
+
+        def url
+          "http://#{@bind}:#{@port}"
+        end
+
+        # Bring the managed service up (no-op-safe when already running).
+        def start!
+          case platform
+          when :linux
+            unless systemctl_available?
+              @messages << "systemd not detected; run `hive web` in the foreground instead"
+              return false
+            end
+
+            ok_reload = @runner.call(%w[systemctl --user daemon-reload])
+            ok_start = @runner.call([ "systemctl", "--user", "start", service_name ])
+            unless ok_start
+              @messages << "systemctl --user start #{service_name} failed; run it manually to see why"
+              return false
+            end
+            ok_reload
+          when :macos
+            return launchd_unavailable! unless launchctl_available?
+
+            @runner.call([ "launchctl", "unload", target_path ]) # benign if not loaded
+            unless @runner.call([ "launchctl", "load", target_path ])
+              @messages << "launchctl load failed for #{target_path}; run it manually"
+              return false
+            end
+
+            true
+          else
+            @messages << "#{cli_label} autostart is not supported on this platform; run `hive web` in the foreground"
+            false
+          end
+        end
+
+        # Bring the managed service down. Idempotent.
+        def stop!
+          case platform
+          when :linux
+            return true unless systemctl_available?
+
+            @runner.call([ "systemctl", "--user", "stop", service_name ])
+          when :macos
+            return true unless launchctl_available?
+
+            @runner.call([ "launchctl", "unload", target_path ])
+          else
+            true
+          end
+        end
+
+        # Read-only liveness probe against the service manager.
+        def running?
+          case platform
+          when :linux
+            return false unless systemctl_available?
+
+            !!@runner.call("systemctl", "--user", "is-active", "--quiet", service_name)
+          when :macos
+            return false unless launchctl_available?
+
+            !!@runner.call("launchctl", "list", launchd_label)
+          else
+            false
+          end
+        end
+
+        # Refresh the manager's view after a manual unit rewrite (used by
+        # `uninstall` so systemd drops the removed unit promptly).
+        def reload_manager
+          case platform
+          when :linux then @runner.call(%w[systemctl --user daemon-reload]) if systemctl_available?
+          when :macos then nil # unload already detaches the plist
+          end
+        end
+
+        private
+
+        def launchd_unavailable!
+          @messages << "launchctl not found; run `hive web` in the foreground instead"
+          false
+        end
+
+        def render_systemd
+          template = File.read(File.expand_path("../../../../examples/systemd/hive-web.service", __dir__))
+          escaped = Shellwords.escape(resolved_binary)
+          template
+            .sub(/^ExecStart=.*$/, "ExecStart=#{escaped} web --host #{@bind} --port #{@port}")
+            .sub(/^Environment=PATH=.*$/, build_path_line)
+            .sub(/^Environment=HIVE_HOME=.*$/, env_line("HIVE_HOME"))
+            .sub(/^Environment=XDG_CONFIG_HOME=.*$/, env_line("XDG_CONFIG_HOME"))
+            .sub(/^Environment=XDG_DATA_HOME=.*$/, env_line("XDG_DATA_HOME"))
+            .sub(/^Environment=XDG_STATE_HOME=.*$/, env_line("XDG_STATE_HOME"))
+        end
+
+        def render_launchd
+          template = File.read(File.expand_path("../../../../examples/launchd/hive-web.plist", __dir__))
+          binary = CGI.escapeHTML(resolved_binary)
+          home = CGI.escapeHTML(@home)
+          template
+            .gsub(%r{<string>/Users/YOU/\.local/bin/hive</string>}, "<string>#{binary}</string>")
+            .gsub("<string>--host</string>\n    <string>127.0.0.1</string>",
+                  "<string>--host</string>\n    <string>#{CGI.escapeHTML(@bind.to_s)}</string>")
+            .gsub("<string>--port</string>\n    <string>4567</string>",
+                  "<string>--port</string>\n    <string>#{@port}</string>")
+            .gsub("/Users/YOU/Library/Logs", "#{home}/Library/Logs")
+            .gsub(%r{<key>PATH</key>\s*<string>[^<]*</string>},
+                  "<key>PATH</key>\n      <string>#{CGI.escapeHTML(launchd_path_value)}</string>")
+            .gsub(%r{<key>XDG_CONFIG_HOME</key>\s*<string>[^<]*</string>},
+                  "<key>XDG_CONFIG_HOME</key>\n      <string>#{CGI.escapeHTML(env_value("XDG_CONFIG_HOME").to_s)}</string>")
+            .gsub(%r{<key>XDG_DATA_HOME</key>\s*<string>[^<]*</string>},
+                  "<key>XDG_DATA_HOME</key>\n      <string>#{CGI.escapeHTML(env_value("XDG_DATA_HOME").to_s)}</string>")
+            .gsub(%r{<key>XDG_STATE_HOME</key>\s*<string>[^<]*</string>},
+                  "<key>XDG_STATE_HOME</key>\n      <string>#{CGI.escapeHTML(env_value("XDG_STATE_HOME").to_s)}</string>")
+        end
+
+        # Absolute XDG values from the INSTALLING shell, falling back to the
+        # XDG defaults Paths resolves at runtime. Baking absolute paths keeps
+        # the service's state resolution identical to the interactive TUI's.
+        def env_value(key)
+          current = ENV[key]
+          return current unless current.nil? || current.empty?
+
+          default_dir =
+            case key
+            when "XDG_CONFIG_HOME" then ".config"
+            when "XDG_DATA_HOME" then ".local/share"
+            when "XDG_STATE_HOME" then ".local/state"
+            end
+          File.join(@home, default_dir, "hive") if default_dir
+        end
+
+        def env_line(key)
+          value = env_value(key)
+          value ? "Environment=#{key}=#{Shellwords.escape(value)}" : ""
+        end
+
+        def launchd_path_value
+          base = [ "#{@home}/.local/bin", "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin" ]
+          base.join(":")
+        end
+      end
+    end
+  end
+end
diff --git a/lib/hive/local/daemon_drift.rb b/lib/hive/local/daemon_drift.rb
new file mode 100644
index 000000000..443a9079e
--- /dev/null
+++ b/lib/hive/local/daemon_drift.rb
@@ -0,0 +1,238 @@
+require "open3"
+require "shellwords"
+require "hive/pid_file"
+require "hive/invoked_binary"
+require "hive/local/dependency_audit"
+
+module Hive
+  module Local
+    # Daemon binary-consistency guarantee for local mode (plan U4 / AE3).
+    #
+    # The classic silent failure: the registered per-user daemon service was
+    # written by an older install (or a different package), so its pinned
+    # binary (`ExecStart=/usr/bin/hive ...` or an old shim path) no longer
+    # matches the `hive` on PATH — tasks created from the TUI or web never
+    # get picked up because the RUNNING daemon is a different program or a
+    # stale version.
+    #
+    # The check inspects the installed unit's pinned binary plus (when the
+    # daemon is alive) that binary's reported version, compares both against
+    # the invoking CLI's resolved path and version, classifies the drift,
+    # and offers `repair!`: rewrite the unit against the current binary
+    # (force install) and restart through the service manager, then
+    # re-verify. Idempotent — repairing a consistent daemon is a no-op
+    # force-install whose rendered content already matches.
+    class DaemonDriftCheck
+      include Hive::PidFile
+
+      STATUSES = %w[ok not_installed not_running path_mismatch version_mismatch].freeze
+
+      Result = Struct.new(:status, :expected_binary, :unit_binary, :expected_version,
+                          :unit_version, :unit_path, :running_pid, :detail,
+                          keyword_init: true) do
+        def ok?
+          status == "ok"
+        end
+      end
+
+      # Subprocess seam ([stdout, stderr, success]) — injectable for tests.
+      DEFAULT_RUNNER = lambda { |*argv|
+        out, err, st = Open3.capture3(*argv)
+        [ out, err, st.success? ]
+      rescue Errno::ENOENT, Errno::EACCES
+        [ "", "", false ]
+      }.freeze
+
+      # `installer:` is injectable so tests can hand in a fully stubbed
+      # service installer (recording runner, fake systemctl availability)
+      # instead of probing the real service manager.
+      def initialize(binary_path: Hive::InvokedBinary.path, expected_version: Hive::VERSION,
+                     home: nil, state_home: nil, runner: DEFAULT_RUNNER, installer: nil)
+        unless installer
+          require "hive/commands/daemon/service_installer"
+          installer = Hive::Commands::Daemon::ServiceInstaller.new(
+            binary_path: binary_path, home: home
+          )
+        end
+        @binary_path = binary_path
+        @expected_version = expected_version.to_s
+        @home = home
+        @state_home = state_home
+        @runner = runner
+        @installer = installer
+      end
+
+      # Pure classification core — precedence mirrors DependencyAudit:
+      # existence gates liveness gates consistency.
+      def self.classify(installed:, running:, paths_match:, versions_match:)
+        return "not_installed" unless installed
+        return "not_running" unless running
+        return "path_mismatch" unless paths_match
+        return "version_mismatch" unless versions_match
+
+        "ok"
+      end
+
+      def pid_file
+        base = @state_home || Hive::Paths.state_home
+        File.join(base, ".daemon.pid")
+      end
+
+      def call
+        expected = resolve(@binary_path)
+        unit_bin = unit_binary
+        installed = !@installer.target_path.nil? && File.exist?(@installer.target_path.to_s)
+        running_pid = read_live_pid
+        running = !running_pid.nil?
+
+        paths_match = !installed || (!unit_bin.nil? && equivalent_paths?(expected, resolve(unit_bin)))
+        versions_match = true
+        unit_version = nil
+        if installed && running && paths_match && !unit_bin.nil?
+          unit_version = probe_version(unit_bin)
+          versions_match = unit_version.nil? || unit_version == @expected_version
+        end
+
+        status = self.class.classify(
+          installed: installed, running: running,
+          paths_match: paths_match, versions_match: versions_match
+        )
+        Result.new(
+          status: status,
+          expected_binary: expected,
+          unit_binary: unit_bin,
+          expected_version: @expected_version,
+          unit_version: unit_version,
+          unit_path: installed ? @installer.target_path : nil,
+          running_pid: running_pid,
+          detail: detail_for(status, expected, unit_bin, unit_version, @installer.target_path)
+        )
+      end
+
+      # Converge the daemon service onto THIS binary+version: rewrite the
+      # unit (force install backs up any user hand-edit), restart through
+      # the service manager, then re-verify.
+      #
+      # A pure VERSION drift renders byte-identical unit content (the pinned
+      # path didn't change), so the force install comes back :unchanged and
+      # does NOT restart by itself — an explicit restart is required or the
+      # stale process survives the "repair". Path drift upgrades restart
+      # inside install! already.
+      def repair!
+        outcome = @installer.install!(autostart: true, force: true)
+        restart_service! if outcome.kind == :unchanged && !read_live_pid.nil?
+        [ outcome, call ]
+      end
+
+      # A DependencyAudit-shaped row so `hive setup` and the web health
+      # endpoint can render drift as one more finding in the shared table.
+      def check(result: call)
+        fix =
+          case result.status
+          when "ok" then []
+          when "not_running" then ["hive daemon start --detach"]
+          when "path_mismatch", "version_mismatch", "not_installed"
+            ["hive daemon install --force   # repin the service to #{result.expected_binary} v#{result.expected_version}"]
+          end
+        Hive::Local::DependencyAudit.build_check(
+          name: "daemon", kind: "hive_owned",
+          status: result.ok? ? "ok" : "unavailable",
+          detail: result.detail,
+          fix_commands: fix
+        )
+      end
+
+      private
+
+      # Explicit service-manager restart used by repair! when the unit file
+      # already matches (version-only drift). Platform inferred from the
+      # installed unit's extension.
+      def restart_service!
+        path = @installer.target_path
+        return unless path.is_a?(String) && File.exist?(path)
+
+        if path.end_with?(".plist")
+          @runner.call("launchctl", "unload", path)
+          @runner.call("launchctl", "load", path)
+        else
+          @runner.call("systemctl", "--user", "restart", "hive-daemon")
+        end
+      end
+
+      def detail_for(status, expected, unit_bin, unit_version, unit_path)
+        case status
+        when "ok"
+          "daemon running from #{unit_bin} (v#{@expected_version}) — matches this CLI"
+        when "not_installed"
+          "no daemon service installed at #{unit_path}; run `hive daemon start --detach` or `hive setup`"
+        when "not_running"
+          "daemon service is installed but no live process holds #{pid_file}"
+        when "path_mismatch"
+          "drift: the daemon unit pins #{unit_bin.inspect} but this CLI is #{expected.inspect}; " \
+          "the running daemon may be a DIFFERENT hive installation"
+        when "version_mismatch"
+          "stale daemon: unit binary reports v#{unit_version.inspect} but this CLI is " \
+          "v#{@expected_version}; restart it to pick up the new version"
+        end
+      end
+
+      def unit_binary
+        path = @installer.target_path
+        return nil unless path.is_a?(String) && File.exist?(path)
+
+        content = File.read(path)
+        if path.end_with?(".plist")
+          launchd_unit_binary(content)
+        else
+          systemd_unit_binary(content)
+        end
+      end
+
+      # ExecStart=<escaped-binary> daemon start — the first shellword after
+      # stripping the key is the pinned binary (the renderer escaped it via
+      # Shellwords.escape, so split round-trips exactly).
+      def systemd_unit_binary(content)
+        line = content.lines.find { |l| l.start_with?("ExecStart=") }
+        return nil unless line
+
+        argv = Shellwords.split(line.sub(/\AExecStart=/, "").strip)
+        argv.first
+      end
+
+      # The launchd plist wraps the invocation in `/bin/sh -c 'exec "$0"'`,
+      # so the pinned hive binary is the FOURTH <string> in ProgramArguments.
+      def launchd_unit_binary(content)
+        block = content[/ProgramArguments.*?<array>(.*?)<\/array>/m, 1]
+        return nil unless block
+
+        strings = block.scan(/<string>(.*?)<\/string>/m).flatten
+        strings[3]
+      end
+
+      # Realpath-tolerant comparison: two spellings of the same file (symlink
+      # vs target, ../ segments) are EQUIVALENT — a wrapper-script layout
+      # must not false-positive as drift.
+      def equivalent_paths?(a, b)
+        return false if a.nil? || b.nil?
+
+        a == b
+      end
+
+      def resolve(path)
+        return nil if path.nil?
+
+        expanded = File.expand_path(path)
+        File.exist?(expanded) ? File.realpath(expanded) : expanded
+      end
+
+      # Best-effort version probe of the UNIT's pinned binary. nil ⇒ unknown
+      # (treated as matching so a non-versioning wrapper doesn't scream).
+      def probe_version(binary)
+        out, _err, ok = @runner.call(binary, "version")
+        return nil unless ok
+
+        out.strip[/\d+\.\d+\.\d+/] || out.strip
+      end
+    end
+  end
+end
diff --git a/lib/hive/local/dependency_audit.rb b/lib/hive/local/dependency_audit.rb
new file mode 100644
index 000000000..734e8ea99
--- /dev/null
+++ b/lib/hive/local/dependency_audit.rb
@@ -0,0 +1,318 @@
+require "open3"
+require "rbconfig"
+require "hive/agent_profiles"
+
+module Hive
+  module Local
+    # Shared dependency-audit engine for the local (non-Docker) install mode
+    # (plan U1). One check engine audits every dependency `hive setup` needs,
+    # classifies each finding (ok / missing / wrong_version / unauthenticated),
+    # and for failures either offers a bootstrap action (Hive-owned deps:
+    # qmd, web bundle) or emits the exact remediation command verbatim
+    # (external deps: claude/codex/gh, system packages) without ever
+    # installing or authenticating them silently.
+    #
+    # The result rows are plain data so three consumers reuse them:
+    #   * `hive setup` (U5) — bootstraps hive-owned failures, prints the table
+    #   * daemon drift surfacing (U4/U6) — a drift finding is just another row
+    #   * humans — the printable summary doubles as troubleshooting docs
+    module DependencyAudit
+      # Matches the gemspec's required_ruby_version.
+      MIN_RUBY_VERSION = "3.4".freeze
+
+      # Agents whose absence blocks task dispatch entirely — setup exits
+      # non-zero when one of these fails so the operator fixes it before
+      # relying on the pipeline. The web tier may still come up with a warning.
+      DISPATCH_CRITICAL = %w[claude codex gh].freeze
+
+      # Hive-owned deps setup may bootstrap automatically. Everything else is
+      # diagnose-and-instruct only.
+      HIVE_OWNED = %w[qmd web-bundle].freeze
+
+      # One audit finding. `kind` is "external" or "hive_owned"; `status` is
+      # the closed enum "ok" | "missing" | "wrong_version" |
+      # "unauthenticated" | "unavailable"; `fix_commands` carries the exact
+      # remediation commands (verbatim, copy-pasteable) for non-ok rows;
+      # `critical` marks dispatch-blocking externals.
+      Check = Struct.new(:name, :kind, :status, :detail, :fix_commands, :critical, :version,
+                         keyword_init: true) do
+        def ok?
+          status == "ok"
+        end
+
+        def hive_owned?
+          kind == "hive_owned"
+        end
+
+        def failing?
+          !ok?
+        end
+      end
+
+      module_function
+
+      # Subprocess seam: returns [stdout, stderr, success_bool]. Injectable so
+      # tests audit synthetic environments without touching the real PATH.
+      DEFAULT_RUNNER = lambda { |*argv|
+        out, err, st = Open3.capture3(*argv)
+        [ out, err, st.success? ]
+      rescue Errno::ENOENT, Errno::EACCES
+        [ "", "", false ]
+      }.freeze
+
+      # Audit every dependency. Returns an array of Checks in display order.
+      def audit(runner: DEFAULT_RUNNER, env: ENV)
+        [
+          check_ruby,
+          *%w[git tmux node npm].map { |bin| check_binary(bin) },
+          check_gh(runner: runner),
+          check_agent("claude", env: env),
+          check_agent("codex", env: env),
+          check_qmd(env: env),
+          check_web_bundle(runner: runner)
+        ]
+      end
+
+      # Pure classification core (unit-tested without spawning anything).
+      # Precedence matters: a wrong-version install must be fixed before it
+      # can be authenticated, so wrong_version outranks unauthenticated.
+      def classify(present:, version_ok: true, authenticated: true)
+        return "ok" if present && version_ok && authenticated
+        return "wrong_version" if present && !version_ok
+        return "unauthenticated" if present && !authenticated
+
+        "missing"
+      end
+
+      # Bootstrap a HIVE-OWNED failing check by running its install command.
+      # Never called for external deps — setup filters on `check.hive_owned?`.
+      # Returns true when the command exits 0.
+      def bootstrap!(check, runner: DEFAULT_RUNNER)
+        cmd = bootstrap_command(check.name)
+        return false unless cmd
+
+        _out, _err, ok = runner.call(*cmd)
+        ok
+      end
+
+      # The exact bootstrap command for a hive-owned dep, or nil when the dep
+      # has no bootstrap (or the app dir it targets is absent).
+      def bootstrap_command(name)
+        case name
+        when "qmd"
+          [ "npm", "install", "--global", "--prefix", qmd_prefix(env: ENV), "@tobilu/qmd" ]
+        when "web-bundle"
+          app_dir = rails_app_dir
+          return nil unless app_dir
+
+          gemfile = File.join(app_dir, "Gemfile")
+          return nil unless File.file?(gemfile)
+
+          [ "bundle", "install", "--gemfile", gemfile ]
+        end
+      end
+
+      # ── Individual probes ────────────────────────────────────────────
+
+      # `current:` is injectable so tests can simulate an older toolchain.
+      def check_ruby(current: RUBY_VERSION.to_s)
+        version_ok = Gem::Version.new(current) >= Gem::Version.new(MIN_RUBY_VERSION)
+        build_check(
+          name: "ruby", kind: "external",
+          status: classify(present: true, version_ok: version_ok),
+          detail: "ruby #{current} (this process)",
+          fix_commands: version_ok ? [] :
+            ["install Ruby >= #{MIN_RUBY_VERSION} (rbenv/ruby-build, mise, or your system package manager)"],
+          version: current
+        )
+      end
+
+      def check_binary(name)
+        path = which(name, env_path: ENV["PATH"])
+        build_check(
+          name: name, kind: "external",
+          status: classify(present: !path.nil?),
+          detail: path || "#{name} not found on PATH",
+          fix_commands: path ? [] : ["install #{name} and ensure it is on PATH"]
+        )
+      end
+
+      def check_gh(runner:)
+        path = which("gh", env_path: ENV["PATH"])
+        unless path
+          return build_check(
+            name: "gh", kind: "external", status: classify(present: false), critical: true,
+            detail: "gh not found on PATH",
+            fix_commands: ["install the GitHub CLI (https://cli.github.com/), then run `gh auth login`"]
+          )
+        end
+
+        _out, _err, authed = runner.call("gh", "auth", "status")
+        if authed
+          build_check(name: "gh", kind: "external", status: "ok", critical: true, detail: "#{path} (authenticated)")
+        else
+          build_check(
+            name: "gh", kind: "external", status: "unauthenticated", critical: true,
+            detail: "gh at #{path} is not authenticated with GitHub",
+            fix_commands: ["gh auth login"]
+          )
+        end
+      end
+
+      # claude / codex: presence via the profile's resolved bin + PATH, auth
+      # via the same credential-artifact probe the web UI's first-run
+      # checklist uses. NEVER auto-runs a login flow here — the exact fix
+      # command is emitted verbatim instead.
+      def check_agent(name, env: ENV)
+        profile = Hive::AgentProfiles.lookup(name.to_sym)
+        bin = profile.bin
+        present = !which(bin, env_path: env["PATH"]).nil?
+        return agent_check(name, profile, false, false) unless present
+
+        agent_check(name, profile, true, Hive::AgentProfiles.logged_in?(name))
+      rescue Hive::AgentProfiles::UnknownAgent
+        build_check(name: name, kind: "external", status: classify(present: false),
+                    detail: "#{name} is not a registered agent profile",
+                    fix_commands: [], critical: DISPATCH_CRITICAL.include?(name))
+      end
+
+      def agent_check(name, profile, present, authed)
+        build_check(
+          name: name, kind: "external",
+          status: classify(present: present, authenticated: authed),
+          critical: DISPATCH_CRITICAL.include?(name),
+          detail: if !present
+                    "#{profile.bin} not found on PATH"
+                  elsif authed
+                    "#{name} present and authenticated"
+                  else
+                    "#{name} present but not authenticated (no credential artifact)"
+                  end,
+          fix_commands: if present
+                          []
+                        else
+                          ["install the #{name} CLI and re-run `hive setup`; to authenticate run `#{name} login` or use the web UI's Agents page"]
+                        end,
+          version: profile.min_version ? ">= #{profile.min_version}" : nil
+        )
+      end
+
+      def check_qmd(env: ENV)
+        path = find_qmd(env: env)
+        return qmd_check(nil, "missing") unless path
+
+        out, err, ok = DEFAULT_RUNNER.call(path, "--version")
+        if ok
+          qmd_check(path, "ok", out.strip)
+        else
+          diagnostic = err.lines.map(&:strip).find { |l| !l.empty? }.to_s
+          qmd_check(path, "unavailable",
+                    "qmd at #{path} failed to start#{diagnostic.empty? ? "" : " (#{diagnostic})"}")
+        end
+      end
+
+      def qmd_check(path, status, version = nil)
+        detail =
+          case status
+          when "ok" then "#{path} #{version}".strip
+          when "missing" then "qmd not installed (Hive-owned: `hive setup` can bootstrap it)"
+          else status
+          end
+        build_check(
+          name: "qmd", kind: "hive_owned", status: status, detail: detail,
+          fix_commands: status == "ok" ? [] :
+            ["npm install --global --prefix \"#{qmd_prefix(env: ENV)}\" @tobilu/qmd"], version: version
+        )
+      end
+
+      def check_web_bundle(runner:)
+        app_dir = rails_app_dir
+        unless app_dir
+          return build_check(
+            name: "web-bundle", kind: "hive_owned", status: "unavailable",
+            detail: "the Rails web app was not found (the local web tier needs a source checkout or HIVEBOX_WEB_APP_DIR)",
+            fix_commands: []
+          )
+        end
+
+        lockfile = File.join(app_dir, "Gemfile.lock")
+        unless File.file?(lockfile)
+          return build_check(
+            name: "web-bundle", kind: "hive_owned", status: "missing",
+            detail: "no Gemfile.lock under #{app_dir}",
+            fix_commands: ["cd #{app_dir} && bundle install"]
+          )
+        end
+
+        _out, err, ok = runner.call("bundle", "check", "--gemfile", File.join(app_dir, "Gemfile"))
+        if ok
+          build_check(name: "web-bundle", kind: "hive_owned", status: "ok",
+                      detail: "web bundle satisfied (#{app_dir})")
+        else
+          reason = err.lines.map(&:strip).find { |l| !l.empty? } || "bundle check failed"
+          build_check(
+            name: "web-bundle", kind: "hive_owned", status: "missing",
+            detail: "web bundle incomplete under #{app_dir}: #{reason}",
+            fix_commands: ["cd #{app_dir} && bundle install"]
+          )
+        end
+      end
+
+      # ── Shared helpers ────────────────────────────────────────────────
+
+      def build_check(name:, kind:, status:, detail:, fix_commands: [], critical: false, version: nil)
+        Check.new(
+          name: name, kind: kind, status: status, detail: detail,
+          fix_commands: Array(fix_commands), critical: critical || DISPATCH_CRITICAL.include?(name),
+          version: version
+        )
+      end
+
+      def which(name, env_path:)
+        env_path.to_s.split(File::PATH_SEPARATOR).each do |dir|
+          path = File.join(dir, name)
+          return path if File.file?(path) && File.executable?(path)
+        end
+        nil
+      end
+
+      def qmd_prefix(env: ENV)
+        data_home = env["XDG_DATA_HOME"].to_s.empty? ? File.expand_path("~/.local/share") : env["XDG_DATA_HOME"]
+        File.join(data_home, "hive", "qmd")
+      end
+
+      # Mirrors Commands::Doctor#find_qmd candidate order (env override →
+      # PATH → XDG data home → install prefix marker).
+      def find_qmd(env: ENV)
+        env_qmd = env["HIVE_QMD_BIN"].to_s
+        return env_qmd if !env_qmd.empty? && File.executable?(env_qmd)
+
+        path_qmd = which("qmd", env_path: env["PATH"])
+        return path_qmd if path_qmd
+
+        data_home = env["XDG_DATA_HOME"].to_s.empty? ? File.expand_path("~/.local/share") : env["XDG_DATA_HOME"]
+        candidates = [
+          File.join(data_home, "hive", "qmd", "bin", "qmd"),
+          File.expand_path("~/.local/share/hive/qmd/bin/qmd")
+        ]
+
+        prefix_file = File.join(data_home, "hive", "install-prefix")
+        if File.readable?(prefix_file)
+          prefix = File.read(prefix_file).lines.first.to_s.strip
+          candidates << File.join(prefix, "hive", "qmd", "bin", "qmd") unless prefix.empty?
+        end
+
+        candidates.find { |candidate| File.file?(candidate) && File.executable?(candidate) }
+      end
+
+      # Same resolution as Commands::Web#rails_app_dir, kept in sync by test.
+      def rails_app_dir(env: ENV)
+        candidates = [
+          env["HIVEBOX_WEB_APP_DIR"],
+          File.expand_path("../../../web", __dir__)
+        ].compact
+        candidates.find { |dir| File.file?(File.join(dir, "config", "application.rb")) }
+      end
+    end
+  end
+end
diff --git a/lib/hive/web/bind_policy.rb b/lib/hive/web/bind_policy.rb
new file mode 100644
index 000000000..12f74da5a
--- /dev/null
+++ b/lib/hive/web/bind_policy.rb
@@ -0,0 +1,53 @@
+module Hive
+  module Web
+    # Bind-policy gate for the local web tier (plan U2). Loopback binds are
+    # the zero-config default: single-user, no auth required. Any
+    # non-loopback bind exposes the unauthenticated pipeline to the network,
+    # so it is refused unless (a) an https origin is configured (a trusted
+    # reverse proxy fronts the app) or (b) the operator passes the explicit
+    # per-run --unsafe-bind escape hatch — which is never persisted to
+    # config, so every unsafe start must re-affirm it.
+    module BindPolicy
+      LOOPBACK_HOSTS = %w[127.0.0.1 ::1 localhost].freeze
+
+      # Decision value object. `allowed?` gates exec; `warning`, when set on
+      # an allowed decision, is printed prominently before boot.
+      Decision = Struct.new(:allowed, :reason, :warning, keyword_init: true) do
+        def allowed?
+          allowed
+        end
+      end
+
+      module_function
+
+      # Pure decision core. `https_origin` is true when web.origin starts
+      # with https:// (implying a fronting proxy that validates Host).
+      def decide(bind:, unsafe_bind: false, https_origin: false)
+        return Decision.new(allowed: true, reason: :loopback) if loopback?(bind)
+        return Decision.new(allowed: true, reason: :https_origin) if https_origin
+
+        unless unsafe_bind
+          return Decision.new(
+            allowed: false, reason: :refused,
+            warning:
+              "refusing to bind #{bind} (non-loopback): the local web tier has no built-in auth, " \
+              "so a network-exposed bind would hand the whole pipeline to your LAN. " \
+              "Either keep the loopback default (127.0.0.1), configure an https origin " \
+              "(web.origin in ~/.config/hive/config.yml), or re-run with --unsafe-bind to accept the risk."
+          )
+        end
+
+        Decision.new(
+          allowed: true, reason: :unsafe_bind,
+          warning:
+            "WARNING: binding #{bind} without authentication (--unsafe-bind). The pipeline, its " \
+            "credentials, and every enrolled repo are reachable from any host that can reach this port."
+        )
+      end
+
+      def loopback?(bind)
+        LOOPBACK_HOSTS.include?(bind.to_s)
+      end
+    end
+  end
+end
