+
+  # Write the daemon unit exactly the way the real installer renders it on
+  # Linux (so the parser round-trips Shellwords escaping).
+  def write_unit(dir, binary_path)
+    installer = Hive::Commands::Daemon::ServiceInstaller.new(
+      host_os: "linux", home: dir, binary_path: binary_path,
+      systemctl_available: false
+    )
+    installer.install!(autostart: false)
+    File.join(dir, ".config/systemd/user/hive-daemon.service")
+  end
+
+  def write_live_pid(statedir)
+    pid_path = File.join(statedir, ".daemon.pid")
+    payload = { "pid" => Process.pid, "process_start_time" => Hive::Lock.process_start_time(Process.pid) }
+    File.write(pid_path, payload.to_yaml)
+    pid_path
+  end
+
+  def build_check(hive_bin:, dir:, statedir:, version_output:, commands: [])
+    # The drift check compares RESOLVED paths, so on hosts where the tmpdir
+    # sits behind a symlink (/var → /private/var on macOS) the version-probe
+    # argv must match the resolved spelling too.
+    bin_for_probe = begin
+      File.realpath(hive_bin)
+    rescue SystemCallError
+      hive_bin
+    end
+    runner = lambda do |*argv|
+      if argv == [ bin_for_probe, "version" ]
+        [ "#{version_output}\n", "", true ]
+      else
+        commands << argv
+        [ "", "", true ]
+      end
+    end
+    installer = Hive::Commands::Daemon::ServiceInstaller.new(
+      host_os: "linux", home: dir, binary_path: hive_bin,
+      systemctl_available: true, runner: ->(argv) { commands << argv; true }
+    )
+    Hive::Local::DaemonDriftCheck.new(
+      binary_path: hive_bin, expected_version: Hive::VERSION,
+      home: dir, state_home: statedir, runner: runner, installer: installer
+    )
+  end
+end
