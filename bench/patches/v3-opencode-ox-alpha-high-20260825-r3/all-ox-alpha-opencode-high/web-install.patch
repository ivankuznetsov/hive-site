+  # ── CLI wiring: foreground stays independent of service state ─────────
+
+  class ExecCaught < StandardError
+    attr_reader :env, :argv
+
+    def initialize(env, argv)
+      @env = env
+      @argv = argv
+      super("exec")
+    end
+  end
+
+  def with_stub_rails_app
+    Dir.mktmpdir("hive-weblife-app") do |dir|
+      FileUtils.mkdir_p([ File.join(dir, "config"), File.join(dir, "bin") ])
+      File.write(File.join(dir, "config", "application.rb"), "# rails app marker")
+      File.write(File.join(dir, "bin", "rails"), "#!/usr/bin/env bash\nexit 0\n")
+      FileUtils.chmod(0o755, File.join(dir, "bin", "rails"))
+      with_env("HIVEBOX_WEB_APP_DIR" => dir) do
+        yield dir
+      end
+    end
+  end
+
+  def catch_exec
+    original = Kernel.method(:exec)
+    Kernel.define_singleton_method(:exec) do |env, *argv|
+      raise ExecCaught.new(env, argv)
+    end
+    yield
+  rescue ExecCaught => e
+    e
+  ensure
+    Kernel.define_singleton_method(:exec, original)
+  end
+
+  def test_foreground_run_still_works_regardless_of_service_state
+    with_tmp_global_config do
+      with_stub_rails_app do
+        caught = catch_exec do
+          capture_io { Hive::Commands::Web.new(port: free_port).call }
+        end
+
+        assert_equal %w[bin/rails server -b], caught.argv[0..2]
+      end
+    end
+  end
+
+  def free_port
+    probe = TCPServer.new("127.0.0.1", 0)
+    port = probe.addr[1]
+    probe.close
+    port
+  end
+
+  # ── CLI subcommand wrappers ────────────────────────────────────────────
+
+  # Sandbox HOME + HIVE_HOME and fake service-manager binaries so the
+  # lifecycle wrappers run deterministically without touching the host.
+  def with_fake_service_manager(ok:)
+    Dir.mktmpdir("hive-weblife-cli") do |dir|
+      fake = File.join(dir, "bin")
+      FileUtils.mkdir_p(fake)
+      %w[systemctl launchctl].each do |name|
+        File.write(File.join(fake, name), "#!/bin/sh\nexit #{ok ? 0 : 1}\n")
+        FileUtils.chmod(0o755, File.join(fake, name))
+      end
+      File.write(File.join(dir, "config.yml"), {}.to_yaml)
+      with_env("HIVE_HOME" => dir, "HOME" => dir,
+               "PATH" => "#{fake}#{File::PATH_SEPARATOR}#{ENV.fetch('PATH', '')}") do
+        yield dir
+      end
+    end
+  end
+
+  def write_web_unit(home)
+    path = File.join(home, ".config/systemd/user/hive-web.service")
+    FileUtils.mkdir_p(File.dirname(path))
+    File.write(path, "ExecStart=/tmp/hive web --host 127.0.0.1 --port 4567\n")
+    path
+  end
+
+  def test_unknown_subcommand_is_a_usage_error
+    error = assert_raises(Hive::InvalidTaskPath) do
+      capture_io { Hive::Commands::Web.new(subcommand: "frobnicate").call }
+    end
+
+    assert_match(/unknown subcommand/, error.message)
+    assert_match(/foreground/, error.message, "the error must remind callers the bare verb is foreground")
+  end
+
+  def test_install_writes_the_unit_and_prints_the_next_hint
+    with_fake_service_manager(ok: true) do |dir|
+      out, = capture_io { Hive::Commands::Web.new(subcommand: "install").call }
+
+      assert File.exist?(File.join(dir, ".config/systemd/user/hive-web.service"))
+      assert_includes out, "next:"
+    end
+  end
+
+  def test_start_refuses_when_nothing_is_installed
+    with_fake_service_manager(ok: true) do |_dir|
+      error = assert_raises(Hive::Error) do
+        capture_io { Hive::Commands::Web.new(subcommand: "start").call }
+      end
+
+      assert_match(/hive web install/, error.message)
+    end
+  end
+
+  def test_start_stop_and_status_cycle_through_the_service_manager
+    with_fake_service_manager(ok: true) do |dir|
+      write_web_unit(dir)
+
+      out, = capture_io { Hive::Commands::Web.new(subcommand: "start").call }
+      assert_match(%r{started — http://127\.0\.0\.1:4567}, out)
+
+      out, = capture_io { Hive::Commands::Web.new(subcommand: "status").call }
+      assert_match(/running/, out)
+
+      out, = capture_io { Hive::Commands::Web.new(subcommand: "stop").call }
+      assert_match(/stopped/, out)
+    end
+
+    with_fake_service_manager(ok: false) do |dir|
+      write_web_unit(dir)
+      error = assert_raises(Hive::Error) do
+        capture_io { Hive::Commands::Web.new(subcommand: "status").call }
+      end
+
+      assert_match(/not running/, error.message)
+    end
+  end
+
+  def test_uninstall_removes_the_unit_and_reports_when_absent
+    with_fake_service_manager(ok: false) do |dir|
+      out, = capture_io { Hive::Commands::Web.new(subcommand: "uninstall").call }
+      assert_match(/nothing to uninstall/, out)
+
+      unit = write_web_unit(dir)
+      out, = capture_io { Hive::Commands::Web.new(subcommand: "uninstall").call }
+
+      refute File.exist?(unit)
+      assert_match(/removed/, out)
+    end
+  end
+
+  private
+
+  def build_linux_installer(dir, systemctl_available: false, runner: nil)
+    hive_bin = File.join(dir, "bin", "hive")
+    FileUtils.mkdir_p(File.dirname(hive_bin))
+    File.write(hive_bin, "#!/bin/sh\n")
+    FileUtils.chmod(0o755, hive_bin)
+    Hive::Commands::Web::ServiceInstaller.new(
+      host_os: "linux", home: dir, binary_path: hive_bin,
+      systemctl_available: systemctl_available,
+      runner: runner || ->(_argv) { true }
+    )
+  end
+end
