diff --git a/lib/hive/commands/setup.rb b/lib/hive/commands/setup.rb
new file mode 100644
index 000000000..dbf523970
--- /dev/null
+++ b/lib/hive/commands/setup.rb
@@ -0,0 +1,214 @@
+require "open3"
+require "hive/config"
+require "hive/local/dependency_audit"
+require "hive/local/daemon_drift"
+
+module Hive
+  module Commands
+    # `hive setup` — the one-command local bring-up (plan U5).
+    #
+    # Thin composition over the shared engines:
+    #   1. dependency audit (U1) — every required dep classified OK/missing/
+    #      wrong-version/unauthenticated;
+    #   2. bootstrap Hive-owned failures (qmd, web bundle) and re-check them;
+    #      external failures are NEVER auto-fixed — their exact remediation
+    #      commands are printed verbatim instead;
+    #   3. ensure the daemon service (U4): install if absent, repair if
+    #     drifted, start via the service manager if registered-but-stopped;
+    #   4. verify/enroll project enrollment (`hive init .` semantics,
+    #      idempotent);
+    #   5. web launch: default prints the foreground hint; `--managed`
+    #      installs+starts the hive-web service (U3); `--no-web` skips.
+    #
+    # Idempotent and re-runnable: an already-converged machine gets a fast
+    # no-op pass with no duplicate units.
+    class Setup
+      EXIT_SUCCESS = 0
+      EXIT_BLOCKING_FINDINGS = 65 # mirrors `hive doctor`'s missing-skill exit
+
+      # `audit:` and `drift:` are injectable seams so tests drive synthetic
+      # findings without spawning probes against the real machine.
+      def initialize(project: Dir.pwd, managed: false, no_web: false, yes: false,
+                     output: $stdout, error_output: $stderr, audit: nil, drift: nil)
+        @project = File.expand_path(project || Dir.pwd)
+        @managed = managed
+        @no_web = no_web
+        @yes = yes
+        @output = output
+        @error_output = error_output
+        @audit = audit
+        @drift = drift
+      end
+
+      def call
+        rows = audit_rows
+
+        bootstrap_hive_owned!(rows)
+
+        daemon_result = ensure_daemon!
+        enrollment = ensure_enrollment!
+
+        web_url = launch_web(rows)
+        render_summary(rows, daemon_result, enrollment, web_url)
+
+        blocking = rows.select { |r| r.critical && r.failing? }
+        blocking.empty? ? EXIT_SUCCESS : EXIT_BLOCKING_FINDINGS
+      end
+
+      private
+
+      def audit_rows
+        return @audit.call if @audit
+
+        Hive::Local::DependencyAudit.audit
+      end
+
+      # Bootstrap only HIVE-OWNED failing checks, then re-run that same probe
+      # so the summary reflects post-bootstrap truth. Failures surface the
+      # underlying tool's guidance verbatim (the row keeps its fix commands).
+      def bootstrap_hive_owned!(rows)
+        rows.each_with_index do |row, idx|
+          next unless row.hive_owned? && row.failing?
+
+          @output.puts "hive setup: bootstrapping #{row.name}…"
+          ok = Hive::Local::DependencyAudit.bootstrap!(row)
+          fresh =
+            case row.name
+            when "qmd" then Hive::Local::DependencyAudit.check_qmd(env: ENV)
+            when "web-bundle" then Hive::Local::DependencyAudit.check_web_bundle(
+              runner: Hive::Local::DependencyAudit::DEFAULT_RUNNER
+            )
+            end
+
+          # A successful install wins over a stale re-probe (bundle check can
+          # lag a just-completed install); a failed install keeps the row's
+          # original fix guidance verbatim.
+          rows[idx] = ok ? (fresh || row) : row
+          unless rows[idx].ok?
+            @error_output.puts "hive setup: #{row.name} bootstrap did not converge; follow the fix command below"
+          end
+        end
+      end
+
+      # Converge the daemon onto this binary/version (U4) and return the
+      # post-convergence Result (always non-nil so the summary can render it):
+      #   not_installed / drifted → force-repair (rewrite unit + restart)
+      #   not_running             → enable --now via the service installer
+      #   ok                      → no-op
+      def ensure_daemon!
+        result = nil
+        drift = @drift || Hive::Local::DaemonDriftCheck.new(binary_path: Hive::InvokedBinary.path)
+        result = drift.call
+
+        case result.status
+        when "ok"
+          result
+        when "not_installed", "path_mismatch", "version_mismatch"
+          _outcome, after = drift.repair!
+          @error_output.puts "hive setup: daemon repaired (#{result.status} → #{after.status})"
+          after
+        when "not_running"
+          require "hive/commands/daemon/service_installer"
+          installer = Hive::Commands::Daemon::ServiceInstaller.new(
+            binary_path: Hive::InvokedBinary.path
+          )
+          installer.install!(autostart: true)
+          installer.messages.each { |line| @error_output.puts "hive: #{line}" }
+          after = drift.call
+          @error_output.puts "hive setup: daemon was stopped; now #{after.status}" unless after.ok?
+          after
+        end
+      rescue Hive::Error => e
+        @error_output.puts "hive setup: daemon convergence failed: #{e.message}"
+        result || nil
+      end
+
+      # Enrollment = `hive init <project>` semantics, idempotently: an
+      # already-initialized project is reported as enrolled, not re-scaffolded.
+      def ensure_enrollment!
+        cfg_path = File.join(@project, ".hive-state", "config.yml")
+        if File.exist?(cfg_path)
+          { status: "already_enrolled", config_yml: cfg_path }
+        elsif !File.directory?(@project)
+          { status: "missing_project", project: @project }
+        else
+          require "hive/commands/init"
+          begin
+            Hive::Commands::Init.new(@project).call
+            { status: "enrolled", config_yml: cfg_path }
+          rescue Hive::AlreadyInitialized
+            { status: "already_enrolled", config_yml: cfg_path }
+          end
+        end
+      end
+
+      # Default: print the foreground hint (zero-config default stays
+      # foreground per R6). --managed installs+starts the hive-web service;
+      # --no-web skips entirely.
+      def launch_web(_rows)
+        cfg = Hive::Config.load_global_web
+        url = "http://#{cfg.fetch("bind")}:#{cfg.fetch("port")}"
+
+        if @no_web
+          @output.puts "hive setup: skipping web bring-up (--no-web)"
+          return nil
+        end
+
+        if @managed
+          require "hive/commands/web/service_installer"
+          installer = Hive::Commands::Web::ServiceInstaller.new(
+            binary_path: Hive::InvokedBinary.path
+          )
+          outcome = installer.install!(autostart: true, force: false)
+          installer.messages.each { |line| @error_output.puts "hive: #{line}" }
+          case outcome.kind
+          when :written, :upgraded, :unchanged
+            installer.start!
+            installer.messages.each { |line| @error_output.puts "hive: #{line}" }
+            @output.puts "hive setup: web service started at #{url}"
+          when :autostart_unavailable
+            @output.puts "hive setup: web service installed; start it with `hive web start` once the service manager is available"
+          else
+            @error_output.puts "hive setup: web service install did not complete — see messages above"
+          end
+        else
+          @output.puts "hive setup: start the web UI with `hive web` (foreground), " \
+                       "or re-run with --managed to install it as a service"
+        end
+
+        url
+      rescue Hive::Error => e
+        @error_output.puts "hive setup: web bring-up failed: #{e.message}"
+        nil
+      end
+
+      def render_summary(rows, daemon_result, enrollment, web_url)
+        @output.puts ""
+        @output.puts "hive setup summary"
+        width = rows.map { |r| r.name.length }.push(6).max
+        rows.each do |r|
+          marker = r.ok? ? "✓" : (r.critical ? "✗" : "!")
+          @output.puts format("  %-#{width}s  %s %-16s %s", r.name, marker, r.status, r.detail)
+          r.fix_commands.each { |cmd| @output.puts format("  %-#{width}s      fix: %s", "", cmd) }
+        end
+
+        daemon_marker = daemon_result&.ok? ? "✓" : "✗"
+        @output.puts format("  %-#{width}s  %s %-16s %s", "daemon", daemon_marker,
+                            daemon_result&.status || "unknown", daemon_result&.detail)
+        @output.puts ""
+        @output.puts "  project: #{@project} (#{enrollment[:status]})"
+
+        @output.puts "  web url: #{web_url}" if web_url
+        @output.puts ""
+
+        blocking = rows.select { |r| r.critical && r.failing? }
+        return if blocking.empty?
+
+        @error_output.puts "hive setup: #{blocking.length} dispatch-critical dependenc#{blocking.length == 1 ? 'y' : 'ies'} still failing:"
+        blocking.each do |r|
+          @error_output.puts "  #{r.name}: #{r.fix_commands.first || r.detail}"
+        end
+      end
+    end
+  end
+end
