diff --git a/test/unit/commands/setup_command_test.rb b/test/unit/commands/setup_command_test.rb
new file mode 100644
index 000000000..55ac20cc6
--- /dev/null
+++ b/test/unit/commands/setup_command_test.rb
@@ -0,0 +1,332 @@
+require "test_helper"
+require "hive/commands/setup"
+require "hive/local/dependency_audit"
+
+class SetupCommandTest < Minitest::Test
+  include HiveTestHelper
+
+  # ── stubs ──────────────────────────────────────────────────────────────
+
+  def ok_row(name)
+    Hive::Local::DependencyAudit.build_check(
+      name: name, kind: "external", status: "ok", detail: "#{name} present"
+    )
+  end
+
+  def failing_critical_row(name, fix:)
+    Hive::Local::DependencyAudit.build_check(
+      name: name, kind: "external", status: "missing", detail: "#{name} not found",
+      fix_commands: [fix], critical: true
+    )
+  end
+
+  def drift_result(status, detail: "")
+    Hive::Local::DaemonDriftCheck::Result.new(
+      status: status, expected_binary: "/bin/hive", unit_binary: "/usr/bin/hive",
+      expected_version: Hive::VERSION, unit_version: nil, unit_path: "/u/hive-daemon.service",
+      running_pid: nil, detail: detail || status
+    )
+  end
+
+  class DriftStub
+    attr_reader :repair_calls
+
+    def initialize(sequence:, repair_to: nil)
+      @sequence = sequence
+      @repair_to = repair_to
+      @repair_calls = 0
+    end
+
+    def call
+      result = @sequence.shift || @sequence.last
+      raise "no drift results left" if result.nil?
+
+      result
+    end
+
+    def repair!
+      @repair_calls += 1
+      [ :upgraded, @repair_to ]
+    end
+  end
+
+  def enrolled_project
+    Dir.mktmpdir("hive-setup-proj").tap do |project|
+      FileUtils.mkdir_p(File.join(project, ".hive-state"))
+      File.write(File.join(project, ".hive-state", "config.yml"), {}.to_yaml)
+    end
+  end
+
+  def run_setup(project:, audit:, drift: DriftStub.new(sequence: [ drift_result("ok") ]))
+    out = StringIO.new
+    err = StringIO.new
+    setup = Hive::Commands::Setup.new(
+      project: project, output: out, error_output: err, audit: audit, drift: drift
+    )
+    code = setup.call
+    [ code, out.string, err.string ]
+  ensure
+    FileUtils.rm_rf(project) if project&.include?("hive-setup-proj")
+  end
+
+  # ── tests ──────────────────────────────────────────────────────────────
+
+  # HIVE_HOME sandbox so Config.load_global_web never touches the developer's
