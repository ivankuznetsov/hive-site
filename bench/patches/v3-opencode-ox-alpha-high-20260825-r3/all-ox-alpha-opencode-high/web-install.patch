@@ -28,4 +28,61 @@ class HealthController < ApplicationController
       render json: { ok: false, daemon: { running: false } }, status: :service_unavailable
     end
   end
+
+  # Drift-aware daemon health (plan U6): is the daemon running, and does its
+  # pinned binary/version match the CLI the web tier ships with? Backed by
+  # the same DaemonDriftCheck the CLI's setup/repair uses, so what the
+  # operator sees here is exactly what `hive setup` would converge to.
+  #
+  # Class-level seam (`probe_override=`) lets integration tests inject a
+  # fake probe without touching the real service manager.
+  def daemon
+    @report = current_probe.call
+    respond_to do |format|
+      format.html { render :daemon }
+      format.json do
+        payload = {
+          "ok" => @report.ok?,
+          "status" => @report.status,
+          "detail" => @report.detail,
+          "expected_binary" => @report.expected_binary,
+          "unit_binary" => @report.unit_binary,
+          "expected_version" => @report.expected_version,
+          "unit_version" => @report.unit_version,
+          "unit_path" => @report.unit_path
+        }
+        render json: payload, status: @report.ok? ? :ok : :service_unavailable
+      end
+    end
+  end
+
+  # Operator-triggered convergence from the browser: same routine as
+  # `hive daemon install --force` / `hive setup`. Login-required (the default
+  # before_action), so an unauthenticated/non-loopback deployment never gets
+  # a repair endpoint without satisfying the web tier's auth posture first.
+  def repair
+    _outcome, after = current_probe.repair!
+    if after&.ok?
+      redirect_to daemon_health_path, notice: "Daemon repaired: #{after.detail}"
+    else
+      redirect_to daemon_health_path,
+                  alert: "Repair ran but the daemon is still #{after&.status || 'unknown'}; check the daemon log."
+    end
+  rescue StandardError => e
+    redirect_to daemon_health_path, alert: "Repair failed: #{e.message}"
+  end
+
+  class << self
+    attr_accessor :probe_override
+  end
+
+  private
+
+  def current_probe
+    override = self.class.probe_override
+    return override if override
+
+    require "hive/local/daemon_drift"
+    @current_probe ||= Hive::Local::DaemonDriftCheck.new(binary_path: Hive::InvokedBinary.path)
+  end
 end
