+  def test_macos_repair_restarts_via_launchctl_when_content_is_unchanged
+    Dir.mktmpdir("hive-drift-plist2") do |dir|
+      plist = File.join(dir, "Library/LaunchAgents/local.hive-daemon.plist")
+      FileUtils.mkdir_p(File.dirname(plist))
+      File.write(plist, "<plist/>")
+
+      commands = []
+      runner = ->(*argv) { commands << argv; [ "", "", true ] }
+      outcome_class = Hive::Commands::ServiceInstaller::Outcome
+      double = Object.new
+      double.define_singleton_method(:target_path) { plist }
+      double.define_singleton_method(:install!) do |autostart:, force:|
+        outcome_class.new(:unchanged)
+      end
+      check = Hive::Local::DaemonDriftCheck.new(
+        binary_path: "/bin/hive", home: dir, state_home: File.join(dir, "state"),
+        runner: runner, installer: double
+      )
+      # A live pidfile so repair!'s explicit-restart condition fires.
+      FileUtils.mkdir_p(File.join(dir, "state"))
+      payload = { "pid" => Process.pid, "process_start_time" => Hive::Lock.process_start_time(Process.pid) }
+      File.write(File.join(dir, "state", ".daemon.pid"), payload.to_yaml)
+
+      outcome, _after = check.repair!
+
+      assert_equal :unchanged, outcome.kind
+      assert_equal [ [ "launchctl", "unload", plist ], [ "launchctl", "load", plist ] ], commands.last(2),
+                   "macOS version-only drift must restart by unloading then loading the plist"
+    end
+  end
+
+  def test_version_probe_tolerates_non_version_output_and_failures
+    with_sandbox do |dir, hive_bin, statedir|
+      write_unit(dir, hive_bin)
+      write_live_pid(statedir)
+
+      # Non-numeric output still counts as a reported version (wrapper scripts).
+      drift = build_check(hive_bin: hive_bin, dir: dir, statedir: statedir,
+                          version_output: "banana")
+      result = drift.call
+
+      assert_equal "version_mismatch", result.status
+      assert_equal "banana", result.unit_version
+
+      # Probe failure (non-zero exit) ⇒ unknown version ⇒ treated as matching.
+      bin_for_probe = File.realpath(hive_bin)
+      failing_runner = lambda do |*argv|
+        if argv == [ bin_for_probe, "version" ]
+          [ "", "", false ]
+        else
+          [ "", "", true ]
+        end
+      end
+      installer = Hive::Commands::Daemon::ServiceInstaller.new(
+        host_os: "linux", home: dir, binary_path: hive_bin,
+        systemctl_available: true, runner: ->(_argv) { true }
+      )
+      drift = Hive::Local::DaemonDriftCheck.new(
+        binary_path: hive_bin, expected_version: Hive::VERSION,
+        home: dir, state_home: statedir, runner: failing_runner, installer: installer
+      )
+      result = drift.call
+
+      assert_equal "ok", result.status
+      assert_nil result.unit_version
+    end
+  end
