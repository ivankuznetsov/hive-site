+++ b/test/unit/web/service_lifecycle_test.rb
@@ -0,0 +1,390 @@
+require "test_helper"
+require "hive/commands/web"
+require "hive/commands/web/service_installer"
+
+class WebServiceLifecycleTest < Minitest::Test
+  include HiveTestHelper
+
+  # ── unit rendering (template tests, no OS dependency) ─────────────────
+
+  def test_linux_unit_pins_binary_and_resolved_bind_port
+    with_tmp_dir do |dir|
+      installer = build_linux_installer(dir)
+      installer.install!(autostart: false)
+
+      body = File.read(File.join(dir, ".config/systemd/user/hive-web.service"))
+      assert_includes body, "ExecStart=#{dir}/bin/hive web --host 127.0.0.1 --port 4567"
+      assert_includes body, "Environment=PATH=",
+                      "minimal PATH must be rewritten so the wrapper's shebang resolves a working Ruby"
+    end
+  end
+
+  def test_linux_unit_bakes_absolute_xdg_values_for_service_context_parity
+    with_tmp_dir do |dir|
+      xdg_config = File.join(dir, "xdg-config")
+      installer = nil
+      with_env("XDG_CONFIG_HOME" => xdg_config) do
+        installer = build_linux_installer(dir)
+        installer.install!(autostart: false)
+      end
+
+      body = File.read(File.join(dir, ".config/systemd/user/hive-web.service"))
+      assert_includes body, "Environment=XDG_CONFIG_HOME=#{xdg_config}",
+                      "the served app must resolve the SAME XDG state as the interactive TUI"
+    end
+  end
+
+  def test_macos_plist_wraps_the_pinned_argv_and_env
+    with_tmp_dir do |dir|
+      commands = []
+      installer = Hive::Commands::Web::ServiceInstaller.new(
+        host_os: "darwin23", home: dir, binary_path: "/opt/hive/bin/hive",
+        runner: ->(argv) { commands << argv; true }
+      )
+      installer.install!(autostart: true)
+
+      body = File.read(File.join(dir, "Library/LaunchAgents/local.hive-web.plist"))
+      assert_includes body, "<string>/opt/hive/bin/hive</string>"
+      assert_includes body, "<string>web</string>"
+      assert_includes body, "<string>--host</string>"
+      assert_includes body, "<string>127.0.0.1</string>"
+      assert_includes body, "<string>4567</string>"
+      assert_includes body, "<string>local.hive-web</string>",
+                       "web must be a SEPARATE launchd label from the daemon's local.hive-daemon"
+      refute_includes body, "local.hive-daemon"
+      assert_equal [ [ "launchctl", "load", File.join(dir, "Library/LaunchAgents/local.hive-web.plist") ] ],
+                   commands
+    end
+  end
+
+  def test_drifted_web_unit_is_not_overwritten_without_force
+    with_tmp_dir do |dir|
+      unit = File.join(dir, ".config/systemd/user/hive-web.service")
+      FileUtils.mkdir_p(File.dirname(unit))
+      File.write(unit, "hand-edited\n")
+      installer = build_linux_installer(dir)
+
+      result = installer.install!(autostart: false)
+
+      assert_equal :drifted, result.kind
+      assert_equal "hand-edited\n", File.read(unit)
+    end
+  end
+
+  # ── lifecycle (command sequences via recording runner) ────────────────
+
+  def test_start_runs_daemon_reload_then_systemctl_start_on_linux
+    with_tmp_dir do |dir|
+      commands = []
+      installer = build_linux_installer(dir, systemctl_available: true,
+                                        runner: ->(argv) { commands << argv; true })
+
+      assert installer.start!
+      assert_includes commands, %w[systemctl --user daemon-reload]
+      assert_includes commands, %w[systemctl --user start hive-web]
+    end
+  end
+
+  def test_linux_start_reports_failure_when_systemctl_start_fails
+    with_tmp_dir do |dir|
+      calls = []
+      installer = build_linux_installer(dir, systemctl_available: true,
+                                        runner: lambda do |argv|
+                                          calls << argv
+                                          argv[2] != "start"
+                                        end)
+
+      refute installer.start!
+      assert installer.messages.any? { |m| m.include?("systemctl --user start hive-web") }
+    end
+  end
+
+  def test_linux_without_systemd_steers_to_the_foreground_run
+    with_tmp_dir do |dir|
+      installer = build_linux_installer(dir, systemctl_available: false,
+                                        runner: ->(_argv) { flunk("must not shell out") })
+
+      refute installer.start!
+      assert installer.messages.first.include?("foreground")
+    end
+  end
+
+  def test_macos_start_reports_failure_when_launchctl_missing_or_rejects
+    with_tmp_dir do |dir|
+      installer = Hive::Commands::Web::ServiceInstaller.new(
