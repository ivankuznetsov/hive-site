+
+  def test_classify_precedence_matrix
+    f = Hive::Local::DaemonDriftCheck.method(:classify)
+    assert_equal "ok", f.call(installed: true, running: true, paths_match: true, versions_match: true)
+    assert_equal "not_installed", f.call(installed: false, running: false, paths_match: false, versions_match: false)
+    assert_equal "not_running", f.call(installed: true, running: false, paths_match: true, versions_match: true)
+    assert_equal "path_mismatch", f.call(installed: true, running: true, paths_match: false, versions_match: false)
+    assert_equal "version_mismatch", f.call(installed: true, running: true, paths_match: true, versions_match: false)
+  end
+
+  def test_consistent_daemon_reports_ok_and_repair_is_noop
+    with_sandbox do |dir, hive_bin, statedir|
+      write_unit(dir, hive_bin)
+      write_live_pid(statedir)
+
+      drift = build_check(hive_bin: hive_bin, dir: dir, statedir: statedir,
+                          version_output: Hive::VERSION)
+      result = drift.call
+
+      assert_equal "ok", result.status
+      assert_equal File.realpath(hive_bin), result.unit_binary
+      _outcome, after = drift.repair!
+      assert_equal "ok", after.status
+    end
+  end
+
+  def test_path_drift_is_detected_and_repair_repins_the_real_binary
+    with_sandbox do |dir, hive_bin, statedir|
+      write_unit(dir, "/usr/bin/hive") # the classic wrong-package unit
+      write_live_pid(statedir)
+
+      commands = []
+      drift = build_check(hive_bin: hive_bin, dir: dir, statedir: statedir,
+                          version_output: Hive::VERSION, commands: commands)
+      result = drift.call
+
+      assert_equal "path_mismatch", result.status
+      assert_includes result.detail, "/usr/bin/hive"
+
+      outcome, after = drift.repair!
+      assert_equal :upgraded, outcome.kind
+      unit_body = File.read(File.join(dir, ".config/systemd/user/hive-daemon.service"))
+      assert_includes unit_body, hive_bin,
+                      "repair must repin ExecStart to the currently invoked binary"
+      assert commands.include?([ "systemctl", "--user", "restart", "hive-daemon" ]),
+             "a path-drift repair must restart through the service manager"
+      assert_equal "ok", after.status
+    end
+  end
+
+  def test_version_drift_is_detected_and_repair_restarts_the_stale_process
+    with_sandbox do |dir, hive_bin, statedir|
+      # Unit pins the RIGHT path; the binary on disk reports an OLD version.
+      write_unit(dir, hive_bin)
+      write_live_pid(statedir)
+
+      commands = []
+      drift = build_check(hive_bin: hive_bin, dir: dir, statedir: statedir,
+                          version_output: "0.0.1", commands: commands)
+      result = drift.call
+
+      assert_equal "version_mismatch", result.status
+      assert_equal "0.0.1", result.unit_version
+
+      outcome, _after = drift.repair!
+      assert_equal :unchanged, outcome.kind,
+                   "a pure version drift renders byte-identical unit content"
+      assert commands.include?([ "systemctl", "--user", "restart", "hive-daemon" ]),
+             "the explicit restart must fire when the force install is a no-op"
+    end
+  end
+
+  def test_registered_but_not_running_is_detected_with_start_guidance
+    with_sandbox do |dir, hive_bin, statedir|
+      write_unit(dir, hive_bin)
+
+      drift = build_check(hive_bin: hive_bin, dir: dir, statedir: statedir,
+                          version_output: Hive::VERSION)
+      result = drift.call
+
+      assert_equal "not_running", result.status
+      row = drift.check(result:)
+      assert_equal ["hive daemon start --detach"], row.fix_commands
+    end
+  end
+
+  def test_not_installed_is_detected_without_a_unit_path
+    with_sandbox do |dir, hive_bin, statedir|
+      drift = build_check(hive_bin: hive_bin, dir: dir, statedir: statedir,
+                          version_output: Hive::VERSION)
+      result = drift.call
+
+      assert_equal "not_installed", result.status
+      assert_nil result.unit_path
+    end
+  end
+
+  def test_check_row_maps_ok_and_drift_into_the_shared_audit_vocabulary
+    with_sandbox do |dir, hive_bin, statedir|
+      write_unit(dir, hive_bin)
+      write_live_pid(statedir)
+
+      healthy = build_check(hive_bin: hive_bin, dir: dir, statedir: statedir,
+                            version_output: Hive::VERSION)
+      ok_row = healthy.check
+      assert_equal "ok", ok_row.status
+      assert_empty ok_row.fix_commands
+
+      drifted_result = healthy.call.dup
+      drifted_result[:status] = "path_mismatch"
+      drifted_result[:detail] = "drift"
+      drifted_result[:unit_binary] = "/usr/bin/hive"
+      row = healthy.check(result: drifted_result)
+
+      assert_equal "unavailable", row.status
+      assert_includes row.fix_commands.first, "hive daemon install --force"
+    end
+  end
+
+  def test_check_rows_carry_status_specific_guidance_for_every_finding
+    stub = minimal_check
+    base = { expected_binary: "/bin/hive", unit_binary: "/usr/bin/hive",
+             expected_version: Hive::VERSION, unit_version: nil,
+             unit_path: "/u/unit.service", running_pid: nil }
+
+    not_installed = stub.check(result: drift_struct("not_installed", **base))
+    version_stale = stub.check(result: drift_struct("version_mismatch", **base))
+
+    assert_includes not_installed.fix_commands.first, "hive setup"
+    assert_includes version_stale.fix_commands.first, "--force"
+    assert_match(/v#{Regexp.escape(Hive::VERSION)}/, version_stale.detail)
+  end
