diff --git a/lib/hive/tui/info_panel.rb b/lib/hive/tui/info_panel.rb
new file mode 100644
index 000000000..7a2385a33
--- /dev/null
+++ b/lib/hive/tui/info_panel.rb
@@ -0,0 +1,157 @@
+require "time"
+require "yaml"
+require "hive/tui/model"
+
+module Hive
+  module Tui
+    # Read-only content assembly for the info panel (`i` on a focused
+    # grid row). Given a Snapshot::Row, builds the frozen
+    # Model::InfoPanelState the panel renders:
+    #
+    # * slug / stage / created_at / original idea text from the task's
+    #   idea.md frontmatter;
+    # * absolute working-dir path (the task folder);
+    # * absolute latest-log path (most recently modified file under
+    #   `<hive-state>/logs/<slug>/`, tie-broken by name descending);
+    # * stage extras — `brainstorm.md` for 2-brainstorm, `plan.md` for
+    #   3-plan, tail of the latest log for 4-execute, nothing for
+    #   1-inbox (or any other stage).
+    #
+    # Every read degrades gracefully: a missing idea.md, logs dir, or
+    # unparseable frontmatter yields placeholder strings, never an
+    # exception — the panel must open even on partial state. No method
+    # here writes, renames, or mutates anything (R6); BubbleModel calls
+    # this once per panel-open so the render thread stays disk-free.
+    module InfoPanel
+      NO_LOGS_PLACEHOLDER = "(no logs)".freeze
+      CREATED_AT_FALLBACK = "(unknown)".freeze
+      IDEA_TEXT_FALLBACK = "(idea.md not found)".freeze
+      MISSING_EXTRA_PLACEHOLDER = "(not present yet)".freeze
+
+      # Bounded read for the execute-log tail (plan U2: last N lines).
+      LOG_TAIL_LINES = 40
+      # Tail reads never load more than this many bytes into memory so a
+      # multi-megabyte execute log cannot stall the panel-open handler.
+      TAIL_CHUNK_BYTES = 65_536
+
+      module_function
+
+      # Build the panel state for `row`. Only reads; raises nothing for
+      # missing/unreadable sources (unanticipated errors propagate to
+      # BubbleModel's last-resort rescue, which flashes and keeps the
+      # TUI alive).
+      def assemble(row:)
+        folder = File.expand_path(row.folder.to_s)
+        data = read_frontmatter(File.join(folder, "idea.md"))
+        latest_log = latest_log_path(folder, row.slug)
+
+        Model::InfoPanelState.new(
+          slug: row.slug.to_s,
+          stage: row.stage.to_s,
+          created_at: format_created_at(data["created_at"]),
+          idea_text: data["original_text"].to_s.empty? ? IDEA_TEXT_FALLBACK : data["original_text"].to_s,
+          work_dir: folder,
+          log_path: latest_log || NO_LOGS_PLACEHOLDER,
+          extra_title: extra_title(row),
+          extra_lines: extra_lines(row, latest_log)
+        ).freeze
+      end
+
+      # Frontmatter `created_at` parses (via YAML) into Time/Date when
+      # well-formed; render it back in its canonical ISO-8601 shape so
+      # the panel shows exactly what idea.md declared.
+      def format_created_at(value)
+        rendered = case value
+                   when Time then value.utc.iso8601
+                   when Date then value.iso8601
+                   else value.to_s
+                   end
+        rendered.empty? ? CREATED_AT_FALLBACK : rendered
+      end
+
+      # @api private — stage-extras section header; nil means "no
+      # extras for this stage" and the view skips the section entirely.
+      def extra_title(row)
+        case row.stage.to_s
+        when "2-brainstorm" then "brainstorm.md"
+        when "3-plan" then "plan.md"
+        when "4-execute" then "latest execute log (tail)"
+        else nil
+        end
+      end
+
+      # @api private — stage-extras body lines. All sources degrade to a
+      # placeholder line rather than erroring (R4/R6); the execute tail
+      # is capped at LOG_TAIL_LINES so a huge log cannot stall render.
+      def extra_lines(row, latest_log)
+        folder = File.expand_path(row.folder.to_s)
+        case row.stage.to_s
+        when "2-brainstorm", "3-plan"
+          doc_name = extra_title(row)
+          path = File.join(folder, doc_name)
+          File.file?(path) ? File.read(path).lines(chomp: true) : [ MISSING_EXTRA_PLACEHOLDER ]
+        when "4-execute"
+          if latest_log.nil?
+            [ NO_LOGS_PLACEHOLDER ]
+          else
+            log_tail_lines(latest_log, LOG_TAIL_LINES)
+          end
+        else
+          []
+        end
+      rescue SystemCallError, IOError
+        [ MISSING_EXTRA_PLACEHOLDER ]
+      end
+
+      # Parse idea.md's YAML frontmatter (`---` delimited head block).
+      # Missing or malformed frontmatter yields {} so callers fall back
+      # to placeholders instead of raising.
+      def read_frontmatter(path)
+        return {} unless File.file?(path)
+
+        contents = File.read(path)
+        match = contents.match(/\A---[ \t]*\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|\z)/m)
+        return {} unless match
+
+        parsed = YAML.safe_load(
+          match[1],
+          permitted_classes: [ Time, Date ],
+          permitted_symbols: [],
+          aliases: false
+        ) || {}
+        parsed.is_a?(Hash) ? parsed : {}
+      rescue Psych::Exception, SystemCallError, IOError
+        {}
+      end
+
+      # Last `count` lines of `path`, reading at most TAIL_CHUNK_BYTES
+      # from the end of the file. The first (possibly partial) line of a
+      # truncated chunk is dropped so no half line ever renders.
+      def log_tail_lines(path, count)
+        return File.foreach(path).to_a.last(count).map(&:chomp) unless File.size(path) > TAIL_CHUNK_BYTES
+
+        File.open(path, "rb") do |file|
+          file.seek(File.size(path) - TAIL_CHUNK_BYTES)
+          file.read.to_s.lines(chomp: true)[1..].last(count).to_a
+        end
+      end
+
+      # Most recently modified regular file directly under
+      # `<hive-state>/logs/<slug>/` (the dir two levels above the task
+      # folder, mirroring `<state>/stages/<stage>/<slug>`). Tie-break:
+      # name descending. Returns nil when the dir or files are absent —
+      # callers render the placeholder.
+      def latest_log_path(task_folder, slug)
+        logs_dir = File.join(File.dirname(File.dirname(task_folder)), "logs", slug.to_s)
+        entries = Dir.children(logs_dir)
+                     .map { |name| File.join(logs_dir, name) }
+                     .select { |path| File.file?(path) }
+        return nil if entries.empty?
+
+        entries.max_by { |path| [ File.mtime(path).to_f, path ] }
+      rescue SystemCallError, IOError
+        nil
+      end
+    end
+  end
+end
