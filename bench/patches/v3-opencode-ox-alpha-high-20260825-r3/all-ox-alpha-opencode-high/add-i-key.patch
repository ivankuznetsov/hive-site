diff --git a/test/unit/tui/views/info_panel_test.rb b/test/unit/tui/views/info_panel_test.rb
new file mode 100644
index 000000000..66eabf12f
--- /dev/null
+++ b/test/unit/tui/views/info_panel_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+require "hive/tui/model"
+require "hive/tui/views/info_panel"
+
+class HiveTuiViewsInfoPanelTest < Minitest::Test
+  include HiveTestHelper
+
+  def state(idea_text: "Build task from user note", extra_title: nil, extra_lines: [])
+    Hive::Tui::Model::InfoPanelState.new(
+      slug: "some-slug",
+      stage: "2-brainstorm",
+      created_at: "2026-05-20T00:00:00Z",
+      idea_text: idea_text,
+      work_dir: "/tmp/hive/some-slug",
+      log_path: "/tmp/hive/logs/some-slug/execute.log",
+      extra_title: extra_title,
+      extra_lines: extra_lines
+    )
+  end
+
+  def model(cols: 80, rows: 24, **state_kwargs)
+    Hive::Tui::Model.initial.with(
+      mode: :info_panel,
+      info_panel_state: state(**state_kwargs),
+      cols: cols,
+      rows: rows
+    )
+  end
+
+  def test_renders_common_fields
+    out = Hive::Tui::Views::InfoPanel.render(model)
+    assert_includes out, "task some-slug — 2-brainstorm"
+    assert_includes out, "created_at: 2026-05-20T00:00:00Z"
+    assert_includes out, "work dir:   /tmp/hive/some-slug"
+    assert_includes out, "log path:   /tmp/hive/logs/some-slug/execute.log"
+  end
+
+  def test_renders_full_idea_text_and_dismiss_hint
+    out = Hive::Tui::Views::InfoPanel.render(model)
+    assert_includes out, "Build task from user note"
+    assert_includes out, "[q] close"
+  end
+
+  def test_nil_state_renders_empty_string
+    m = Hive::Tui::Model.initial.with(mode: :info_panel, info_panel_state: nil)
+    assert_equal "", Hive::Tui::Views::InfoPanel.render(m)
+  end
+
+  def test_wide_lines_truncate_with_ellipsis
+    out = Hive::Tui::Views::InfoPanel.render(model(cols: 20))
+    refute_includes out, "/tmp/hive/logs/some-slug/execute.log",
+                    "long lines must be truncated to the terminal width"
+    assert_includes out, "…", "truncated lines must carry the ellipsis indicator"
+  end
+
+  def test_tall_content_is_capped_with_overflow_indicator
+    long_idea = (1..60).map { |i| "idea line #{i}" }.join("\n")
+    out = Hive::Tui::Views::InfoPanel.render(model(rows: 10, idea_text: long_idea))
+
+    assert_includes out, "idea line 1", "head of tall content must stay visible"
+    refute_includes out, "idea line 60", "tail beyond the viewport must be cut"
+    out_lines = out.lines(chomp: true)
+    assert_equal Hive::Tui::Views::InfoPanel::OVERFLOW_INDICATOR, out_lines.last,
+                 "clipped panels must end with the ellipsis overflow indicator"
+    assert_operator out_lines.length, :<=, 10,
+                    "panel must never exceed the viewport height"
+  end
+
+  def test_extra_section_renders_when_present
+    out = Hive::Tui::Views::InfoPanel.render(
+      model(extra_title: "brainstorm.md", extra_lines: [ "## Round 1", "- answer" ])
+    )
+    assert_includes out, "brainstorm.md"
+    assert_includes out, "## Round 1"
+  end
+
+  def test_no_extra_section_when_title_absent
+    out = Hive::Tui::Views::InfoPanel.render(model)
+    refute_includes out, "(no extras)"
+  end
+end
