+
+  def test_latest_log_path_picks_most_recently_modified_file
+    with_tmp_dir do |dir|
+      logs_dir = File.join(dir, "logs", "some-slug")
+      FileUtils.mkdir_p(logs_dir)
+      old_log = File.join(logs_dir, "a-old.log")
+      new_log = File.join(logs_dir, "b-new.log")
+      File.write(old_log, "old\n")
+      sleep 0.02
+      File.write(new_log, "new\n")
+
+      assert_equal new_log,
+                   Hive::Tui::InfoPanel.latest_log_path(dir, "some-slug"),
+                   "must pick the most recently modified log"
+    end
+  end
+
+  def test_latest_log_path_tie_breaks_by_name_descending
+    with_tmp_dir do |dir|
+      logs_dir = File.join(dir, "logs", "some-slug")
+      FileUtils.mkdir_p(logs_dir)
+      %w[alpha.log beta.log].each { |name| File.write(File.join(logs_dir, name), "x\n") }
+      same = Time.now
+      File.utime(same, same, File.join(logs_dir, "alpha.log"))
+      File.utime(same, same, File.join(logs_dir, "beta.log"))
+
+      assert_equal File.join(logs_dir, "beta.log"),
+                   Hive::Tui::InfoPanel.latest_log_path(dir, "some-slug"),
+                   "equal mtimes tie-break by name descending"
+    end
+  end
+
+  def test_assembly_performs_no_writes
+    with_tmp_dir do |dir|
+      write_idea_md(dir)
+      logs_dir = File.join(dir, "logs", "some-slug")
+      FileUtils.mkdir_p(logs_dir)
+      File.write(File.join(logs_dir, "run.log"), "hello\n")
+      before = snapshot_tree(dir)
+
+      Hive::Tui::InfoPanel.assemble(row: make_row(folder: dir))
+
+      assert_tree_unchanged(before, dir)
+    end
+  end
+end
