new file mode 100644
index 000000000..fad8872c2
--- /dev/null
+++ b/lib/hive/tui/views/info_panel.rb
@@ -0,0 +1,78 @@
+require "hive/tui/styles"
+require "hive/tui/views/format"
+
+module Hive
+  module Tui
+    module Views
+      # Full-screen, read-only info panel for the focused task (`i` in
+      # grid mode). Pure view function over `Model::InfoPanelState` —
+      # all content was assembled (read-only) when the panel opened, so
+      # render never touches the filesystem. Lines wider than the
+      # terminal are truncated with a trailing ellipsis; content taller
+      # than the viewport is cut with a single `…` overflow line
+      # (scrolling is a follow-up).
+      module InfoPanel
+        DISMISS_HINT = "[q] close  [Esc] close  [i] close".freeze
+        OVERFLOW_INDICATOR = "…".freeze
+
+        module_function
+
+        def render(model, width: model.cols.to_i, height: model.rows.to_i)
+          state = model.info_panel_state
+          return "" if state.nil?
+
+          usable = [ width.to_i, 1 ].max
+          max_visible = [ height.to_i, 1 ].max
+          lines = build_lines(state).map { |line| truncate_line(line, usable) }
+          lines = cap_to_viewport(lines, max_visible)
+          lines.join("\n")
+        end
+
+        # @api private — exposed for tests.
+        def build_lines(state)
+          lines = [
+            Styles::HEADER.render("task #{state.slug} — #{state.stage}"),
+            "",
+            "slug:       #{state.slug}",
+            "stage:      #{state.stage}",
+            "created_at: #{state.created_at}",
+            "work dir:   #{state.work_dir}",
+            "log path:   #{state.log_path}",
+            "",
+            Styles::HEADER.render("idea"),
+            *idea_lines(state)
+          ]
+          unless state.extra_title.nil?
+            lines << ""
+            lines << Styles::HEADER.render(state.extra_title)
+            lines.concat(Array(state.extra_lines))
+          end
+
+          lines << ""
+          lines << Styles::HINT.render(DISMISS_HINT)
+          lines
+        end
+
+        # Multi-line idea text must land as individual rows so width
+        # truncation and the viewport cap operate per line.
+        def idea_lines(state)
+          split = state.idea_text.to_s.lines(chomp: true)
+          split.empty? ? [ "" ] : split
+        end
+
+        # R8: no scrolling this iteration — drop the tail and mark it
+        # with a lone ellipsis line so the operator can tell the panel
+        # is clipped rather than complete.
+        def cap_to_viewport(lines, max_visible)
+          return lines if lines.length <= max_visible
+
+          lines.first([ max_visible - 1, 1 ].max) + [ OVERFLOW_INDICATOR ]
+        end
+
+        def truncate_line(line, usable)
+          Views::Format.truncate(line, usable)
+        end
+      end
+    end
+  end
+end
