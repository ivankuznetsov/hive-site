+
+      assert_equal Hive::Tui::InfoPanel::NO_LOGS_PLACEHOLDER, state.log_path
+      assert_equal [ Hive::Tui::InfoPanel::NO_LOGS_PLACEHOLDER ], state.extra_lines
+    end
