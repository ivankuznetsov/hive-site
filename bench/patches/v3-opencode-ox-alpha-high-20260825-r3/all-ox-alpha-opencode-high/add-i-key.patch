@@ -0,0 +1,208 @@
+require "test_helper"
+require "fileutils"
+require "tmpdir"
+require "hive/tui/info_panel"
+
+# Pins the read-only content assembly for the info panel (`i`): common
+# fields from idea.md frontmatter, absolute paths, latest-log discovery,
+# and graceful placeholders for missing sources. Every scenario asserts
+# the fixture tree stays byte-identical — assembly must never write.
+class HiveTuiInfoPanelTest < Minitest::Test
+  include HiveTestHelper
+
+  def make_row(folder:, slug: "some-slug", stage: "1-inbox")
+    Hive::Tui::Snapshot::Row.new(
+      project_name: "demo", stage: stage, slug: slug, folder: folder,
+      state_file: File.join(folder, "idea.md"), marker: "waiting", attrs: {},
+      mtime: nil, age_seconds: 0, claude_pid: nil, claude_pid_alive: nil,
+      action_key: "needs_input", action_label: "Needs your input",
+      suggested_command: nil, next_action: nil, diagnostic: nil
+    )
+  end
+
+  def write_idea_md(dir, created_at: "2026-05-20T00:00:00Z", original_text: "Build task")
+    body = [
+      "---",
+      "slug: some-slug",
+      "created_at: #{created_at}",
+      "original_text: |",
+      *original_text.lines.map { |line| "  #{line.chomp}" },
+      "---",
+      "",
+      "# some-slug",
+      "",
+      original_text
+    ].join("\n")
+    File.write(File.join(dir, "idea.md"), body)
+  end
+
+  def snapshot_tree(dir)
+    Dir.glob("#{dir}/**/*", File::FNM_DOTMATCH)
+       .sort
+       .reject { |path| path == dir || File.directory?(path) }
+       .to_h { |path| [ path, [ File.read(path), File.mtime(path) ] ] }
+  end
+
+  def assert_tree_unchanged(before, dir)
+    assert_equal before.keys, snapshot_tree(dir).keys,
+                 "assembly must not create or delete files"
+    snapshot_tree(dir).each do |path, (content, mtime)|
+      assert_equal before[path][0], content, "#{path} content must be untouched"
+      assert_equal before[path][1], mtime, "#{path} mtime must be untouched"
+    end
+  end
+
+  def test_inbox_card_yields_common_fields_without_extras
+    with_tmp_dir do |dir|
+      write_idea_md(dir)
+      row = make_row(folder: dir)
+
+      state = Hive::Tui::InfoPanel.assemble(row: row)
+
+      assert_equal "some-slug", state.slug
+      assert_equal "1-inbox", state.stage
+      assert_equal "2026-05-20T00:00:00Z", state.created_at
+      assert_equal "Build task", state.idea_text
+      assert_equal dir, state.work_dir
+      refute_includes state.work_dir, "./", "work dir must be absolute and normalized"
+      assert_nil state.extra_title, "1-inbox cards carry no stage extras"
+      assert_empty state.extra_lines
+      assert_equal Hive::Tui::InfoPanel::NO_LOGS_PLACEHOLDER, state.log_path
+    end
+  end
+
+  def test_brainstorm_card_includes_brainstorm_md_contents
+    with_tmp_dir do |dir|
+      write_idea_md(dir)
+      File.write(File.join(dir, "brainstorm.md"), "## Round 1\n- locked requirement\n")
+      state = Hive::Tui::InfoPanel.assemble(row: make_row(folder: dir, stage: "2-brainstorm"))
+
+      assert_equal "brainstorm.md", state.extra_title
+      assert_includes state.extra_lines.join("\n"), "locked requirement"
+    end
+  end
+
+  def test_brainstorm_card_without_brainstorm_md_shows_placeholder
+    with_tmp_dir do |dir|
+      write_idea_md(dir)
+      state = Hive::Tui::InfoPanel.assemble(row: make_row(folder: dir, stage: "2-brainstorm"))
+
+      assert_equal [ Hive::Tui::InfoPanel::MISSING_EXTRA_PLACEHOLDER ], state.extra_lines
+    end
+  end
+
+  def test_plan_card_includes_plan_md_contents
+    with_tmp_dir do |dir|
+      write_idea_md(dir)
+      File.write(File.join(dir, "plan.md"), "# Plan: ship it\n")
+      state = Hive::Tui::InfoPanel.assemble(row: make_row(folder: dir, stage: "3-plan"))
+
+      assert_equal "plan.md", state.extra_title
+      assert_includes state.extra_lines.join("\n"), "# Plan: ship it"
+    end
+  end
+
+  def test_plan_card_without_plan_md_shows_placeholder
+    with_tmp_dir do |dir|
+      write_idea_md(dir)
+      state = Hive::Tui::InfoPanel.assemble(row: make_row(folder: dir, stage: "3-plan"))
+
+      assert_equal [ Hive::Tui::InfoPanel::MISSING_EXTRA_PLACEHOLDER ], state.extra_lines
+    end
+  end
+
+  def test_execute_card_includes_bounded_tail_of_latest_log
+    with_tmp_dir do |dir|
+      write_idea_md(dir)
+      logs_dir = File.join(dir, "logs", "some-slug")
+      FileUtils.mkdir_p(logs_dir)
+      latest = File.join(logs_dir, "run.log")
+      File.write(latest, Array.new(100) { |i| "line #{i}" }.join("\n") << "\n")
+      stale = File.join(logs_dir, "older.log")
+      File.write(stale, "stale\n")
+
+      state = Hive::Tui::InfoPanel.assemble(row: make_row(folder: dir, stage: "4-execute"))
+
+      assert_equal latest, state.log_path
+      body = state.extra_lines.join("\n")
+      refute_includes body, "line 0", "tail must be bounded to the last lines only"
+      assert_includes body, "line 99"
+      assert_operator state.extra_lines.length, :<=, Hive::Tui::InfoPanel::LOG_TAIL_LINES
