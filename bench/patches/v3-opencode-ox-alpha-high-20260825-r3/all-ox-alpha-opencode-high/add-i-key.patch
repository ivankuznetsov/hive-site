+
+  def test_missing_idea_md_degrades_to_placeholders
+    with_tmp_dir do |dir|
+      state = Hive::Tui::InfoPanel.assemble(row: make_row(folder: dir))
+
+      assert_equal Hive::Tui::InfoPanel::IDEA_TEXT_FALLBACK, state.idea_text
+      assert_equal Hive::Tui::InfoPanel::CREATED_AT_FALLBACK, state.created_at
+    end
+  end
+
+  def test_malformed_frontmatter_degrades_to_placeholders
+    with_tmp_dir do |dir|
+      File.write(File.join(dir, "idea.md"), "---\noriginal_text: [broken\n---\n")
+
+      state = Hive::Tui::InfoPanel.assemble(row: make_row(folder: dir))
+
+      assert_equal Hive::Tui::InfoPanel::IDEA_TEXT_FALLBACK, state.idea_text
+    end
