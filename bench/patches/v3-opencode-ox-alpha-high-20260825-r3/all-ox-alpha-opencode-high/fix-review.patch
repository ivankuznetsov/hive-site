+              no_change_evidence: new_commit || clean,
+              unresolved_escalation: false,
+              missing_output_marker: false,
+              artifacts_checked: "none",
+              commit_evidence: new_commit ? "new_commit=#{head_now[0, 12]}" : (clean ? "no_change" : "none")
+            }
+          end
+        end
       end
     end
   end
