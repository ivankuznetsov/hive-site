@@ -151,4 +151,50 @@ class StopHookInstallerTest < Minitest::Test
   def test_stop_hook_syntax
     assert system("sh", "-n", HOOK)
   end
+
+  def test_sentinel_filename_constants_match_the_shell_hook
+    assert_equal ".done", Hive::StopHookInstaller::DONE_FILENAME
+    assert_equal "result.json", Hive::StopHookInstaller::RESULT_FILENAME
+
+    hook_body = File.read(HOOK)
+    assert_includes hook_body, %(${HIVE_TASK_STAGE_DIR}/#{Hive::StopHookInstaller::RESULT_FILENAME})
+    assert_includes hook_body, %(${HIVE_TASK_STAGE_DIR}/#{Hive::StopHookInstaller::DONE_FILENAME})
+  end
+
+  def test_launcher_and_installer_derive_signal_files_from_one_source
+    task = Struct.new(:folder).new("/tmp/some-task")
+    expected = Hive::StopHookInstaller.signal_file_paths(task.folder)
+
+    assert_equal File.join(task.folder, ".done"), expected[:done]
+    assert_equal Hive::ClaudeLauncher.done_path(task), expected[:done]
+    assert_equal Hive::ClaudeLauncher.result_path(task), expected[:result]
+  end
+
+  # Installer → hook → launcher round-trip: the settings file must point at
+  # the generated hook, and invoking it exactly as Claude Code does (shell
+  # string + HIVE_TASK_STAGE_DIR + JSON on stdin) must produce the sentinel
+  # files at the exact paths ClaudeLauncher's wait loops poll, which
+  # cleanup_done then removes.
+  def test_install_to_hook_to_launcher_sentinel_round_trip
+    require "hive/claude_launcher"
+
+    with_tmp_dir do |dir|
+      settings_path = Hive::StopHookInstaller.install(stage_dir: dir).first
+      command = JSON.parse(File.read(settings_path))
+                    .fetch("hooks").fetch("Stop").fetch(0)
+                    .fetch("hooks").fetch(0).fetch("command")
+
+      payload = %({"session_id":"round-trip"})
+      out, err, status = Open3.capture3({ "HIVE_TASK_STAGE_DIR" => nil }, "sh", "-c", command,
+                                        stdin_data: payload)
+
+      assert status.success?, "hook invocation failed: #{err.inspect}"
+      task = Struct.new(:folder).new(dir)
+      assert_equal payload, File.read(Hive::ClaudeLauncher.result_path(task))
+      assert File.exist?(Hive::ClaudeLauncher.done_path(task))
+
+      Hive::ClaudeLauncher.cleanup_done(task)
+      refute File.exist?(Hive::ClaudeLauncher.done_path(task))
+    end
+  end
