diff --git a/test/unit/claude_completion_evaluator_test.rb b/test/unit/claude_completion_evaluator_test.rb
new file mode 100644
index 000000000..7bc6cf615
--- /dev/null
+++ b/test/unit/claude_completion_evaluator_test.rb
@@ -0,0 +1,133 @@
+require "test_helper"
+require "json"
+require "fileutils"
+require "hive/claude_completion_evaluator"
+
+class ClaudeCompletionEvaluatorTest < Minitest::Test
+  include HiveTestHelper
+
+  def base_context(overrides = {})
+    {
+      sentinel_seen: false,
+      exit_status: :timeout,
+      crashed: false,
+      session_readable: true,
+      worktree_readable: true,
+      required_artifacts: [],
+      change_claimed: true,
+      new_commit_since_start: false,
+      no_change_evidence: false,
+      unresolved_escalation: false,
+      missing_output_marker: false
+    }.merge(overrides)
+  end
+
+  def test_predicate_holds_when_every_condition_is_satisfied
+    decision = Hive::ClaudeCompletionEvaluator.evaluate(base_context)
+
+    assert decision.fallback_ok?
+    assert_nil decision.failed_condition
+  end
+
+  def test_each_flipped_condition_fails_the_predicate
+    cases = {
+      sentinel_missing: { sentinel_seen: true },
+      exit_timeout_only: { exit_status: :error },
+      not_crashed: { crashed: true },
+      session_readable: { session_readable: false },
+      worktree_readable: { worktree_readable: false },
+      artifacts_exist_and_parse: { required_artifacts: [ { path: "/nonexistent/artifact.md" } ] },
+      commit_or_no_change_evidence: { change_claimed: true, new_commit_since_start: false },
+      no_unresolved_escalation: { unresolved_escalation: true },
+      no_missing_output_marker: { missing_output_marker: true }
+    }
+
+    cases.each do |expected_failure, overrides|
+      decision = Hive::ClaudeCompletionEvaluator.evaluate(base_context(overrides))
+
+      refute decision.fallback_ok?,
+             "flipping #{expected_failure} must fail the predicate"
+      assert_equal expected_failure, decision.failed_condition
+    end
+  end
+
+  def test_commit_required_branch_requires_new_commit
+    decision = Hive::ClaudeCompletionEvaluator.evaluate(
+      base_context(change_claimed: true, new_commit_since_start: false)
+    )
+    refute decision.fallback_ok?
+    assert_equal :commit_or_no_change_evidence, decision.failed_condition
+
+    ok = Hive::ClaudeCompletionEvaluator.evaluate(
+      base_context(change_claimed: true, new_commit_since_start: true)
+    )
+    assert ok.fallback_ok?
+  end
+
+  def test_no_change_branch_accepts_explicit_no_change_evidence_or_new_commit
+    ambiguous = Hive::ClaudeCompletionEvaluator.evaluate(
+      base_context(change_claimed: false, new_commit_since_start: false, no_change_evidence: false)
+    )
+    refute ambiguous.fallback_ok?
+    assert_equal :commit_or_no_change_evidence, ambiguous.failed_condition
+
+    explicit = Hive::ClaudeCompletionEvaluator.evaluate(
+      base_context(change_claimed: false, new_commit_since_start: false, no_change_evidence: true)
+    )
+    assert explicit.fallback_ok?
+
+    committed = Hive::ClaudeCompletionEvaluator.evaluate(
+      base_context(change_claimed: false, new_commit_since_start: true, no_change_evidence: false)
+    )
+    assert committed.fallback_ok?
+  end
+
+  def test_artifact_must_exist_be_non_empty_and_parse
+    with_tmp_dir do |dir|
+      good = File.join(dir, "good.json")
+      File.write(good, JSON.generate(status: "passed"))
+      empty = File.join(dir, "empty.md")
+      File.write(empty, "")
+      bad = File.join(dir, "bad.json")
+      File.write(bad, "{not json")
+
+      ok = Hive::ClaudeCompletionEvaluator.evaluate(base_context(
+        required_artifacts: [ { path: good, parser: ->(body) { JSON.parse(body).is_a?(Hash) } } ]
+      ))
+      assert ok.fallback_ok?
+
+      missing = Hive::ClaudeCompletionEvaluator.evaluate(base_context(
+        required_artifacts: [ { path: File.join(dir, "nope.md") } ]
+      ))
+      refute missing.fallback_ok?
+      assert_equal :artifacts_exist_and_parse, missing.failed_condition
+
+      empty_result = Hive::ClaudeCompletionEvaluator.evaluate(base_context(
+        required_artifacts: [ { path: empty } ]
+      ))
+      refute empty_result.fallback_ok?
+
+      unparseable = Hive::ClaudeCompletionEvaluator.evaluate(base_context(
+        required_artifacts: [ { path: bad, parser: ->(body) { JSON.parse(body) } } ]
+      ))
+      refute unparseable.fallback_ok?
+
+      raising_parser = Hive::ClaudeCompletionEvaluator.evaluate(base_context(
+        required_artifacts: [ { path: good, parser: ->(_body) { raise ArgumentError, "boom" } } ]
+      ))
+      refute raising_parser.fallback_ok?
+    end
+  end
+
+  def test_normalize_coerces_truthy_values_to_strict_booleans
+    evidence = Hive::ClaudeCompletionEvaluator.normalize(
+      session_readable: "yes", crashed: nil, change_claimed: 1,
+      required_artifacts: nil
+    )
+
+    refute evidence[:session_readable]
+    refute evidence[:crashed]
+    assert evidence[:change_claimed]
+    assert_equal [], evidence[:required_artifacts]
+  end
+end
