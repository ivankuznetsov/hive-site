+      # Evidence closure for the shared tmux completion fallback
+      # (ClaudeLauncher / ClaudeCompletionEvaluator). Evaluated only when
+      # the fix agent's Stop hook never wrote `.done`; a positive decision
+      # lets a clean-exit-with-artifacts pass reach SUCCESS instead of a
+      # terminal REVIEW_ERROR. The pass always claims code changes here, so
+      # the commit rule requires HEAD to have advanced past before_fix_head;
+      # unresolved escalations or a missing/unparseable escalations doc keep
+      # the strict failure.
+      def fix_completion_check(ctx, before_fix_head)
+        escalations = Hive::Stages::Review::Triage.escalations_path(ctx)
+        lambda do
+          head_now = git_head(ctx.worktree_path)
+          new_commit = !head_now.to_s.empty? && head_now != before_fix_head.to_s
+          {
+            phase: "fix",
+            pass: format("%02d", ctx.pass),
+            session: "worktree=#{File.basename(ctx.worktree_path)}",
+            required_artifacts: [ { path: escalations, parser: ->(body) { !body.strip.empty? } } ],
+            change_claimed: true,
+            new_commit_since_start: new_commit,
+            no_change_evidence: false,
+            unresolved_escalation: count_escalations(ctx).positive?,
+            missing_output_marker: false,
+            artifacts_checked: File.basename(escalations),
+            commit_evidence: new_commit ? "new_commit=#{head_now[0, 12]}" : "none"
+          }
+        end
+      end
+
       # The triage bias configured for this run, surfaced into commit
       # trailers so `hive metrics rollback-rate` can compare bias presets.
       # Defaults to "courageous" — same default as Triage.run! itself.
