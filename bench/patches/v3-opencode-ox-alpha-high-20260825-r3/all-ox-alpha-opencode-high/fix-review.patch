+    # Tolerant completion fallback for the missing-stop-hook-sentinel
+    # incident shape: a tmux phase did real work (artifacts written,
+    # commits made) but `.done` never appeared, so the wait drained to its
+    # deadline. When a caller supplied a `completion_check` closure, build
+    # the shared evidence context (launcher-observed facts merged over the
+    # caller's parameterized inputs), evaluate the R3 predicate, and on a
+    # positive decision emit the WARN-level `claude_completion_fallback`
+    # audit event and return an :ok envelope so the stage proceeds to
+    # SUCCESS. A nil check, an evaluator decline, or any evaluation error
+    # returns nil so the caller keeps its exact strict-failure path
+    # (crashes, unreadable/gone tmux, missing artifacts never soften).
+    def completion_fallback_result(task, runner, log_label, completion_check)
+      return nil unless completion_check
+
+      supplied = completion_check.call || {}
+      evidence = supplied.merge(
+        sentinel_seen: false,
+        exit_status: :timeout,
+        crashed: false,
+        session_readable: pane_readable?(runner)
+      )
+      decision = Hive::ClaudeCompletionEvaluator.evaluate(evidence)
+      unless decision.fallback_ok?
+        warn "[hive] claude_completion_fallback declined for #{task_slug(task)}: #{decision.failed_condition}"
+        return nil
+      end
+
+      emit_completion_fallback_event(task, supplied)
+      { status: :ok, log_label: log_label, completion_fallback: true }
+    rescue StandardError => e
+      warn "[hive] claude_completion_fallback evaluation failed for #{task_slug(task)}: #{e.class}: #{e.message}"
+      nil
+    end
+
+    def pane_readable?(runner)
+      return false unless runner.respond_to?(:capture_pane_tail)
+
+      !runner.capture_pane_tail(bytes: SENTINEL_CAPTURE_BYTES).to_s.strip.empty?
+    rescue Hive::TmuxError
+      false
+    end
+
+    def emit_completion_fallback_event(task, supplied)
+      require "hive/stages/base"
+      payload = {
+        phase: supplied[:phase] || "unknown",
+        pass: supplied[:pass] || "n/a",
+        session: supplied[:session] || "pid=unknown",
+        expected_sentinel: done_path(task),
+        missing_signal: "stop_hook_sentinel_not_written",
+        artifacts: supplied[:artifacts_checked] || "none",
+        commit_evidence: supplied[:commit_evidence] || "none",
+        slug: task_slug(task)
+      }
+      message = "WARN " + payload.map { |key, value| "#{key}=#{value}" }.join(" ")
+      Hive::Events.emit(
+        task_folder: task.folder,
+        slug: task_slug(task),
+        stage: Hive::Stages::Base.stage_label(task),
+        event_type: :claude_completion_fallback,
+        agent: "claude",
+        message: message
+      )
+    rescue StandardError => e
+      warn "[hive] could not emit claude_completion_fallback event: #{e.class}: #{e.message}"
+      nil
+    end
+
     def poll_interval
       Float(tmux_env("POLL_INTERVAL_SEC", DONE_POLL_INTERVAL_SEC.to_s))
     end
