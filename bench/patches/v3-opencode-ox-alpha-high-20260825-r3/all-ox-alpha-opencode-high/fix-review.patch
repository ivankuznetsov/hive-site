+        end
+
+        marker = Hive::Markers.current(File.join(folder, "task.md"))
+        assert_equal :review_complete, marker.name,
+                     "clean-exit-with-artifacts must not strand in REVIEW_ERROR"
+        events = File.readlines(File.join(folder, "events.jsonl")).map { |l| JSON.parse(l) }
+        fallback = events.find { |e| e["event_type"] == "claude_completion_fallback" }
