diff --git a/test/unit/daemon/auto_retry/classify_test.rb b/test/unit/daemon/auto_retry/classify_test.rb
new file mode 100644
index 000000000..a52e12622
--- /dev/null
+++ b/test/unit/daemon/auto_retry/classify_test.rb
@@ -0,0 +1,86 @@
+# frozen_string_literal: true
+
+require "test_helper"
+require "hive/daemon/auto_retry/classify"
+
+# U1: recoverable-marker classification pins the closed v1 allowlist and
+# the required diagnostic signatures (AE3: unknown signatures stay parked).
+class HiveDaemonAutoRetryClassifyTest < Minitest::Test
+  def test_codex_auth_implementer_failure_is_recoverable
+    result = classify(reason: "implementer_failed",
+                      message: "codex exec failed: HTTP 401 missing bearer auth")
+    assert_predicate(result, :recoverable?)
+    assert_equal(:codex_auth, result.kind)
+  end
+
+  def test_unrelated_implementer_failure_is_not_recoverable
+    result = classify(reason: "implementer_failed", message: "exit_code=1 build broke in src/foo.ts")
+    refute_predicate(result, :recoverable?)
+  end
+
+  def test_missing_bearer_and_basic_auth_variants_match
+    assert classify(reason: "implementer_failed", message: "unauthorized: missing basic auth").recoverable?
+    assert classify(reason: "implementer_failed", message: "401 Unauthorized").recoverable?
+  end
+
+  def test_claude_launch_readiness_failure_is_recoverable
+    result = classify(reason: "claude_launch_failed",
+                      message: "tmux session hive-x did not become ready")
+    assert_predicate(result, :recoverable?)
+    assert_equal(:claude_launcher, result.kind)
+  end
+
+  def test_claude_launch_with_unrecognized_content_is_not_recoverable
+    result = classify(reason: "claude_launch_failed", message: "something entirely different happened")
+    refute_predicate(result, :recoverable?)
+  end
+
+  def test_unknown_reasons_are_never_recoverable
+    %w[
+      implementer_test_failed
+      review_findings
+      merge_conflict
+      dirty_worktree
+      exit_code
+      timeout
+      limits_reached
+    ].each do |reason|
+      result = classify(reason: reason, message: "HTTP 401 unauthorized")
+      refute_predicate(result, :recoverable?, "reason #{reason} must not be auto-retryable")
+    end
+  end
+
+  def test_marker_without_diagnostics_is_not_recoverable
+    result = Hive::Daemon::AutoRetry::Classifier.classify(
+      marker_name: "error",
+      marker_attrs: { "reason" => "implementer_failed" },
+      diagnostics: ""
+    )
+    refute_predicate(result, :recoverable?)
+  end
+
+  def test_diagnostics_text_reads_red_status_and_newest_log
+    Dir.mktmpdir do |folder|
+      FileUtils.mkdir_p(File.join(folder, "diagnostics"))
+      File.write(File.join(folder, "diagnostics", "red-status.md"), "summary: codex returned 401 missing bearer\n")
+      FileUtils.mkdir_p(File.join(folder, "logs"))
+      File.write(File.join(folder, "logs", "old.log"), "stale\n")
+      File.write(File.join(folder, "logs", "new.log"), "latest line mentions 401\n")
+
+      text = Hive::Daemon::AutoRetry::Classifier.diagnostics_text(folder, {})
+      assert_includes(text, "missing bearer")
+      assert_includes(text, "latest line mentions 401")
+      refute_includes(text, "stale")
+    end
+  end
+
+  private
+
+  def classify(reason:, message:)
+    Hive::Daemon::AutoRetry::Classifier.classify(
+      marker_name: "error",
+      marker_attrs: { "reason" => reason, "message" => message },
+      diagnostics: ""
+    )
+  end
+end
