@@ -0,0 +1,70 @@
+# frozen_string_literal: true
+
+require "test_helper"
+require "hive/config"
+
+# U8: `daemon.auto_retry.enabled` kill-switch — default on, strict boolean
+# validation matching the repo's existing daemon-config convention.
+class HiveDaemonAutoRetryConfigTest < Minitest::Test
+  include HiveTestHelper
+
+  def test_default_config_enables_auto_retry
+    assert_equal(true, Hive::Config::DEFAULTS.dig("daemon", "auto_retry", "enabled"))
+  end
+
+  def test_load_merges_the_default_for_projects_without_the_key
+    with_tmp_dir do |project_root|
+      FileUtils.mkdir_p(File.join(project_root, ".hive-state"))
+      File.write(File.join(project_root, ".hive-state", "config.yml"), {}.to_yaml)
+
+      cfg = Hive::Config.load(project_root)
+      assert_equal(true, cfg.dig("daemon", "auto_retry", "enabled"))
+    end
+  end
+
+  def test_explicit_false_is_honored
+    with_tmp_dir do |project_root|
+      FileUtils.mkdir_p(File.join(project_root, ".hive-state"))
+      File.write(
+        File.join(project_root, ".hive-state", "config.yml"),
+        { "daemon" => { "auto_retry" => { "enabled" => false } } }.to_yaml
+      )
+
+      cfg = Hive::Config.load(project_root)
+      assert_equal(false, cfg.dig("daemon", "auto_retry", "enabled"))
+    end
+  end
+
+  def test_non_boolean_enabled_raises_config_error
+    with_tmp_dir do |project_root|
+      FileUtils.mkdir_p(File.join(project_root, ".hive-state"))
+      File.write(
+        File.join(project_root, ".hive-state", "config.yml"),
+        { "daemon" => { "auto_retry" => { "enabled" => "yes" } } }.to_yaml
+      )
+
+      error = assert_raises(Hive::ConfigError) { Hive::Config.load(project_root) }
+      assert_match(/daemon\.auto_retry\.enabled/, error.message)
+    end
+  end
+
+  def test_non_hash_auto_retry_block_raises_config_error
+    with_tmp_dir do |project_root|
+      FileUtils.mkdir_p(File.join(project_root, ".hive-state"))
+      File.write(
+        File.join(project_root, ".hive-state", "config.yml"),
+        { "daemon" => { "auto_retry" => true } }.to_yaml
+      )
+
+      error = assert_raises(Hive::ConfigError) { Hive::Config.load(project_root) }
+      assert_match(/daemon\.auto_retry/, error.message)
+    end
+  end
+
+  def test_global_daemon_block_validation_rejects_bad_auto_retry
+    source = "the global config"
+    cfg = { "daemon" => { "auto_retry" => { "enabled" => 42 } } }
+    error = assert_raises(Hive::ConfigError) { Hive::Config.validate_daemon!(cfg, source) }
+    assert_match(/daemon\.auto_retry\.enabled/, error.message)
+  end
+end
diff --git a/test/unit/daemon/auto_retry/engine_test.rb b/test/unit/daemon/auto_retry/engine_test.rb
new file mode 100644
index 000000000..97a615771
--- /dev/null
+++ b/test/unit/daemon/auto_retry/engine_test.rb
@@ -0,0 +1,253 @@
+# frozen_string_literal: true
+
+require "test_helper"
+require "hive/daemon/auto_retry"
+require "hive/daemon/status_consumer"
+
+# U4/U6/U7/U8: the daemon evaluation loop. Multi-tick sequences run against
+# an injected probe suite / state store / request queue so no external CLI
+# is ever spawned.
+class HiveDaemonAutoRetryEngineTest < Minitest::Test
+  include HiveTestHelper
+
+  Row = Hive::Daemon::StatusConsumer::Row
+  NOW = Time.utc(2026, 6, 29, 12, 0, 0)
+
+  class FakeController
+    def initialize(running: [])
+      @running = running
+    end
+
+    def running_task?(project:, slug:)
+      @running.include?([ project, slug ])
+    end
+  end
+
+  class FakeLogger
+    attr_reader :events
+
+    def initialize
+      @events = []
+    end
+
+    def event(name, **attrs)
+      @events << [ name, attrs ]
+    end
+  end
+
+  class FakeRequestQueue
+    attr_reader :requests
+
+    def initialize
+      @requests = []
+    end
+
+    def write_request!(**kwargs)
+      @requests << kwargs
+      "req-#{@requests.size}"
+    end
+  end
+
+  # Probe suite double whose verdicts are scripted per call.
+  class ScriptedSuite
+    def initialize(healthy: true)
+      @healthy = healthy
+      @calls = 0
+    end
+
+    attr_reader :calls
+
+    def evaluate(_kind)
+      @calls += 1
+      result = Hive::Daemon::AutoRetry::ProbeResult.new(
+        name: "scripted", ok: @healthy, duration_ms: 1,
+        stdout: "", stderr: "", error: @healthy ? nil : "probe says no"
+      )
+      [ @healthy, [result] ]
+    end
+  end
+
+  def setup
+    @logger = FakeLogger.new
+    @controller = FakeController.new
+    @queue = FakeRequestQueue.new
+    @safety = nil
+    @sandbox = File.join(Dir.tmpdir, "hive-auto-retry-test-#{Process.pid}-#{rand(1_000_000)}")
+    FileUtils.mkdir_p(@sandbox)
+    @state_path = File.join(@sandbox, "auto_retry_state.json")
+  end
+
+  def teardown
+    FileUtils.rm_rf(@sandbox)
+  end
+
+  def engine(suite, config_loader: ->(_p) { {} })
+    Hive::Daemon::AutoRetry::Engine.new(
+      controller: @controller,
+      logger: @logger,
+      request_queue: @queue,
+      state_store: Hive::Daemon::AutoRetry::StateStore.new(path: @state_path),
+      config_loader: config_loader,
+      safety: safety,
+      backoff_sec: 1800,
+      probe_suite_factory: ->(*) { suite }
+    )
+  end
+
+  def safety
+    @safety ||= Hive::Daemon::AutoRetry::SafetyGuard.new(worktree_factory: ->(*) { nil })
+  end
+
+  def write_error_marker(reason:, message:)
+    folder = File.join(@sandbox, "stages", "4-execute", "task-58")
+    FileUtils.mkdir_p(folder)
+    state = File.join(folder, "task.md")
+    File.write(state, "# task\n\n<!-- ERROR reason=#{reason} message=\"#{message}\" -->\n")
+    folder
+  end
+
+  def row_for(folder, stage: "4-execute", reason: "implementer_failed", marker_id: nil,
+              message: "HTTP 401 missing bearer auth")
+    attrs = { "reason" => reason, "message" => message }
+    attrs["marker_id"] = marker_id if marker_id
+    Row.new(
+      project: "proj", slug: "task-58", stage: stage,
+      marker: "error", marker_attrs: attrs,
+      folder: folder, state_file: File.join(folder, "task.md"),
+      live_task_lock: false
+    )
+  end
+
+  def decisions
+    @logger.events.select { |name, _| name == :auto_retry_decision }
+  end
+
+  def test_healthy_recoverable_marker_is_retried_with_audit_event
+    folder = write_error_marker(reason: "implementer_failed", message: "401 unauthorized")
+    e = engine(ScriptedSuite.new(healthy: true))
+    e.tick([row_for(folder)], now: NOW)
+
+    assert_equal(1, @queue.requests.size)
+    assert_equal([ "hive", "run", "task-58", "--project", "proj" ], @queue.requests.first[:argv])
+    assert_equal("healer", @queue.requests.first[:requestor])
+    assert_equal("auto_retry", @queue.requests.first[:trigger])
+    decision = decisions.last[1]
+    assert_equal("retried", decision[:action])
+    assert_equal("implementer_failed", decision[:marker_reason])
+
+    events = File.readlines(File.join(folder, "events.jsonl")).map { |l| JSON.parse(l) }
+    assert(events.any? { |ev| ev["event_type"] == "auto_retry_decision" && ev["message"].include?("retried") })
+
+    # The marker itself must be GONE (manual-clear equivalence).
+    refute_includes(File.read(File.join(folder, "task.md")), "<!-- ERROR")
+  end
+
+  def test_fingerprint_unchanged_skips_probes_until_fallback_elapses
+    folder = write_error_marker(reason: "claude_launch_failed", message: "tmux session did not become ready")
+    suite = ScriptedSuite.new(healthy: false) # never healthy; probes are the cost we count
+    e = engine(suite)
+    row = row_for(folder, reason: "claude_launch_failed", message: "tmux session did not become ready")
+
+    e.tick([row], now: NOW)
+    assert_equal(1, suite.calls)
+
+    e.tick([row], now: NOW + 60) # same fingerprint, within fallback window
+    assert_equal(1, suite.calls, "unchanged fingerprint must not re-probe")
+
+    e.tick([row], now: NOW + Hive::Daemon::AutoRetry::Engine::FALLBACK_PROBE_INTERVAL_SEC + 1)
+    assert_equal(2, suite.calls, "fallback interval must force a re-probe")
+  end
+
+  def test_retry_cap_and_backoff_exhaust_to_permanent_park
+    folder = write_error_marker(reason: "implementer_failed", message: "401")
+    e = engine(ScriptedSuite.new(healthy: true))
+    row = row_for(folder)
+
+    # Attempt 1: fires immediately on first healthy signal.
+    e.tick([row], now: NOW)
+    assert_equal(1, @queue.requests.size)
+    # The stage fails again: marker reappears. Backoff blocks an immediate retry #2.
+    e.tick([row], now: NOW + 60)
+    assert_equal(1, @queue.requests.size)
+    # After >= 30 min AND a fresh healthy signal, retry #2 fires.
+    e.tick([row], now: NOW + 1900)
+    assert_equal(2, @queue.requests.size)
+    # Third strike: exhausted => parked, no more retries, terminal audit event.
+    e.tick([row], now: NOW + 3800)
+    assert_equal(2, @queue.requests.size)
+    exhausted = decisions.find { |_, d| d[:action] == "parked_exhausted" }
+    assert exhausted, "expected a parked_exhausted decision"
+
+    # And nothing further ever happens.
+    e.tick([row], now: NOW + 100_000)
+    assert_equal(2, @queue.requests.size)
+    assert_equal(decisions.count { |_, d| d[:action] == "parked_exhausted" }, 1)
+  end
+
+  def test_unrecoverable_marker_never_enters_evaluation
+    folder = write_error_marker(reason: "exit_code", message: "HTTP 401 missing bearer auth")
+    suite = ScriptedSuite.new(healthy: true)
+    e = engine(suite)
+    e.tick([row_for(folder, reason: "exit_code")], now: NOW)
+
+    assert_empty(@queue.requests)
+    assert_empty(decisions)
+    assert_equal(0, suite.calls)
+  end
+
+  def test_failed_probes_emit_throttled_negative_decision_once_per_fingerprint
+    folder = write_error_marker(reason: "implementer_failed", message: "401")
+    e = engine(ScriptedSuite.new(healthy: false))
+    row = row_for(folder)
+
+    e.tick([row], now: NOW)
+    e.tick([row], now: NOW + 60)
+    negatives = decisions.select { |_, d| d[:action] == "not_retried" }
+    assert_equal(1, negatives.size, "negative decisions throttle per fingerprint window")
+
+    # A changed health signal (config change) re-arms the negative event.
+    loader = ->(_p) { { "execute" => { "agent" => "codex" } } }
+    e2 = Hive::Daemon::AutoRetry::Engine.new(
+      controller: @controller, logger: @logger, request_queue: @queue,
+      state_store: Hive::Daemon::AutoRetry::StateStore.new(path: @state_path),
+      config_loader: loader, safety: safety,
+      probe_suite_factory: ->(*) { ScriptedSuite.new(healthy: false) }
+    )
+    # tick re-loads configs through the injected loader; the changed
+    # fingerprint must produce a second (re-armed) negative decision.
+    e2.tick([row], now: NOW + 20_000)
+    negatives = decisions.select { |_, d| d[:action] == "not_retried" }
+    assert_equal(2, negatives.size)
+  end
+
+  def test_kill_switch_off_is_a_zero_cost_early_return
+    folder = write_error_marker(reason: "implementer_failed", message: "401")
+    suite = ScriptedSuite.new(healthy: true)
+    e = engine(suite)
+    e.tick([row_for(folder)], now: NOW, enabled: false)
+
+    assert_empty(@queue.requests)
+    assert_empty(decisions)
+    assert_equal(0, suite.calls)
+  end
+
+  def test_live_lock_or_inflight_rows_are_skipped
+    folder = write_error_marker(reason: "implementer_failed", message: "401")
+    e = engine(ScriptedSuite.new(healthy: true))
+
+    locked = row_for(folder)
+    locked.live_task_lock = true
+    e.tick([locked], now: NOW)
+    assert_empty(@queue.requests)
+
+    busy = Hive::Daemon::AutoRetry::Engine.new(
+      controller: FakeController.new(running: [ %w[proj task-58] ]),
+      logger: @logger, request_queue: @queue,
+      state_store: Hive::Daemon::AutoRetry::StateStore.new(path: @state_path),
+      config_loader: ->(_p) { {} }, safety: safety,
+      probe_suite_factory: ->(*) { ScriptedSuite.new(healthy: true) }
+    )
+    busy.tick([row_for(folder)], now: NOW)
+    assert_empty(@queue.requests)
+  end
+end
diff --git a/test/unit/daemon/auto_retry/health_probes_test.rb b/test/unit/daemon/auto_retry/health_probes_test.rb
new file mode 100644
index 000000000..212772708
--- /dev/null
+++ b/test/unit/daemon/auto_retry/health_probes_test.rb
@@ -0,0 +1,201 @@
+# frozen_string_literal: true
+
+require "test_helper"
+require "hive/daemon/auto_retry/health_probes"
+require "hive/daemon/auto_retry/probes"
+
+# U3: concrete health probes with a mocked subprocess layer (no real CLI
+# calls), plus the Suite composition contract (doctor green is required
+# before any reason-specific probe runs).
+class HiveDaemonAutoRetryHealthProbesTest < Minitest::Test
+  include HiveTestHelper
+
+  Ok = ->(name) {
+    Hive::Daemon::AutoRetry::ProbeResult.new(name: name, ok: true, duration_ms: 1,
+                                             stdout: "", stderr: "", error: nil)
+  }
+  Fail = ->(name, error) {
+    Hive::Daemon::AutoRetry::ProbeResult.new(name: name, ok: false, duration_ms: 1,
+                                             stdout: "", stderr: "", error: error)
+  }
+
+  class FakeRunner
+    attr_reader :invoked
+
+    def initialize(command_results: {}, block_results: {}, command_blocks: {})
+      @command_results = command_results
+      @block_results = block_results
+      @command_blocks = command_blocks
+      @invoked = []
+    end
+
+    def run(name, _timeout_ms: nil, &_block)
+      @invoked << name
+      @block_results.fetch(name) { yield }
+    end
+
+    def run_command(name, argv, env: {}, timeout_ms: nil)
+      @invoked << [name, argv]
+      block = @command_blocks[name]
+      return block.call(argv, env) if block
+
+      @command_results[name] || Fail.call(name, "not stubbed")
+    end
+  end
+
+  def config(mode = "headless")
+    { "claude" => { "mode" => mode } }
+  end
+
+  def suite(runner, claude_mode: "headless")
+    Hive::Daemon::AutoRetry::HealthProbes::Suite.new(
+      runner: runner, config: config(claude_mode), project_root: "/tmp/does-not-matter"
+    )
+  end
+
+  # The Suite runs the REAL in-process doctor as its universal precondition.
+  # Composition tests stub Doctor.new with a scripted exit code (0 = green).
+  def with_doctor(exit_code: 0)
+    fake = Class.new do
+      define_method(:initialize) { |*| }
+      define_method(:call) { exit_code }
+    end
+    with_replaced_singleton_method(Hive::Commands::Doctor, :new, ->(*) { fake.new }) do
+      yield
+    end
+  end
+
+  def test_codex_auth_passes_only_when_login_and_smoke_both_pass
+    runner = FakeRunner.new(
+      command_results: {
+        "codex_login_status" => Ok.call("codex_login_status"),
+        "codex_exec_smoke" => Ok.call("codex_exec_smoke")
+      }
+    )
+    with_doctor do
+      healthy, results = suite(runner).evaluate(:codex_auth)
+      assert healthy
+      assert(results.all?(&:ok))
+      assert_equal(%w[codex_login_status codex_exec_smoke],
+                   runner.invoked.grep(Array).map(&:first))
+    end
+  end
+
+  def test_logged_out_codex_fails_without_spawning_the_smoke_test
+    runner = FakeRunner.new(
+      command_results: {
+        "codex_login_status" => Fail.call("codex_login_status", "exit 1")
+      }
+    )
+    with_doctor do
+      healthy, results = suite(runner).evaluate(:codex_auth)
+      refute healthy
+      refute_includes(runner.invoked.grep(Array).map(&:first), "codex_exec_smoke")
+      assert(results.any? { |r| r.name == "codex_login_status" && !r.ok })
+    end
+  end
+
+  def test_logged_out_text_with_exit_zero_is_not_healthy
+    logged_out = Hive::Daemon::AutoRetry::ProbeResult.new(
+      name: "codex_login_status", ok: true, duration_ms: 1,
+      stdout: "Not logged in", stderr: "", error: nil
+    )
+    runner = FakeRunner.new(command_results: { "codex_login_status" => logged_out })
+    with_doctor do
+      healthy, results = suite(runner).evaluate(:codex_auth)
+      refute healthy
+      refute_includes(runner.invoked.grep(Array).map(&:first), "codex_exec_smoke")
+      assert(results.any? { |r| r.name == "codex_login_status" && !r.ok })
+    end
+  end
+
+  def test_smoke_failure_after_green_login_fails_the_probe
+    login_ok = Hive::Daemon::AutoRetry::ProbeResult.new(
+      name: "codex_login_status", ok: true, duration_ms: 1,
+      stdout: "Logged in", stderr: "", error: nil
+    )
+    runner = FakeRunner.new(
+      command_results: {
+        "codex_login_status" => login_ok,
+        "codex_exec_smoke" => Fail.call("codex_exec_smoke", "exit 1")
+      }
+    )
+    with_doctor do
+      healthy, results = suite(runner).evaluate(:codex_auth)
+      refute healthy
+      assert(results.any? { |r| r.name == "codex_exec_smoke" && !r.ok })
+    end
+  end
+
+  def test_claude_launcher_probe_checks_version_and_tmux_readiness_in_tmux_mode
+    runner = FakeRunner.new(
+      command_results: { "claude_version" => Ok.call("claude_version") },
+      block_results: { "claude_ready_detector" => Ok.call("claude_ready_detector") }
+    )
+    with_doctor do
+      with_replaced_singleton_method(Hive::ClaudeLauncher, :tmux_status, ->(*) { [ :present, "tmux 3.3a found" ] }) do
+        healthy, results = suite(runner, claude_mode: "tmux").evaluate(:claude_launcher)
+        assert healthy
+        assert(results.all?(&:ok))
+      end
+    end
+    assert_includes(runner.invoked.map(&:to_s), "claude_ready_detector")
+  end
+
+  def test_claude_launcher_readiness_failure_is_not_healthy
+    runner = FakeRunner.new(
+      command_results: { "claude_version" => Ok.call("claude_version") },
+      block_results: { "claude_ready_detector" => Fail.call("claude_ready_detector", "tmux readiness failed: no tmux") }
+    )
+    with_doctor do
+      with_replaced_singleton_method(Hive::ClaudeLauncher, :tmux_status, ->(*) { [ :missing, "tmux not found" ] }) do
+        healthy, _results = suite(runner, claude_mode: "tmux").evaluate(:claude_launcher)
+        refute healthy
+      end
+    end
+  end
+
+  def test_red_doctor_fails_every_composition_regardless_of_specific_probes
+    runner = FakeRunner.new(
+      command_results: {
+        "codex_login_status" => Ok.call("codex_login_status"),
+        "codex_exec_smoke" => Ok.call("codex_exec_smoke")
+      }
+    )
+    with_doctor(exit_code: 65) do
+      healthy, results = suite(runner).evaluate(:codex_auth)
+      refute healthy
+      assert(results.any? { |r| r.name == "hive_doctor" && !r.ok })
+      # The reason-specific probes must NOT have been spawned past a red doctor.
+      refute_includes(runner.invoked.grep(Array).map(&:first), "codex_login_status")
+    end
+  end
+
+  def test_unknown_kind_is_never_healthy
+    runner = FakeRunner.new
+    with_doctor do
+      healthy, _results = suite(runner).evaluate(:mystery)
+      refute healthy
+    end
+  end
+
+  def test_doctor_probe_runs_the_real_doctor_in_process
+    Dir.mktmpdir do |project_root|
+      # Deterministically red: a nonexistent brainstorm skill makes the
+      # real doctor report a missing row on ANY machine, while headless
+      # mode keeps the tmux runtime check out of the picture.
+      cfg = Hive::Config::DEFAULTS.merge(
+        "project_root" => project_root,
+        "claude" => { "mode" => "headless" },
+        "brainstorm" => { "skill" => "/hive-definitely-not-a-real-skill" },
+        "plan" => { "skill" => "/hive-definitely-not-a-real-skill" }
+      )
+      runner = Hive::Daemon::AutoRetry::ProbeRunner.new
+      result = Hive::Daemon::AutoRetry::HealthProbes::HiveDoctor.evaluate(
+        runner: runner, config: cfg, project_root: project_root
+      )
+      refute_predicate(result, :ok)
+      assert_match(/doctor exited/, result.error.to_s)
+    end
+  end
+end
diff --git a/test/unit/daemon/auto_retry/probes_test.rb b/test/unit/daemon/auto_retry/probes_test.rb
new file mode 100644
index 000000000..f87dc3b76
--- /dev/null
+++ b/test/unit/daemon/auto_retry/probes_test.rb
@@ -0,0 +1,77 @@
+# frozen_string_literal: true
+
+require "test_helper"
+require "hive/daemon/auto_retry/probes"
+
+# U2: uniform probe execution. A hang, a raise, and a nonzero exit are all
+# "not healthy" (AE6); results cache per tick-scoped runner; the cache never
+# leaks across runners (ticks).
+class HiveDaemonAutoRetryProbesTest < Minitest::Test
+  def test_fast_passing_probe_is_ok_and_cached_within_a_tick
+    calls = 0
+    runner = Hive::Daemon::AutoRetry::ProbeRunner.new
+    result = runner.run("probe") { calls += 1 }
+
+    assert_predicate(result, :ok)
+    runner.run("probe") { calls += 1 }
+    assert_equal(1, calls, "second evaluation in the same tick must hit the cache")
+  end
+
+  def test_cache_does_not_leak_across_ticks
+    calls = 0
+    first = Hive::Daemon::AutoRetry::ProbeRunner.new
+    second = Hive::Daemon::AutoRetry::ProbeRunner.new
+    first.run("probe") { calls += 1 }
+    second.run("probe") { calls += 1 }
+    assert_equal(2, calls)
+  end
+
+  def test_raising_probe_is_not_healthy_with_cause_captured
+    runner = Hive::Daemon::AutoRetry::ProbeRunner.new
+    result = runner.run("boom") { raise ArgumentError, "no dice" }
+    refute_predicate(result, :ok)
+    assert_match(/ArgumentError: no dice/, result.error)
+  end
+
+  def test_hanging_in_process_probe_times_out_as_not_healthy
+    runner = Hive::Daemon::AutoRetry::ProbeRunner.new
+    result = runner.run("hang", timeout_ms: 100) { sleep 5 }
+    refute_predicate(result, :ok)
+    assert_match(/timed out/, result.error)
+  ensure
+    # The abandoned thread keeps sleeping; do not let it leak a failure.
+  end
+
+  def test_successful_command_captures_stdout_verbatim
+    runner = Hive::Daemon::AutoRetry::ProbeRunner.new
+    result = runner.run_command("echo", [ "sh", "-c", "echo hello-out; echo hello-err >&2" ])
+    assert_predicate(result, :ok)
+    assert_includes(result.stdout, "hello-out")
+    assert_includes(result.stderr, "hello-err")
+  end
+
+  def test_failing_command_records_stderr_and_exit_code
+    runner = Hive::Daemon::AutoRetry::ProbeRunner.new
+    result = runner.run_command("fail", [ "sh", "-c", "echo bad >&2; exit 3" ])
+    refute_predicate(result, :ok)
+    assert_match(/exit 3/, result.error)
+    assert_includes(result.stderr, "bad")
+  end
+
+  def test_hanging_command_is_killed_at_the_deadline
+    runner = Hive::Daemon::AutoRetry::ProbeRunner.new
+    started = Time.now
+    result = runner.run_command("hang", [ "sh", "-c", "sleep 60" ], timeout_ms: 200)
+    elapsed = Time.now - started
+    refute_predicate(result, :ok)
+    assert_match(/timed out/, result.error)
+    assert_operator(elapsed, :<, 10, "hung command must be killed at the deadline")
+  end
+
+  def test_missing_binary_degrades_to_not_healthy
+    runner = Hive::Daemon::AutoRetry::ProbeRunner.new
+    result = runner.run_command("missing", [ "hive-definitely-not-a-binary-xyz" ])
+    refute_predicate(result, :ok)
+    refute_nil(result.error)
+  end
+end
diff --git a/test/unit/daemon/auto_retry/safety_test.rb b/test/unit/daemon/auto_retry/safety_test.rb
