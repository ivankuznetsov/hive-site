index 000000000..6bc60c247
--- /dev/null
+++ b/test/unit/daemon/auto_retry/safety_test.rb
@@ -0,0 +1,124 @@
+# frozen_string_literal: true
+
+require "test_helper"
+require "hive/daemon/auto_retry/safety"
+
+# U5: work-area safety guard. Default-deny semantics: dirty-with-unknown
+# files and answered brainstorm content are unsafe (AE5); clean or
+# allowlisted-agent-generated-only worktrees are safe.
+class HiveDaemonAutoRetrySafetyTest < Minitest::Test
+  include HiveTestHelper
+
+  Row = Hive::Daemon::StatusConsumer::Row
+
+  def test_clean_execute_worktree_is_safe
+    with_tmp_dir do |folder|
+      row = execute_row(folder)
+      with_tmp_git_repo do |repo|
+        verdict = guard(worktree_path: repo).safe?(row: row, config: { "project_root" => repo })
+        assert_predicate(verdict, :safe?)
+      end
+    end
+  end
+
+  def test_uncommitted_user_edit_is_unsafe
+    with_tmp_dir do |folder|
+      row = execute_row(folder)
+      with_tmp_git_repo do |repo|
+        File.write(File.join(repo, "user-edit.txt"), "precious\n")
+        verdict = guard(worktree_path: repo).safe?(row: row, config: { "project_root" => repo })
+        refute_predicate(verdict, :safe?)
+      end
+    end
+  end
+
+  def test_missing_worktree_is_safe_retry_starts_clean
+    Dir.mktmpdir do |dir|
+      verdict = guard(worktree_path: nil).safe?(row: execute_row(dir), config: { "project_root" => dir })
+      assert_predicate(verdict, :safe?)
+    end
+  end
+
+  def test_brainstorm_with_answered_content_is_unsafe
+    Dir.mktmpdir do |folder|
+      state = File.join(folder, "brainstorm.md")
+      File.write(state, <<~MD)
+        ## Round 1
+
+        ### Q1. What should we build?
+        ### A1. A rocket ship.
+      MD
+      verdict = guard.safe?(row: row_for(folder, stage: "2-brainstorm", state_file: state), config: {})
+      refute_predicate(verdict, :safe?)
+    end
+  end
+
+  def test_pristine_brainstorm_without_answers_is_safe
+    Dir.mktmpdir do |folder|
+      state = File.join(folder, "brainstorm.md")
+      File.write(state, <<~MD)
+        <!-- ERROR reason=claude_launch_failed marker_id=abc -->
+
+        ## Round 1
+
+        ### Q1. What should we build?
+      MD
+      verdict = guard.safe?(row: row_for(folder, stage: "2-brainstorm", state_file: state), config: {})
+      assert_predicate(verdict, :safe?)
+    end
+  end
+
+  def test_nonempty_plan_md_is_unsafe_by_default
+    Dir.mktmpdir do |folder|
+      state = File.join(folder, "plan.md")
+      File.write(state, "# Plan\n\ncontent a rerun would replace\n")
+      verdict = guard.safe?(row: row_for(folder, stage: "3-plan", state_file: state), config: {})
+      refute_predicate(verdict, :safe?)
+    end
+  end
+
+  def test_terminal_success_marker_always_blocks_retry
+    Dir.mktmpdir do |folder|
+      state = File.join(folder, "task.md")
+      File.write(state, "<!-- EXECUTE_COMPLETE -->\n<!-- ERROR reason=implementer_failed -->\n")
+      row = row_for(folder, stage: "4-execute", state_file: state)
+      verdict = guard(worktree_path: nil).safe?(row: row, config: { "project_root" => folder })
+      refute_predicate(verdict, :safe?)
+      assert_match(/EXECUTE_COMPLETE/, verdict.rationale)
+    end
+  end
+
+  def test_unknown_stage_is_unsafe_by_default
+    Dir.mktmpdir do |folder|
+      row = row_for(folder, stage: "6-review", state_file: File.join(folder, "task.md"))
+      verdict = guard.safe?(row: row, config: {})
+      refute_predicate(verdict, :safe?)
+    end
+  end
+
+  private
+
+  def guard(worktree_path: nil)
+    Hive::Daemon::AutoRetry::SafetyGuard.new(
+      worktree_factory: ->(_project_root, _slug) { worktree_path }
+    )
+  end
+
+  def execute_row(folder)
+    state = File.join(folder, "task.md")
+    File.write(state, "<!-- ERROR reason=implementer_failed -->\n")
+    Row.new(
+      project: "p", slug: "s", stage: "4-execute",
+      marker: "error", marker_attrs: { "reason" => "implementer_failed" },
+      folder: folder, state_file: state
+    )
+  end
+
+  def row_for(folder, stage:, state_file:)
+    Row.new(
+      project: "p", slug: "s", stage: stage,
+      marker: "error", marker_attrs: { "reason" => "implementer_failed" },
+      folder: folder, state_file: state_file
+    )
+  end
+end
