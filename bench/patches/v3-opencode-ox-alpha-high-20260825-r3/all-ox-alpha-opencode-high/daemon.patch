diff --git a/lib/hive/daemon/auto_retry/classify.rb b/lib/hive/daemon/auto_retry/classify.rb
new file mode 100644
index 000000000..e3271154c
--- /dev/null
+++ b/lib/hive/daemon/auto_retry/classify.rb
@@ -0,0 +1,132 @@
+# frozen_string_literal: true
+
+module Hive
+  module Daemon
+    module AutoRetry
+      # U1: recoverable-marker classification.
+      #
+      # A closed v1 allowlist of terminal ERROR marker reasons the daemon may
+      # auto-retry, each with a REQUIRED diagnostic signature matched against
+      # the failure evidence captured on disk (the marker's own `message`
+      # attribute plus `diagnostics/red-status.md` and the newest task log).
+      # Anything else — other reasons, unrecognized signatures, missing
+      # diagnostics — classifies as NOT recoverable and stays parked for
+      # manual `hive markers clear`.
+      #
+      # Pure function: no I/O in `classify` itself. The `diagnostics_text`
+      # helper is the only filesystem-touching part and is best-effort /
+      # never-raising so callers can treat it as a total function.
+      module Classifier
+        # reason => probe-kind that must pass before a retry (U3/U4).
+        RECOVERABLE_REASONS_V1 = {
+          "implementer_failed" => :codex_auth,
+          "claude_launch_failed" => :claude_launcher
+        }.freeze
+
+        # Codex auth failure: the 401 / missing-bearer / missing-basic-auth
+        # shape Codex emits when its credentials are absent or expired.
+        CODEX_AUTH_SIGNATURE = /(\b401\b|unauthorized|missing bearer|missing basic auth|invalid api key|not logged in)/i
+
+        # Claude launcher/wrapper/readiness failures: session did not start,
+        # readiness detector never became ready, wrapper could not be
+        # inspected, tmux unavailable. Mirrors the AgentError messages
+        # ClaudeLauncher raises and spawn_claude_with_tmux_marker! stamps
+        # into reason=claude_launch_failed markers.
+        CLAUDE_LAUNCH_SIGNATURE = /(tmux|wrapper|did not start|already exists|become ready|ready|could not inspect|launch)/i
+
+        # Outcome of classification: `recoverable?` verdict, the probe kind
+        # to satisfy (:codex_auth / :claude_launcher), and the audit-facing
+        # rationale.
+        class Result
+          attr_reader :kind, :rationale
+
+          def initialize(recoverable:, kind:, rationale:)
+            @recoverable = recoverable
+            @kind = kind
+            @rationale = rationale
+          end
+
+          def recoverable?
+            @recoverable
+          end
+        end
+
+        module_function
+
+        def classify(marker_name:, marker_attrs:, diagnostics: "")
+          attrs = marker_attrs.to_h
+          reason = attrs["reason"].to_s
+
+          kind = RECOVERABLE_REASONS_V1[reason]
+          unless kind
+            return Result.new(recoverable: false, kind: nil,
+                              rationale: "reason #{reason.inspect} is not in the recoverable allowlist")
+          end
+
+          evidence = [attrs["message"].to_s, diagnostics.to_s].join("\n")
+          if evidence.strip.empty?
+            return Result.new(recoverable: false, kind: kind,
+                              rationale: "no stored diagnostics to confirm the #{reason} signature")
+          end
+
+          case kind
+          when :codex_auth
+            if evidence.match?(CODEX_AUTH_SIGNATURE)
+              Result.new(recoverable: true, kind: kind,
+                         rationale: "#{reason} carries the codex 401/missing-auth signature")
+            else
+              Result.new(recoverable: false, kind: kind,
+                         rationale: "#{reason} without the codex 401/missing-auth signature")
+            end
+          when :claude_launcher
+            if evidence.match?(CLAUDE_LAUNCH_SIGNATURE)
+              Result.new(recoverable: true, kind: kind,
+                         rationale: "#{reason} carries the launcher/wrapper/readiness signature")
+            else
+              Result.new(recoverable: false, kind: kind,
+                         rationale: "#{reason} without the launcher/wrapper/readiness signature")
+            end
+          else
+            Result.new(recoverable: false, kind: kind, rationale: "unknown probe kind #{kind.inspect}")
+          end
+        end
+
+        # Best-effort concatenation of every on-disk diagnostic source the
+        # signature match may inspect. Never raises; unreadable or missing
+        # sources contribute nothing. Bounded reads keep a giant log from
+        # being slurped whole.
+        DIAGNOSTICS_TAIL_BYTES = 16 * 1024
+
+        def diagnostics_text(folder, marker_attrs)
+          parts = []
+          red_status = File.join(folder.to_s, "diagnostics", "red-status.md")
+          parts << tail_of(red_status) if File.file?(red_status)
+          newest_log(folder)&.then { |path| parts << tail_of(path) }
+          parts.join("\n")
+        rescue StandardError
+          ""
+        end
+
+        def tail_of(path)
+          size = File.size(path)
+          offset = [size - DIAGNOSTICS_TAIL_BYTES, 0].max
+          File.open(path, "rb") do |file|
+            file.seek(offset)
+            file.read.to_s
+          end
+        rescue SystemCallError
+          ""
+        end
+
+        def newest_log(folder)
+          candidates = Dir[File.join(folder.to_s, "logs", "*.log")]
+          return nil if candidates.empty?
+
+          candidates.max_by { |path| File.mtime(path) rescue Time.at(0) }
+        rescue SystemCallError
+          nil
+        end
+      end
+    end
+  end
+end
diff --git a/lib/hive/daemon/auto_retry/engine.rb b/lib/hive/daemon/auto_retry/engine.rb
new file mode 100644
index 000000000..9e5b2f1ba
--- /dev/null
+++ b/lib/hive/daemon/auto_retry/engine.rb
@@ -0,0 +1,291 @@
+# frozen_string_literal: true
+
+require "time"
+require "hive/markers"
+require "hive/events"
+require "hive/daemon/auto_retry/classify"
+require "hive/daemon/auto_retry/probes"
+require "hive/daemon/auto_retry/health_probes"
+require "hive/daemon/auto_retry/fingerprint"
+require "hive/daemon/auto_retry/safety"
+require "hive/daemon/auto_retry/state_store"
+
+module Hive
+  module Daemon
+    module AutoRetry
+      # U4/U6/U7: the daemon-tick decision loop.
+      #
+      # Per tick, every parked task whose current ERROR marker classifies as
+      # recoverable (U1) is evaluated under:
+      #   * fingerprint gating — probes only re-run when the health-signal
+      #     fingerprint changed since the last probe, or the low-frequency
+      #     fallback interval elapsed (R6);
+      #   * a fresh ProbeRunner per tick, giving tick-scoped probe caching
+      #     across rows (R5);
+      #   * limits/backoff — max 2 auto-retries per task per reason; retry
+      #     #1 fires on the first healthy signal, retry #2 needs ANOTHER
+      #     healthy signal AND >= 30 minutes since retry #1; the third
+      #     strike marks the task exhausted => permanently parked until a
+      #     manual `hive markers clear` (R7);
+      #   * the safety guard (U5/R8) — default-deny;
+      #   * manual-clear-equivalent mechanics (U6/R9) — the marker is
+      #     cleared through the same locked `Hive::Markers.clear_current`
+      #     primitive `hive markers clear` uses, then the stage rerun is
+      #     enqueued through the normal dispatch-request queue so it passes
+      #     the usual concurrency gates. No resume path.
+      # Every decision — positive and throttled negative — is audited both
+      # to the daemon log and to the task's events.jsonl (U7/R10).
+      class Engine
+        MAX_ATTEMPTS_PER_REASON = 2
+        SECOND_RETRY_BACKOFF_SEC = 1800
+        FALLBACK_PROBE_INTERVAL_SEC = 1800
+
+        def initialize(controller:, logger:, request_queue:, state_store:, config_loader:,
+                       safety: SafetyGuard.new, classifier: Classifier,
+                       max_attempts: MAX_ATTEMPTS_PER_REASON,
+                       backoff_sec: SECOND_RETRY_BACKOFF_SEC,
+                       fallback_interval_sec: FALLBACK_PROBE_INTERVAL_SEC,
+                       probe_suite_factory: nil)
+          @controller = controller
+          @logger = logger
+          @request_queue = request_queue
+          @state_store = state_store
+          @config_loader = config_loader
+          @safety = safety
+          @classifier = classifier
+          @max_attempts = max_attempts
+          @backoff_sec = backoff_sec
+          @fallback_interval_sec = fallback_interval_sec
+          @probe_suite_factory = probe_suite_factory || ->(runner, config, project_root) {
+            HealthProbes::Suite.new(runner: runner, config: config, project_root: project_root)
+          }
+        end
+
+        # `enabled:` comes from the global `daemon.auto_retry.enabled`
+        # kill-switch (U8). When false this is a cheap early return with
+        # zero probe cost and zero events (AE7).
+        def tick(rows, now: Time.now, enabled: true, legacy_layout_projects: {})
+          return unless enabled
+
+          runner = ProbeRunner.new
+          configs = {}
+          project_roots = {}
+          rows.each do |row|
+            next if legacy_layout_projects.include?(row.project)
+            next if @controller.running_task?(project: row.project, slug: row.slug)
+            next if row.live_task_lock == true
+            next unless row.marker.to_s == "error"
+
+            config = configs[row.project] ||= @config_loader.call(row.project)
+            root = project_roots[row.project] ||= resolve_project_root(row.project, config)
+            evaluate_row(row, config, root, runner, now)
+          end
+        rescue StandardError => e
+          @logger.event(:fatal,
+                        message: "auto_retry engine raised: #{e.class}: #{e.message}",
+                        keeping_previous: true)
+        end
+
+        private
+
+        def evaluate_row(row, config, project_root, runner, now)
+          attrs = row.marker_attrs.to_h
+          verdict = @classifier.classify(
+            marker_name: row.marker.to_s,
+            marker_attrs: attrs,
+            diagnostics: Classifier.diagnostics_text(row.folder, attrs)
+          )
+          return unless verdict.recoverable?
+
+          key = [row.project.to_s, row.slug.to_s, row.stage.to_s, attrs["reason"].to_s]
+          state = @state_store[key]
+          if state.exhausted
+            return # permanently parked; manual clear resets by removing the marker's reason match target
+          end
+
+          if state.attempts >= @max_attempts
+            exhaust!(row, key, state, verdict, now)
+            return
+          end
+
+          fingerprint = Fingerprint.compute(config: config, project_root: project_root)
+          return unless probe_due?(state, fingerprint, now)
+
+          healthy, probe_results = probe_suite(runner, config, project_root).evaluate(verdict.kind)
+          @state_store.update(key) do |entry|
+            entry.last_fingerprint = fingerprint
+            entry.last_probed_at = now
+          end
+
+          unless healthy
+            emit_negative(row, key, verdict, probe_results, fingerprint, state.attempts,
+                          rationale: "not retried: health probes failed " \
+                                     "(#{probe_results.reject(&:ok).map(&:summary).join('; ')})",
+                          now: now)
+            return
+          end
+
+          unless backoff_satisfied?(state, now)
+            emit_negative(row, key, verdict, probe_results, fingerprint, state.attempts,
+                          rationale: "healthy but #{SECOND_RETRY_BACKOFF_SEC}s backoff after attempt " \
+                                     "#{state.attempts} has not elapsed",
+                          now: now)
+            return
+          end
+
+          safety_verdict = @safety.safe?(row: row, config: config)
+          unless safety_verdict.safe?
+            emit_negative(row, key, verdict, probe_results, fingerprint, state.attempts,
+                          rationale: "not retried: #{safety_verdict.rationale}",
+                          now: now)
+            return
+          end
+
+          retry_stage!(row, key, state, verdict, probe_results, fingerprint, now)
+        end
+
+        def probe_due?(state, fingerprint, now)
+          return true if state.last_fingerprint.nil? && state.last_probed_at.nil? # first evaluation
+          return true if fingerprint.nil? # cannot prove sameness => probe
+          return true if state.last_fingerprint != fingerprint
+
+          last_probe = state.last_probed_at
+          return true if last_probe.nil?
+          return true if (now - last_probe) >= @fallback_interval_sec
+
+          false
+        end
+
+        def backoff_satisfied?(state, now)
+          return true if state.attempts.zero?
+
+          last_attempt = state.last_attempt_at
+          return true if last_attempt.nil?
+
+          (now - last_attempt) >= @backoff_sec
+        end
+
+        def probe_suite(runner, config, project_root)
+          @probe_suite_factory.call(runner, config, project_root)
+        end
+
+        def resolve_project_root(project, config)
+          root = config["project_root"]
+          return File.expand_path(root) if root
+
+          Hive::Config.find_project(project)&.fetch("path", nil)
+        end
+
+        # U6 mechanics: clear via the same locked primitive `hive markers
+        # clear` uses, then enqueue the rerun through the normal dispatch-
+        # request queue (requestor=healer) so caps/cooldown/in-flight gates
+        # still apply. A failed clear (concurrent writer changed the marker)
+        # consumes nothing and logs nothing — the next tick reconciles.
+        def retry_stage!(row, key, state, verdict, probe_results, fingerprint, now)
+          attrs = row.marker_attrs.to_h
+          match_attrs = { "reason" => attrs["reason"].to_s }
+          marker_id = attrs["marker_id"].to_s
+          match_attrs["marker_id"] = marker_id.empty? ? nil : marker_id
+
+          cleared = Hive::Markers.clear_current(
+            row.state_file, expected_name: :error, match_attrs: match_attrs
+          )
+          return unless cleared
+
+          attempts = state.attempts + 1
+          argv = [ "hive", "run", row.slug, "--project", row.project ]
+          begin
+            request_id = @request_queue.write_request!(
+              project: row.project, slug: row.slug, argv: argv,
+              requestor: "healer", trigger: "auto_retry"
+            )
+          rescue StandardError => e
+            audit(row, verdict, probe_results, fingerprint, attempts, "retry_enqueue_failed",
+                  "#{verdict.rationale}; marker cleared but rerun enqueue FAILED " \
+                  "(#{e.class}: #{e.message}) — run `#{argv.join(' ')}` manually",
+                  now: now, request_id: nil)
+            raise e
+          end
+
+          @state_store.update(key) do |entry|
+            entry.attempts = attempts
+            entry.last_attempt_at = now
+            entry.last_fingerprint = fingerprint
+            entry.last_probed_at = now
+          end
+
+          audit(row, verdict, probe_results, fingerprint, attempts, "retried",
+                "#{verdict.rationale}; attempt #{attempts}/#{@max_attempts} " \
+                "enqueued via #{argv.join(' ')}",
+                now: now, request_id: request_id)
+        end
+
+        def exhaust!(row, key, state, verdict, now)
+          return if state.last_attempt_at.nil?
+
+          @state_store.update(key) { |entry| entry.exhausted = true }
+          audit(row, verdict, [], state.last_fingerprint, state.attempts, "parked_exhausted",
+                "exhausted #{@max_attempts} auto-retries; permanently parked — recover with `hive markers clear`",
+                now: now, request_id: nil)
+        end
+
+        # Throttled negative decisions (R10): emit at most once per
+        # fingerprint change or per fallback interval per task/reason.
+        def emit_negative(row, key, verdict, probe_results, fingerprint, attempts, rationale:, now:)
+          state = @state_store[key]
+          throttle_changed = state.last_negative_fingerprint != fingerprint
+          stale = state.last_negative_at.nil? ||
+                  ((now - state.last_negative_at) >= @fallback_interval_sec)
+          unless throttle_changed || stale
+            @state_store.update(key) do |entry|
+              entry.last_fingerprint = fingerprint
+              entry.last_probed_at = now
+            end
+            return
+          end
+
+          @state_store.update(key) do |entry|
+            entry.last_negative_fingerprint = fingerprint
+            entry.last_negative_at = now
+          end
+          audit(row, verdict, probe_results, fingerprint, attempts, "not_retried",
+                rationale, now: now, request_id: nil)
+        end
+
+        # U7 dual-channel audit: one structured line in the daemon log plus
+        # an event in the task's own events.jsonl (best-effort; Events.emit
+        # never raises).
+        def audit(row, verdict, probe_results, fingerprint, attempts, action, rationale, now:, request_id:)
+          payload = {
+            project: row.project,
+            slug: row.slug,
+            stage: row.stage,
+            marker_reason: row.marker_attrs.to_h["reason"].to_s,
+            marker_id: row.marker_attrs.to_h["marker_id"].to_s,
+            kind: verdict.kind&.to_s,
+            action: action,
+            auto_retry_attempts: attempts,
+            max_attempts: @max_attempts,
+            health_fingerprint: fingerprint,
+            probes: probe_results.map(&:summary),
+            rationale: rationale,
+            request_id: request_id,
+            decision_ts: now.utc.iso8601
+          }
+          @logger.event(:auto_retry_decision, **payload)
+
+          message = "auto_retry[#{action}] #{rationale} (probes: " \
+                    "#{probe_results.map(&:summary).join('; ')}; fingerprint: #{fingerprint})"
+          Events.emit(
+            task_folder: row.folder.to_s,
+            slug: row.slug.to_s,
+            stage: row.stage.to_s,
+            event_type: :auto_retry_decision,
+            agent: "daemon-auto-retry",
+            message: message
+          )
+        end
+      end
+    end
+  end
+end
diff --git a/lib/hive/daemon/auto_retry/fingerprint.rb b/lib/hive/daemon/auto_retry/fingerprint.rb
new file mode 100644
index 000000000..d80481222
--- /dev/null
+++ b/lib/hive/daemon/auto_retry/fingerprint.rb
@@ -0,0 +1,87 @@
+# frozen_string_literal: true
+
+require "digest"
+require "hive/agent_profiles"
+
+module Hive
+  module Daemon
+    module AutoRetry
+      # Health-signal fingerprint (R6): a cheap hash over everything that,
+      # when it CHANGES, justifies a fresh probe round — daemon binary
+      # path/version fingerprint, agent binaries + wrapper mtimes, relevant
+      # config blocks, the env slice probes/stages inherit, and the
+      # plugin/skill inventory directory mtimes. Stat-only: no CLI calls.
+      # State-only signals that have no on-disk artifact (e.g. Codex login
+      # revocation without any file change) are covered by the engine's
+      # low-frequency periodic fallback re-probe instead.
+      module Fingerprint
+        ENV_KEYS = %w[CODEX_HOME HIVE_CODEX_BIN HIVE_CLAUDE_BIN HIVE_PI_BIN HIVE_HOME].freeze
+
+        # Skill/plugin inventory roots worth watching. Only their mtimes are
+        # stat'ed; missing roots contribute nothing.
+        SKILL_INVENTORY_ROOTS = [
+          -> { File.join(Dir.home, ".claude", "skills") },
+          -> { File.join(Dir.home, ".codex", "prompts") },
+          ->(project_root) { File.join(project_root.to_s, ".claude", "skills") }
+        ].freeze
+
+        CONFIG_KEYS = %w[agents claude brainstorm plan execute].freeze
+
+        module_function
+
+        def compute(config:, project_root:)
+          parts = [
+            Hive::VERSION,
+            daemon_binary_signal,
+            env_slice,
+            config_slice(config),
+            agent_binary_signals(config),
+            skill_inventory_signals(project_root)
+          ]
+          ::Digest::SHA256.hexdigest(parts.inspect)
+        rescue StandardError
+          nil
+        end
+
+        def daemon_binary_signal
+          path = $PROGRAM_NAME.to_s
+          mtime = File.exist?(path) ? File.mtime(path).to_f : nil
+          [path, mtime]
+        rescue StandardError
+          [path, nil]
+        end
+
+        def env_slice
+          ENV_KEYS.to_h { |key| [key, ENV[key]] }
+        end
+
+        def config_slice(config)
+          CONFIG_KEYS.to_h { |key| [key, config[key]] }.inspect
+        end
+
+        def agent_binary_signals(config)
+          %w[claude codex].filter_map do |name|
+            profile = Hive::AgentProfiles.lookup(name, cfg: config)
+            bin = profile.bin
+            expanded = File.expand_path(bin)
+            mtime = File.file?(expanded) ? File.mtime(expanded).to_f : nil
+            [bin, mtime]
+          rescue StandardError
+            nil
+          end
+        end
+
+        def skill_inventory_signals(project_root)
+          SKILL_INVENTORY_ROOTS.filter_map do |resolver|
+            root = resolver.arity.zero? ? resolver.call : resolver.call(project_root)
+            next unless File.directory?(root)
+
+            [root, File.mtime(root).to_f]
+          rescue StandardError
+            nil
+          end
+        end
+      end
+    end
+  end
+end
