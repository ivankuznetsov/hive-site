+++ b/lib/hive/daemon/auto_retry/health_probes.rb
@@ -0,0 +1,71 @@
+# frozen_string_literal: true
+
+require "stringio"
+
+module Hive
+  module Daemon
+    module AutoRetry
+      # U3 concrete probes. Each probe goes through the U2 ProbeRunner so
+      # timeouts, output capture, and tick-scoped caching are automatic.
+      # External CLI invocations inherit the daemon's own environment
+      # (Open3 merges the passed env ONTO ENV), which keeps the probe
+      # environment identical to a real stage run.
+      module HealthProbes
+      end
+    end
+  end
+end
+
+require "hive/daemon/auto_retry/health_probes/hive_doctor"
+require "hive/daemon/auto_retry/health_probes/codex_auth"
+require "hive/daemon/auto_retry/health_probes/claude_launcher"
+
+module Hive
+  module Daemon
+    module AutoRetry
+      module HealthProbes
+        # Composes the universal precondition with the reason-specific
+        # probe set. The doctor must be green for ANY retry (AE2 negative
+        # arm): a red doctor fails the whole composition regardless of the
+        # specific-probe results. All results are cached per tick through
+        # the shared ProbeRunner, so several parked markers evaluated in
+        # one tick run each underlying check at most once.
+        class Suite
+          def initialize(runner:, config:, project_root:)
+            @runner = runner
+            @config = config
+            @project_root = project_root
+          end
+
+          # Returns [healthy, probe_results]. `kind` is the Classifier kind
+          # (:codex_auth or :claude_launcher); an unknown kind is never
+          # healthy (default-deny).
+          def evaluate(kind)
+            results = []
+            doctor_result = HiveDoctor.evaluate(runner: @runner, config: @config,
+                                                project_root: @project_root)
+            results << doctor_result
+            return [false, results] unless doctor_result.ok
+
+            specific = case kind
+                       when :codex_auth
+                         CodexAuth.evaluate(runner: @runner)
+                       when :claude_launcher
+                         ClaudeLauncherProbe.evaluate(runner: @runner, config: @config)
+                       else
+                         ProbeResult.new(name: "unknown_kind_#{kind}", ok: false,
+                                         duration_ms: 0, stdout: "", stderr: "",
+                                         error: "no probe set for kind #{kind.inspect}")
+                       end
+            results.concat(Array(specific))
+            [results.all?(&:ok), results]
+          end
+
+          private
+
+          attr_reader :runner
+        end
+      end
+    end
+  end
+end
diff --git a/lib/hive/daemon/auto_retry/health_probes/claude_launcher.rb b/lib/hive/daemon/auto_retry/health_probes/claude_launcher.rb
new file mode 100644
index 000000000..a1f98f554
--- /dev/null
+++ b/lib/hive/daemon/auto_retry/health_probes/claude_launcher.rb
@@ -0,0 +1,69 @@
+# frozen_string_literal: true
+
+module Hive
+  module Daemon
+    module AutoRetry
+      module HealthProbes
+        # Claude launcher probe (R4): the active claude binary/wrapper must
+        # exist and answer `--version` (binary/version fingerprint match),
+        # and — in tmux mode — the tmux runtime readiness check
+        # (Hive::ClaudeLauncher.tmux_status, the same detector `hive doctor`
+        # uses) must pass. The universal doctor green is enforced by the
+        # Suite composition. The resolved wrapper path + mtime are exposed
+        # as health signals for the U4 fingerprint.
+        module ClaudeLauncherProbe
+          VERSION_PROBE = "claude_version"
+          READY_PROBE = "claude_ready_detector"
+
+          Signal = Struct.new(:bin_path, :bin_mtime, keyword_init: true)
+
+          module_function
+
+          def evaluate(runner:, config:)
+            profile = Hive::AgentProfiles.lookup(:claude, cfg: config)
+            version = runner.run_command(VERSION_PROBE, [ profile.bin, "--version" ])
+            return version unless version.ok
+
+            results = [version]
+            if Hive::Config.claude_mode(config) == :tmux
+              ready = runner.run(READY_PROBE) do
+                status, message = Hive::ClaudeLauncher.tmux_status
+                raise "tmux readiness failed: #{message}" unless status == :present
+              end
+              results << ready
+            end
+
+            return [composite(results)] if results.all?(&:ok)
+
+            results
+          end
+
+          # Cheap health signals folded into the U4 fingerprint: resolved
+          # wrapper path + mtime. Best-effort; nils degrade gracefully.
+          def health_signals(config)
+            profile = Hive::AgentProfiles.lookup(:claude, cfg: config)
+            bin = File.expand_path(profile.bin)
+            if File.file?(bin)
+              Signal.new(bin_path: bin, bin_mtime: File.mtime(bin).to_f)
+            else
+              Signal.new(bin_path: profile.bin, bin_mtime: nil)
+            end
+          rescue StandardError
+            Signal.new(bin_path: nil, bin_mtime: nil)
+          end
+
+          def composite(results)
+            ProbeResult.new(
+              name: "claude_launcher",
+              ok: true,
+              duration_ms: results.sum(&:duration_ms),
+              stdout: results.map(&:name).join("+"),
+              stderr: "",
+              error: nil
+            )
+          end
+        end
+      end
+    end
+  end
+end
diff --git a/lib/hive/daemon/auto_retry/health_probes/codex_auth.rb b/lib/hive/daemon/auto_retry/health_probes/codex_auth.rb
new file mode 100644
index 000000000..8a2339578
--- /dev/null
+++ b/lib/hive/daemon/auto_retry/health_probes/codex_auth.rb
@@ -0,0 +1,45 @@
+# frozen_string_literal: true
+
+module Hive
+  module Daemon
+    module AutoRetry
+      module HealthProbes
+        # Codex auth probe (R3): `codex login status` must report a logged-in
+        # session AND a tiny `codex exec` smoke prompt must succeed. Both
+        # conditions are required — a logged-out login status or a passing
+        # status with a failing smoke test both mean NOT healthy.
+        module CodexAuth
+          LOGIN_PROBE = "codex_login_status"
+          SMOKE_PROBE = "codex_exec_smoke"
+          SMOKE_PROMPT = "Reply with exactly: OK"
+
+          module_function
+
+          def evaluate(runner:)
+            login = runner.run_command(LOGIN_PROBE, [ "codex", "login", "status" ])
+            unless login.ok && !login.stdout.match?(/not logged in|logged out/i)
+              # A CLI that exits 0 while reporting "not logged in" must NOT
+              # read as healthy: rewrite the verdict here so both shapes
+              # (nonzero exit, logged-out text) are unambiguously unhealthy.
+              return ProbeResult.new(name: LOGIN_PROBE,
+                                     ok: false,
+                                     duration_ms: login.duration_ms,
+                                     stdout: login.stdout, stderr: login.stderr,
+                                     error: "codex is not logged in")
+            end
+            smoke = runner.run_command(
+              SMOKE_PROBE,
+              [ "codex", "exec", "--skip-git-repo-check", SMOKE_PROMPT ]
+            )
+            return smoke unless smoke.ok
+
+            ProbeResult.new(name: "codex_auth", ok: true,
+                            duration_ms: login.duration_ms + smoke.duration_ms,
+                            stdout: "#{LOGIN_PROBE}=ok #{SMOKE_PROBE}=ok",
+                            stderr: "", error: nil)
+          end
+        end
+      end
+    end
+  end
+end
diff --git a/lib/hive/daemon/auto_retry/health_probes/hive_doctor.rb b/lib/hive/daemon/auto_retry/health_probes/hive_doctor.rb
new file mode 100644
index 000000000..f88d8aa17
--- /dev/null
+++ b/lib/hive/daemon/auto_retry/health_probes/hive_doctor.rb
@@ -0,0 +1,33 @@
+# frozen_string_literal: true
+
+module Hive
+  module Daemon
+    module AutoRetry
+      module HealthProbes
+        # Universal lightweight precondition (R2): the existing `hive doctor`
+        # skill/dependency checks, run in-process at reduced depth (JSON
+        # envelope, no table render). Green (exit 0) => healthy. A config
+        # error surfaces as doctor's own exit 78 => not healthy.
+        module HiveDoctor
+          PROBE_NAME = "hive_doctor"
+
+          module_function
+
+          def evaluate(runner:, config:, project_root:)
+            runner.run(PROBE_NAME) do
+              output = StringIO.new
+              doctor = Hive::Commands::Doctor.new(
+                config: config,
+                project_root: project_root,
+                json: true,
+                output: output
+              )
+              exit_code = doctor.call
+              raise "doctor exited #{exit_code}: #{output.string.strip[0, 300]}" unless exit_code.zero?
+            end
+          end
+        end
+      end
+    end
+  end
+end
diff --git a/lib/hive/daemon/auto_retry/probes.rb b/lib/hive/daemon/auto_retry/probes.rb
new file mode 100644
index 000000000..5ecb48d74
--- /dev/null
+++ b/lib/hive/daemon/auto_retry/probes.rb
@@ -0,0 +1,151 @@
+# frozen_string_literal: true
+
+require "open3"
+require "timeout"
+
+module Hive
+  module Daemon
+    module AutoRetry
+      # U2: uniform health-probe execution.
+      #
+      # `ProbeResult` captures everything the audit trail needs: verdict,
+      # wall-clock duration, verbatim stdout/stderr tails, and the failure
+      # cause. A hang (timeout), a nonzero exit, or a raise are ALL
+      # "not healthy" — never an error that escapes into the tick.
+      ProbeResult = Struct.new(:name, :ok, :duration_ms, :stdout, :stderr, :error,
+                               keyword_init: true) do
+        def summary
+          if ok
+            "#{name}: ok"
+          else
+            detail = error.to_s.empty? ? stderr_tail : error.to_s
+            "#{name}: failed (#{detail})"
+          end
+        end
+
+        def stderr_tail
+          tail = stderr.to_s.strip.lines.last.to_s.strip
+          tail.empty? ? "no output" : tail[0, 200]
+        end
+      end
+
+      class ProbeRunner
+        # Per-command timeouts (R5): 10–30s constants in v1.
+        DEFAULT_TIMEOUT_MS = 30_000
+        FAST_TIMEOUT_MS = 10_000
+
+        # A fresh runner is a fresh cache: the Engine builds one per tick so
+        # multiple parked markers evaluated in the same tick share results,
+        # while nothing leaks across ticks.
+        def initialize(timeout_ms: DEFAULT_TIMEOUT_MS)
+          @default_timeout_ms = timeout_ms
+          @cache = {}
+        end
+
+        # In-process probe: run the block under a hard deadline. Any raise /
+        # timeout => ok:false with the cause captured.
+        def run(name, timeout_ms: @default_timeout_ms)
+          started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+          cached = @cache[name]
+          return cached if cached
+
+          result = Timeout.timeout(timeout_ms / 1000.0) do
+            yield
+            ProbeResult.new(name: name, ok: true, duration_ms: elapsed_ms(started),
+                            stdout: "", stderr: "", error: nil)
+          end
+          @cache[name] = result
+          result
+        rescue Timeout::Error
+          result = ProbeResult.new(name: name, ok: false, duration_ms: timeout_ms,
+                                   stdout: "", stderr: "",
+                                   error: "timed out after #{timeout_ms}ms")
+          @cache[name] = result
+          result
+        rescue StandardError => e
+          result = ProbeResult.new(name: name, ok: false,
+                                   duration_ms: elapsed_ms(started),
+                                   stdout: "", stderr: "",
+                                   error: "#{e.class}: #{e.message}")
+          @cache[name] = result
+          result
+        end
+
+        # External-CLI probe: spawn argv with its own process group so a
+        # hung CLI can be killed on the deadline; stdout/stderr captured
+        # verbatim for the audit trail. Nonzero exit / timeout / spawn
+        # failure all yield ok:false. Results are cached per probe name for
+        # the lifetime of this (tick-scoped) runner.
+        def run_command(name, argv, env: {}, timeout_ms: @default_timeout_ms)
+          @cache[name] ||= execute_command(name, argv, env: env, timeout_ms: timeout_ms)
+        end
+
+        def execute_command(name, argv, env: {}, timeout_ms: @default_timeout_ms)
+          started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+          out = ""
+          err = ""
+          timed_out = false
+          status = nil
+          Open3.popen3(env, *argv.map(&:to_s), pgroup: true) do |stdin, stdout, stderr, wait_thr|
+            stdin.close
+            out_thread = Thread.new { stdout.read }
+            err_thread = Thread.new { stderr.read }
+            begin
+              Timeout.timeout(timeout_ms / 1000.0) { wait_thr.join }
+              status = wait_thr.value
+            rescue Timeout::Error
+              timed_out = true
+              kill_process_group(wait_thr.pid)
+              begin
+                Timeout.timeout(2) { wait_thr.join }
+              rescue Timeout::Error
+                nil
+              end
+            end
+            out = out_thread.value.to_s
+            err = err_thread.value.to_s
+          end
+
+          if timed_out
+            ProbeResult.new(name: name, ok: false, duration_ms: timeout_ms,
+                            stdout: tail(out), stderr: tail(err),
+                            error: "timed out after #{timeout_ms}ms")
+          elsif status&.success?
+            ProbeResult.new(name: name, ok: true, duration_ms: elapsed_ms(started),
+                            stdout: out, stderr: err, error: nil)
+          else
+            code = status ? "exit #{status.exitstatus}" : "unknown status"
+            ProbeResult.new(name: name, ok: false, duration_ms: elapsed_ms(started),
+                            stdout: out, stderr: err, error: code)
+          end
+        rescue StandardError => e
+          ProbeResult.new(name: name, ok: false, duration_ms: elapsed_ms(started),
+                          stdout: tail(out), stderr: tail(err),
+                          error: "#{e.class}: #{e.message}")
+        end
+
+        private
+
+        def kill_process_group(pid)
+          Process.kill("-KILL", pid)
+        rescue Errno::ESRCH, Errno::EPERM
+          begin
+            Process.kill("KILL", pid)
+          rescue Errno::ESRCH, Errno::EPERM
+            nil
+          end
+        rescue StandardError
+          nil
+        end
+
+        def elapsed_ms(started)
+          ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round
+        end
+
+        def tail(text)
+          text.to_s[-2048..] || text.to_s
+        end
+      end
+    end
+  end
+end
diff --git a/lib/hive/daemon/auto_retry/safety.rb b/lib/hive/daemon/auto_retry/safety.rb
new file mode 100644
index 000000000..18999c3ca
--- /dev/null
+++ b/lib/hive/daemon/auto_retry/safety.rb
@@ -0,0 +1,174 @@
+# frozen_string_literal: true
+
+require "open3"
+require "timeout"
+require "hive/brainstorm_parser"
+require "hive/stages/auto_commit"
+
+module Hive
+  module Daemon
+    module AutoRetry
+      # U5: work-area safety guard (R8). A retry re-runs the stage FROM
+      # SCRATCH, so before any marker clear this guard must prove the rerun
+      # cannot discard user work. DEFAULT-DENY: ambiguity, unreadable state,
+      # or an unknown stage all mean NOT safe.
+      #
+      # Stage-aware checks:
+      #   * execute (4-execute): the worktree must be clean OR contain only
+      #     files that pass the existing review.fix.auto_commit scope-check
+      #     allow/deny globs (the repo's one piece of "agent-generated and
+      #     safe" knowledge — nothing new is invented here). Any denied or
+      #     unclassified path => unsafe. A worktree that does not exist yet
+      #     is safe (a retry creates it fresh).
+      #   * brainstorm (2-brainstorm): answered Q&A content present in
+      #     brainstorm.md would be overwritten by a regeneration => unsafe.
+      #     Pristine / zero-question files are safe.
+      #   * plan (3-plan): a non-empty plan.md may hold user edits =>
+      #     unsafe; missing/empty is safe.
+      #   * every stage: terminal success markers already on the state file
+      #     (EXECUTE_COMPLETE / COMPLETE) make a retry unsafe, always.
+      class SafetyGuard
+        SUCCESS_MARKERS = %w[EXECUTE_COMPLETE COMPLETE REVIEW_COMPLETE].freeze
+        STATUS_TIMEOUT_SEC = 10
+
+        # Outcome of one guard evaluation: `safe?` plus the audit-facing
+        # rationale (recorded verbatim on negative decisions).
+        class Verdict
+          attr_reader :rationale
+
+          def initialize(allowed:, rationale:)
+            @allowed = allowed
+            @rationale = rationale
+          end
+
+          def safe?
+            @allowed
+          end
+        end
+
+        def initialize(worktree_factory: nil)
+          @worktree_factory = worktree_factory
+        end
+
+        def safe?(row:, config:)
+          state_text = File.read(row.state_file.to_s)
+          success_marker = success_marker_in(state_text)
+          if success_marker
+            return Verdict.new(allowed: false,
+                               rationale: "state file already carries a #{success_marker} marker; retrying could discard completed work")
+          end
+
+          case row.stage.to_s
+          when "4-execute"
+            execute_safety(row, config)
+          when "2-brainstorm"
+            brainstorm_safety(row)
+          when "3-plan"
+            plan_safety(row)
+          else
+            Verdict.new(allowed: false,
+                        rationale: "no safety rule for stage #{row.stage.inspect}; refusing by default")
+          end
+        rescue StandardError => e
+          Verdict.new(allowed: false, rationale: "safety check failed (#{e.class}: #{e.message}); refusing by default")
+        end
+
+        private
+
+        def success_marker_in(state_text)
+          SUCCESS_MARKERS.find { |name| state_text.match?(/<!--\s*#{name}\b/) }
+        end
+
+        def execute_safety(row, config)
+          worktree_path = resolve_worktree(row, config)
+          unless worktree_path && File.directory?(worktree_path)
+            return Verdict.new(allowed: true, rationale: "execute worktree does not exist yet; a retry starts clean")
+          end
+
+          result = git_status_porcelain(worktree_path)
+          unless result[:success]
+            return Verdict.new(allowed: false,
+                               rationale: "git status failed in worktree (#{result[:message]}); cannot prove safety")
+          end
+
+          paths = result[:stdout].split("\n").filter_map do |line|
+            line.sub(/\A..\s?/, "").strip
+          end.reject(&:empty?)
+          return Verdict.new(allowed: true, rationale: "worktree is clean") if paths.empty?
+
+          violations = Hive::Stages::AutoCommit.auto_commit_scope_violations(config, paths)
+          if violations.empty?
+            Verdict.new(allowed: true,
+                        rationale: "worktree changes are all within the agent-generated scope allowlist: #{paths.join(', ')}")
+          else
+            Verdict.new(allowed: false,
+                        rationale: "unclassified worktree changes present (#{violations.map(&:path).join(', ')}); " \
+                                   "retry could discard user work")
+          end
+        end
+
+        def brainstorm_safety(row)
+          path = row.state_file.to_s
+          return Verdict.new(allowed: true, rationale: "brainstorm.md missing; nothing to overwrite") unless File.file?(path)
+
+          parsed = Hive::BrainstormParser.parse(path)
+          questions = Array(parsed)
+          return Verdict.new(allowed: true, rationale: "no parseable questions; safe to regenerate") if questions.empty?
+
+          answered = questions.count(&:answered?)
+          if answered.positive?
+            Verdict.new(allowed: false,
+                        rationale: "#{answered} answered brainstorm question(s) present; a rerun would overwrite them")
+          else
+            Verdict.new(allowed: true, rationale: "questions exist but none are answered yet; safe to regenerate")
+          end
+        rescue StandardError => e
+          Verdict.new(allowed: false, rationale: "brainstorm.md unreadable (#{e.class}: #{e.message}); refusing by default")
+        end
+
+        def plan_safety(row)
+          path = row.state_file.to_s
+          return Verdict.new(allowed: true, rationale: "plan.md missing; nothing to overwrite") unless File.file?(path)
+          return Verdict.new(allowed: true, rationale: "plan.md empty; nothing to overwrite") if File.size(path).zero?
+
+          Verdict.new(allowed: false,
+                      rationale: "plan.md holds generated content a rerun would replace; refusing by default")
+        end
+
+        def resolve_worktree(row, config)
+          factory = @worktree_factory || ->(project_root, slug) {
+            require "hive/worktree"
+            Hive::Worktree.new(project_root, slug).path
+          }
+          project_root = project_root_for(row, config)
+          return nil unless project_root
+
+          factory.call(project_root, row.slug)
+        end
+
+        def project_root_for(row, config)
+          root = config["project_root"]
+          return File.expand_path(root) if root
+
+          entry = Hive::Config.find_project(row.project)
+          entry&.fetch("path", nil)
+        end
+
+        def git_status_porcelain(worktree_path)
+          out, err, status = Timeout.timeout(STATUS_TIMEOUT_SEC) do
+            Open3.capture3("git", "-C", worktree_path, "status", "--porcelain")
+          end
+          if status.success?
+            { success: true, stdout: out, message: "" }
+          else
+            { success: false, stdout: "", message: err.strip[0, 200] }
+          end
+        rescue Timeout::Error
+          { success: false, stdout: "", message: "git status timed out after #{STATUS_TIMEOUT_SEC}s" }
+        rescue Errno::ENOENT => e
+          { success: false, stdout: "", message: e.message }
+        end
+      end
+    end
+  end
+end
diff --git a/lib/hive/daemon/auto_retry/state_store.rb b/lib/hive/daemon/auto_retry/state_store.rb
new file mode 100644
index 000000000..4671caf3e
--- /dev/null
+++ b/lib/hive/daemon/auto_retry/state_store.rb
@@ -0,0 +1,133 @@
+# frozen_string_literal: true
+
+require "fileutils"
+require "json"
+require "securerandom"
+require "time"
+
+module Hive
+  module Daemon
+    module AutoRetry
+      # Crash-safe persisted bookkeeping for auto-retry attempts, keyed by
+      # [project, slug, stage, reason]. Mirrors the Hive::UpdateCheck::State /
+      # DispatchBaselines discipline: a JSON envelope with schema_version,
+      # atomic tempfile+rename writes, and a fail-closed load (torn/corrupt/
+      # newer files degrade to an empty map — worst case one task earns its
+      # attempt budget fresh after an unclean shutdown).
+      class StateStore
+        SCHEMA = "hive-daemon-auto-retry-state"
+        SCHEMA_VERSION = 1
+
+        Entry = Struct.new(:attempts, :last_fingerprint, :last_attempt_at,
+                           :last_probed_at, :last_negative_fingerprint,
+                           :last_negative_at, :exhausted,
+                           keyword_init: true) do
+          # Fresh-entry defaults: zero attempts, not exhausted.
+          def initialize(attempts: 0, last_fingerprint: nil, last_attempt_at: nil,
+                         last_probed_at: nil, last_negative_fingerprint: nil,
+                         last_negative_at: nil, exhausted: false)
+            super
+          end
+
+          def self.from_h(hash)
+            return new if hash.nil?
+
+            new(
+              attempts: hash["attempts"].to_i,
+              last_fingerprint: hash["last_fingerprint"],
+              last_attempt_at: parse_time(hash["last_attempt_at"]),
+              last_probed_at: parse_time(hash["last_probed_at"]),
+              last_negative_fingerprint: hash["last_negative_fingerprint"],
+              last_negative_at: parse_time(hash["last_negative_at"]),
+              exhausted: hash["exhausted"] == true
+            )
+          end
+
+          def self.parse_time(value)
+            Time.iso8601(value.to_s)
+          rescue ArgumentError
+            nil
+          end
+
+          def to_h
+            {
+              "attempts" => attempts,
+              "last_fingerprint" => last_fingerprint,
+              "last_attempt_at" => last_attempt_at&.iso8601,
+              "last_probed_at" => last_probed_at&.iso8601,
+              "last_negative_fingerprint" => last_negative_fingerprint,
+              "last_negative_at" => last_negative_at&.iso8601,
+              "exhausted" => exhausted
+            }
+          end
+        end
+
+        def initialize(path:)
+          @path = path
+          @entries = load
+        end
+
+        def get(key)
+          @entries[serialize_key(key)]
+        end
+
+        def put(key, entry)
+          @entries[serialize_key(key)] = entry
+          write
+          entry
+        end
+
+        def [](key)
+          get(key) || Entry.new
+        end
+
+        def update(key)
+          entry = self[key]
+          yield entry
+          put(key, entry)
+        end
+
+        attr_reader :path
+
+        private
+
+        def serialize_key(key)
+          JSON.generate(key.map(&:to_s))
+        end
+
+        def load
+          raw = File.read(@path)
+          doc = JSON.parse(raw)
+          unless doc.is_a?(Hash) && doc["schema"] == SCHEMA && doc["schema_version"] == SCHEMA_VERSION &&
+                 doc["entries"].is_a?(Hash)
+            return {}
+          end
+
+          doc["entries"]
+        rescue Errno::ENOENT
+          {}
+        rescue JSON::ParserError, SystemCallError
+          {}
+        end
+
+        def write
+          FileUtils.mkdir_p(File.dirname(@path))
+          payload = {
+            "schema" => SCHEMA,
+            "schema_version" => SCHEMA_VERSION,
+            "entries" => @entries.transform_values { |entry| entry.to_h }
+          }
+          tmp = "#{@path}.tmp.#{Process.pid}.#{SecureRandom.hex(4)}"
+          File.open(tmp, File::WRONLY | File::CREAT | File::TRUNC, 0o644) do |f|
+            f.write(JSON.generate(payload))
+            f.flush
+            f.fsync
+          end
+          File.rename(tmp, @path)
+        ensure
+          FileUtils.rm_f(tmp) if defined?(tmp) && tmp && File.exist?(tmp)
+        end
+      end
+    end
+  end
+end
