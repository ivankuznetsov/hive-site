# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/

# AI-native docs: serve the LLM index + per-page raw markdown as fetchable,
# cross-origin, clean text/markdown so an agent can read them directly.
/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Assets aren't content-hashed (just-the-docs-default.css, landing.css, …), so
# keep the cache short or a deploy would leave returning visitors on stale CSS/JS.
# Cloudflare still revalidates with ETags; this just bounds browser staleness.
/assets/*
  Cache-Control: public, max-age=600, must-revalidate

# Baseline security headers for HTML.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/box.sh
  Content-Type: text/x-shellscript; charset=utf-8
/box.ps1
  Content-Type: text/plain; charset=utf-8
